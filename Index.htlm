<!DOCTYPE html>
<html><head><base target="_top"><meta charset="utf-8">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<title>Control Almacén</title>
<script>var JS_ERR="";function avisoJs(t){var d=document.getElementById("jsErr")||document.createElement("div");d.id="jsErr";d.style.cssText="position:fixed;left:0;right:0;bottom:0;z-index:9999;background:#b42318;color:#fff;font:13px sans-serif;padding:8px 12px;white-space:pre-wrap";d.textContent=t;(document.body||document.documentElement).appendChild(d);}
window.onerror=function(m,s,l,c){if(!JS_ERR){JS_ERR="Error en la página (línea "+l+":"+(c||0)+"): "+m;avisoJs(JS_ERR+"\nEnvía una captura de este aviso a soporte.");}};
window.addEventListener("load",function(){if(window.APP_OK||JS_ERR)return;var sc=document.scripts,t=sc.length?sc[sc.length-1].text:"";avisoJs("La página no cargó completa ("+(window.APP_INI?"el código empezó pero no terminó":"el código no llegó a ejecutarse")+"; "+sc.length+" scripts, último de "+t.length+" caracteres, termina en: "+t.trim().slice(-40)+").\nEnvía una captura de este aviso a soporte.");});</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* Layout: pantalla de ingreso; luego menú lateral oscuro + barra superior con acciones; vistas en tarjetas; documentos en ventanas modales */
:root{
  --bg:#f2f4f7; --surface:#ffffff; --ink:#14202b; --muted:#5f6b77; --line:#dde2e8; --soft:#f7f9fb;
  --side:#0f2a43; --side-2:#163954; --side-ink:#c5d3e0; --side-hi:#ffffff;
  --accent:#1f5f8b; --accent-ink:#ffffff; --accent-soft:#e3eef6;
  --ok:#2f7d4a; --ok-soft:#e1f1e6; --warn:#a35f00; --warn-soft:#fbefd9; --bad:#b3261e; --bad-soft:#f9e0de;
  --f-body:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace;
  --shadow:0 1px 2px rgba(16,24,40,.05);
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#12171c; --surface:#1a2128; --ink:#e6eaee; --muted:#9aa6b1; --line:#2c3640; --soft:#1f2730;
  --side:#0b1a28; --side-2:#13283a; --side-ink:#a9bacb; --side-hi:#ffffff;
  --accent:#6fb0dc; --accent-ink:#0d1a22; --accent-soft:#1b3242;
  --ok:#6cc58a; --ok-soft:#1c3125; --warn:#f0b04a; --warn-soft:#382b15; --bad:#f1847c; --bad-soft:#3d1f1d; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#12171c; --surface:#1a2128; --ink:#e6eaee; --muted:#9aa6b1; --line:#2c3640; --soft:#1f2730;
  --side:#0b1a28; --side-2:#13283a; --side-ink:#a9bacb; --side-hi:#ffffff;
  --accent:#6fb0dc; --accent-ink:#0d1a22; --accent-soft:#1b3242;
  --ok:#6cc58a; --ok-soft:#1c3125; --warn:#f0b04a; --warn-soft:#382b15; --bad:#f1847c; --bad-soft:#3d1f1d; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{background:var(--bg);color:var(--ink);font:14.5px/1.5 var(--f-body);margin:0}
button{font:inherit}
svg.i{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}

/* ingreso */
#login{min-height:100vh;display:grid;place-items:center;padding:24px 16px;background:linear-gradient(160deg,var(--side) 0 38%,var(--bg) 38%)}
.lcard{width:100%;max-width:380px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:28px 26px;box-shadow:0 20px 50px rgba(0,0,0,.18);display:grid;gap:14px}
.brand{display:flex;align-items:center;gap:10px}
.brand .logo{width:38px;height:38px;border-radius:8px;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center}
.brand .logo svg{width:22px;height:22px}
.brand b{display:block;font-size:1.05rem;letter-spacing:.01em}
.brand small{color:var(--muted);font-size:.78rem}
.lcard h2{margin:6px 0 0;font-size:1.25rem}
.lcard .btn{width:100%;padding:10px}

/* estructura */
#app{display:grid;grid-template-columns:236px 1fr;min-height:100vh}
.side{background:var(--side);color:var(--side-ink);display:flex;flex-direction:column;position:sticky;top:0;height:100vh}
.side .brand{padding:18px 18px 14px;border-bottom:1px solid rgba(255,255,255,.08)}
.side .brand b{color:var(--side-hi)} .side .brand small{color:var(--side-ink)}
.nav{flex:1;overflow-y:auto;padding:10px 10px;display:grid;align-content:start;gap:2px}
.nav .grp{font-size:.66rem;letter-spacing:.12em;text-transform:uppercase;color:#7f97ad;padding:12px 10px 4px}
.nav button{display:flex;align-items:center;gap:10px;width:100%;background:none;border:0;color:var(--side-ink);padding:8px 10px;border-radius:6px;cursor:pointer;text-align:left;font-size:.9rem}
.nav button:hover{background:var(--side-2);color:var(--side-hi)}
.nav button[aria-current="page"]{background:var(--accent);color:#fff}
.nav .cnt{margin-left:auto;background:var(--bad);color:#fff;font-size:.68rem;font-weight:600;border-radius:99px;padding:0 7px}
.who{border-top:1px solid rgba(255,255,255,.08);padding:12px 16px;display:grid;gap:6px;font-size:.82rem}
.who b{color:var(--side-hi);font-weight:600;display:block}
.who .links{display:flex;gap:12px}
.who .links button{background:none;border:0;color:var(--side-ink);padding:0;cursor:pointer;text-decoration:underline;font-size:.8rem}
.main{min-width:0;display:flex;flex-direction:column}
.top{background:var(--surface);border-bottom:1px solid var(--line);padding:14px 24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;position:sticky;top:0;z-index:5}
.top h1{font-size:1.3rem;margin:0;font-weight:600}
.sub{color:var(--muted);font-size:.82rem;margin:2px 0 0}
.content{padding:20px 24px 48px;display:grid;grid-template-columns:minmax(0,1fr);gap:16px;max-width:1400px;width:100%}
.view{min-width:0}
@media (max-width:900px){
  #app{grid-template-columns:minmax(0,1fr)} .side,.main{min-width:0}
  .side{position:static;height:auto}
  .side .brand{padding:12px 16px}
  .nav{display:flex;overflow-x:auto;padding:6px 10px;gap:4px}
  .nav .grp{display:none}
  .nav button{white-space:nowrap;width:auto}
  .who{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;padding:8px 16px}
  .top{position:static;padding:12px 16px}
  .content{padding:16px 16px 40px}
}

/* componentes */
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
.tile{background:var(--surface);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:8px;padding:12px 14px;text-align:left;color:inherit;cursor:pointer;box-shadow:var(--shadow)}
.tile:hover{border-color:var(--accent)}
.tile .n{font-size:1.55rem;font-weight:600;line-height:1.15;font-variant-numeric:tabular-nums;white-space:nowrap}
.tile .l{color:var(--muted);font-size:.74rem;text-transform:uppercase;letter-spacing:.05em}
.tile.bad{border-left-color:var(--bad)} .tile.bad .n{color:var(--bad)}
.tile.warn{border-left-color:var(--warn)} .tile.warn .n{color:var(--warn)}
.tile.ok{border-left-color:var(--ok)}
.view{display:grid;gap:14px}
.dash{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:14px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:16px 18px;display:grid;gap:8px;min-width:0;box-shadow:var(--shadow)}
.card h2{font-size:1rem;font-weight:600;margin:0}
.card .cap{font-size:.8rem;color:var(--muted);margin:-6px 0 0}
.chart{position:relative;height:270px}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:.8rem;color:var(--muted)}
.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px;vertical-align:-1px}
.reps{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:14px}
.reps .card .bar select,.reps .card .bar input{flex:1 1 140px}
.bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.toolbar{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:10px 12px;box-shadow:var(--shadow)}
input,select,textarea{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:7px 10px;min-width:0;width:100%}
.bar input,.bar select{width:auto}
input:focus-visible,select:focus-visible,button:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
input[readonly]{background:var(--soft);color:var(--muted)}
.grow{flex:1 1 220px}
.btn{display:inline-flex;align-items:center;gap:6px;font-weight:600;font-size:.86rem;border-radius:6px;padding:7px 13px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer;white-space:nowrap}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn.sm{padding:3px 9px;font-size:.78rem}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn svg.i{width:16px;height:16px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:18px;display:grid;gap:12px}
.panel h2{font-size:1.15rem;font-weight:600;margin:0}
.panel h3{font:600 .74rem var(--f-body);text-transform:uppercase;letter-spacing:.07em;color:var(--muted);margin:4px 0 0;border-top:1px solid var(--line);padding-top:12px}
.form{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:10px}
.form label,.form .fld{display:grid;gap:3px;font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;min-width:0;align-content:start}
.form .full{grid-column:1/-1} .form .two{grid-column:span 2}
@media (max-width:560px){.form .two{grid-column:1/-1}}
.combo{display:flex;gap:6px} .combo select{flex:1}
.combo .btn{padding:4px 10px;text-transform:none;letter-spacing:0}
.tablebox{overflow-x:auto;background:var(--surface);border:1px solid var(--line);border-radius:8px;box-shadow:var(--shadow)}
table{border-collapse:collapse;width:100%}
.tablebox table{min-width:760px}
th,td{padding:8px 11px;text-align:left;border-bottom:1px solid var(--line);vertical-align:middle}
th{font:600 .7rem var(--f-body);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);background:var(--soft);white-space:nowrap}
tr:last-child td{border-bottom:0}
tbody tr:hover td{background:var(--soft)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;white-space:nowrap}
.code{font:500 .76rem var(--f-mono);color:var(--muted)}
.big{font-weight:600;font-size:1.02rem;font-variant-numeric:tabular-nums}
.pill{display:inline-block;font-size:.68rem;font-weight:600;padding:2px 8px;border-radius:99px;text-transform:uppercase;letter-spacing:.03em;white-space:nowrap}
.pill.ok{background:var(--ok-soft);color:var(--ok)} .pill.warn{background:var(--warn-soft);color:var(--warn)} .pill.bad{background:var(--bad-soft);color:var(--bad)} .pill.info{background:var(--accent-soft);color:var(--accent)} .pill.mute{background:var(--soft);color:var(--muted);border:1px solid var(--line)}
.drop{display:grid;place-items:center;gap:6px;border:2px dashed var(--line);border-radius:10px;padding:32px 16px;cursor:pointer;text-align:center;margin:8px 0;background:var(--surface)}
.drop.on{border-color:var(--accent);background:var(--accent-soft,var(--surface))} .drop input{display:none} .drop b{font-size:1rem;color:var(--accent)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 12px} .chips span{font-size:.8rem;padding:5px 10px;border-radius:6px;border:1px solid var(--line);background:var(--surface)}
.chips .ok{border-color:var(--ok);color:var(--ok)} .chips .warn{border-color:var(--warn);color:var(--warn)} .chips .bad{border-color:var(--bad);color:var(--bad)}
.tl{display:flex;flex-wrap:wrap;gap:6px 0;margin:0 0 14px;font-size:.8rem} .tl span{padding:4px 10px;border-left:3px solid var(--line);color:var(--muted)}
.tl span.on{border-left-color:var(--ok);color:var(--ink)} .tl span.no{border-left-color:var(--bad);color:var(--bad)} .tl b{display:block;font-size:.72rem;text-transform:uppercase;letter-spacing:.04em}
tr.excl td{opacity:.5} .rev{font-size:.74rem;line-height:1.35} .rev div{margin-top:2px}
tr.st-bad td:first-child{box-shadow:inset 3px 0 0 var(--bad)} tr.st-warn td:first-child{box-shadow:inset 3px 0 0 var(--warn)}
.empty{padding:26px;text-align:center;color:var(--muted)}
.note{font-size:.82rem;color:var(--muted)}
.err{color:var(--bad);font-size:.86rem}
.warnmsg{color:var(--warn);font-size:.86rem}
.sel{background:var(--accent-soft);border-radius:8px;padding:10px 14px;display:flex;flex-wrap:wrap;gap:4px 16px;align-items:baseline}
.total{font-weight:700;font-size:1.3rem;font-variant-numeric:tabular-nums}
.modal{position:fixed;inset:0;background:rgba(10,20,30,.55);display:flex;align-items:flex-start;justify-content:center;padding:28px 16px;overflow:auto;z-index:20}
.modal>.panel{width:100%;max-width:1040px;box-shadow:0 18px 50px rgba(0,0,0,.25)}
.modal.small>.panel{max-width:520px}
#pMat,#pEnt{z-index:30}
.phead{display:flex;justify-content:space-between;align-items:center;gap:10px}
.x{background:none;border:0;font-size:1.6rem;line-height:1;color:var(--muted);cursor:pointer;padding:2px 8px}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg button{font-weight:600;font-size:.86rem;padding:7px 14px;border-radius:6px;border:1px solid var(--line);background:var(--surface);color:var(--muted);cursor:pointer}
.seg button b{font-family:var(--f-mono);font-weight:500;font-size:.72rem;margin-right:6px;opacity:.8}
.seg button[aria-pressed="true"]{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.tipohelp{font-size:.84rem;color:var(--muted);margin:-4px 0 0}
.done{display:grid;gap:12px;justify-items:start;padding:8px 0}
.done .docn{font-size:2.2rem;font-weight:700;letter-spacing:.02em;color:var(--accent)}
.qty{width:105px;text-align:right}
td select{min-width:190px;font-size:.82rem;padding:4px 6px}
.minis{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px}
.chk{display:flex;align-items:center;gap:6px;font-size:.86rem;color:var(--muted);white-space:nowrap;text-transform:none;letter-spacing:0}
.chk input{width:auto}
.form label.chk{display:flex;flex-direction:row;align-items:center;gap:8px;text-transform:none;letter-spacing:0;font-size:.9rem;color:var(--ink)} .form label.chk input{width:auto;margin:0;flex:none} .form label.chk[hidden]{display:none}
.pilban{margin:6px 0 0;padding:4px 10px;border-radius:6px;background:#fff4d6;color:#7a5200;font-size:.8rem;font-weight:600;border:1px solid #f0d58a}
.iv-rep{margin:6px 0 4px;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--soft)} .iv-rep ul{margin:4px 0 0;padding-left:18px} .iv-rep li{margin:2px 0}
#pQr{z-index:30} #pQr .panel,#pResp .panel{grid-template-columns:minmax(0,1fr)} #qrBody .code{overflow-wrap:anywhere}
.qr-list{border:1px solid var(--line);border-radius:8px} .qr-list>div{display:flex;gap:10px;justify-content:space-between;align-items:flex-start;padding:8px 10px;border-top:1px solid var(--line)} .qr-list>div:first-child{border-top:0} .qr-list>div>div{min-width:0} .qr-list .q{font-weight:700;white-space:nowrap;text-align:right;flex:none} .qr-list a{color:var(--accent);font-weight:600} .qr-msg{padding:10px 12px;border-radius:8px;margin:4px 0 10px;font-weight:500}
.qr-msg.ok{background:var(--ok-soft);color:var(--ok)} .qr-msg.warn{background:var(--warn-soft);color:var(--warn)} .qr-msg.bad{background:var(--bad-soft);color:var(--bad)} .qr-msg.mute{background:var(--soft);color:var(--muted)}
.qr-info{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px;margin:6px 0 10px} .qr-info div{display:grid;gap:1px;min-width:0} .qr-info span{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em} .qr-info b{font-weight:600;overflow-wrap:anywhere}
.qr-big{font-size:1.8rem;font-weight:700;line-height:1.1;margin:2px 0 8px} .qr-big small{font-size:.9rem;color:var(--muted);font-weight:500}
#lQr{display:block;margin-top:10px} #lQr[hidden]{display:none}
#pConf{z-index:40}
.pbtns{display:flex;align-items:center;gap:2px;flex:none} .xmin{font-size:1.3rem;font-weight:700}
#tray{position:fixed;right:16px;bottom:16px;z-index:15;display:flex;flex-direction:column;align-items:flex-end;gap:8px} #tray:empty{display:none}
#tray button{display:flex;align-items:center;gap:8px;max-width:340px;padding:10px 14px;border:0;border-radius:10px;background:var(--accent);color:var(--accent-ink);font:600 .9rem var(--f-body);cursor:pointer;box-shadow:0 8px 24px rgba(0,0,0,.25)}
#tray button span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap} #tray button b{flex:none}
@media (max-width:600px){#tray{left:16px;right:16px;bottom:12px;align-items:stretch} #tray button{max-width:none}} .cf-body p{margin:8px 0} .cf-cab{padding:8px 10px;background:var(--soft);border-radius:8px;margin-bottom:8px}
.cf-g{border-left:4px solid var(--line);background:var(--soft);border-radius:6px;padding:6px 10px;margin:6px 0} .cf-g ul{margin:4px 0 0;padding-left:18px;max-height:180px;overflow:auto} .cf-g summary{cursor:pointer}
.cf-g.ok{border-left-color:var(--ok)} .cf-g.warn{border-left-color:var(--warn)} .cf-g.bad{border-left-color:var(--bad)}
.pl-nuevos{margin:8px 0} .pl-g{margin:6px 0} .pl-g .chk{white-space:normal;margin:3px 0 0 4px}
.pos{color:var(--ok)} .neg{color:var(--bad)}
.menu{position:relative;display:inline-block}.menu summary{list-style:none;cursor:pointer}.menu summary::-webkit-details-marker{display:none}
.menu-list{position:absolute;right:0;top:calc(100% + 4px);z-index:40;display:grid;gap:4px;background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:6px;min-width:230px;box-shadow:0 8px 24px rgba(0,0,0,.18)}
.menu-list .btn{justify-content:flex-start;width:100%}
tr.anul td{color:var(--muted)} tr.anul td b.code{text-decoration:line-through}
.btn.danger{color:var(--bad);border-color:var(--bad)}
.agenda{display:grid;grid-template-columns:repeat(var(--n,6),minmax(128px,1fr));gap:8px;overflow-x:auto;padding-bottom:4px}
.ag-venc{border:1px solid var(--bad);border-radius:8px;background:var(--soft);padding:6px 8px;margin-bottom:8px} .ag-venc .ag-h{color:var(--bad)} .ag-venc-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:6px}
.pill.ag-p{font-size:.62rem;padding:1px 6px}
@media (max-width:760px){.agenda{grid-template-columns:1fr;overflow:visible}.ag-col{min-height:0}.ag-col.vacio{display:none}}
.ag-col{background:var(--soft);border:1px solid var(--line);border-radius:8px;padding:6px;min-height:140px;display:flex;flex-direction:column;gap:6px}
.ag-col.hoy{border-color:var(--warn);box-shadow:inset 0 3px 0 var(--warn)} .ag-col.venc{border-color:var(--bad);box-shadow:inset 0 3px 0 var(--bad)}
.ag-h{font-size:.74rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);display:flex;justify-content:space-between;padding:2px 2px 4px}
.ag-card{font:inherit;text-align:left;cursor:pointer;display:block;width:100%;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:6px;padding:6px 8px;font-size:.8rem;line-height:1.35}
.ag-card:hover{box-shadow:0 2px 8px rgba(0,0,0,.14)}
.ag-card.warn{border-left-color:var(--warn)} .ag-card.bad{border-left-color:var(--bad)} .ag-card.ok{border-left-color:var(--ok);opacity:.75} .ag-card.ok .ag-who{text-decoration:line-through} .ag-card.mute{border-left-color:var(--line);opacity:.6}
.ag-t{font-weight:700;display:flex;justify-content:space-between;flex-wrap:wrap;gap:2px 4px;align-items:center} .ag-who{font-weight:700} .ag-empty{color:var(--muted);font-size:.76rem;text-align:center;padding:10px 0}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:6px;font-weight:500;max-width:calc(100% - 32px);z-index:40}
@media (prefers-reduced-motion:no-preference){.toast{animation:up .2s ease-out}@keyframes up{from{opacity:0;transform:translate(-50%,8px)}}}
.split{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:4px}.split .qty{width:84px}
label.mini{display:block;margin-top:4px;text-transform:none;letter-spacing:0;font-weight:400}
label.mini input,label.mini select{width:auto;padding:2px 6px;font-size:.82rem}
.deuda{margin:10px 0;padding:10px 12px;border:1px solid var(--warn,#c9a227);border-radius:8px;background:rgba(201,162,39,.08);text-align:left;max-width:640px}
.deuda .row{display:flex;gap:10px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin-top:6px}

/* diseno Stitch: menu lateral, barra superior, panel y celular */
.side .brand{background:rgba(255,255,255,.04)}
.nav .cnt{background:#fbefd9;color:#a35f00;font-weight:700} #navVen{background:#f9e0de;color:#b3261e}
.nav button[aria-current="page"]{background:#1f5f8b;color:#fff;font-weight:600}
.who{display:grid;grid-template-columns:auto minmax(0,1fr);gap:8px 10px;align-items:center;background:rgba(0,0,0,.18);padding:12px 14px}
.who .av{width:34px;height:34px;border-radius:50%;background:#1f5f8b;color:#fff;display:grid;place-items:center;font-weight:700;font-size:.78rem;letter-spacing:.02em}
.who .wtx{min-width:0;line-height:1.3} .who .wtx b,.who .wtx span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap} .who .wtx span{font-size:.76rem}
.who .links{grid-column:1/-1;display:flex;justify-content:space-between;gap:8px}
.who .links button{display:inline-flex;align-items:center;gap:5px;text-decoration:none;font-size:.78rem} .who .links button:hover{color:#fff} .who .links svg.i{width:15px;height:15px}
.top{flex-wrap:nowrap;padding:10px 24px;gap:14px}
.ttl{min-width:0;flex:0 1 auto} .top h1{font-size:1.2rem}
.tsearch{flex:1 1 240px;max-width:440px;margin-left:auto;position:relative;display:block}
.tsearch svg.i{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--muted);width:16px;height:16px;pointer-events:none}
.tsearch input{padding-left:34px;background:var(--soft)}
.tacts{display:flex;align-items:center;gap:8px;flex:none}
.btn.ico{padding:7px 8px} .btn.ico svg.i{width:18px;height:18px}
.bell{position:relative} .bell .dot{position:absolute;top:-6px;right:-6px;background:var(--bad);color:#fff;font-size:.62rem;font-weight:700;line-height:16px;min-width:16px;padding:0 4px;border-radius:99px;text-align:center}
.ham{display:none}
#actions .sm{display:none}
.menu-list{min-width:250px} .menu-list hr{border:0;border-top:1px solid var(--line);margin:2px 0}
.menu-list .btn{border-color:transparent;font-weight:500} .menu-list .btn:hover{background:var(--soft);border-color:var(--line)}
.menu-list .tag{font:500 .68rem var(--f-mono);color:var(--muted);background:var(--soft);border:1px solid var(--line);border-radius:4px;padding:0 4px;min-width:26px;text-align:center}
.tiles{grid-template-columns:repeat(4,minmax(0,1fr))}
.tile{display:flex;flex-direction:column;gap:2px;padding:12px 14px 0;min-width:0}
.tile .th{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}
.tile .th svg.i{color:var(--muted);width:18px;height:18px} .tile.bad .th svg.i{color:var(--bad)} .tile.warn .th svg.i{color:var(--warn)} .tile.ok .th svg.i{color:var(--ok)}
.tile .l{font-weight:600;font-size:.68rem;letter-spacing:.07em}
.tile .n{font-size:1.7rem;font-weight:700;margin:2px 0 6px}
.tile .f{margin-top:auto;border-top:1px solid var(--line);padding:6px 0 8px;font-size:.76rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sech{display:flex;justify-content:space-between;align-items:baseline;flex-wrap:wrap;gap:4px 12px;margin-top:4px}
.sech h2{display:flex;align-items:center;gap:8px;font-size:1rem;font-weight:600;margin:0} .sech h2 svg.i{color:var(--warn)}
.avisos{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:12px}
.av-c{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:12px 14px;display:flex;flex-direction:column;gap:6px;box-shadow:var(--shadow);min-width:0}
.av-h{display:flex;justify-content:space-between;align-items:center} .av-h svg.i{color:var(--muted)}
.av-c .t{font-size:.95rem;font-weight:600} .av-c p{margin:0;font-size:.84rem;color:var(--muted);overflow-wrap:anywhere} .av-c p b{color:var(--ink)}
.av-c .go{margin-top:auto;align-self:flex-end;background:none;border:0;color:var(--accent);font:600 .84rem var(--f-body);cursor:pointer;padding:4px 0}
.av-c .go:hover{text-decoration:underline} .av-c.cero .t{color:var(--muted)}
.ch-h{display:flex;justify-content:space-between;align-items:flex-start;gap:10px} .ch-h .cap{margin:2px 0 0}
.ch-h h2{display:flex;align-items:center;gap:8px} .dotr{width:9px;height:9px;border-radius:50%;background:var(--bad);display:inline-block}
.badge{font:500 .74rem var(--f-mono);color:var(--muted);background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:3px 8px;white-space:nowrap}
.badge:empty{display:none}
.donut{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,200px);gap:16px;align-items:center}
.dc{position:absolute;inset:0;display:grid;place-content:center;text-align:center;pointer-events:none}
.dc b{font:700 1.6rem var(--f-mono);color:var(--ink)} .dc span{font-size:.7rem;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.legend.col{display:grid;gap:6px}
.legend.col span{display:flex;align-items:center;justify-content:space-between;gap:8px;background:var(--soft);border-radius:6px;padding:7px 10px;color:var(--ink)}
.legend.col em{font-style:normal;display:flex;align-items:center} .legend.col b{font-variant-numeric:tabular-nums}
.legend.col span.mu{color:var(--muted);background:none;border:1px dashed var(--line)}
#tbAt tr.st-bad td:first-child{color:var(--bad);font-weight:600} #tbAt tr.st-warn td:first-child{color:var(--warn);font-weight:600}
#tbAt td:first-child .code{font-weight:500}
.card.quick{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
.quick .qt{display:flex;align-items:center;gap:12px} .quick .qt svg.i{width:28px;height:28px;color:var(--accent)} .quick .cap{margin:0}
.scrim{position:fixed;inset:0;background:rgba(10,20,30,.5);z-index:34}
.bnav{display:none}
@media (max-width:1100px){.tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:900px){
  .side{position:fixed;left:0;top:0;bottom:0;height:auto;width:270px;max-width:86vw;z-index:35;transform:translateX(-102%);transition:transform .2s ease;box-shadow:0 0 40px rgba(0,0,0,.35)}
  body.menu-on .side{transform:none}
  .side .brand{padding:18px 18px 14px}
  .nav{display:grid;overflow-y:auto;padding:10px}
  .nav .grp{display:block}
  .nav button{white-space:normal;width:100%}
  .who{display:grid;padding:12px 14px}
  .ham{display:inline-flex}
  .top{position:sticky;top:0;flex-wrap:wrap;padding:10px 16px;gap:8px 10px}
  .ttl{flex:1 1 0} .top h1{font-size:1.08rem} .sub{font-size:.74rem}
  .tsearch{order:5;flex:1 1 100%;max-width:none;margin:0}
  #actions .lg{display:none} #actions .sm{display:inline}
  .content{padding:14px 16px 96px}
  .bnav{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);position:fixed;left:0;right:0;bottom:0;z-index:15;background:var(--surface);border-top:1px solid var(--line);padding:4px 6px calc(4px + env(safe-area-inset-bottom,0px));box-shadow:0 -4px 16px rgba(0,0,0,.06)}
  .bnav button{position:relative;display:grid;justify-items:center;gap:2px;background:none;border:0;border-radius:8px;padding:6px 2px;color:var(--muted);font:600 .68rem var(--f-body);cursor:pointer;min-width:0}
  .bnav button span{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .bnav button[aria-current="page"]{color:var(--accent);background:var(--accent-soft)}
  .bnav .cnt{position:absolute;top:2px;left:calc(50% + 6px);background:var(--bad);color:#fff;font-size:.6rem;line-height:15px;min-width:15px;padding:0 4px;border-radius:99px}
  #tray{bottom:calc(72px + env(safe-area-inset-bottom,0px))}
  .toast{bottom:calc(80px + env(safe-area-inset-bottom,0px))}
  .donut{grid-template-columns:1fr}
}
@media (max-width:600px){.top .sub{display:none}}
@media (max-width:520px){.tiles{gap:8px} .tile{padding:10px 12px 0} .tile .n{font-size:1.4rem} .tile .l{font-size:.62rem} .card{padding:14px} .quick .bar .btn{flex:1 1 40%}}
@media (max-width:640px){
  #atCard .tablebox{overflow:visible;border:0;box-shadow:none;background:none} #atCard table{min-width:0} #atCard thead{display:none}
  #tbAt tr{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;align-items:center;padding:10px 12px;border:1px solid var(--line);border-left:4px solid var(--accent);border-radius:8px;margin-bottom:8px;background:var(--surface)}
  #tbAt tr.st-bad{border-left-color:var(--bad)} #tbAt tr.st-warn{border-left-color:var(--warn)}
  #tbAt td{display:block;border:0;padding:0;box-shadow:none!important;background:none!important}
  #tbAt td:nth-child(1),#tbAt td:nth-child(2),#tbAt td:nth-child(5){grid-column:1/-1} #tbAt td:nth-child(3){text-align:left} #tbAt td:nth-child(5):empty{display:none}
  #tbAt td.empty{grid-column:1/-1}
}
@media print{.bnav,.scrim{display:none!important}}
</style>
</head><body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="ic-logo" viewBox="0 0 24 24"><path d="M3 21V9l9-6 9 6v12"/><path d="M7 21v-8h10v8M7 17h10"/></symbol>
  <symbol id="ic-dash" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></symbol>
  <symbol id="ic-stock" viewBox="0 0 24 24"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></symbol>
  <symbol id="ic-orc" viewBox="0 0 24 24"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9zM9 11h6M9 15h4"/></symbol>
  <symbol id="ic-mov" viewBox="0 0 24 24"><path d="M4 7h15l-3-3M20 17H5l3 3"/></symbol>
  <symbol id="ic-pres" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5M12 8v4l3 2"/></symbol>
  <symbol id="ic-kdx" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3.5 6h.01M3.5 12h.01M3.5 18h.01"/></symbol>
  <symbol id="ic-mat" viewBox="0 0 24 24"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></symbol>
  <symbol id="ic-ent" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14.5a6.5 6.5 0 0 1 3.5 5.5"/></symbol>
  <symbol id="ic-rep" viewBox="0 0 24 24"><path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M6 14h12v7H6z"/></symbol>
  <symbol id="ic-usr" viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></symbol>
  <symbol id="ic-sol" viewBox="0 0 24 24"><path d="M7 3h10a2 2 0 0 1 2 2v16l-7-3-7 3V5a2 2 0 0 1 2-2z"/><path d="M9 8h6M9 12h4"/></symbol>
  <symbol id="ic-menu" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16"/></symbol>
  <symbol id="ic-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></symbol>
  <symbol id="ic-bell" viewBox="0 0 24 24"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.9 1.9 0 0 0 3.4 0"/></symbol>
  <symbol id="ic-key" viewBox="0 0 24 24"><circle cx="7.5" cy="15.5" r="4.5"/><path d="M10.7 12.3L20 3M16 7l3 3M14 9l2 2"/></symbol>
  <symbol id="ic-out" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></symbol>
  <symbol id="ic-bolt" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></symbol>
  <symbol id="ic-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></symbol>
  <symbol id="ic-alert" viewBox="0 0 24 24"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/><path d="M12 9v4M12 17h.01"/></symbol>
  <symbol id="ic-x" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M15 9l-6 6M9 9l6 6"/></symbol>
  <symbol id="ic-cal" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></symbol>
  <symbol id="ic-coin" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></symbol>
  <symbol id="ic-clock" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></symbol>
  <symbol id="ic-pause" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></symbol>
  <symbol id="ic-ref" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></symbol>
</svg>

<!-- INGRESO -->
<div id="login">
  <form class="lcard" id="fLogin" onsubmit="return false">
    <div class="brand"><span class="logo"><svg class="i"><use href="#ic-logo"/></svg></span><span><b>CONTROL ALMACÉN</b><small>Gestión de materiales de obra</small></span></div>
    <h2>Iniciar sesión</h2>
    <div class="form" style="grid-template-columns:1fr">
      <label>Usuario<input id="lUsr" autocomplete="username" autocapitalize="characters" required></label>
      <label>Contraseña<input id="lPwd" type="password" autocomplete="current-password" required></label>
      <label class="chk"><input type="checkbox" id="lRec"> Mantener la sesión en este equipo (celular del almacén)</label>
    </div>
    <span class="pilban" id="lQr" hidden></span>
    <button class="btn primary" type="submit" id="lBtn">Ingresar</button>
    <span class="err" id="lErr"></span>
    <span class="note">¿Olvidaste tu contraseña? Pide al administrador que te asigne una nueva.</span>
  </form>
</div>

<div id="app" hidden>
  <aside class="side">
    <div class="brand"><span class="logo"><svg class="i"><use href="#ic-logo"/></svg></span><span><b>CONTROL ALMACÉN</b><small>Gestión de materiales</small></span></div>
    <nav class="nav" aria-label="Secciones">
      <span class="grp">General</span>
      <button data-tab="dash"><svg class="i"><use href="#ic-dash"/></svg>Panel</button>
      <button data-tab="stock"><svg class="i"><use href="#ic-stock"/></svg>Stock</button>
      <button data-tab="orc"><svg class="i"><use href="#ic-orc"/></svg>Órdenes de compra</button>
      <span class="grp">Operación</span>
      <button data-tab="sol"><svg class="i"><use href="#ic-sol"/></svg><span id="navSolT">Solicitudes</span><span class="cnt" id="navSol" hidden></span></button>
      <button data-tab="mov"><svg class="i"><use href="#ic-mov"/></svg><span id="navMovT">Movimientos</span></button>
      <button data-tab="pres"><svg class="i"><use href="#ic-pres"/></svg>Préstamos<span class="cnt" id="navVen" hidden></span></button>
      <button data-tab="kdx"><svg class="i"><use href="#ic-kdx"/></svg>Kardex</button>
      <button data-tab="rep"><svg class="i"><use href="#ic-rep"/></svg>Reportes</button>
      <span class="grp">Configuración</span>
      <button data-tab="mat"><svg class="i"><use href="#ic-mat"/></svg>Materiales</button>
      <button data-tab="ent"><svg class="i"><use href="#ic-ent"/></svg>Contratistas y proveedores</button>
      <button data-tab="usr" id="navUsr" hidden><svg class="i"><use href="#ic-usr"/></svg>Usuarios</button>
    </nav>
    <div class="who"><span class="av" id="wIni" aria-hidden="true"></span><div class="wtx"><b id="wNom"></b><span id="wRol"></span></div><div class="links"><button id="btnClave" title="Cambiar contraseña"><svg class="i"><use href="#ic-key"/></svg>Cambiar clave</button><button id="btnSalir"><svg class="i"><use href="#ic-out"/></svg>Salir</button></div></div>
  </aside>
  <div class="scrim" id="scrim" hidden></div>

  <nav class="bnav" aria-label="Accesos rápidos">
    <button data-tab="dash"><svg class="i"><use href="#ic-dash"/></svg><span>Panel</span></button>
    <button data-tab="stock"><svg class="i"><use href="#ic-stock"/></svg><span>Stock</span></button>
    <button data-tab="sol"><svg class="i"><use href="#ic-sol"/></svg><span>Solicitudes</span><span class="cnt" id="bnSol" hidden></span></button>
    <button data-tab="mov"><svg class="i"><use href="#ic-mov"/></svg><span id="bnMovT">Movimientos</span></button>
    <button type="button" id="bnMas"><svg class="i"><use href="#ic-menu"/></svg><span>Más</span></button>
  </nav>
  <div class="main">
    <header class="top">
      <button class="btn ico ham" id="btnMenu" type="button" aria-label="Abrir menú"><svg class="i"><use href="#ic-menu"/></svg></button>
      <div class="ttl"><h1 id="pgTit">Panel</h1><p class="sub" id="sub">Cargando…</p><p class="pilban" id="pilBan" hidden></p></div>
      <label class="tsearch"><svg class="i"><use href="#ic-search"/></svg><input id="qGlobal" type="search" placeholder="Buscar material, documento, orden o REQ" autocomplete="off" aria-label="Buscar material, documento, orden o REQ"></label>
      <div class="tacts">
        <button class="btn ico" id="btnRef" title="Actualizar datos" aria-label="Actualizar datos"><svg class="i"><use href="#ic-ref"/></svg></button>
        <button class="btn ico bell" id="btnBell" type="button" title="Requieren atención" aria-label="Requieren atención"><svg class="i"><use href="#ic-bell"/></svg><span class="dot" id="bellN" hidden></span></button>
        <span id="actions" hidden>
          <details class="menu" id="actMas"><summary class="btn primary"><svg class="i"><use href="#ic-plus"/></svg><span class="lg">Nuevo documento</span><span class="sm">Nuevo</span></summary><div class="menu-list">
            <button class="btn" data-nuevo="INGRESO"><b class="tag">NI</b>Ingreso de material</button>
            <button class="btn" data-nuevo="SALIDA"><b class="tag">VS</b>Salida (vale)</button>
            <button class="btn" data-nuevo="PRESTAMO"><b class="tag">PR</b>Préstamo</button>
            <button class="btn" data-nuevo="DEVOLUCION"><b class="tag">DV</b>Devolución</button>
            <button class="btn" data-nuevo="INTERNAMIENTO"><b class="tag">IM</b>Internamiento</button>
            <hr>
            <button class="btn" data-nuevo="MERMA"><b class="tag">MR</b>Merma / chatarra</button>
            <button class="btn" data-nuevo="AJUSTE"><b class="tag">AJ</b>Ajuste</button>
            <button class="btn" id="btnInv"><b class="tag">IF</b>Inventario físico</button>
          </div></details>
        </span>
      </div>
    </header>

    <div class="content">
      <!-- PANEL -->
      <section class="view" id="v-dash">
        <div class="tiles">
          <button class="tile ok" data-go="stock" data-st="con"><span class="th"><span class="l">Materiales con stock</span><svg class="i"><use href="#ic-stock"/></svg></span><span class="n" id="tMat">–</span><span class="f" id="fMat"></span></button>
          <button class="tile" data-go="stock" data-st="con"><span class="th"><span class="l">Valor en almacén</span><svg class="i"><use href="#ic-coin"/></svg></span><span class="n" id="tVal">–</span><span class="f" id="fVal"></span></button>
          <button class="tile warn" data-go="stock" data-st="Bajo mínimo"><span class="th"><span class="l">Bajo stock mínimo</span><svg class="i"><use href="#ic-alert"/></svg></span><span class="n" id="tMin">–</span><span class="f" id="fMin"></span></button>
          <button class="tile bad" data-go="stock" data-st="Sin stock"><span class="th"><span class="l">Sin stock</span><svg class="i"><use href="#ic-x"/></svg></span><span class="n" id="tSin">–</span><span class="f" id="fSin"></span></button>
          <button class="tile warn" data-go="pres" data-st=""><span class="th"><span class="l">Préstamos pendientes</span><svg class="i"><use href="#ic-pres"/></svg></span><span class="n" id="tPre">–</span><span class="f" id="fPre"></span></button>
          <button class="tile bad" data-go="pres" data-st="Vencido"><span class="th"><span class="l">Préstamos vencidos</span><svg class="i"><use href="#ic-cal"/></svg></span><span class="n" id="tVen">–</span><span class="f" id="fVen"></span></button>
          <button class="tile warn" data-go="orc" data-st="venc"><span class="th"><span class="l">Por vencer o revisar</span><svg class="i"><use href="#ic-clock"/></svg></span><span class="n" id="tVid">–</span><span class="f" id="fVid"></span></button>
          <button class="tile warn" data-go="orc" data-st="dorm"><span class="th"><span class="l">Sin movimiento 60+ días</span><svg class="i"><use href="#ic-pause"/></svg></span><span class="n" id="tDor">–</span><span class="f" id="fDor"></span></button>
        </div>
        <div class="sech"><h2><svg class="i"><use href="#ic-bolt"/></svg>Avisos del día</h2><span class="note" id="avN"></span></div>
        <div class="avisos" id="avisos"></div>
        <div class="dash">
          <div class="card"><div class="ch-h"><div><h2>Consumo por mes</h2><p class="cap">Valor de los vales de salida, en S/</p></div><span class="badge" id="bMes"></span></div><div class="chart"><canvas id="chMes"></canvas></div></div>
          <div class="card"><div class="ch-h"><div><h2>Consumo por área</h2><p class="cap">Valor de salidas según el área que consume, en S/</p></div><span class="badge" id="bArea"></span></div><div class="chart"><canvas id="chArea"></canvas></div></div>
          <div class="card"><div class="ch-h"><div><h2>Estado del stock</h2><p class="cap">Materiales con movimiento, según su saldo</p></div></div><div class="donut"><div class="chart"><canvas id="chEst"></canvas><div class="dc"><b id="dcN">–</b><span>materiales</span></div></div><div class="legend col" id="lgEst"></div></div></div>
          <div class="card"><div class="ch-h"><div><h2>Préstamos pendientes por receptor</h2><p class="cap">Valor de lo que aún no devuelven, en S/</p></div><span class="badge" id="bPre"></span></div><div class="chart"><canvas id="chPre"></canvas></div></div>
        </div>
        <div class="card" id="atCard"><div class="ch-h"><div><h2><i class="dotr"></i>Requieren atención</h2><p class="cap">Préstamos vencidos, materiales sin stock o bajo el mínimo, por vencer y sin movimiento</p></div><span class="badge" id="atN"></span></div>
          <div class="tablebox"><table><thead><tr><th>Asunto</th><th>Detalle</th><th class="num">Cantidad</th><th>Estado</th><th>Acción</th></tr></thead><tbody id="tbAt"></tbody></table></div></div>
        <div class="card quick" id="quick" hidden><div class="qt"><svg class="i"><use href="#ic-orc"/></svg><div><b>Registro rápido</b><p class="cap">Los documentos de todos los días, a un clic</p></div></div>
          <div class="bar"><button class="btn" data-nuevo="INGRESO"><svg class="i"><use href="#ic-orc"/></svg>Ingreso</button><button class="btn" data-nuevo="PRESTAMO"><svg class="i"><use href="#ic-pres"/></svg>Préstamo</button><button class="btn" data-nuevo="DEVOLUCION"><svg class="i"><use href="#ic-mov"/></svg>Devolución</button><button class="btn primary" data-nuevo="SALIDA"><svg class="i"><use href="#ic-mov"/></svg>Salida (vale)</button></div></div>
      </section>

      <!-- STOCK -->
      <section class="view" id="v-stock" hidden>
        <div class="bar toolbar">
          <input class="grow" id="qStock" type="search" placeholder="Buscar material o código">
          <select id="qStCat"><option value="">Todas las categorías</option></select>
          <select id="qSt"><option value="con">Con movimiento</option><option value="">Todos los materiales</option><option>Normal</option><option>Bajo mínimo</option><option>Sin stock</option><option>Sin movimiento</option></select>
          <button class="btn" id="btnCsv">Exportar CSV</button>
        </div>
        <div class="tablebox"><table><thead><tr><th>Material</th><th>Categoría</th><th>Und</th><th class="num">Entradas</th><th class="num">Salidas</th><th class="num">Prestado</th><th class="num">Saldo</th><th class="num">Mínimo</th><th>Estado</th><th class="num">C. prom.</th><th class="num">Valor S/</th></tr></thead><tbody id="tbStock"></tbody></table></div>
        <p class="note">Stock general: la suma de todas las órdenes del material. Para ver cuánto queda de cada orden y área, usa Órdenes de compra. Prestado es lo que está fuera en préstamo y vuelve al saldo con la devolución.</p>
      </section>

      <!-- ÓRDENES -->
      <section class="view" id="v-orc" hidden>
        <div class="bar toolbar">
          <input class="grow" id="qOrc" type="search" placeholder="Buscar orden, material, proveedor, REQ o guía">
          <select id="qOrcArea"><option value="">Todas las áreas</option></select>
          <select id="qOrcSt"><option value="abiertas">Con saldo</option><option value="">Todas las órdenes</option><option>Sin usar</option><option>En uso</option><option>Agotada</option><option value="dorm">Sin movimiento (60+ días)</option><option value="venc">Por vencer, vencidas o por revisar</option><option value="general">Stock general</option><option value="incompl">Falta llegar (orden incompleta)</option></select>
          <button class="btn" id="btnEtqL" hidden title="Etiquetas con QR para las órdenes de perecibles y herramientas del filtro">Etiquetas por orden</button>
          <button class="btn" data-rep="orc">Imprimir</button>
        </div>
        <div class="tablebox"><table><thead><tr><th>Orden de compra</th><th>Área</th><th>Ingreso</th><th>Proveedor</th><th>Material</th><th class="num">Ingresado</th><th class="num">Usado</th><th class="num">Saldo de la orden</th><th>Estado y alertas</th></tr></thead><tbody id="tbOrc"></tbody></table></div>
        <p class="note">Cada orden de compra ingresa con su nota de ingreso y su área. Las salidas y préstamos eligen de qué orden sale el material, y las devoluciones regresan a su orden. Los movimientos antiguos sin orden se descuentan de la más antigua. Si el saldo de un área o requerimiento ya no se va a usar, almacén lo pasa a <b>stock general</b> (documento LG): lo puede pedir cualquier área y al área de origen le llega un correo. "Sin movimiento" = 60 días o más sin salidas de esa orden.</p>
      </section>

      <!-- SOLICITUDES -->
      <section class="view" id="v-sol" hidden>
        <div class="tiles" id="solTiles">
          <div class="tile warn"><div class="n" id="sP">–</div><div class="l">Por revisar (enviadas o vistas)</div></div>
          <div class="tile"><div class="n" id="sPa">–</div><div class="l">Aprobadas por entregar</div></div>
          <div class="tile"><div class="n" id="sA">–</div><div class="l">Áreas que solicitan</div></div>
          <div class="tile"><div class="n" id="sI">–</div><div class="l">Materiales pedidos</div></div>
        </div>
        <div class="bar toolbar">
          <input class="grow" id="qSol" type="search" placeholder="Buscar solicitud, material, motivo, lote o manzana">
          <select id="qSolArea"><option value="">Todas las áreas</option></select>
          <select id="qSolSt"><option value="abiertas">Abiertas</option><option value="">Todas</option><option value="ENVIADA">Enviadas</option><option value="VISTA">Vistas por almacén</option><option value="APROBADA">Aprobadas</option><option value="PARCIAL">Entregadas en parte</option><option value="ENTREGADA">Entregadas</option><option value="RECHAZADA">Rechazadas</option><option value="CERRADA">Cerradas con pendiente</option><option value="ANULADA">Anuladas</option><option value="venc">Recojo vencido</option></select>
          <input type="date" id="qSolDe" aria-label="Desde" title="Desde"><input type="date" id="qSolA" aria-label="Hasta" title="Hasta">
          <button class="btn" id="btnRec">Recojos programados</button>
          <button class="btn" id="btnImp" hidden>Importar Excel del área</button>
          <button class="btn primary" id="btnSol" hidden>+ Nueva solicitud</button>
        </div>
        <div class="tablebox"><table><thead><tr><th>Solicitud</th><th>Área / solicitante</th><th>Motivo</th><th>Lote / Mz</th><th class="num">Ítems</th><th class="num">Pedido</th><th class="num">Entregado</th><th>Estado</th><th>Vale y fecha</th><th></th></tr></thead><tbody id="tbSol"></tbody></table></div>
        <p class="note">Enviada → Vista por almacén → Aprobada (material separado) → Entregada. El área solicita de sus propias órdenes o almacén importa el Excel del área; al entregar se genera el vale de salida. Lo que no se entrega queda pendiente en la misma solicitud. El metrado y los lotes son datos de referencia de ingeniería: el sistema los guarda y los imprime, no los calcula.</p>
      </section>

      <!-- MOVIMIENTOS -->
      <section class="view" id="v-mov" hidden>
        <div class="bar toolbar">
          <input class="grow" id="qMov" type="search" placeholder="Buscar documento, material, receptor, obra, ORC…">
          <select id="qMovT"><option value="">Todos los documentos</option><option value="INGRESO">NI · Ingresos</option><option value="SALIDA">VS · Salidas</option><option value="PRESTAMO">PR · Préstamos</option><option value="DEVOLUCION">DV · Devoluciones</option><option value="INTERNAMIENTO">IM · Internamientos</option><option value="MERMA">MR · Mermas</option><option value="AJUSTE">AJ · Ajustes</option><option value="LIBERACION">LG · Pases a stock general</option></select>
          <label class="chk" id="qMovMiaBox" hidden><input type="checkbox" id="qMovMia"> Solo para mi área</label><input type="date" id="qMovDe" aria-label="Desde"><input type="date" id="qMovA" aria-label="Hasta">
        </div>
        <div class="tablebox"><table><thead><tr><th>Documento</th><th>Fecha</th><th>Tipo</th><th>Proveedor / receptor</th><th>Área · referencia</th><th>Materiales</th><th class="num" id="thMovTot">Total S/</th><th></th></tr></thead><tbody id="tbMov"></tbody></table></div>
      </section>

      <!-- PRÉSTAMOS -->
      <section class="view" id="v-pres" hidden>
        <div class="tiles">
          <div class="tile warn"><div class="n" id="pN">–</div><div class="l">Ítems pendientes</div></div>
          <div class="tile bad"><div class="n" id="pV">–</div><div class="l">Vencidos</div></div>
          <div class="tile"><div class="n" id="pC">–</div><div class="l">Receptores con préstamos</div></div>
          <div class="tile"><div class="n" id="pS">–</div><div class="l">Valor fuera del almacén</div></div>
        </div>
        <div class="bar toolbar">
          <input class="grow" id="qPre" type="search" placeholder="Buscar material, préstamo u orden">
          <select id="qPreCon"><option value="">Todos los receptores</option></select>
          <select id="qPreSt"><option value="">Pendientes</option><option>Vencido</option><option>Vence pronto</option><option>Al día</option><option value="todos">Todos, incluso devueltos</option></select>
        </div>
        <div class="tablebox"><table><thead><tr><th>Préstamo</th><th>Prestado a</th><th>Material</th><th>De la orden</th><th class="num">Prestado</th><th class="num">Devuelto</th><th class="num">Pendiente</th><th>Devolver el</th><th>Estado</th><th></th></tr></thead><tbody id="tbPre"></tbody></table></div>
        <p class="note">El material prestado sale de una orden y vuelve a esa misma orden con la devolución. Si el área que lo pidió ya lo consumió, al devolver elige "Reponer desde" su propia orden: la orden prestadora recupera su saldo y el consumo queda en la orden de quien pidió.</p>
      </section>

      <!-- KARDEX -->
      <section class="view" id="v-kdx" hidden>
        <div class="bar toolbar">
          <input class="grow" id="qKdx" list="dlMat" autocomplete="off" placeholder="Elige un material (descripción o código)">
          <input type="date" id="qKdxDe" aria-label="Desde"><input type="date" id="qKdxA" aria-label="Hasta">
          <button class="btn" id="btnKdx">Imprimir kardex</button>
        </div>
        <div class="sel" id="kdxHead"><span class="note">Elige un material para ver todos sus movimientos con el saldo después de cada uno.</span></div>
        <div class="tablebox"><table><thead><tr><th>Fecha</th><th>Documento</th><th>Tipo</th><th>Orden · área</th><th>Proveedor / receptor</th><th class="num">Entrada</th><th class="num">Salida</th><th class="num">Saldo</th><th class="num">P.U.</th></tr></thead><tbody id="tbKdx"></tbody></table></div>
      </section>

      <!-- REPORTES -->
      <section class="view" id="v-rep" hidden>
        <div class="reps">
          <div class="card"><h2>Stock valorizado</h2><p class="cap">Saldo general de cada material al día, con costo promedio</p>
            <div class="bar"><select id="rStCat"><option value="">Todas las categorías</option></select><select id="rStEst"><option value="con">Con movimiento</option><option value="">Todos</option><option>Normal</option><option>Bajo mínimo</option><option>Sin stock</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="stock">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Saldo por orden de compra</h2><p class="cap">Ingresado, usado y saldo de cada orden, por área</p>
            <div class="bar"><select id="rOrcArea"><option value="">Todas las áreas</option></select><select id="rOrcSt"><option value="abiertas">Con saldo</option><option value="">Todas</option><option>Agotada</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="orcRep">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Saldo por requerimiento</h2><p class="cap">Lo pedido en cada REQ que sigue en almacén, por área</p>
            <div class="bar"><select id="rReqArea"><option value="">Todas las áreas</option></select><select id="rReqSt"><option value="abiertas">Con saldo</option><option value="">Todos</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="req">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Vencimientos y revisiones</h2><p class="cap">Lotes vencidos, por vencer (15 días), por revisar y herramientas por reponer</p>
            <div class="bar"><select id="rVidArea"><option value="">Todas las áreas</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="vida">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Material sin movimiento</h2><p class="cap">Saldos de áreas sin ninguna salida en 60 días o más</p>
            <div class="bar"><select id="rDorArea"><option value="">Todas las áreas</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="dorm">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Solicitudes de material</h2><p class="cap">Lo que pide cada área y cómo lo atendió almacén</p>
            <div class="bar"><select id="rSolArea"><option value="">Todas las áreas</option></select><select id="rSolSt"><option value="abiertas">Abiertas</option><option value="">Todas</option><option value="ENTREGADA">Entregadas</option><option value="RECHAZADA">Rechazadas</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="sol">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Movimientos</h2><p class="cap">Ingresos, salidas, préstamos y devoluciones por fecha</p>
            <div class="bar"><input type="date" id="rMovDe" aria-label="Desde"><input type="date" id="rMovA" aria-label="Hasta"></div>
            <div class="bar"><select id="rMovT"><option value="">Todos los tipos</option><option value="INGRESO">Ingresos</option><option value="SALIDA">Salidas</option><option value="PRESTAMO">Préstamos</option><option value="DEVOLUCION">Devoluciones</option><option value="LIBERACION">Pases a stock general</option><option value="INTERNAMIENTO">Internamientos</option><option value="MERMA">Mermas</option><option value="AJUSTE">Ajustes</option></select><select id="rMovArea"><option value="">Todas las áreas</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="mov">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Préstamos pendientes</h2><p class="cap">Lo que cada receptor debe devolver, para cobrar o descontar</p>
            <div class="bar"><select id="rPreCon"><option value="">Todos los receptores</option></select><label class="chk"><input type="checkbox" id="rPreVen">Solo vencidos</label></div>
            <div class="bar"><button class="btn primary" data-rep="pres">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Préstamos entre obras</h2><p class="cap">Material que una etapa prestó a otra: devuelto, lo que falta y su valor</p>
            <div class="bar"><select id="rObr"><option value="">Todas las obras / etapas</option></select><label class="chk"><input type="checkbox" id="rObrPend">Solo lo que falta devolver</label></div>
            <div class="bar"><button class="btn primary" data-rep="obras">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Consumo</h2><p class="cap">Material entregado con vale de salida, agrupado</p>
            <div class="bar"><input type="date" id="rConDe" aria-label="Desde"><input type="date" id="rConA" aria-label="Hasta"></div>
            <div class="bar"><select id="rConG"><option value="AREA">Por área</option><option value="OBRA">Por obra</option><option value="CONTRATISTA">Por receptor</option><option value="USO">Por uso / partida</option></select></div>
            <div class="bar"><button class="btn primary" data-rep="consumo">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Kardex de un material</h2><p class="cap">Entradas, salidas y saldo en un periodo</p>
            <div class="bar"><input id="rKdx" list="dlMat" autocomplete="off" placeholder="Material o código"></div>
            <div class="bar"><input type="date" id="rKdxDe" aria-label="Desde"><input type="date" id="rKdxA" aria-label="Hasta"></div>
            <div class="bar"><button class="btn primary" data-rep="kardex">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Material por contratista</h2><p class="cap">Entregado, devuelto, malogrado, retazos y consumo neto</p>
            <div class="bar"><select id="rCtrCon"><option value="">Todos los contratistas</option></select><select id="rCtrCont" aria-label="Contrato"><option value="">Todos los contratos</option></select></div>
            <div class="bar"><input type="date" id="rCtrDe" aria-label="Desde"><input type="date" id="rCtrA" aria-label="Hasta"></div>
            <div class="bar"><button class="btn primary" data-rep="contratista">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Toma de inventario</h2><p class="cap">Hoja para el conteo físico, con espacio para anotar</p>
            <div class="bar"><select id="rInvCat"><option value="">Todas las categorías</option></select><label class="chk"><input type="checkbox" id="rInvTodo">Incluir sin movimiento</label></div>
            <div class="bar"><button class="btn primary" data-rep="inventario">Imprimir / guardar PDF</button></div></div>
          <div class="card"><h2>Reimprimir documento</h2><p class="cap">Nota de ingreso, vale de salida, préstamo, devolución o ajuste</p>
            <div class="bar"><input id="rDoc" list="dlDoc" autocomplete="off" placeholder="VS-0001"></div>
            <div class="bar"><button class="btn primary" data-rep="doc">Imprimir / guardar PDF</button></div></div>
        </div>
      </section>

      <!-- MATERIALES -->
      <section class="view" id="v-mat" hidden>
        <div class="seg" id="matSeg" style="margin-bottom:12px">
          <button type="button" data-mv="mat" aria-pressed="true">Materiales</button>
          <button type="button" data-mv="eq" aria-pressed="false">Equivalencias de compra</button>
          <button type="button" data-mv="und" aria-pressed="false">Unidades</button>
        </div>
        <div id="matBox">
        <div class="bar toolbar">
          <input class="grow" id="qMat" type="search" placeholder="Buscar material, código o ubicación">
          <select id="qMatCat"><option value="">Todas las categorías</option></select>
          <button class="btn" id="btnVidaSug" hidden>Cargar vida útil sugerida</button>
          <button class="btn" id="btnEtq" hidden title="Imprime una etiqueta con QR por cada material de la lista (usa el buscador para elegir cuáles)">Etiquetas QR de estante</button>
          <button class="btn primary" id="btnMat" hidden>+ Material nuevo</button>
        </div>
        <div class="tablebox"><table><thead><tr><th>Código</th><th>Descripción</th><th>Categoría</th><th>Und almacén</th><th class="num">Saldo</th><th class="num">Stock mín.</th><th>Ubicación</th><th>Vida útil</th><th></th></tr></thead><tbody id="tbMat"></tbody></table></div>
        </div>
        <div id="eqBox" hidden>
        <div class="bar toolbar">
          <input class="grow" id="qEq" type="search" placeholder="Buscar material o unidad de compra">
          <button class="btn primary" id="btnEq" hidden>+ Equivalencia</button>
        </div>
        <div class="tablebox"><table><thead><tr><th>Código</th><th>Material</th><th>Logística compra en</th><th>Equivale a</th><th>Tipo</th><th>Observación</th><th></th></tr></thead><tbody id="tbEq"></tbody></table></div>
        <p class="note" style="margin-top:10px" data-x="eqnota">El stock, las salidas y el kardex siempre van en la unidad de almacén. <b>Fija</b>: el factor no cambia (1 rollo de cable = 100 m) y el ingreso lo toma de aquí. <b>Variable</b>: depende del peso real (alambre, fierro); el ingreso propone el último factor y el almacenero lo corrige según la guía. Cada ingreso guarda su propio factor, así que cambiar o quitar una equivalencia no altera lo ya registrado.</p>
        </div>
        <div id="undBox" hidden>
        <div class="bar toolbar">
          <input class="grow" id="qUnd" type="search" placeholder="Buscar unidad, código SUNAT o sinónimo">
          <button class="btn" id="btnUnif" hidden>Unificar unidades</button>
          <button class="btn primary" id="btnUnd" hidden>+ Unidad</button>
        </div>
        <div class="tablebox"><table><thead><tr><th>Unidad</th><th>Código SUNAT</th><th>Sinónimos (se cambian solos)</th><th class="num">Materiales</th><th>Estado</th><th></th></tr></thead><tbody id="tbUnd"></tbody></table></div>
        <p class="note" style="margin-top:10px">Lista oficial de unidades, con el código del Catálogo N° 03 de SUNAT (el que usan facturas y guías). En pantalla y en los documentos se ve el nombre; el código sale en la exportación a Excel (columna Und SUNAT). Los sinónimos son las formas en que la gente escribe la unidad: el sistema los cambia solos al nombre oficial.</p>
        </div>
      </section>

      <!-- unidades: va dentro de la vista Materiales -->
      <!-- MAESTROS -->
      <section class="view" id="v-ent" hidden>
        <div class="bar toolbar">
          <div class="seg" id="entSeg">
            <button type="button" data-et="CONTRATISTA" aria-pressed="true">Contratistas / receptores</button>
            <button type="button" data-et="PROVEEDOR" aria-pressed="false">Proveedores</button>
            <button type="button" data-et="AREA" aria-pressed="false">Áreas</button>
            <button type="button" data-et="OBRA" aria-pressed="false">Obras</button>
          </div>
          <input class="grow" id="qEnt" type="search" placeholder="Buscar nombre o documento">
          <button class="btn primary" id="btnEnt" hidden>+ Nuevo</button>
        </div>
        <div class="tablebox"><table><thead><tr><th>Nombre</th><th>RUC / DNI</th><th>Contacto</th><th class="num">Movimientos</th><th>Estado</th><th></th></tr></thead><tbody id="tbEnt"></tbody></table></div>
        <p class="note">Los nombres se eligen de esta lista en cada documento, así un mismo contratista no queda registrado de dos formas (G&amp;S y GYS). Si ya pasó, el administrador puede usar Unificar para juntarlos en uno.</p>
      </section>

      <!-- USUARIOS -->
      <section class="view" id="v-usr" hidden>
        <div class="bar toolbar"><span class="note grow">Administrador: todo, incluso usuarios. Almacenero: registra documentos, materiales y la lista maestra. Gerencia: consulta todo, sin registrar. Área: consulta el stock general y solo las órdenes y préstamos de su área.</span><button class="btn" id="btnAviso">Aviso semanal por correo: …</button><button class="btn" id="btnResp">Copia semanal: …</button><button class="btn" id="btnPil">Prueba piloto</button><button class="btn" id="btnCie">Cierre anual</button><button class="btn primary" id="btnUsr">+ Usuario nuevo</button></div>
        <div class="tablebox"><table><thead><tr><th>Usuario</th><th>Nombre</th><th>Rol</th><th>Área</th><th>Estado</th><th>Creado</th><th></th></tr></thead><tbody id="tbUsr"></tbody></table></div>
      </section>
    </div>
  </div>
</div>

<!-- DOCUMENTO -->
<div class="modal" id="pDoc" hidden><section class="panel">
  <div class="phead"><h2 id="dTit">Nuevo documento</h2><span class="pbtns"><button class="x xmin" type="button" data-min="pDoc" aria-label="Minimizar" title="Minimizar: guarda lo que llenaste y te deja revisar otra cosa">—</button><button class="x" type="button" data-close="pDoc" aria-label="Cerrar">×</button></span></div>
  <div id="dForm" class="panel" style="border:0;padding:0">
    <div class="seg" id="dSeg">
      <button type="button" data-tipo="INGRESO"><b>NI</b>Ingreso</button>
      <button type="button" data-tipo="SALIDA"><b>VS</b>Salida</button>
      <button type="button" data-tipo="PRESTAMO"><b>PR</b>Préstamo</button>
      <button type="button" data-tipo="DEVOLUCION"><b>DV</b>Devolución</button>
      <button type="button" data-tipo="INTERNAMIENTO"><b>IM</b>Internamiento</button>
      <button type="button" data-tipo="MERMA"><b>MR</b>Merma</button>
      <button type="button" data-tipo="AJUSTE"><b>AJ</b>Ajuste</button>
    </div>
    <p class="tipohelp" id="dHelp"></p>
    <div class="form">
      <label>Fecha<input id="dFecha" type="date"></label>
      <label class="two" data-t="DEVOLUCION">Préstamo que se devuelve<select id="dRef"></select></label>
      <div class="fld two" data-t="INGRESO">Proveedor<div class="combo"><select id="dProv"></select><button type="button" class="btn" data-newent="PROVEEDOR" data-for="dProv">+ Nuevo</button></div></div>
      <div class="fld" data-t="INGRESO SALIDA PRESTAMO DEVOLUCION"><span id="dAreaL">Área</span><div class="combo"><select id="dArea"></select><button type="button" class="btn" data-newent="AREA" data-for="dArea">+</button></div></div>
      <label data-t="INGRESO">Orden de compra (ORC)<input id="dOrc" maxlength="30" placeholder="001-0003656"></label>
      <label data-t="INGRESO">Requerimiento (REQ)<input id="dReq" maxlength="40" placeholder="REQ-PRI-26-025"></label>
      <label data-t="INGRESO">Guía de remisión<input id="dGuia" maxlength="30"></label>
      <div class="fld two" data-t="SALIDA PRESTAMO DEVOLUCION INTERNAMIENTO MERMA"><span id="dConL">Entregado a</span><div class="combo"><select id="dCon"></select><button type="button" class="btn" data-newent="CONTRATISTA" data-for="dCon">+ Nuevo</button></div></div>
      <label class="chk full" data-t="PRESTAMO"><input type="checkbox" id="dEntre">Es para otra obra / etapa (sale del stock general o de una orden de otra etapa)</label>
      <div class="fld" data-t="INGRESO SALIDA PRESTAMO DEVOLUCION INTERNAMIENTO MERMA"><span id="dObraL">Obra / etapa</span><div class="combo"><select id="dObra"></select><button type="button" class="btn" data-newent="OBRA" data-for="dObra">+</button></div></div>
      <label data-t="SALIDA PRESTAMO DEVOLUCION INTERNAMIENTO MERMA">Contrato (opcional)<input id="dCont" list="dlCont" maxlength="40" autocomplete="off" placeholder="N° o código del contrato"></label>
      <label data-t="SALIDA">Uso / partida<input id="dUso" list="dlUso" maxlength="80" autocomplete="off" placeholder="TARRAJEO MÓDULO 2"></label>
      <label data-t="SALIDA PRESTAMO">Solicitado por<input id="dSol" list="dlSol" maxlength="60" autocomplete="off"></label>
      <label data-t="PRESTAMO">Devolver a más tardar<input id="dFdev" type="date"></label>
      <label id="dAutBox" hidden>Autorizado por<input id="dAut" list="dlSol" maxlength="60" autocomplete="off" placeholder="Residente o jefe de la etapa que presta"></label>
      <label class="full"><span id="dObsL">Observación</span><input id="dObs" maxlength="250"></label>
    </div>
    <div id="dPickBox" class="panel" style="border:0;padding:0">
      <h3>Agregar material</h3>
      <div class="form">
        <label class="two">Material (escribe descripción o código)<input id="dMat" list="dlMat" autocomplete="off" placeholder="CEMENTO, FIERRO, TUBERIA…"></label>
        <label class="two" id="dLoteBox">De la orden de compra<select id="dLote"></select></label>
        <label data-t="INGRESO">Unidad de compra<select id="dUndC"></select></label>
        <label data-t="INTERNAMIENTO">Estado del material<select id="dEst"><option value="BUENO">Bueno: vuelve a stock</option><option value="REGULAR">Regular: vuelve a stock</option><option value="MALOGRADO">Malogrado: no entra, va a merma</option></select></label>
        <label class="chk" data-t="INTERNAMIENTO" style="align-self:end"><input type="checkbox" id="dRet">Es retazo (pedazo cortado)</label>
        <label id="dRetUBox" hidden>Retazo medido en<select id="dRetU"><option value="M">Metros (con wincha)</option><option value="PZA">Piezas</option><option value="PIE">Pies (madera)</option></select></label>
        <label id="dUndNBox" hidden>Nueva unidad de compra<input id="dUndN" list="dlUnd" autocomplete="off" maxlength="10" placeholder="ROLLO, CAJA, TN…"></label>
        <label id="dFacBox" hidden><span>1 <span id="dFacU"></span> = ¿cuántos <span id="dFacB"></span>?</span><input id="dFac" type="number" min="0" step="any"></label>
        <label><span id="dCantL">Cantidad</span><input id="dCant" type="number" min="0" step="any"></label>
        <label data-t="INGRESO"><span id="dPuL">P.U. sin IGV (S/)</span><input id="dPu" type="number" min="0" step="any"></label>
        <div class="bar" style="align-self:end"><button class="btn" type="button" id="dAdd">Agregar</button><button class="btn" type="button" id="dNewMat" data-t="INGRESO">+ Material nuevo</button></div>
        <label class="chk full" id="dFijaBox" hidden><input type="checkbox" id="dFija">Equivalencia fija: siempre trae lo mismo (ficha técnica o empaque). Déjalo sin marcar si depende del peso real.</label>
        <div class="full"><span class="note" id="dInfo"></span> <b class="note" id="dConv"></b> <span class="warnmsg" id="dWarn"></span> <span class="err" id="dErr"></span></div>
      </div>
    </div>
    <h3>Ítems del documento</h3>
    <div class="tablebox"><table><thead><tr><th>#</th><th>Material</th><th>Und</th><th id="dColOrc">Orden</th><th class="num" id="dColCtx">Stock</th><th class="num" id="dColCant">Cantidad</th><th class="num" id="dColPu">P.U.</th><th class="num" id="dColTot">Total S/</th><th></th></tr></thead><tbody id="dItems"></tbody></table></div>
    <div class="bar"><span class="note" id="dTotL">Total del documento</span><span class="total" id="dTot">S/ 0.00</span></div>
    <div class="bar"><button class="btn primary" id="dSave">Registrar documento</button><button class="btn" type="button" data-close="pDoc">Cancelar</button><span class="err" id="dSaveErr"></span></div>
  </div>
  <div class="done" id="dDone" hidden>
    <span class="note">Documento registrado</span>
    <span class="docn" id="dDoneN"></span>
    <span id="dDoneTxt"></span>
    <div id="dDeuda" class="deuda" hidden></div>
    <div class="bar"><button class="btn primary" id="dPrint">Imprimir documento</button><button class="btn" id="dOtro">Registrar otro</button><button class="btn" type="button" data-close="pDoc">Cerrar</button></div>
  </div>
</section></div>

<!-- MATERIAL -->
<div class="modal" id="pMat" hidden><section class="panel">
  <div class="phead"><h2 id="mTit">Material nuevo</h2><button class="x" type="button" data-close="pMat" aria-label="Cerrar">×</button></div>
  <form class="form" id="fMat">
    <label class="full">Descripción<input id="mDesc" maxlength="160" placeholder="FIERRO CORRUGADO DE 1/2&quot;"></label>
    <label>Categoría<input id="mCat" list="dlCat" maxlength="40" autocomplete="off"></label>
    <label>Unidad de almacén<input id="mUnd" list="dlUnd" maxlength="10" autocomplete="off"></label>
    <label>Código (automático)<input id="mCod" readonly></label>
    <label>Stock mínimo<input id="mMin" type="number" min="0" step="any" placeholder="0 = sin alerta"></label>
    <label class="two">Ubicación en almacén<input id="mUbi" maxlength="40" placeholder="ESTANTE A-2"></label>
    <label>Vida útil<select id="mVidaT"><option value="">No vence</option><option value="PERECIBLE">Perecible (vence)</option><option value="REVISION">Revisión periódica</option><option value="HERRAMIENTA">Herramienta (reposición)</option></select></label>
    <label id="mVidaDBox" hidden><span id="mVidaDL">Días</span><input id="mVidaD" type="number" min="1" step="1" placeholder="90"></label>
    <label id="mVidaFBox" hidden>Fuente<input id="mVidaF" maxlength="80" placeholder="Ficha técnica del fabricante"></label>
    <p class="note full" style="margin:0">Vida útil: la manda la ficha técnica del fabricante o la fecha impresa en el empaque. Perecible = vence (cemento, yeso, pegamentos). Revisión = no vence pero se revisa (fierro por óxido). Herramienta = se repone por desgaste; al devolverla se anota su estado.</p>
    <p class="note full" id="mUndNota" style="margin:0">Unidad de almacén = la unidad en que se entrega a obra (KG, M, UND…). Si logística compra en otra (rollo, caja, tonelada), no crees otro material: registra una equivalencia de compra.</p>
    <div class="full bar"><button class="btn primary" type="submit" id="mSave">Guardar</button><button class="btn" type="button" data-close="pMat">Cancelar</button><span class="err" id="mErr"></span></div>
  </form>
</section></div>

<!-- CONTRATISTA / PROVEEDOR / ÁREA / OBRA -->
<div class="modal small" id="pEnt" hidden><section class="panel">
  <div class="phead"><h2 id="eTit">Nuevo</h2><button class="x" type="button" data-close="pEnt" aria-label="Cerrar">×</button></div>
  <form class="form" id="fEnt" style="grid-template-columns:1fr 1fr">
    <label class="full">Nombre<input id="eNom" maxlength="100" autocomplete="off"></label>
    <label>RUC / DNI<input id="eDoc" maxlength="20"></label>
    <label>Contacto / teléfono<input id="eCon" maxlength="60"></label>
    <label class="chk full" id="eActBox"><input type="checkbox" id="eAct" checked>Activo (aparece en los documentos)</label>
    <div class="full"><span class="warnmsg" id="eWarn"></span></div>
    <div class="full bar"><button class="btn primary" type="submit" id="eSave">Guardar</button><button class="btn" type="button" data-close="pEnt">Cancelar</button><span class="err" id="eErr"></span></div>
  </form>
</section></div>

<!-- SOLICITUD -->
<div class="modal" id="pSol" hidden><section class="panel">
  <div class="phead"><h2 id="sTit">Solicitud de materiales</h2><span class="pbtns"><button class="x xmin" type="button" data-min="pSol" aria-label="Minimizar" title="Minimizar: guarda lo que llenaste y te deja revisar otra cosa">—</button><button class="x" type="button" data-close="pSol" aria-label="Cerrar">×</button></span></div>
  <div id="sForm" class="panel" style="border:0;padding:0">
    <p class="tipohelp">Pide material de los requerimientos (REQ) de tu área o del stock general. Almacén elige la orden al entregar. Almacén revisa y genera el vale de salida.</p>
    <div class="form">
      <label>Fecha<input id="sFecha" type="date"></label>
      <label>N° de solicitud del área<input id="sNro" maxlength="20" placeholder="E-117 (opcional)"></label>
      <div class="fld" id="sAreaBox">Área solicitante<div class="combo"><select id="sArea"></select><button type="button" class="btn" data-newent="AREA" data-for="sArea">+</button></div></div>
      <div class="fld two">Receptor (a quién se entrega)<div class="combo"><select id="sRec"></select><button type="button" class="btn" data-newent="CONTRATISTA" data-for="sRec">+ Nuevo</button></div></div>
      <label class="two">Responsable<input id="sResp" list="dlSol" maxlength="60" autocomplete="off" placeholder="EDUARDO RAMOS"></label>
      <div class="fld">Obra / etapa<div class="combo"><select id="sObra"></select><button type="button" class="btn" data-newent="OBRA" data-for="sObra">+</button></div></div>
      <label>Contrato (opcional)<input id="sCont" list="dlCont" maxlength="40" autocomplete="off" placeholder="N° o código del contrato"></label>
      <label class="two">Motivo<input id="sMot" maxlength="120" placeholder="RETIRO PARCIAL - 15 MÓDULOS"></label>
      <label>Área intervenida (m²)<input id="sMet" maxlength="20" placeholder="26 M2"></label>
      <label class="two">Lote<input id="sLotes" maxlength="80" placeholder="11, 12, 13, 14, 15"></label>
      <label>Mz<input id="sMz" maxlength="20" placeholder="C2"></label>
      <label class="two">Uso / partida<input id="sUso" list="dlUso" maxlength="80" autocomplete="off" placeholder="TARRAJEO MÓDULO 2"></label>
      <label class="full">Observación<input id="sObs" maxlength="250"></label>
      <label class="chk full"><input type="checkbox" id="sPres">Es préstamo de otra área / etapa (el material es de otra área u obra y se devuelve a su orden)</label>
      <label id="sFdevBox" hidden>Devolverá el<input id="sFdev" type="date"></label>
    </div>
    <h3>Agregar material</h3>
    <div class="form">
      <label class="two">Material (escribe descripción o código)<input id="sMat" list="dlMat" autocomplete="off" placeholder="CEMENTO, FIERRO, TUBERIA…"></label>
      <label class="two" id="sLoteBox"><span id="sLoteL">De qué requerimiento (REQ)</span><select id="sLote"></select></label>
      <label>Cantidad<input id="sCant" type="number" min="0" step="any"></label>
      <div class="bar" style="align-self:end"><button class="btn" type="button" id="sAdd">Agregar</button></div>
      <div class="full"><span class="note" id="sInfo"></span> <span class="err" id="sErr"></span></div>
    </div>
    <h3>Materiales solicitados</h3>
    <div class="tablebox"><table><thead><tr><th>REQ</th><th>Órdenes</th><th>Material</th><th>Und</th><th class="num">Disponible</th><th class="num">Cantidad</th><th></th></tr></thead><tbody id="sItems"></tbody></table></div>
    <div class="bar"><span class="note">Ítems</span><span class="total" id="sTot">0</span></div>
    <div class="bar"><button class="btn primary" id="sSave">Enviar solicitud</button><button class="btn" type="button" id="sPrev">Vista previa</button><button class="btn" type="button" data-close="pSol">Cancelar</button><span class="err" id="sSaveErr"></span></div>
  </div>
  <div class="done" id="sDone" hidden>
    <span class="note">Solicitud enviada</span>
    <span class="docn" id="sDoneN"></span>
    <span id="sDoneTxt"></span>
    <div class="bar"><button class="btn primary" id="sPrint">Imprimir solicitud</button><button class="btn" type="button" data-close="pSol">Cerrar</button></div>
  </div>
</section></div>

<!-- IMPORTAR SOLICITUD DEL ÁREA -->
<div class="modal" id="pImp" hidden><section class="panel">
  <div class="phead"><h2>Importar solicitud del área</h2><span class="pbtns"><button class="x xmin" type="button" data-min="pImp" aria-label="Minimizar" title="Minimizar: guarda lo que llenaste y te deja revisar otra cosa">—</button><button class="x" type="button" data-close="pImp" aria-label="Cerrar">×</button></span></div>
  <div id="iPaso1">
    <p class="tipohelp">Elige el Excel de la solicitud (formato E-117). El sistema lo lee, revisa cada material contra el stock y te muestra el resultado. No se registra nada hasta que confirmes.</p>
    <label class="drop" id="iDrop"><input type="file" id="iFile" accept=".xlsx,.xlsm,.xls"><b>Elegir archivo Excel</b><span class="note">o arrástralo aquí</span></label>
    <p class="err" id="iErr"></p>
  </div>
  <div id="iPaso2" hidden>
    <div class="chips" id="iRes"></div>
    <div class="form">
      <label>N° de solicitud del área<input id="iNro" maxlength="20"></label>
      <div class="fld" id="iAreaBox">Área solicitante (DE)<select id="iArea"></select></div>
      <label>Fecha<input id="iFecha" type="date"></label>
      <div class="fld two">Receptor<div class="combo"><select id="iRec"></select><button type="button" class="btn" id="iRecNew">+ Nuevo</button></div></div>
      <label class="two">Responsable<input id="iResp" maxlength="60"></label>
      <div class="fld">Obra / proyecto<div class="combo"><select id="iObra"></select><button type="button" class="btn" data-newent="OBRA" data-for="iObra">+</button></div></div>
      <label>Contrato (opcional)<input id="iCont" list="dlCont" maxlength="40" autocomplete="off"></label>
      <label class="two">Motivo<input id="iMot" maxlength="120"></label>
      <label>Área intervenida (m²)<input id="iMet" maxlength="20"></label>
      <label class="two">Lote<input id="iLotes" maxlength="80"></label>
      <label>Mz<input id="iMz" maxlength="20"></label>
      <label class="full">Observación<input id="iObs" maxlength="250"></label>
      <div class="full"><span class="warnmsg" id="iWarn"></span></div>
    </div>
    <h3>Materiales del archivo</h3>
    <div class="tablebox"><table><thead><tr><th title="Incluir">✓</th><th>Fila</th><th>Lo que pidió el área</th><th>Material en almacén</th><th>REQ</th><th class="num">Disponible</th><th class="num">Cantidad</th><th>Revisión</th></tr></thead><tbody id="iItems"></tbody></table></div>
    <div class="bar" style="margin-top:12px"><button class="btn primary" id="iSave">Registrar solicitud</button><button class="btn" id="iPrev">Vista previa</button><button class="btn" id="iOtro">Elegir otro archivo</button><span class="err" id="iSaveErr"></span></div>
  </div>
</section></div>

<!-- ATENDER SOLICITUD -->
<div class="modal" id="pAte" hidden><section class="panel">
  <div class="phead"><h2 id="aTit">Atender solicitud</h2><span class="pbtns"><button class="x xmin" type="button" data-min="pAte" aria-label="Minimizar" title="Minimizar: guarda lo que llenaste y te deja revisar otra cosa">—</button><button class="x" type="button" data-close="pAte" aria-label="Cerrar">×</button></span></div>
  <div class="tl" id="aLinea"></div>
  <div class="form" id="aHead"></div>
  <h3 id="aItemsT">Qué se entrega ahora</h3>
  <div class="tablebox"><table><thead><tr><th>REQ y orden de la que sale</th><th>Material</th><th>Und</th><th class="num">Pedido</th><th class="num">Entregado</th><th class="num">Disponible</th><th class="num" id="aColDar">Entregar</th></tr></thead><tbody id="aItems"></tbody></table></div>
  <div class="form" id="aRecBox" style="grid-template-columns:repeat(4,minmax(0,1fr));margin-top:10px">
    <label>Fecha de recojo<input type="date" id="aRecF"></label>
    <label>Hora (opcional)<input type="time" id="aRecH" step="900"></label>
    <label>Turno<select id="aRecT"><option>MAÑANA</option><option>TARDE</option><option>TODO EL DÍA</option></select></label>
    <label>Plazo para recoger (días)<input type="number" id="aRecD" min="0" step="1" value="3"></label>
  </div>
  <label class="full" id="aObsBox" style="display:grid;gap:3px;font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-top:10px">Observación del vale<input id="aObs" maxlength="250"></label>
  <label class="full" id="aAutBox" hidden style="display:grid;gap:3px;font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-top:10px">Autorizado por (es préstamo de otra área / etapa)<input id="aAut" list="dlSol" maxlength="60" autocomplete="off" placeholder="Residente o jefe del área dueña"></label>
  <div class="bar" style="margin-top:12px"><button class="btn" id="aApr">Aprobar (material separado)</button><button class="btn primary" id="aSave">Generar vale de salida</button><button class="btn" id="aRepro">Reprogramar recojo</button><button class="btn" id="aCerr">Cerrar pendiente</button><button class="btn" id="aRech">Rechazar</button><button class="btn" id="aWsp">WhatsApp</button><button class="btn" id="aPrint">Imprimir</button><button class="btn" type="button" data-close="pAte">Cerrar</button><span class="err" id="aErr"></span></div>
  <p class="note" id="aNota">Aprobar avisa al área que su material está listo y en qué fecha y turno debe pasar el contratista. Si no recoge en el plazo, reprograma o cierra lo pendiente para liberar el material. Entrega todo o una parte: lo que falte queda pendiente en la misma solicitud. Si el REQ tiene varias órdenes, se reparte desde la más antigua y puedes cambiar cuánto sale de cada una.</p>
</section></div>

<!-- CORREGIR DOCUMENTO -->
<div class="modal" id="pCor" hidden><section class="panel">
  <div class="phead"><h2 id="coTit">Corregir documento</h2><button class="x" type="button" data-close="pCor" aria-label="Cerrar">×</button></div>
  <p class="tipohelp" id="coHelp"></p>
  <div class="form" id="coCab"></div>
  <h3>Ítems</h3>
  <div class="tablebox"><table><thead><tr><th>#</th><th>Material</th><th>Und</th><th class="num">Cantidad</th></tr></thead><tbody id="coItems"></tbody></table></div>
  <div class="form" style="grid-template-columns:1fr;margin-top:10px"><label>Motivo (obligatorio)<input id="coMot" maxlength="200" placeholder="Se olvidó poner el REQ / la guía decía 10"></label></div>
  <div class="bar" style="margin-top:12px"><button class="btn primary" id="coSave">Guardar corrección</button><button class="btn danger" id="coAnu" hidden>Anular documento</button><button class="btn" type="button" data-close="pCor">Cancelar</button><span class="err" id="coErr"></span></div>
  <p class="note" id="coNota"></p>
</section></div>

<!-- RECOJOS PROGRAMADOS -->
<div class="modal" id="pRec" hidden><section class="panel">
  <div class="phead"><h2>Cronograma de recojo</h2><button class="x" type="button" data-close="pRec" aria-label="Cerrar">×</button></div>
  <div class="bar toolbar">
    <button class="btn" id="rcPrev" aria-label="Semana anterior">◀</button><button class="btn" id="rcHoy">Esta semana</button><button class="btn" id="rcSig" aria-label="Semana siguiente">▶</button>
    <b class="grow" id="rcTit"></b>
    <select id="rcCon"><option value="">Todos los contratistas</option></select><select id="rcArea"><option value="">Todas las áreas</option></select>
  </div>
  <div id="rcVenc"></div><div class="agenda" id="rcAgenda"></div>
  <div class="bar" style="margin-top:12px"><button class="btn primary" id="rcImg">Compartir imagen</button><button class="btn" id="rcWsp">Texto para WhatsApp</button><button class="btn" id="rcPrint">PDF / imprimir</button></div>
  <p class="note"><span class="pill info">Programado</span> <span class="pill warn">Hoy</span> <span class="pill bad">Vencido</span> <span class="pill ok">Recogido</span> · Toca una tarjeta para ver los materiales, entregar o reprogramar.</p>
</section></div>

<!-- INVENTARIO FISICO -->
<div class="modal" id="pInv" hidden><section class="panel">
  <div class="phead"><h2>Inventario físico</h2><span class="pbtns"><button class="x xmin" type="button" data-min="pInv" aria-label="Minimizar" title="Minimizar: guarda lo que llenaste y te deja revisar otra cosa">—</button><button class="x" type="button" data-close="pInv" aria-label="Cerrar">×</button></span></div>
  <p class="tipohelp">Escribe lo que contaste. Solo se ajustan los materiales contados que tienen diferencia; el resto queda igual. Al registrar se crea un Ajuste (AJ) y se imprime la constancia con firmas.</p>
  <div class="bar toolbar"><input class="grow" id="ivQ" type="search" placeholder="Buscar material o código"><select id="ivCat"><option value="">Todas las categorías</option></select><label class="chk"><input type="checkbox" id="ivSolo">Solo los que ya conté</label></div>
  <div class="form" style="grid-template-columns:1fr 2fr"><label>Fecha del conteo<input type="date" id="ivFecha"></label><label>Motivo<input id="ivMot" maxlength="200"></label></div>
  <div class="tablebox"><table><thead><tr><th>Material</th><th>Und</th><th>Ubicación</th><th class="num">Sistema</th><th class="num">Contado</th><th class="num">Diferencia</th></tr></thead><tbody id="ivItems"></tbody></table></div>
  <div class="bar"><span class="note" id="ivRes"></span></div>
  <div class="iv-rep note" id="ivRep" hidden></div>
  <div class="bar"><button class="btn primary" id="ivSave">Registrar ajuste</button><button class="btn" id="ivPrint">Imprimir constancia</button><button class="btn" type="button" data-close="pInv">Cerrar</button><span class="err" id="ivErr"></span></div>
</section></div>

<!-- CIERRE ANUAL -->
<div class="modal" id="pCie" hidden><section class="panel">
  <div class="phead"><h2>Cierre anual</h2><button class="x" type="button" data-close="pCie" aria-label="Cerrar">×</button></div>
  <ol class="note" style="margin:0 0 10px;padding-left:18px;line-height:1.55">
    <li><b>Copia de respaldo:</b> se guarda en tu Drive una copia completa del archivo con todo el historial. Esa copia no se borra.</li>
    <li><b>Saldos iniciales:</b> en este archivo los movimientos se reemplazan por un ingreso de saldo inicial, separado por orden de compra, REQ y área, con su precio y su fecha de ingreso.</li>
    <li><b>Lo pendiente sigue:</b> préstamos sin devolver, solicitudes abiertas o entregadas en parte y recojos programados pasan tal como están.</li>
    <li><b>No cambia:</b> usuarios, materiales, equivalencias, contratistas, proveedores, áreas y obras. La numeración de documentos continúa.</li>
  </ol>
  <p class="warnmsg" style="margin:0 0 10px">Hazlo después del inventario físico de fin de año y cuando nadie esté registrando documentos.</p>
  <div class="form" style="grid-template-columns:1fr 1fr">
    <label>Fecha de cierre<input type="date" id="ciFecha"></label>
    <label>Escribe CERRAR para confirmar<input id="ciConf" autocomplete="off" maxlength="10"></label>
    <div class="full note" id="ciRes">Calculando…</div>
  </div>
  <div class="bar" style="margin-top:12px"><button class="btn primary" id="ciSave">Hacer cierre anual</button><button class="btn" type="button" data-close="pCie">Cancelar</button><span class="err" id="ciErr"></span></div>
  <div class="done" id="ciDone" hidden></div>
</section></div>

<!-- PRUEBA PILOTO -->
<div class="modal" id="pPil" hidden><section class="panel">
  <div class="phead"><h2>Prueba piloto</h2><button class="x" type="button" data-close="pPil" aria-label="Cerrar">×</button></div>
  <ol class="note" style="margin:0 0 10px;padding-left:18px;line-height:1.55">
    <li><b>Antes de probar</b>, pulsa <b>Empezar prueba piloto</b>. El sistema anota qué materiales, contratistas y usuarios ya existen.</li>
    <li><b>Durante la prueba</b> registren ingresos, salidas, préstamos y solicitudes ficticias. Arriba de cada pantalla se verá un aviso de prueba.</li>
    <li><b>Al terminar</b>, se guarda una copia de respaldo en tu Drive y se borran todos los movimientos, solicitudes y correcciones. Puedes borrar también lo que se creó durante la prueba.</li>
  </ol>
  <p class="warnmsg" style="margin:0 0 10px">Los correos de aviso sí se envían durante la prueba. Si no quieres que lleguen, deja vacío el correo de los usuarios de prueba.</p>
  <div class="bar" style="margin-bottom:10px"><button class="btn primary" id="plIni">Empezar prueba piloto</button><span class="note" id="plActivo" hidden></span></div>
  <h3 style="margin:6px 0">Terminar la prueba y borrar los datos</h3>
  <div class="note" id="plRes">Calculando…</div>
  <div id="plNuevos" class="pl-nuevos"></div>
  <div class="form" style="grid-template-columns:1fr"><label>Escribe BORRAR para confirmar<input id="plConf" autocomplete="off" maxlength="10"></label></div>
  <div class="bar" style="margin-top:12px"><button class="btn danger" id="plSave">Borrar datos de prueba</button><button class="btn" type="button" data-close="pPil">Cancelar</button><span class="err" id="plErr"></span></div>
  <div class="done" id="plDone" hidden></div>
</section></div>

<!-- CODIGO QR ESCANEADO -->
<div class="modal small" id="pQr" hidden><section class="panel">
  <div class="phead"><h2 id="qrTit">Código escaneado</h2><button class="x" type="button" data-close="pQr" aria-label="Cerrar">×</button></div>
  <div id="qrBody"></div>
  <div class="bar" id="qrAct" style="margin-top:12px"></div>
</section></div>

<!-- COPIA DE SEGURIDAD -->
<div class="modal small" id="pResp" hidden><section class="panel">
  <div class="phead"><h2>Copia de seguridad semanal</h2><button class="x" type="button" data-close="pResp" aria-label="Cerrar">×</button></div>
  <p class="note">Cada domingo a las 10 p. m. se guarda una copia completa de este archivo (todas las hojas) en la carpeta <b>Respaldos Control Almacén</b>, al lado de la hoja en tu Drive. Se conservan las últimas 8 copias (dos meses); las más antiguas van a la papelera. Si algo se borra o se daña, se abre la copia y se recupera desde ahí.</p>
  <p id="rsEst"></p><p id="rsUlt" class="note"></p>
  <div class="bar"><button class="btn primary" type="button" id="rsTog"></button><button class="btn" type="button" id="rsAhora">Hacer una copia ahora</button><button class="btn" type="button" data-close="pResp">Cerrar</button></div>
  <span class="err" id="rsErr"></span>
  <p class="note">La primera vez, el dueño de la hoja ejecuta <b>Almacén → Dar permisos</b> para autorizar el acceso a Drive.</p>
</section></div>

<!-- PASE A STOCK GENERAL -->
<div class="modal small" id="pLib" hidden><section class="panel">
  <div class="phead"><h2>Pasar a stock general</h2><button class="x" type="button" data-close="pLib" aria-label="Cerrar">×</button></div>
  <div class="form" style="grid-template-columns:1fr 1fr">
    <div class="full" id="lInfo"></div>
    <label>Cantidad a pasar (<span id="lUnd"></span>)<input id="lCant" type="number" min="0" step="any"></label>
    <label class="full">Motivo<input id="lMot" maxlength="160" placeholder="Saldo sin uso desde hace 3 meses"></label>
    <p class="note full" style="margin:0">Se registra un documento LG. El stock total no cambia: el saldo deja de ser del área y cualquier área puede pedirlo. Mantiene su orden de compra, su precio y su fecha de ingreso (para el vencimiento). Al área de origen le llega un correo.</p>
    <div class="full bar"><button class="btn primary" type="button" id="lSave">Pasar a stock general</button><button class="btn" type="button" data-close="pLib">Cancelar</button><span class="err" id="lErr"></span></div>
  </div>
</section></div>

<!-- EQUIVALENCIA -->
<div class="modal small" id="pEqv" hidden><section class="panel">
  <div class="phead"><h2 id="qTit">Equivalencia de compra</h2><button class="x" type="button" data-close="pEqv" aria-label="Cerrar">×</button></div>
  <form class="form" id="fEqv" style="grid-template-columns:1fr 1fr">
    <label class="full">Material<input id="qvMat" list="dlMat" autocomplete="off" placeholder="ALAMBRE, CABLE, CLAVOS…"></label>
    <label>Logística compra en<input id="qvUnd" list="dlUnd" maxlength="10" autocomplete="off" placeholder="ROLLO, CAJA, TN…"></label>
    <label><span>1 <span id="qvU">unidad</span> = ¿cuántos <span id="qvB">—</span>?</span><input id="qvFac" type="number" min="0" step="any"></label>
    <label>Tipo<select id="qvTipo"><option value="FIJA">Fija (ficha técnica / empaque)</option><option value="VARIABLE">Variable (peso real según guía)</option></select></label>
    <label>Observación<input id="qvObs" maxlength="60" placeholder="Según ficha del fabricante"></label>
    <div class="full"><span class="note" id="qvInfo"></span></div>
    <div class="full bar"><button class="btn primary" type="submit" id="qvSave">Guardar</button><button class="btn" type="button" data-close="pEqv">Cancelar</button><span class="err" id="qvErr"></span></div>
  </form>
</section></div>

<!-- UNIDAD -->
<div class="modal small" id="pUnd" hidden><section class="panel">
  <div class="phead"><h2 id="unTit">Unidad de medida</h2><button class="x" type="button" data-close="pUnd" aria-label="Cerrar">×</button></div>
  <form class="form" id="fUnd" style="grid-template-columns:1fr 1fr">
    <label>Nombre (como se ve en almacén)<input id="unNom" maxlength="10" autocomplete="off" placeholder="BALDE"></label>
    <label>Código SUNAT (Catálogo N° 03)<input id="unCod" maxlength="6" autocomplete="off" placeholder="BJ"></label>
    <label class="full">Sinónimos (cómo lo escribe la gente, separados por coma)<input id="unSin" maxlength="200" autocomplete="off" placeholder="BALDES, BDE"></label>
    <label class="chk full" id="unActBox"><input type="checkbox" id="unAct"> Activa (aparece en la lista para elegir)</label>
    <p class="note full" style="margin:0">Si escriben un sinónimo (por ejemplo GL), el sistema lo cambia solo al nombre (GALON). Si la unidad no tiene código propio en SUNAT (plancha, varilla, tubo), usa NIU, que es "unidad".</p>
    <div class="full bar"><button class="btn primary" type="submit" id="unSave">Guardar</button><button class="btn" type="button" data-close="pUnd">Cancelar</button><span class="err" id="unErr"></span></div>
  </form>
</section></div>

<!-- UNIFICAR UNIDADES -->
<div class="modal small" id="pUnif" hidden><section class="panel">
  <div class="phead"><h2>Unificar unidades</h2><button class="x" type="button" data-close="pUnif" aria-label="Cerrar">×</button></div>
  <p class="note" style="margin:0">Cambia las unidades escritas distinto (GL, BLS, KGS…) a su nombre oficial en materiales, movimientos, solicitudes y equivalencias. Solo cambia el nombre de la unidad: las cantidades no se tocan. Las equivalencias que quedan como 1 = 1 (la misma unidad del material) o repetidas se quitan.</p>
  <div id="ufRes" class="note">Calculando…</div>
  <div class="bar"><button class="btn primary" type="button" id="ufSave">Unificar</button><button class="btn" type="button" data-close="pUnif">Cerrar</button><span class="err" id="ufErr"></span></div>
</section></div>

<!-- UNIFICAR -->
<div class="modal small" id="pUni" hidden><section class="panel">
  <div class="phead"><h2>Unificar nombres</h2><button class="x" type="button" data-close="pUni" aria-label="Cerrar">×</button></div>
  <p class="note" style="margin:0">Todos los documentos de <b id="uDe"></b> pasarán a nombre de:</p>
  <select id="uA"></select>
  <p class="warnmsg" style="margin:0">Esto cambia el historial y no se puede deshacer desde la app.</p>
  <div class="bar"><button class="btn primary" id="uSave">Unificar</button><button class="btn" type="button" data-close="pUni">Cancelar</button><span class="err" id="uErr"></span></div>
</section></div>

<!-- USUARIO -->
<div class="modal small" id="pUsr" hidden><section class="panel">
  <div class="phead"><h2 id="uTit">Usuario nuevo</h2><button class="x" type="button" data-close="pUsr" aria-label="Cerrar">×</button></div>
  <form class="form" id="fUsr" style="grid-template-columns:1fr 1fr">
    <label>Usuario<input id="usUsr" maxlength="30" autocomplete="off" placeholder="JPEREZ"></label>
    <label>Rol<select id="usRol"></select></label>
    <label class="full" id="usAreaBox">Área que puede consultar<select id="usArea"></select></label>
    <label class="full">Nombre completo<input id="usNom" maxlength="60"></label>
    <label class="full">Correo (para los avisos)<input id="usMail" type="email" maxlength="80" placeholder="nombre@empresa.com"></label>
    <label class="full"><span id="usPwdL">Contraseña (mínimo 6 caracteres)</span><input id="usPwd" type="password" autocomplete="new-password"></label>
    <label class="chk full" id="usActBox"><input type="checkbox" id="usAct" checked>Activo (puede ingresar)</label>
    <div class="full bar"><button class="btn primary" type="submit" id="usSave">Guardar</button><button class="btn" type="button" data-close="pUsr">Cancelar</button><button class="btn danger" type="button" id="usDel" hidden>Eliminar</button><span class="err" id="usErr"></span></div>
  </form>
</section></div>

<!-- CLAVE -->
<div class="modal small" id="pClave" hidden><section class="panel">
  <div class="phead"><h2>Cambiar contraseña</h2><button class="x" type="button" data-close="pClave" aria-label="Cerrar">×</button></div>
  <form class="form" id="fClave" style="grid-template-columns:1fr">
    <label>Contraseña actual<input id="cAct" type="password" autocomplete="current-password"></label>
    <label>Nueva contraseña (mínimo 6 caracteres)<input id="cNew" type="password" autocomplete="new-password"></label>
    <label>Repite la nueva<input id="cNew2" type="password" autocomplete="new-password"></label>
    <div class="bar"><button class="btn primary" type="submit">Guardar</button><button class="btn" type="button" data-close="pClave">Cancelar</button><span class="err" id="cErr"></span></div>
  </form>
</section></div>

<!-- CONFIRMAR -->
<div class="modal small" id="pConf" hidden><section class="panel">
  <div class="phead"><h2 id="cfTit">¿Confirmar?</h2><button class="x" type="button" id="cfX" aria-label="Cerrar">×</button></div>
  <div id="cfBody" class="cf-body"></div>
  <div class="bar" style="margin-top:14px"><button class="btn primary" type="button" id="cfOk">Sí, confirmar</button><button class="btn" type="button" id="cfNo">Volver</button></div>
</section></div>

<datalist id="dlMat"></datalist><datalist id="dlUso"></datalist><datalist id="dlSol"></datalist><datalist id="dlCat"></datalist><datalist id="dlUnd"></datalist><datalist id="dlDoc"></datalist><datalist id="dlCont"></datalist>
<div class="toast" id="toast" hidden></div>
<div id="tray" aria-label="Ventanas minimizadas"></div>
<script>
window.APP_INI=1;
var $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
var S={token:"",ses:null,mat:[],mov:[],ent:[],eq:[],sol:[],sols:[],mv:"mat",usuarios:[],roles:{},stock:[],byCod:{},lots:{},lotList:[],loans:[],docs:[],d:null,edit:null,et:"CONTRATISTA",tab:"dash",db:false};
var esc=v=>String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
var U=v=>String(v??"").trim().toUpperCase(), N=v=>Number(v)||0, str=v=>v==null?"":String(v).trim();
var nf=new Intl.NumberFormat("es-PE",{maximumFractionDigits:2}), mf=new Intl.NumberFormat("es-PE",{minimumFractionDigits:2,maximumFractionDigits:2});
var fmt=n=>nf.format(N(n)), money=n=>"S/ "+mf.format(N(n));
var fdate=d=>{const m=/^(\d{4})-(\d\d)-(\d\d)/.exec(d||"");return m?`${m[3]}/${m[2]}/${m[1]}`:"";};
var today=()=>{const d=new Date();return new Date(d-d.getTimezoneOffset()*6e4).toISOString().slice(0,10);};
var addDays=(iso,n)=>{const d=new Date(iso+"T12:00:00");d.setDate(d.getDate()+n);return d.toISOString().slice(0,10);};
var dias=(a,b)=>Math.round((new Date(b+"T12:00:00")-new Date(a+"T12:00:00"))/864e5);
var uniq=a=>[...new Set(a.map(U).filter(Boolean))].sort((x,y)=>x.localeCompare(y,"es"));
var sum=(a,f)=>a.reduce((t,x)=>t+N(f(x)),0);
function toast(m){const t=$("#toast");t.textContent=m;t.hidden=false;clearTimeout(toast.h);toast.h=setTimeout(()=>t.hidden=true,3500);}
var opts=(arr,blank)=>(blank!=null?`<option value="">${esc(blank)}</option>`:"")+arr.map(v=>`<option>${esc(v)}</option>`).join("");
function keepSel(el,html){const v=el.value;el.innerHTML=html;if([...el.options].some(o=>o.value===v))el.value=v;}
function setDl(id,arr){$("#"+id).innerHTML=arr.map(v=>`<option value="${esc(v)}">`).join("");}
var VISTAS_AREA=["stock","orc","mov","sol","pres","kdx"], esArea=()=>S.ses&&S.ses.rol==="AREA", puedeVer=t=>t==="usr"?isAdmin():!esArea()||VISTAS_AREA.includes(t);
var canWrite=()=>S.ses&&(S.ses.rol==="ADMIN"||S.ses.rol==="ALMACEN"), isAdmin=()=>S.ses&&S.ses.rol==="ADMIN";
function store(k,v){try{v==null?sessionStorage.removeItem(k):sessionStorage.setItem(k,v);}catch(e){}}
function load(k){try{return sessionStorage.getItem(k)||"";}catch(e){return "";}}
// "Mantener la sesion en este equipo": el token tambien queda en localStorage (sirve para escanear QR con el celular sin volver a ingresar)
function guardarTk(tk,rec){ store("alm.tk",tk); try{ if(tk&&rec) localStorage.setItem("alm.tk",tk); else localStorage.removeItem("alm.tk"); }catch(e){} }
function tkGuardado(){ let t=load("alm.tk"); if(!t){ try{ t=localStorage.getItem("alm.tk")||""; if(t) store("alm.tk",t); }catch(e){} } return t; }

var TIPO={
  INGRESO:{pre:"NI",signo:1,nom:"Ingreso",doc:"Nota de ingreso",pill:"ok",help:"Material que llega de un proveedor con su orden de compra. Cada orden queda registrada con su \u00e1rea y su saldo propio."},
  SALIDA:{pre:"VS",signo:-1,nom:"Salida",doc:"Vale de salida",pill:"info",help:"Material entregado para consumo. Elige de qu\u00e9 orden de compra sale."},
  PRESTAMO:{pre:"PR",signo:-1,nom:"Pr\u00e9stamo",doc:"Vale de pr\u00e9stamo",pill:"warn",help:"Material o herramienta que sale y debe volver en una fecha. Puede salir de la orden de otra \u00e1rea: al devolverlo regresa a esa orden."},
  DEVOLUCION:{pre:"DV",signo:1,nom:"Devoluci\u00f3n",doc:"Nota de devoluci\u00f3n",pill:"ok",help:"Lo que regresa al almac\u00e9n: un pr\u00e9stamo (elige cu\u00e1l) o material sobrante de obra."},
  LIBERACION:{pre:"LG",signo:0,nom:"Pase a stock general",doc:"Pase a stock general",pill:"info",help:""},
  AJUSTE:{pre:"AJ",signo:1,nom:"Ajuste",doc:"Ajuste de inventario",pill:"mute",help:"Corrige el saldo seg\u00fan el conteo f\u00edsico. Escribe lo que contaste; el sistema registra la diferencia."},
  INTERNAMIENTO:{pre:"IM",signo:1,nom:"Internamiento",doc:"Nota de internamiento",pill:"ok",help:"Sobrante que devuelve un contratista. Entra a stock general a costo promedio. Marca el estado de cada material: lo malogrado no entra al stock. El fierro cortado u otro sobrante en pedazos se registra como retazo, medido en metros o piezas."},
  MERMA:{pre:"MR",signo:-1,nom:"Merma",doc:"Baja por merma",pill:"bad",help:"Da de baja material inservible: retazos que ya no sirven, chatarra, bolsas abiertas o mojadas. Elige de qu\u00e9 orden sale e indica el motivo."}
};
var TIT={dash:"Panel",stock:"Stock general",orc:"\u00d3rdenes de compra",sol:"Solicitudes de material",mov:"Movimientos",pres:"Pr\u00e9stamos",kdx:"Kardex",rep:"Reportes",mat:"Materiales",ent:"Contratistas, proveedores, \u00e1reas y obras",usr:"Usuarios"};
var ENTN={CONTRATISTA:"contratista / receptor",PROVEEDOR:"proveedor",AREA:"\u00e1rea",OBRA:"obra"}, ENTCOL={CONTRATISTA:"CONTRATISTA",PROVEEDOR:"PROVEEDOR",AREA:"AREA",OBRA:"OBRA"};
var stCls={"Normal":"ok","Bajo m\u00ednimo":"warn","Sin stock":"bad","Sin movimiento":"mute"};
var solCls={ENVIADA:"warn",VISTA:"warn",APROBADA:"info",PARCIAL:"info",ENTREGADA:"ok",RECHAZADA:"bad",ANULADA:"mute",CERRADA:"mute"};
var solTxt={ENVIADA:"Enviada",VISTA:"Vista por almac\u00e9n",APROBADA:"Aprobada",PARCIAL:"Entregada en parte",ENTREGADA:"Entregada",RECHAZADA:"Rechazada",ANULADA:"Anulada",CERRADA:"Cerrada con pendiente"};
var SOL_CERR=["ENTREGADA","RECHAZADA","ANULADA","CERRADA"];
var puedePedir=()=>S.ses&&["ADMIN","ALMACEN","AREA"].includes(S.ses.rol);
var prCls={"Vencido":"bad","Vence pronto":"warn","Al d\u00eda":"info","Devuelto":"ok"};
var orCls={"Sin usar":"info","En uso":"ok","Agotada":"mute"};
var ef=x=>!TIPO[x.TIPO]||x.ANULADO?0:(x.TIPO==="DEVOLUCION"&&x.LOTE_ORIGEN)||(x.TIPO==="INTERNAMIENTO"&&x.ESTADO_DEV==="MALOGRADO")?0:TIPO[x.TIPO].signo*N(x.CANT);
var who=x=>x.TIPO==="INGRESO"?x.PROVEEDOR:x.TIPO==="LIBERACION"?"STOCK GENERAL":x.TIPO==="MERMA"?(x.CONTRATISTA||"BAJA DE ALMAC\u00c9N"):x.CONTRATISTA;
// unidades: las que solo se cuentan en enteros (igual que Code.gs)
var ENTERAS=["UND","UNID","UNIDAD","PZA","PIEZA","BOLSA","BLS","PLANCHA","VARILLA","CARTUCHO","CAJA","CAJAS","PAR","JGO","JUEGO"];
var esEntera=u=>ENTERAS.includes(U(u)), noEntero=(q,u)=>esEntera(u)&&Math.abs(q-Math.round(q))>1e-9;
var eqDe=cod=>S.eq.filter(e=>e.CODIGO===U(cod)), eqBusca=(cod,und)=>S.eq.find(e=>e.CODIGO===U(cod)&&e.UND_COMPRA===U(und));
var eqTxt=e=>`1 ${e.UND_COMPRA} = ${fmt(e.FACTOR)} ${(S.byCod[e.CODIGO]||{}).und||""}`;
// "\u2248 2 ROLLO": equivalente aproximado en la unidad de compra (fija primero)
function aprox(cod,q){const e=eqDe(cod).sort((a,b)=>(b.TIPO==="FIJA")-(a.TIPO==="FIJA"))[0]; return e&&q>0?`\u2248 ${fmt(q/e.FACTOR)} ${e.UND_COMPRA}`:"";}
var compraTxt=x=>x.UND_COMPRA?`${fmt(x.CANT_COMPRA)} ${x.UND_COMPRA} \u00d7 S/ ${mf.format(x.PU_COMPRA)} (1 ${x.UND_COMPRA} = ${fmt(x.FACTOR)} ${x.UND})`:"";
var lotTxt=l=>l&&l.IM?`Stock general \u00b7 internamiento ${l.DOC}`:l?`ORC ${l.ORC||"s/n"}${l.AREA?" \u00b7 "+l.AREA:l.EX_LOTE?" \u00b7 STOCK GENERAL":""}${l.OBRA?" \u00b7 "+l.OBRA:""}`:"";
// vida util y material dormido (mismas reglas que Code.gs)
var DIAS_VENCER=15, DIAS_DORM=60;
/* retazos: se miden con wincha o por piezas; el fierro pasa a kg con el peso por metro de la varilla */
var KG_M_FIERRO=[[/1\s?3\/8/,7.907],[/\b6\s?MM\b/,0.222],[/\b8\s?MM\b/,0.395],[/3\/8/,0.56],[/\b12\s?MM\b/,0.888],[/1\/2/,0.994],[/5\/8/,1.552],[/3\/4/,2.235],[/(^|[^\/\d])1\s?("|''|PULG)/,3.973]];
function kgPorMetro(desc){const d=U(desc); if(!/FIERRO|CORRUGAD|VARILLA/.test(d)) return 0; const r=KG_M_FIERRO.find(x=>x[0].test(d)); return r?r[1]:0;}
var matDe=cod=>S.mat.find(m=>U(m.CODIGO)===U(cod))||{};
function kgM(cod){const m=matDe(cod); let k=N(m.KG_M); if(!k&&m.RETAZO_DE&&U(m.UND)==="M") k=kgPorMetro(matDe(m.RETAZO_DE).DESCRIPCION); return k;}
var kgDe=(cod,q)=>kgM(cod)&&q?`\u2248 ${fmt(q*kgM(cod))} kg`:"";
var retazosDe=cod=>S.mat.filter(m=>U(m.RETAZO_DE)===U(cod)).map(m=>S.byCod[U(m.CODIGO)]).filter(x=>x&&x.saldo>0);
function retazoAviso(cod){const r=retazosDe(cod); if(!r.length) return "";
  return "Retazo primero: hay "+r.map(x=>`${fmt(x.saldo)} ${x.und} de ${x.desc}${kgDe(x.codigo,x.saldo)?" ("+kgDe(x.codigo,x.saldo)+")":""}`).join(", ")+" en "+(r[0].ubi||"almac\u00e9n")+". \u00dasalo antes que material nuevo para trabajos chicos.";}
var VIDA_NOM={PERECIBLE:"Perecible (vence)",REVISION:"Revisi\u00f3n peri\u00f3dica",HERRAMIENTA:"Herramienta (reposici\u00f3n)"};
var vidaCls={"Vencido":"bad","Por vencer":"warn","Revisar":"warn","Evaluar reposici\u00f3n":"warn"};
var esGeneral=l=>!!l&&!l.AREA&&(!l.REQ||U(l.REQ)==="STOCK");
function vidaLote(l,m){ const tipo=U(m&&m.VIDA_TIPO), d=N(m&&m.VIDA_DIAS), hoy=today(); if(!tipo||l.SALDO<=0) return null;
  const base=String(l.FECHA).slice(0,10);
  if(tipo==="PERECIBLE"){ const v=/^\d{4}-\d\d-\d\d/.test(l.VENCE||"")?l.VENCE.slice(0,10):d?addDays(base,d):""; if(!v) return null;
    const r=dias(hoy,v); return r<0?{estado:"Vencido",fecha:v,dias:r}:r<=DIAS_VENCER?{estado:"Por vencer",fecha:v,dias:r}:null; }
  if(!d) return null; const f=addDays(base,d), r=dias(hoy,f);
  return r<=0?{estado:tipo==="HERRAMIENTA"?"Evaluar reposici\u00f3n":"Revisar",fecha:f,dias:r}:null; }
var vidaTxt=v=>v.estado==="Vencido"?`venci\u00f3 el ${fdate(v.fecha)}`:v.estado==="Por vencer"?`vence el ${fdate(v.fecha)} (${v.dias===0?"hoy":v.dias===1?"ma\u00f1ana":"en "+v.dias+" d\u00edas"})`:`desde el ${fdate(v.fecha)}`;

/* ---------- servidor ---------- */
// si el Code.gs publicado es mas viejo que esta pagina, la funcion no existe: se avisa claro en vez del error tecnico de Google
function run(fn,...args){return new Promise((ok,ko)=>{const r=google.script.run.withSuccessHandler(ok).withFailureHandler(ko);
  if(typeof r[fn]!=="function"){ko(new Error(`El Code.gs que est\u00e1 en Apps Script es una versi\u00f3n anterior (le falta "${fn}"). Pega el Code.gs nuevo completo, guarda y publica una Nueva versi\u00f3n.`));return;} r[fn](...args);});}
var msg=e=>String(e?.message||e||"error de conexi\u00f3n").replace(/^Error:\s*/,"");
async function api(fn,...args){
  try{ return await run(fn,S.token,...args); }
  catch(e){ if(/^SESION:/.test(msg(e))){ salir(msg(e).replace(/^SESION:\s*/,"")); } throw new Error(msg(e).replace(/^SESION:\s*/,"")); }
}

/* ---------- sesion ---------- */
$("#fLogin").onsubmit=async e=>{e.preventDefault(); $("#lErr").textContent=""; $("#lBtn").disabled=true; $("#lBtn").textContent="Ingresando\u2026";
  try{ const r=await run("login",$("#lUsr").value,$("#lPwd").value); S.token=r.token; guardarTk(r.token,$("#lRec").checked); $("#lPwd").value=""; await cargar(); }
  catch(x){ $("#lErr").textContent=msg(x); }
  $("#lBtn").disabled=false; $("#lBtn").textContent="Ingresar"; };
function salir(aviso){ if(S.token) run("logout",S.token).catch(()=>{}); S.token=""; S.ses=null; S.db=false; guardarTk(null); LARGOS.forEach(id=>delete $("#"+id).dataset.min); renderTray();
  $$(".modal").forEach(m=>m.hidden=true); $("#app").hidden=true; $("#login").hidden=false; $("#lErr").textContent=aviso||""; $("#lUsr").focus(); }
$("#btnSalir").onclick=()=>salir("");
$("#btnClave").onclick=()=>{$("#fClave").reset();$("#cErr").textContent="";$("#pClave").hidden=false;$("#cAct").focus();};
$("#fClave").onsubmit=async e=>{e.preventDefault(); const err=$("#cErr"); err.textContent="";
  if($("#cNew").value.length<6){err.textContent="La nueva contrase\u00f1a debe tener al menos 6 caracteres.";return;}
  if($("#cNew").value!==$("#cNew2").value){err.textContent="Las contrase\u00f1as nuevas no coinciden.";return;}
  try{ await api("cambiarClave",$("#cAct").value,$("#cNew").value); $("#pClave").hidden=true; toast("Contrase\u00f1a actualizada."); }catch(x){err.textContent=msg(x);} };

/* ---------- calculos (las mismas reglas que Code.gs) ---------- */
function compute(){
  const st={};
  S.mat.forEach(m=>st[U(m.CODIGO)]={codigo:m.CODIGO,desc:m.DESCRIPCION,cat:U(m.CATEGORIA),und:U(m.UND),min:N(m.STOCK_MIN),ubi:m.UBICACION,ent:0,sal:0,saldo:0,qI:0,vI:0,pres:0});
  S.mov.forEach(x=>{const s=st[U(x.CODIGO)]; if(!s) return; const e=ef(x); s.saldo+=e; if(e>0) s.ent+=e; else s.sal-=e;
    if(x.TIPO==="INGRESO"){s.qI+=N(x.CANT);s.vI+=N(x.CANT)*N(x.PU);}});
  // ordenes (lotes): cada linea de ingreso; lo antiguo sin orden sale de la mas antigua (PEPS)
  // total comprado por orden de compra y material (CANT_OC, lo escribe almacen en el ingreso) y cuanto va llegando
  const OC={}; S.mov.forEach(x=>{ if(x.TIPO!=="INGRESO"||!str(x.ORC)||/^SI-/.test(x.DOC)) return; const k=ocKey(x.ORC,x.CODIGO);
    const o=OC[k]||(OC[k]={orc:x.ORC,codigo:x.CODIGO,und:x.UND,total:0,llego:0,n:0}); o.n++; o.llego+=N(x.CANT); if(N(x.CANT_OC)>0) o.total=N(x.CANT_OC); x._n=o.n; x._van=o.llego; });
  S.oc=OC;
  const L={}, porMat={};
  S.mov.forEach(x=>{ const k=U(x.CODIGO), q=N(x.CANT);
    if(x.TIPO==="INGRESO"){ const l={OC:OC[ocKey(x.ORC,x.CODIGO)]||null,LLEGADA:x._n||0,ID:x.LOTE||String(x.ID),DOC:x.DOC,CODIGO:x.CODIGO,DESCRIPCION:x.DESCRIPCION,UND:x.UND,ORC:x.ORC,REQ:x.REQ,GUIA:x.GUIA,AREA:x.AREA,OBRA:x.OBRA||"",PROVEEDOR:x.PROVEEDOR,FECHA:x.FECHA,PU:N(x.PU),ING:q,SALDO:q,COMPRA:compraTxt(x),VENCE:x.VENCE,ULT:str(x.ULT_MOV)>x.FECHA?str(x.ULT_MOV):x.FECHA};
      L[l.ID]=l; (porMat[k]=porMat[k]||[]).push(l); return; }
    if(x.TIPO==="INTERNAMIENTO"){ if(ef(x)<=0) return;
      const l={ID:x.LOTE||String(x.ID),DOC:x.DOC,CODIGO:x.CODIGO,DESCRIPCION:x.DESCRIPCION,UND:x.UND,ORC:"",REQ:"STOCK",GUIA:"",AREA:"",PROVEEDOR:x.CONTRATISTA,FECHA:x.FECHA,PU:N(x.PU),ING:q,SALDO:q,COMPRA:"",VENCE:"",ULT:x.FECHA,IM:true};
      L[l.ID]=l; (porMat[k]=porMat[k]||[]).push(l); return; }
    const lote=L[x.LOTE], org=L[x.LOTE_ORIGEN];
    if(lote&&x.FECHA>lote.ULT) lote.ULT=x.FECHA;
    if(x.TIPO==="LIBERACION"){ if(!lote) return; lote.SALDO-=q;
      const g=Object.assign({},lote,{ID:String(x.ID),DOC:x.DOC,REQ:"STOCK",AREA:"",OBRA:"",ING:q,SALDO:q,ULT:x.FECHA,EX_REQ:lote.REQ,EX_AREA:lote.AREA,EX_LOTE:lote.ID,LIB_DOC:x.DOC,LIB_FECHA:x.FECHA});
      L[g.ID]=g; (porMat[k]=porMat[k]||[]).push(g); return; }
    if(x.TIPO==="DEVOLUCION"&&org){ if(lote) lote.SALDO+=q; org.SALDO-=q; return; }
    if(x.TIPO==="AJUSTE"&&!lote){ const e=ef(x), ls=porMat[k]=porMat[k]||[];
      if(e>0){ const g={ID:String(x.ID),DOC:x.DOC,CODIGO:x.CODIGO,DESCRIPCION:x.DESCRIPCION,UND:x.UND,ORC:"",REQ:"STOCK",GUIA:"",AREA:"",PROVEEDOR:"",FECHA:x.FECHA,PU:N(x.PU),ING:e,SALDO:e,COMPRA:"",VENCE:"",ULT:x.FECHA,AJ:true};
        L[g.ID]=g; ls.push(g); return; }
      repartoAj(ls,-e).forEach(p=>{p.l.SALDO-=p.q;}); return; }
    const e=ef(x); if(lote){lote.SALDO+=e;return;}
    const ls=porMat[k]||[]; if(!ls.length) return;
    if(e>0){ls[ls.length-1].SALDO+=e;return;}
    let r=-e; ls.forEach(l=>{const u=Math.min(Math.max(l.SALDO,0),r); l.SALDO-=u; r-=u;}); if(r>0) ls[ls.length-1].SALDO-=r; });
  S.lots=L; S.lotsMat=porMat;
  S.lotList=Object.values(L).map(l=>Object.assign(l,{USADO:l.ING-l.SALDO,estado:l.SALDO<=0?"Agotada":l.SALDO<l.ING?"En uso":"Sin usar"}))
    .sort((a,b)=>String(b.FECHA).localeCompare(String(a.FECHA))||String(b.DOC).localeCompare(String(a.DOC)));
  // prestamos: una fila por PR, material y orden
  const P={}, hoy=today(), key=(d,x)=>U(d)+"|"+U(x.CODIGO)+"|"+(x.LOTE||"");
  S.mov.forEach(x=>{ if(x.TIPO!=="PRESTAMO") return; const k=key(x.DOC,x);
    const o=P[k]||(P[k]={doc:x.DOC,codigo:x.CODIGO,desc:x.DESCRIPCION,und:x.UND,con:x.CONTRATISTA,cont:x.CONTRATO||"",aut:x.AUTORIZA||"",area:x.AREA,obra:x.OBRA,sol:x.SOLICITANTE,fecha:x.FECHA,fdev:x.FECHA_DEV,lote:x.LOTE||"",pu:N(x.PU),prestado:0,devuelto:0});
    o.prestado+=N(x.CANT); });
  S.mov.forEach(x=>{ if(x.TIPO==="DEVOLUCION"&&x.DOC_REF){const o=P[key(x.DOC_REF,x)]; if(o){ o.devuelto+=N(x.CANT); if(x.ESTADO_DEV) o.estDev=x.ESTADO_DEV; }} });
  S.loans=Object.values(P).map(o=>{o.pend=Math.max(0,o.prestado-o.devuelto); o.de=o.aut?((L[o.lote]||{}).OBRA||(L[o.lote]||{}).AREA||"sin etapa"):""; o.para=o.obra||o.area; const d=o.fdev?dias(hoy,o.fdev):null; o.dias=d;
    o.estado=o.pend<=0?"Devuelto":d!=null&&d<0?"Vencido":d!=null&&d<=2?"Vence pronto":"Al d\u00eda";
    const s=st[U(o.codigo)]; if(s&&o.pend>0) s.pres+=o.pend; return o;})
    .sort((a,b)=>String(a.fdev).localeCompare(String(b.fdev))||String(a.doc).localeCompare(String(b.doc)));
  S.stock=Object.values(st).map(s=>{s.cp=s.qI?s.vI/s.qI:0; s.valor=Math.max(0,s.saldo)*s.cp;
    s.estado=(!s.ent&&!s.sal&&!s.min)?"Sin movimiento":s.saldo<=0?"Sin stock":(s.min>0&&s.saldo<=s.min?"Bajo m\u00ednimo":"Normal"); return s;})
    .sort((a,b)=>a.desc.localeCompare(b.desc,"es"));
  S.byCod=Object.fromEntries(S.stock.map(s=>[U(s.codigo),s]));
  // solicitudes agrupadas por documento
  const SD={};
  S.sol.forEach(x=>{const o=SD[x.DOC]||(SD[x.DOC]={doc:x.DOC,h:x,items:[],pedido:0,atendido:0,vales:[]});
    o.items.push(x); o.pedido+=x.CANT; o.atendido+=x.ATENDIDO;
    str(x.DOC_SAL).split(/\s+/).filter(Boolean).forEach(v=>{if(!o.vales.includes(v))o.vales.push(v);});});
  S.sols=Object.values(SD).map(o=>{const e=o.items.map(i=>i.ESTADO);
    o.estado=e.every(x=>SOL_CERR.includes(x))&&e.includes("CERRADA")?"CERRADA":e.every(x=>x==="RECHAZADA")?"RECHAZADA":e.every(x=>x==="ANULADA")?"ANULADA":e.every(x=>x==="ENTREGADA")?"ENTREGADA":o.atendido>0?"PARCIAL":
      e.includes("APROBADA")?"APROBADA":e.includes("VISTA")?"VISTA":"ENVIADA";
    o.abierta=!SOL_CERR.includes(o.estado);
    const rc=o.items.find(i=>i.RECOJO_FECHA); o.recojo=rc?{fecha:rc.RECOJO_FECHA,turno:rc.RECOJO_TURNO,hora:rc.RECOJO_HORA,lim:rc.RECOJO_LIMITE||rc.RECOJO_FECHA}:null;
    o.vencido=!!(o.abierta&&o.recojo&&o.recojo.lim<today()&&pendientesSol(o).length); return o;})
    .sort((a,b)=>String(b.h.FECHA).localeCompare(String(a.h.FECHA))||String(b.doc).localeCompare(String(a.doc)));
  // lo pedido y aun no entregado reserva saldo de la orden (misma regla del servidor)
  S.res={}; S.sol.forEach(x=>{ if(SOL_CERR.includes(x.ESTADO)) return;
    const f=x.CANT-x.ATENDIDO; if(f<=0) return; const k=solKey(x); S.res[k]=(S.res[k]||0)+f;});
  S.resL=reservaPorLote();
  // vida util y saldos dormidos por orden
  const mm={}; S.mat.forEach(m=>mm[U(m.CODIGO)]=m); const hoy2=today();
  S.lotList.forEach(l=>{ l.vida=vidaLote(l,mm[U(l.CODIGO)]); l.libre=l.SALDO-N(S.resL[l.ID]);
    l.dorm=l.AREA&&l.libre>0?dias(String(l.ULT).slice(0,10),hoy2):0; if(l.dorm<DIAS_DORM) l.dorm=0; });
  const D={};
  (S.movAll||S.mov).forEach(x=>{const o=D[x.DOC]||(D[x.DOC]={doc:x.DOC,tipo:x.TIPO,fecha:x.FECHA,h:x,items:[],total:0}); o.items.push(x); o.total+=N(x.TOTAL);});
  S.docs=Object.values(D).sort((a,b)=>String(b.fecha).localeCompare(String(a.fecha))||N(b.h.ID)-N(a.h.ID));
  S.docMap=Object.fromEntries(S.docs.map(d=>[d.doc,d]));
}
function matFind(q){q=U(q); if(!q) return null; return S.stock.find(s=>U(s.desc)===q||U(s.codigo)===q)||null;}
var entAct=t=>S.ent.filter(e=>e.TIPO===t&&e.ACTIVO!=="NO").map(e=>e.NOMBRE).sort((a,b)=>a.localeCompare(b,"es"));
var areas=()=>uniq(entAct("AREA").concat(S.mov.map(x=>x.AREA)));

/* ---------- render ---------- */
function render(){
  compute();
  const st=S.stock, pend=S.loans.filter(l=>l.pend>0), ven=pend.filter(l=>l.estado==="Vencido");
  $("#tMat").textContent=st.filter(s=>s.saldo>0).length; $("#tVal").textContent="S/ "+new Intl.NumberFormat("es-PE",{maximumFractionDigits:0}).format(sum(st,s=>s.valor));
  $("#tMin").textContent=st.filter(s=>s.estado==="Bajo m\u00ednimo").length; $("#tSin").textContent=st.filter(s=>s.estado==="Sin stock").length;
  $("#tPre").textContent=pend.length; $("#tVen").textContent=ven.length;
  $("#tVid").textContent=S.lotList.filter(l=>l.vida).length; $("#tDor").textContent=S.lotList.filter(l=>l.dorm).length;
  $("#navVen").hidden=!ven.length; $("#navVen").textContent=ven.length;
  const pri=(a,t)=>a.length?short(a[0],34)+(a.length>1?" y "+(a.length-1)+" m\u00e1s":""):t, lv=S.lotList.filter(l=>l.vida), ld=S.lotList.filter(l=>l.dorm);
  $("#fMat").textContent=`de ${st.length} materiales registrados`; $("#fVal").textContent="Saldo a costo promedio";
  $("#fMin").textContent=pri(st.filter(s=>s.estado==="Bajo m\u00ednimo").map(s=>s.desc),"Todo sobre el m\u00ednimo");
  $("#fSin").textContent=pri(st.filter(s=>s.estado==="Sin stock").map(s=>s.desc),"Nada agotado");
  $("#fPre").textContent=pend.length?soles0(sum(pend,l=>l.pend*l.pu))+" fuera del almac\u00e9n":"Nada prestado";
  $("#fVen").textContent=ven.length?"Pedir la devoluci\u00f3n hoy":"Ninguno vencido";
  $("#fVid").textContent=pri(lv.slice().sort((a,b)=>a.vida.dias-b.vida.dias).map(l=>l.DESCRIPCION),"Nada por vencer");
  $("#fDor").textContent=ld.length?soles0(sum(ld,l=>l.libre*l.PU))+" detenido":"Todo con movimiento";
  $("#sub").textContent=`${S.mat.length} materiales \u00b7 ${S.docs.length} documentos \u00b7 ${S.lotList.filter(l=>l.SALDO>0).length} \u00f3rdenes con saldo \u00b7 al ${fdate(today())}`;
  $("#wNom").textContent=S.ses.nombre; $("#wIni").textContent=String(S.ses.nombre||"?").split(/\s+/).filter(Boolean).slice(0,2).map(w=>w[0]).join("").toUpperCase(); $("#quick").hidden=!canWrite(); $("#wRol").textContent=(S.ses.rolNombre||"")+(esArea()?" \u00b7 "+S.ses.area:"");
  $("#actions").hidden=!canWrite(); $("#btnMat").hidden=!canWrite(); $("#btnVidaSug").hidden=!isAdmin(); avisoBtn(); respBtn(); $("#btnEtq").hidden=esArea(); $("#btnEtqL").hidden=esArea(); $("#btnEnt").hidden=!canWrite(); $$("[data-tab]").forEach(n=>n.hidden=!puedeVer(n.dataset.tab)); const nAt=puedeVer("dash")?filasAtencion().length:0; $("#btnBell").hidden=!puedeVer("dash"); $("#bellN").hidden=!nAt; $("#bellN").textContent=nAt>99?"99+":nAt; $$(".nav .grp").forEach(g=>{let n=g.nextElementSibling,vis=false;while(n&&!n.classList.contains("grp")){if(!n.hidden)vis=true;n=n.nextElementSibling;}g.hidden=!vis;});

  const cats=uniq(S.mat.map(m=>m.CATEGORIA)), ars=areas();
  ["#qStCat","#qMatCat","#rStCat","#rInvCat"].forEach(s=>keepSel($(s),opts(cats,"Todas las categor\u00edas")));
  ["#qOrcArea","#rOrcArea","#rMovArea","#qSolArea","#rSolArea","#rReqArea","#rVidArea","#rDorArea"].forEach(s=>keepSel($(s),opts(ars,"Todas las \u00e1reas")));
  fillSolSelects();
  const porAtender=S.sols.filter(o=>o.abierta).length;
  $("#navSol").hidden=!porAtender; $("#navSol").textContent=porAtender; $("#bnSol").hidden=!porAtender; $("#bnSol").textContent=porAtender;
  $("#navSolT").textContent=esArea()?"Mis solicitudes":"Solicitudes";
  TIT.mov=$("#navMovT").textContent=esArea()?"Ingresos de material":"Movimientos"; $("#bnMovT").textContent=esArea()?"Ingresos":"Movimientos"; $("#qMovT").value=esArea()?"INGRESO":$("#qMovT").value; $("#qMovT").disabled=esArea(); $("#qMovMiaBox").hidden=!esArea(); $("#thMovTot").hidden=esArea();
  $("#btnSol").hidden=!puedePedir(); $("#btnImp").hidden=!puedePedir(); $("#sAreaBox").hidden=esArea(); $("#iAreaBox").hidden=esArea();
  if(esArea()){ const q=$("#qOrcArea"); q.innerHTML=opts([S.ses.area]); q.value=S.ses.area; q.disabled=true; }
  keepSel($("#rCtrCon"),opts(uniq(S.mov.filter(x=>["SALIDA","PRESTAMO","DEVOLUCION","INTERNAMIENTO"].includes(x.TIPO)).map(x=>x.CONTRATISTA)),"Todos los contratistas")); optsCont();
  ["#qPreCon","#rPreCon"].forEach(s=>keepSel($(s),opts(uniq(pend.map(l=>l.con)),"Todos los receptores")));
  keepSel($("#rObr"),opts(uniq(S.loans.filter(l=>l.aut).flatMap(l=>[l.para,l.de])).sort(),"Todas las obras / etapas"));
  $("#dlMat").innerHTML=st.map(s=>`<option value="${esc(s.desc)}">${esc(s.codigo)} \u00b7 ${esc(s.und)} \u00b7 saldo ${fmt(s.saldo)}</option>`).join("");
  setDl("dlUso",uniq(S.mov.map(x=>x.USO))); setDl("dlSol",uniq(S.mov.map(x=>x.SOLICITANTE)));
  setDl("dlCat",cats); dlUnidades(); setDl("dlDoc",S.docs.map(d=>d.doc));
  renderStock(); renderOrc(); renderSol(); renderMov(); renderPres(); renderKdx(); renderMat(); renderEnt(); renderUsr(); renderDash();
}
var empty=(n,m)=>`<tr><td colspan="${n}" class="empty">${esc(m)}</td></tr>`;
function filtStock(q,cat,e){return S.stock.filter(s=>(!q||U(s.desc+" "+s.codigo).includes(q))&&(!cat||s.cat===cat)&&(e==="con"?s.estado!=="Sin movimiento":!e||s.estado===e));}
function renderStock(){
  const r=filtStock(U($("#qStock").value),$("#qStCat").value,$("#qSt").value);
  $("#tbStock").innerHTML=!r.length?empty(11,S.mov.length?"Ning\u00fan material coincide con el filtro.":"A\u00fan no hay movimientos. Registra una nota de ingreso para empezar."):
    r.map(s=>{const c=stCls[s.estado];return `<tr class="${c==="bad"||c==="warn"?"st-"+c:""}"><td>${esc(s.desc)}<div class="code">${esc(s.codigo)}${s.ubi?" \u00b7 "+esc(s.ubi):""}</div></td><td>${esc(s.cat)}</td><td>${esc(s.und)}</td>
    <td class="num">${fmt(s.ent)}</td><td class="num">${fmt(s.sal)}</td><td class="num">${s.pres?`<span class="pill warn">${fmt(s.pres)}</span>`:"\u2013"}</td><td class="num"><span class="big">${fmt(s.saldo)}</span>${kgDe(s.codigo,s.saldo)?`<div class="code">${kgDe(s.codigo,s.saldo)}</div>`:""}</td>
    <td class="num">${s.min?fmt(s.min):"\u2013"}</td><td><span class="pill ${c}">${s.estado}</span></td><td class="num">${s.cp?mf.format(s.cp):"\u2013"}</td><td class="num">${mf.format(s.valor)}</td></tr>`;}).join("");
}
function filtOrc(q,a,e){if(esArea())a=S.ses.area;return S.lotList.filter(o=>(e==="abiertas"?o.SALDO>0:e==="dorm"?o.dorm>0:e==="venc"?!!o.vida:e==="general"?esGeneral(o)&&o.SALDO>0:e==="incompl"?!!(o.OC&&o.OC.total-o.OC.llego>1e-9):!e||o.estado===e)&&(!a||U(o.AREA)===a)&&(!q||U([o.ORC,o.DOC,o.PROVEEDOR,o.DESCRIPCION,o.CODIGO,o.REQ,o.GUIA,o.AREA].join(" ")).includes(q)));}
function renderOrc(){
  const r=filtOrc(U($("#qOrc").value),$("#qOrcArea").value,$("#qOrcSt").value);
  $("#tbOrc").innerHTML=!r.length?empty(9,S.lotList.length?"Ninguna orden coincide con el filtro.":"A\u00fan no hay ingresos registrados."):
    r.map(o=>`<tr class="${o.vida&&o.vida.estado==="Vencido"?"st-bad":o.vida||o.dorm?"st-warn":""}"><td><b>${esc(o.ORC||"(sin orden)")}</b>${o.REQ?`<div class="code">${esc(o.REQ)}</div>`:""}</td><td>${o.AREA?esc(o.AREA):o.EX_LOTE?`<span class="pill info">Stock general</span><div class="code">ex ${esc(o.EX_AREA||o.EX_REQ||"")} \u00b7 ${esc(o.LIB_DOC)}</div>`:'<span class="note">\u2014</span>'}</td><td class="code">${esc(o.DOC)}<div>${fdate(o.FECHA)}${o.GUIA?" \u00b7 GR "+esc(o.GUIA):""}</div></td><td>${esc(o.PROVEEDOR)}</td>
    <td>${esc(o.DESCRIPCION)}<div class="code">${esc(o.CODIGO)} \u00b7 ${esc(o.UND)} \u00b7 P.U. ${mf.format(o.PU)}</div></td><td class="num">${fmt(o.ING)}${o.COMPRA?`<div class="code">${esc(o.COMPRA.replace(/ \(.*/,""))}</div>`:""}${ocLote(o)?`<div class="code ${o.OC.total-o.OC.llego>1e-9?"neg":""}">${esc(ocLote(o))}</div>`:""}</td><td class="num">${fmt(o.USADO)}</td><td class="num"><span class="big">${fmt(o.SALDO)}</span></td><td><span class="pill ${orCls[o.estado]}">${o.estado}</span>${prestadoA(o)}${alertasLote(o,true)}${puedeLiberar(o)?`<div style="margin-top:6px"><button class="btn sm" data-lib="${esc(o.ID)}">A stock general</button></div>`:""}${!esArea()&&conEtiqueta(o)&&o.SALDO>0?`<div style="margin-top:6px"><button class="btn sm" data-etq="${esc(o.ID)}">Etiqueta QR</button></div>`:""}</td></tr>`).join("");
}
// lo que esta orden tiene prestado a otras obras / etapas (sigue siendo suyo: vuelve con la devolucion)
function prestadoA(o){ const g={}; S.loans.filter(l=>l.aut&&l.pend>0&&l.lote===o.ID).forEach(l=>g[l.para]=(g[l.para]||0)+l.pend);
  return Object.entries(g).map(([ob,q])=>`<div style="margin-top:6px"><span class="pill warn">Prestado a ${esc(ob)}: ${fmt(q)}</span></div>`).join(""); }
function alertasLote(o,enCelda){ const a=[]; if(o.vida) a.push(`<span class="pill ${vidaCls[o.vida.estado]}">${esc(o.vida.estado)}</span><div class="code">${esc(vidaTxt(o.vida))}</div>`);
  if(o.dorm) a.push(`<span class="pill warn">Sin movimiento</span><div class="code">${o.dorm} d\u00edas sin salidas</div>`); return a.length?(enCelda?'<div style="margin-top:6px">'+a.join("")+"</div>":a.join("")):enCelda?"":'<span class="note">\u2014</span>'; }
var puedeLiberar=o=>canWrite()&&o.SALDO>0&&!esGeneral(o)&&o.libre>0;
function abrirLib(id){ const o=S.lots[id]; if(!o) return; S.lib=o;
  $("#lInfo").innerHTML=`<b>${esc(o.DESCRIPCION)}</b><div class="code">${esc(o.CODIGO)} \u00b7 ORC ${esc(o.ORC||"s/n")}${o.REQ?" \u00b7 "+esc(o.REQ):""} \u00b7 ${esc(o.AREA||"sin \u00e1rea")} \u00b7 ingres\u00f3 el ${fdate(o.FECHA)}</div>
    <div class="code">Saldo ${fmt(o.SALDO)} ${esc(o.UND)}${o.SALDO>o.libre?` \u00b7 ${fmt(o.SALDO-o.libre)} pedidos en solicitudes abiertas`:""} \u00b7 se puede pasar: <b>${fmt(o.libre)}</b>${o.dorm?` \u00b7 ${o.dorm} d\u00edas sin salidas`:""}</div>`;
  $("#lCant").value=o.libre; $("#lUnd").textContent=o.UND; $("#lMot").value=o.dorm?`Sin movimiento hace ${o.dorm} d\u00edas`:""; $("#lErr").textContent="";
  $("#pLib").hidden=false; $("#lMot").focus(); }
$("#lSave").onclick=async()=>{ const o=S.lib, q=Number($("#lCant").value), mot=$("#lMot").value.trim(), err=$("#lErr"); err.textContent="";
  if(!(q>0)){err.textContent="La cantidad debe ser mayor que cero.";return;}
  if(q>o.libre+1e-9){err.textContent=`Solo se pueden pasar ${fmt(o.libre)} ${o.UND}.`;return;}
  if(noEntero(q,o.UND)){err.textContent=`${o.UND} se cuenta en enteros.`;return;}
  if(!mot){err.textContent="Escribe el motivo (queda en el documento y en el correo al \u00e1rea).";return;}
  $("#lSave").disabled=true;
  try{ const d=await api("pasarAStockGeneral",[{lote:o.ID,cant:q}],mot); await cargar(); $("#pLib").hidden=true; toast(`${d}: ${fmt(q)} ${o.UND} de ${o.DESCRIPCION} pasaron a stock general.`); }
  catch(x){ err.textContent="No se pudo registrar: "+msg(x); }
  $("#lSave").disabled=false; };
$("#tbOrc").addEventListener("click",e=>{const b=e.target.closest("[data-lib]"); if(b) abrirLib(b.dataset.lib); const t=e.target.closest("[data-etq]"); if(t) imprimirEtiquetas("Etiqueta de orden",[etqLote(S.lots[t.dataset.etq])]);});
function resumenItems(items){const n=items.length;return esc(items.slice(0,2).map(x=>`${x.DESCRIPCION} (${fmt(Math.abs(N(x.CANT)))})`).join(", "))+(n>2?` <span class="note">y ${n-2} m\u00e1s</span>`:"");}
function filtSol(q,ar,e,de,a){return S.sols.filter(o=>(e==="abiertas"?o.abierta:e==="venc"?o.vencido:!e||o.estado===e)&&(!ar||o.h.AREA===ar)&&(!de||o.h.FECHA>=de)&&(!a||o.h.FECHA<=a)&&
  (!q||U([o.doc,o.h.NRO_AREA,o.h.AREA,o.h.SOLICITANTE,o.h.RESPONSABLE,o.h.RECEPTOR,o.h.MOTIVO,o.h.OBRA,o.h.LOTES_OBRA,o.h.MZ,o.h.USO,o.vales.join(" "),...o.items.map(i=>i.DESCRIPCION+" "+i.CODIGO)].join(" ")).includes(q)));}
function renderSol(){
  const ab=S.sols.filter(o=>o.abierta);
  $("#sP").textContent=S.sols.filter(o=>["ENVIADA","VISTA"].includes(o.estado)).length; $("#sPa").textContent=S.sols.filter(o=>["APROBADA","PARCIAL"].includes(o.estado)).length;
  $("#sA").textContent=uniq(ab.map(o=>o.h.AREA)).length; $("#sI").textContent=sum(ab,o=>o.items.filter(i=>i.CANT>i.ATENDIDO).length);
  const r=filtSol(U($("#qSol").value),$("#qSolArea").value,$("#qSolSt").value,$("#qSolDe").value,$("#qSolA").value);
  $("#tbSol").innerHTML=!r.length?empty(10,S.sols.length?"Ninguna solicitud coincide con el filtro.":"A\u00fan no hay solicitudes registradas."):
    r.map(o=>{const h=o.h, mia=U(h.USUARIO)===U(S.ses.usuario);
      return `<tr class="${["ENVIADA"].includes(o.estado)&&canWrite()?"st-warn":""}"><td><b class="code" style="color:var(--ink)">${esc(o.doc)}</b>${h.NRO_AREA?`<div class="code"><b>${esc(h.NRO_AREA)}</b> del \u00e1rea</div>`:""}<div class="code">${fdate(h.FECHA)}</div></td>
      <td>${esc(h.AREA)}<div class="code">${esc(h.SOLICITANTE)}${h.RECEPTOR?" \u00b7 "+esc(h.RECEPTOR):""}</div></td>
      <td>${h.PRESTAMO==="SI"?'<span class="pill warn">Pr\u00e9stamo</span> ':""}${esc(h.MOTIVO)}${h.USO?`<div class="code">${esc(h.USO)}</div>`:""}</td>
      <td class="note">${esc([h.LOTES_OBRA&&"Lote "+h.LOTES_OBRA,h.MZ&&"Mz "+h.MZ,h.METRADO].filter(Boolean).join(" \u00b7 "))}</td>
      <td class="num">${o.items.length}</td><td class="num">${fmt(o.pedido)}</td><td class="num">${fmt(o.atendido)}</td>
      <td><span class="pill ${solCls[o.estado]}">${solTxt[o.estado]}</span>${o.recojo&&o.abierta?`<div class="code ${o.vencido?"neg":""}">${o.vencido?"Recojo vencido":"Recoger"} ${esc(recTxt(o.recojo))}</div>`:""}</td>
      <td class="code">${o.vales.map(v=>`<div>${esc(v)} <span class="note">${fdate((S.docMap[v]||{}).fecha)}</span></div>`).join("")||'<span class="note">\u2014</span>'}</td>
      <td class="bar">${canWrite()&&o.abierta?`<button class="btn sm primary" data-ate="${esc(o.doc)}">Revisar</button>`:`<button class="btn sm" data-ate="${esc(o.doc)}">Ver</button>`}
      ${["ENVIADA","VISTA"].includes(o.estado)&&(mia||isAdmin())?`<button class="btn sm" data-anu="${esc(o.doc)}">Anular</button>`:""}
      <button class="btn sm" data-psol="${esc(o.doc)}">Imprimir</button></td></tr>`;}).join("");
}
["#qSol","#qSolArea","#qSolSt","#qSolDe","#qSolA"].forEach(x=>$(x).addEventListener("input",renderSol));
$("#tbSol").addEventListener("click",async e=>{
  const a=e.target.closest("[data-ate]"); if(a){abrirAte(a.dataset.ate);return;}
  const p=e.target.closest("[data-psol]"); if(p){printSol(p.dataset.psol);return;}
  const n=e.target.closest("[data-anu]"); if(!n) return;
  if(!confirm(`\u00bfAnular la solicitud ${n.dataset.anu}?`)) return;
  try{ await api("anularSolicitud",n.dataset.anu); toast("Solicitud anulada."); await cargar(); }catch(x){ toast("No se pudo anular: "+msg(x)); } });

/* ---------- nueva solicitud ---------- */
function abrirSol(){ if(!libreModal("pSol")) return;
  S.s={cart:[]};
  ["#sNro","#sMot","#sMet","#sLotes","#sMz","#sUso","#sObs","#sMat","#sCant","#sResp","#sCont"].forEach(x=>$(x).value=""); fillSolSelects();
  $("#sFecha").value=today(); $("#sErr").textContent=""; $("#sSaveErr").textContent=""; $("#sInfo").textContent="";
  if(esArea()){ $("#sArea").innerHTML=opts([S.ses.area]); $("#sArea").value=S.ses.area; }
  $("#sResp").value=S.ses.nombre||""; $("#sPres").checked=false; $("#sFdev").value=addDays(today(),7); presUI();
  $("#sForm").hidden=false; $("#sDone").hidden=true; $("#sSave").disabled=false;
  prepSolLote(); renderSolCart(); $("#pSol").hidden=false; $("#pSol").scrollTop=0; $("#sMot").focus({preventScroll:true});
}
$("#btnSol").onclick=abrirSol;
var areaSol=()=>esArea()?S.ses.area:U($("#sArea").value);
/* De donde sale cada linea (misma regla del servidor):
   REQ|req|codigo = cualquier orden de ese requerimiento; MAT|codigo = stock general; id de lote = solicitudes antiguas */
function solKey(x){const r=U(x.REQ),c=U(x.CODIGO); if(r&&r!=="STOCK") return "REQ|"+r+"|"+c;
  if(!r&&x.LOTE){const l=S.lots[x.LOTE]; if(!l) return x.LOTE; return l.AREA&&U(l.REQ)&&U(l.REQ)!=="STOCK"?"REQ|"+U(l.REQ)+"|"+c:"MAT|"+c;}
  return "MAT|"+c;}
var reqKey=(req,cod)=>solKey({REQ:req||"STOCK",CODIGO:cod});
var porFecha=(a,b)=>String(a.FECHA).localeCompare(String(b.FECHA))||(N(a.ID)-N(b.ID))||String(a.ID).localeCompare(String(b.ID));
function poolSol(k){ if(S.lots[k]) return [S.lots[k]]; const p=k.split("|");
  return S.lotList.filter(l=>p[0]==="REQ"?U(l.REQ)===p[1]&&U(l.AREA)&&U(l.CODIGO)===p[2]:!U(l.AREA)&&U(l.CODIGO)===p[1]).sort(porFecha);}
function reservaPorLote(){const r={}, ks=Object.keys(S.res);
  ks.filter(k=>S.lots[k]).forEach(k=>r[k]=(r[k]||0)+S.res[k]);
  ks.filter(k=>!S.lots[k]).forEach(k=>{let q=S.res[k]; poolSol(k).forEach(l=>{const u=Math.min(Math.max(l.SALDO-(r[l.ID]||0),0),q); if(u>0){r[l.ID]=(r[l.ID]||0)+u; q-=u;}});});
  return r;}
// cuanto se puede pedir todavia de una clave: saldo de sus ordenes menos lo ya solicitado y pendiente
function dispKey(k){const pool=poolSol(k); let t=sum(pool,l=>Math.max(l.SALDO,0));
  if(k.indexOf("MAT|")===0){const c=k.slice(4); t+=Math.max(0,((S.byCod[c]||{}).saldo||0)-sum(S.lotsMat[c]||[],l=>Math.max(l.SALDO,0)));}
  return t-(S.lots[k]?0:sum(pool,l=>N(S.res[l.ID])))-N(S.res[k]);}
var orcsDe=k=>uniq(poolSol(k).filter(l=>l.SALDO>0).map(l=>l.ORC||"s/n"));
// requerimientos de un material que el area puede pedir (los de su area primero) + stock general
function reqsPedibles(cod,area){const g={};
  (S.lotsMat[U(cod)]||[]).forEach(l=>{const r=U(l.REQ); if(!r||r==="STOCK"||!U(l.AREA)) return; (g[r]=g[r]||[]).push(l);});   // sin area = stock general
  return Object.keys(g).map(r=>{const ls=g[r], suya=ls.some(l=>U(l.AREA)===area), otra=ls.find(l=>U(l.AREA)&&U(l.AREA)!==area);
      return {req:r,area:ls[0].AREA,suya,ajena:!!otra&&!suya,k:reqKey(r,cod)};})
    .filter(o=>!(esArea()&&o.ajena)).sort((x,y)=>(y.suya-x.suya)||x.req.localeCompare(y.req));}
// prestamo pedido por el area: material de otra area u obra/etapa (lo de su misma obra o area no es prestamo)
var solPres=()=>$("#sPres").checked;
function presUI(){ $("#sFdevBox").hidden=!solPres(); $("#sLoteL").textContent=solPres()?"De d\u00f3nde (stock general u otra \u00e1rea / etapa)":"De qu\u00e9 requerimiento (REQ)"; }
$("#sPres").addEventListener("change",()=>{ S.s.cart=[]; presUI(); prepSolLote(); renderSolCart(); });
$("#sObra").addEventListener("change",()=>{ if(solPres()){ S.s.cart=[]; prepSolLote(); renderSolCart(); } });
function reqsPres(cod,area){ const g={}, ob=U($("#sObra").value);
  (S.lotsMat[U(cod)]||[]).forEach(l=>{const r=U(l.REQ); if(!r||r==="STOCK"||!U(l.AREA)) return; (g[r]=g[r]||[]).push(l);});
  return Object.keys(g).filter(r=>!g[r].every(l=>ob?U(l.OBRA)===ob:U(l.AREA)===area))
    .map(r=>({req:r,area:uniq(g[r].map(l=>l.AREA)).join(", "),obra:uniq(g[r].map(l=>l.OBRA).filter(Boolean)).join(", "),k:reqKey(r,cod)})).sort((x,y)=>x.req.localeCompare(y.req)); }
var reqTxt=r=>!r||U(r)==="STOCK"?"Stock general":r;
var enSolCart=(k,skip)=>S.s.cart.reduce((t,x,i)=>t+(i!==skip&&reqKey(x.req,x.codigo)===k?N(x.cant):0),0);
var dispSol=(k,skip)=>dispKey(k)-enSolCart(k,skip);
function prepSolLote(){
  const m=matFind($("#sMat").value), box=$("#sLoteBox"), sel=$("#sLote");
  box.hidden=!m; if(!m){sel.innerHTML="";return;}
  const gk=reqKey("STOCK",m.codigo), dg=dispSol(gk);
  if(solPres()){ const rp=reqsPres(m.codigo,areaSol()).filter(o=>dispSol(o.k)>0);
    sel.innerHTML=`<option value="STOCK">Stock general (sin deuda) \u00b7 quedan ${fmt(Math.max(0,dg))} ${esc(m.und)}</option>`+rp.map(o=>`<option value="${esc(o.req)}">Pr\u00e9stamo de ${esc(o.obra||o.area)} \u00b7 ${esc(o.req)}${o.obra?" \u00b7 "+esc(o.area):""} \u00b7 quedan ${fmt(dispSol(o.k))} ${esc(m.und)}</option>`).join("");
    if(!rp.length) $("#sInfo").textContent+=" \u00b7 Ninguna otra \u00e1rea / etapa tiene saldo de este material.";
    return; }
  const rs=reqsPedibles(m.codigo,areaSol()).filter(o=>dispSol(o.k)>0);
  sel.innerHTML=rs.map(o=>`<option value="${esc(o.req)}">${esc(o.req)}${o.area?" \u00b7 "+esc(o.area):""} \u00b7 quedan ${fmt(dispSol(o.k))} ${esc(m.und)} \u00b7 ORC ${esc(orcsDe(o.k).join(", "))}</option>`).join("")
    +`<option value="STOCK">Stock general \u00b7 quedan ${fmt(Math.max(0,dg))} ${esc(m.und)}</option>`;
}
$("#sMat").addEventListener("input",()=>{const m=matFind($("#sMat").value); $("#sErr").textContent="";
  $("#sInfo").textContent=m?`${m.codigo} \u00b7 ${m.und} \u00b7 stock general ${fmt(m.saldo)}`:""; prepSolLote();});
$("#sArea").addEventListener("change",prepSolLote);
$("#sAdd").onclick=()=>{
  const m=matFind($("#sMat").value), q=Number($("#sCant").value), err=$("#sErr"), req=$("#sLote").value||"STOCK";
  if(!m){err.textContent="Elige un material de la lista.";return;}
  if(!(q>0)){err.textContent="La cantidad debe ser mayor que cero.";return;}
  if(noEntero(q,m.und)){err.textContent=`${m.und} se cuenta en enteros: no se aceptan decimales.`;return;}
  const k=reqKey(req,m.codigo); if(q>dispSol(k)){err.textContent=`De ${reqTxt(req)} solo quedan ${fmt(Math.max(0,dispSol(k)))} ${m.und} sin comprometer.`;return;}
  S.s.cart.push({codigo:m.codigo,desc:m.desc,und:m.und,cant:q,req});
  ["#sMat","#sCant"].forEach(x=>$(x).value=""); err.textContent=""; $("#sInfo").textContent=""; prepSolLote(); renderSolCart(); $("#sMat").focus();
};
$("#sCant").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();$("#sAdd").click();}});
function renderSolCart(){
  const c=S.s.cart;
  $("#sItems").innerHTML=c.length?c.map((x,i)=>{const k=reqKey(x.req,x.codigo);
    return `<tr><td>${esc(reqTxt(x.req))}</td><td class="code">${esc(U(x.req)==="STOCK"?"ALMAC\u00c9N":orcsDe(k).join(", ")||"\u2014")}</td><td>${esc(x.desc)}<div class="code">${esc(x.codigo)}</div></td><td>${esc(x.und)}</td>
    <td class="num">${fmt(Math.max(0,dispSol(k,i)))}</td>
    <td class="num"><input class="qty" type="number" min="0" step="any" value="${x.cant}" data-sq="${i}" aria-label="Cantidad"></td>
    <td><button class="btn sm" data-srm="${i}">Quitar</button></td></tr>`;}).join(""):empty(7,"Agrega materiales con el buscador de arriba.");
  $("#sTot").textContent=String(c.length);
}
$("#sItems").addEventListener("change",e=>{const i=e.target.dataset.sq; if(i!=null){S.s.cart[i].cant=Number(e.target.value)||0; setTimeout(renderSolCart);}});
$("#sItems").addEventListener("click",e=>{const b=e.target.closest("[data-srm]"); if(b){S.s.cart.splice(+b.dataset.srm,1);renderSolCart();}});
$("#sSave").onclick=async()=>{
  const err=$("#sSaveErr"); err.textContent=""; const c=S.s.cart;
  if(!c.length){err.textContent="Agrega al menos un material.";return;}
  if(!$("#sMot").value.trim()){err.textContent="Escribe el motivo de la solicitud.";return;}
  if(solPres()&&!$("#sFdev").value){err.textContent="Indica la fecha en que se devolver\u00e1 el pr\u00e9stamo.";return;}
  for(const [i,x] of c.entries()){
    if(!(x.cant>0)){err.textContent=`Cantidad no v\u00e1lida en ${x.desc}.`;return;}
    if(noEntero(x.cant,x.und)){err.textContent=`${x.desc}: ${x.und} solo acepta enteros.`;return;}
    const k=reqKey(x.req,x.codigo); if(x.cant>dispSol(k,i)){err.textContent=`De ${x.desc} en ${reqTxt(x.req)} solo quedan ${fmt(Math.max(0,dispSol(k,i)))}.`;return;} }
  const cab=cabSol(), rep=nroRepetido(cab.nroArea,cab.area);
  if(rep){err.textContent=`La solicitud ${cab.nroArea} de ${cab.area} ya est\u00e1 registrada como ${rep}.`;return;}
  $("#sSave").disabled=true; $("#sSave").textContent="Enviando\u2026";
  try{ const doc=await api("registrarSolicitud",cab,c.map(x=>({codigo:x.codigo,cant:x.cant,req:x.req||"STOCK"})));
    await cargar(); S.s.done=doc; $("#sForm").hidden=true; $("#sDone").hidden=false; $("#sDoneN").textContent=doc;
    $("#sDoneTxt").textContent=`${c.length} material${c.length>1?"es":""} \u00b7 ${cab.motivo}. Almac\u00e9n ya fue avisado.`;
  }catch(x){ err.textContent="No se pudo enviar: "+msg(x); }
  $("#sSave").disabled=false; $("#sSave").textContent="Enviar solicitud";
};
$("#sPrint").onclick=()=>printSol(S.s.done);
function cabSol(){const v=x=>$(x).value.trim();
  return {fecha:v("#sFecha")||today(),nroArea:v("#sNro"),area:areaSol(),receptor:v("#sRec"),responsable:v("#sResp"),obra:v("#sObra"),contrato:v("#sCont"),motivo:v("#sMot"),
    metrado:v("#sMet"),lotes:v("#sLotes"),mz:v("#sMz"),uso:v("#sUso"),obs:v("#sObs"),prestamo:solPres(),fechaDev:solPres()?$("#sFdev").value:""};}
var nroRepetido=(nro,area)=>{nro=U(nro);if(!nro)return "";const o=S.sols.find(x=>x.h.NRO_AREA===nro&&x.h.AREA===U(area)&&x.estado!=="ANULADA");return o?o.doc:"";};
$("#sPrev").onclick=()=>{ if(!S.s.cart.length){$("#sSaveErr").textContent="Agrega al menos un material para ver la vista previa.";return;}
  printSolData(solBorrador(cabSol(),S.s.cart),true); };

/* ---------- revisar / atender solicitud ---------- */
var hora=t=>{const m=/^(\d{4}-\d\d-\d\d)(?:[ T](\d\d:\d\d))?/.exec(t||"");return m?fdate(m[1])+(m[2]?" "+m[2]:""):"";};
function lineaTiempo(o){const h=o.h, e=o.estado;
  const pasos=[["Enviada",hora(h.REGISTRADO)||fdate(h.FECHA),h.SOLICITANTE+(h.ORIGEN==="IMPORTADA"?" \u00b7 importada":"")],
    ["Vista por almac\u00e9n",hora(h.VISTA_EN),h.VISTA_POR],["Aprobada",hora(h.APROBADA_EN),h.APROBADA_POR]];
  if(o.recojo) pasos.push(["Recojo",recTxt(o.recojo),o.vencido?"VENCIDO":""]);
  o.vales.forEach(v=>pasos.push(["Vale "+v,fdate((S.docMap[v]||{}).fecha),""]));
  if(SOL_CERR.includes(e)) pasos.push([solTxt[e],hora(h.CERRADA_EN),h.CERRADA_POR+(e==="RECHAZADA"&&h.OBS?" \u00b7 "+h.OBS:"")]);
  return pasos;}
function abrirAte(doc){ if($("#pAte").dataset.min&&S.a&&U(S.a.doc)===U(doc)){ restaurar("pAte"); return; } if(!libreModal("pAte")) return;
  const o=S.sols.find(x=>U(x.doc)===U(doc)); if(!o){toast("No se encontr\u00f3 la solicitud.");return;}
  if(canWrite()&&o.abierta&&!o.h.VISTA_EN) api("marcarVista",o.doc).then(r=>{if(r)cargar().then(()=>{if(!$("#pAte").hidden&&S.a&&S.a.doc===o.doc)abrirAte(o.doc);});}).catch(()=>{});
  const h=o.h, act=canWrite()&&o.abierta;
  o.items.forEach(x=>delete x._dar); S.a={doc:o.doc,o,items:o.items,act};
  $("#aTit").textContent=`Solicitud ${o.doc}`+(h.NRO_AREA?` \u00b7 ${h.NRO_AREA} del \u00e1rea`:"")+` \u00b7 ${solTxt[o.estado]}`;
  $("#aLinea").innerHTML=lineaTiempo(o).map(p=>`<span class="${p[1]||/^Vale/.test(p[0])?(/Rechazada|Anulada|Cerrada/.test(p[0])||p[2]==="VENCIDO"?"no":"on"):""}"><b>${esc(p[0])}</b>${esc(p[1]||"\u2014")}${p[2]?" \u00b7 "+esc(p[2]):""}</span>`).join("");
  $("#aAutBox").hidden=!(act&&h.PRESTAMO==="SI"); $("#aAut").value="";
  $("#aHead").innerHTML=[["Tipo",h.PRESTAMO==="SI"?"PR\u00c9STAMO \u00b7 devolver el "+fdate(h.FECHA_DEV):""],["\u00c1rea",h.AREA],["N\u00b0 del \u00e1rea",h.NRO_AREA],["Receptor",h.RECEPTOR||"(sin receptor: el\u00edgelo antes de entregar)"],["Contrato",h.CONTRATO],["Responsable",h.RESPONSABLE],["Obra / proyecto",h.OBRA],
    ["Motivo",h.MOTIVO],["\u00c1rea intervenida",h.METRADO],["Lote / Mz",[h.LOTES_OBRA,h.MZ&&"Mz "+h.MZ].filter(Boolean).join(" \u00b7 ")],["Uso / partida",h.USO],["Fecha",fdate(h.FECHA)],["Recojo",o.recojo?recTxt(o.recojo)+(o.vencido?" (vencido)":""):""]]
    .filter(x=>x[1]).map(x=>`<div class="fld"><span>${esc(x[0])}</span><b style="font-size:.9rem;color:var(--ink);text-transform:none">${esc(x[1])}</b></div>`).join("");
  $("#aObs").value=""; $("#aErr").textContent="";
  const rc=o.recojo; $("#aRecBox").hidden=!act;
  $("#aRecF").value=rc?rc.fecha:addDays(today(),1); $("#aRecH").value=rc&&rc.hora?rc.hora:""; $("#aRecT").value=rc&&rc.turno?rc.turno:"MA\u00d1ANA"; $("#aRecD").value=rc?Math.max(0,dias(rc.fecha,rc.lim)):3;
  $("#aRepro").hidden=!act||!h.APROBADA_EN; $("#aCerr").hidden=!act||!(o.atendido>0||h.APROBADA_EN); $("#aWsp").hidden=!rc||!o.abierta;
  $("#aApr").hidden=!act||!!h.APROBADA_EN; $("#aSave").hidden=!act; $("#aRech").hidden=!act||o.atendido>0; $("#aObsBox").hidden=!act; $("#aNota").hidden=!act;
  $("#aItemsT").textContent=act?"Qu\u00e9 se entrega ahora":"Materiales"; $("#aColDar").textContent=act?"Entregar":"Estado";
  renderAte(); $("#pAte").hidden=false; $("#pAte").scrollTop=0;
}
// ordenes con saldo para un material, primero las del area que pide
function ordenesPara(cod,area){return (S.lotsMat[U(cod)]||[]).filter(l=>l.SALDO>0).sort((x,y)=>(U(y.AREA)===area)-(U(x.AREA)===area)||String(x.FECHA).localeCompare(String(y.FECHA)));}
// de que ordenes puede salir una linea: las de su REQ (la mas antigua primero); stock general = ordenes sin area
function ordenesLinea(x){const k=solKey(x);
  if(S.lots[k]) return [S.lots[k]];
  let os=poolSol(k).filter(l=>l.SALDO>0);
  if(!os.length&&k.indexOf("MAT|")===0) os=(S.lotsMat[U(x.CODIGO)]||[]).filter(l=>l.SALDO>0).sort(porFecha);
  return os;}
// ORC de lo ya entregado (por los vales de la solicitud)
var orcsEntregadas=x=>uniq(S.mov.filter(m=>U(m.CODIGO)===U(x.CODIGO)&&str(x.DOC_SAL).split(/\s+/).includes(m.DOC)).map(m=>m.ORC||"s/n"));
// reparte lo que falta entre las ordenes, la mas antigua primero
function repartir(x,os,falta){const d={}; let r=falta; os.forEach(l=>{const u=Math.min(Math.max(l.SALDO,0),r); d[l.ID]=u; r-=u;}); return d;}
var darLinea=x=>sum(Object.values(x._dar||{}),v=>v);
function renderAte(){
  const a=S.a;
  $("#aItems").innerHTML=a.items.map((x,i)=>{const falta=Math.max(0,x.CANT-x.ATENDIDO), abierta=a.act&&falta>0&&!SOL_CERR.includes(x.ESTADO), k=solKey(x);
    const req=S.lots[k]?(S.lots[k].REQ||"sin REQ"):reqTxt(x.REQ), os=ordenesLinea(x), disp=sum(os,l=>Math.max(l.SALDO,0))||(os.length?0:((S.byCod[U(x.CODIGO)]||{}).saldo||0));
    let orden=`<b>${esc(req)}</b>`, dar;
    if(!abierta){ const oe=orcsEntregadas(x); orden+=`<div class="code">${oe.length?"Sali\u00f3 de ORC "+esc(oe.join(", ")):(S.lots[k]?"ORC "+esc(S.lots[k].ORC||"s/n"):"")}</div>`;
      dar=`<span class="pill ${solCls[x.ESTADO]||"mute"}">${solTxt[x.ESTADO]||x.ESTADO}</span>`; }
    else if(!os.length){ if(!x._dar) x._dar={"":Math.min(falta,Math.max(0,disp))};
      dar=`<input class="qty" type="number" min="0" step="any" value="${x._dar[""]}" data-ad="${i}" data-lot="" aria-label="Entregar">`; }
    else { if(!x._dar) x._dar=repartir(x,os,falta);
      orden+=os.map(l=>`<div class="split"><span class="code">${l.IM?"Internamiento "+esc(l.DOC):"ORC "+esc(l.ORC||"s/n")}${l.AREA&&U(x.REQ)==="STOCK"?" \u00b7 "+esc(l.AREA):""} \u00b7 ${fdate(String(l.FECHA).slice(0,10))} \u00b7 quedan ${fmt(l.SALDO)}</span>
        <input class="qty" type="number" min="0" step="any" value="${N(x._dar[l.ID])}" data-ad="${i}" data-lot="${esc(l.ID)}" aria-label="Entregar de la ORC ${esc(l.ORC||"s/n")}"></div>`).join("")
        +(os.length>1?`<div class="note">Se reparti\u00f3 desde la orden m\u00e1s antigua; puedes cambiarlo.</div>`:"");
      dar=`<b data-adt="${i}">${fmt(darLinea(x))}</b>`; }
    const poco=abierta&&disp<falta;
    return `<tr class="${poco?"st-warn":""}"><td>${orden}</td><td>${esc(x.DESCRIPCION)}<div class="code">${esc(x.CODIGO)}</div>${abierta&&retazoAviso(x.CODIGO)?`<div class="warnmsg code">${esc(retazoAviso(x.CODIGO))}</div>`:""}</td><td>${esc(x.UND)}</td>
    <td class="num">${fmt(x.CANT)}</td><td class="num">${fmt(x.ATENDIDO)}</td><td class="num ${poco?"neg":""}">${fmt(disp)}</td>
    <td class="num">${dar}</td></tr>`;}).join("")||empty(7,"Sin materiales.");
}
$("#aItems").addEventListener("input",e=>{const d=e.target.dataset; if(d.ad==null) return; S.a.tocado=true; const x=S.a.items[+d.ad];
  x._dar[d.lot]=Number(e.target.value)||0; const t=$(`#aItems [data-adt="${d.ad}"]`); if(t) t.textContent=fmt(darLinea(x));});
/* ventana de confirmacion: nada se registra hasta pulsar "Si, confirmar" */
function confirmar(titulo,html,ok){ return new Promise(res=>{ const p=$("#pConf");
  $("#cfTit").textContent=titulo; $("#cfBody").innerHTML=html; $("#cfOk").textContent=ok||"S\u00ed, confirmar";
  const fin=v=>{ p.hidden=true; $("#cfOk").onclick=$("#cfNo").onclick=$("#cfX").onclick=null; res(v); };
  $("#cfOk").onclick=()=>fin(true); $("#cfNo").onclick=$("#cfX").onclick=()=>fin(false); S.cfFin=fin;
  p.hidden=false; $("#cfOk").focus(); }); }
function recojoResumen(rc){ if(!rc.fecha) return "<b>Sin fecha de recojo.</b> El \u00e1rea sabr\u00e1 que est\u00e1 aprobada, pero no cu\u00e1ndo recoger.";
  const lim=rc.dias>0?addDays(rc.fecha,rc.dias):"";
  return `Recoger el <b>${DSEM[new Date(rc.fecha+"T12:00:00").getDay()].toLowerCase()} ${fdate(rc.fecha)}</b>${rc.hora?` a las <b>${esc(rc.hora)}</b>`:""}${rc.turno?` (${esc(rc.turno.toLowerCase())})`:""}${lim?`, a m\u00e1s tardar el ${fdate(lim)}`:""}.`; }
function cabAte(o){const h=(o&&o.h)||{}; return `<div class="cf-cab"><b>${esc(S.a.doc)}</b>${h.NRO_AREA?" \u00b7 "+esc(h.NRO_AREA):""} \u00b7 ${esc(h.AREA)}<br>Recoge: <b>${esc(h.RECEPTOR||"(sin receptor)")}</b></div>`;}
$("#aApr").onclick=async()=>{ $("#aErr").textContent="";
  const rc0=recojoForm(), o0=S.a.o;
  if(!await confirmar(`\u00bfAprobar la solicitud ${S.a.doc}?`,cabAte(o0)+`<p>${recojoResumen(rc0)}</p><p class="note">Se avisar\u00e1 al \u00e1rea por correo y el material quedar\u00e1 separado.</p>`,"S\u00ed, aprobar")) return;
  $("#aApr").disabled=true;
  try{ const rc=recojoForm(); await api("aprobarSolicitud",S.a.doc,rc); toast(`Solicitud ${S.a.doc} aprobada`+(rc.fecha?`: recoger el ${fdate(rc.fecha)}`:"")+". Se avis\u00f3 al \u00e1rea."); await cargar(); abrirAte(S.a.doc); }
  catch(x){ $("#aErr").textContent="No se pudo aprobar: "+msg(x); }
  $("#aApr").disabled=false; };
$("#aSave").onclick=async()=>{
  const err=$("#aErr"); err.textContent="";
  if(!S.a.o.h.RECEPTOR){err.textContent="La solicitud no indica a qui\u00e9n se entrega. Pide al \u00e1rea el receptor o an\u00falala y reg\u00edstrala de nuevo.";return;}
  const dar=[], porLote={};
  for(const x of S.a.items){ if(!x._dar) continue; const falta=x.CANT-x.ATENDIDO, t=darLinea(x);
    if(Object.values(x._dar).some(v=>v<0)){err.textContent=`Cantidad no v\u00e1lida en ${x.DESCRIPCION}.`;return;}
    if(t>falta+1e-9){err.textContent=`De ${x.DESCRIPCION} solo quedan ${fmt(falta)} por entregar.`;return;}
    for(const [lot,q] of Object.entries(x._dar)){ if(!(q>0)) continue;
      if(noEntero(q,x.UND)){err.textContent=`${x.DESCRIPCION}: ${x.UND} solo acepta enteros.`;return;}
      const l=S.lots[lot]; porLote[lot||"MAT|"+x.CODIGO]=(porLote[lot||"MAT|"+x.CODIGO]||0)+q;
      if(l&&porLote[lot]>l.SALDO+1e-9){err.textContent=`La ORC ${l.ORC||"s/n"} de ${x.DESCRIPCION} solo tiene ${fmt(l.SALDO)}.`;return;}
      if(!l&&q>((S.byCod[U(x.CODIGO)]||{}).saldo||0)){err.textContent=`Stock insuficiente de ${x.DESCRIPCION}.`;return;}
      dar.push({id:x.ID,cant:q,lote:lot}); } }
  if(!dar.length){err.textContent="Indica cu\u00e1nto se entrega.";return;}
  if(S.a.o.h.PRESTAMO==="SI"&&dar.some(d=>S.lots[d.lote]&&!esGeneral(S.lots[d.lote]))&&!$("#aAut").value.trim()){err.textContent="Es un pr\u00e9stamo: escribe qui\u00e9n lo autoriz\u00f3.";return;}
  { const ab=S.a.items.filter(x=>x._dar&&x.CANT-x.ATENDIDO>0), li=x=>`<li>${esc(x.DESCRIPCION)}: <b>${fmt(darLinea(x))}</b> de ${fmt(x.CANT-x.ATENDIDO)} ${esc(x.UND)}</li>`;
    const comp=ab.filter(x=>darLinea(x)>=x.CANT-x.ATENDIDO-1e-9), parte=ab.filter(x=>darLinea(x)>0&&darLinea(x)<x.CANT-x.ATENDIDO-1e-9), nada=ab.filter(x=>!(darLinea(x)>0));
    const html=cabAte(S.a.o)+
      (comp.length?`<details class="cf-g ok"><summary><b>${comp.length} \u00edtem${comp.length>1?"s":""} completo${comp.length>1?"s":""}</b> \u00b7 ver lista</summary><ul>${comp.map(li).join("")}</ul></details>`:"")+
      (parte.length?`<div class="cf-g warn"><b>${parte.length} en parte</b><ul>${parte.map(li).join("")}</ul></div>`:"")+
      (nada.length?`<div class="cf-g bad"><b>${nada.length} no se lleva${nada.length>1?"n":""} hoy</b><ul>${nada.map(li).join("")}</ul></div>`:"")+
      (parte.length||nada.length?`<p class="note">Lo que no se lleva queda pendiente en la solicitud.</p>`:"");
    if(!await confirmar(`\u00bfEntregar a ${S.a.o.h.RECEPTOR}?`,html,"S\u00ed, generar vale")) return; }
  $("#aSave").disabled=true; $("#aSave").textContent="Generando\u2026";
  try{ const vale=await api("atenderSolicitud",S.a.doc,dar,$("#aObs").value.trim(),$("#aAut").value.trim()); await cargar();
    $("#pAte").hidden=true; toast(`${/ /.test(vale)?"Vales":"Vale"} ${vale} generado${/ /.test(vale)?"s":""}.`); printDoc(vale.split(" ")[0]);
  }catch(x){ err.textContent="No se pudo generar el vale: "+msg(x); }
  $("#aSave").disabled=false; $("#aSave").textContent="Generar vale de salida";
};
$("#aRech").onclick=async()=>{
  const m=prompt(`\u00bfPor qu\u00e9 se rechaza la solicitud ${S.a.doc}?`); if(m==null) return;
  if(!m.trim()){toast("Escribe el motivo del rechazo.");return;}
  try{ await api("rechazarSolicitud",S.a.doc,m.trim()); $("#pAte").hidden=true; toast("Solicitud rechazada. Se avis\u00f3 al \u00e1rea."); await cargar(); }
  catch(x){ $("#aErr").textContent="No se pudo rechazar: "+msg(x); } };
$("#aPrint").onclick=()=>printSol(S.a.doc);
var recojoForm=()=>({fecha:$("#aRecF").value,hora:$("#aRecH").value,turno:$("#aRecT").value,dias:N($("#aRecD").value)});
$("#aRecH").addEventListener("input",()=>{const v=$("#aRecH").value; if(v) $("#aRecT").value=v<"13:00"?"MA\u00d1ANA":"TARDE";});
$("#aRepro").onclick=async()=>{ $("#aErr").textContent=""; const rc=recojoForm(); if(!rc.fecha){$("#aErr").textContent="Indica la nueva fecha de recojo.";return;}
  if(!await confirmar(`\u00bfReprogramar el recojo de ${S.a.doc}?`,cabAte(S.a.o)+`<p>Nueva fecha: ${recojoResumen(rc)}</p><p class="note">Se avisar\u00e1 al \u00e1rea por correo.</p>`,"S\u00ed, reprogramar")) return;
  try{ await api("reprogramarRecojo",S.a.doc,rc); toast(`Recojo de ${S.a.doc} reprogramado para el ${fdate(rc.fecha)}. Se avis\u00f3 al \u00e1rea.`); await cargar(); abrirAte(S.a.doc); }
  catch(x){ $("#aErr").textContent="No se pudo reprogramar: "+msg(x); } };
$("#aCerr").onclick=async()=>{
  const m=prompt(`Lo que falta entregar de ${S.a.doc} se da por terminado y el material separado queda libre. \u00bfPor qu\u00e9? (ej. no recogi\u00f3 en el plazo)`); if(m==null) return;
  if(!m.trim()){toast("Escribe el motivo.");return;}
  try{ await api("cerrarSolicitud",S.a.doc,m.trim()); $("#pAte").hidden=true; toast(`Pendiente de ${S.a.doc} cerrado. Se avis\u00f3 al \u00e1rea.`); await cargar(); }
  catch(x){ $("#aErr").textContent="No se pudo cerrar: "+msg(x); } };
$("#aWsp").onclick=()=>{ const o=S.sols.find(x=>x.doc===S.a.doc); if(o) window.open(wspUrl(textoRecojo([o])),"_blank"); };

/* ---------- cronograma de recojo ---------- */
var recTxt=r=>r?`${fdate(r.fecha)}${r.hora?" a las "+r.hora:""}${r.turno?" ("+r.turno.toLowerCase()+")":""}${r.lim&&r.lim!==r.fecha?", hasta el "+fdate(r.lim):""}`:"";
function pendientesSol(o){return o.items.filter(i=>!SOL_CERR.includes(i.ESTADO)&&i.CANT>i.ATENDIDO);}
var wspUrl=t=>["https:","","wa.me",""].join("/")+"?text="+encodeURIComponent(t);
function textoRecojo(list){
  return list.map(o=>{const h=o.h;
    return `*Recojo de material ${o.doc}${h.NRO_AREA?" ("+h.NRO_AREA+")":""}*\n\u00c1rea: ${h.AREA}\nRecoge: ${h.RECEPTOR||"-"}\nFecha: ${recTxt(o.recojo)||"por confirmar"}${o.vencido?" (VENCIDO)":""}\n`+
      pendientesSol(o).map(i=>`- ${i.DESCRIPCION}: ${fmt(i.CANT-i.ATENDIDO)} ${i.UND}`).join("\n");}).join("\n\n")+"\n\nAlmac\u00e9n";}
/* agenda semanal: quien viene, cuando y por que solicitud (los materiales estan en la solicitud) */
var DSEM=["Dom","Lun","Mar","Mi\u00e9","Jue","Vie","S\u00e1b"];
var lunes=iso=>addDays(iso,-((new Date(iso+"T12:00:00").getDay()+6)%7));
var diaTxt=f=>DSEM[new Date(f+"T12:00:00").getDay()]+" "+fdate(f).slice(0,5);
var horaTxt=r=>r.hora||(r.turno==="MA\u00d1ANA"?"Ma\u00f1ana":r.turno==="TARDE"?"Tarde":"Todo el d\u00eda");
var horaOrd=r=>r.hora||(r.turno==="MA\u00d1ANA"?"08:00":r.turno==="TARDE"?"13:00":"07:00");
function recEst(o){ if(o.estado==="ENTREGADA") return ["Recogido","ok"]; if(!o.abierta) return [solTxt[o.estado]||o.estado,"mute"];
  if(o.vencido) return ["Vencido","bad"]; if(o.recojo.fecha===today()) return ["Hoy","warn"]; if(o.recojo.fecha<today()) return ["En plazo","warn"]; return ["Programado","info"]; }
var faltanTxt=o=>{const n=pendientesSol(o).length; return o.estado==="ENTREGADA"?"todo entregado":n+" \u00edtem"+(n===1?"":"s")+" por recoger";};
function semanaRec(){ const ini=S.recWk||lunes(today()), c=$("#rcCon").value, a=$("#rcArea").value;
  const base=S.sols.filter(o=>o.recojo&&!["ANULADA","RECHAZADA","CERRADA"].includes(o.estado)&&(!c||o.h.RECEPTOR===c)&&(!a||o.h.AREA===a));
  const ord=(x,y)=>horaOrd(x.recojo).localeCompare(horaOrd(y.recojo))||x.doc.localeCompare(y.doc), dias=[];
  for(let i=0;i<7;i++){const f=addDays(ini,i); dias.push({f,items:base.filter(o=>o.recojo.fecha===f&&!o.vencido).sort(ord)});}
  if(!dias[6].items.length) dias.pop();
  const venc=base.filter(o=>o.vencido).sort((x,y)=>x.recojo.fecha.localeCompare(y.recojo.fecha)||ord(x,y));
  return {ini,fin:dias[dias.length-1].f,dias,venc,filtro:[c,a].filter(Boolean).join(" \u00b7 ")};}
function cardRec(o){const e=recEst(o);
  return `<button type="button" class="ag-card ${e[1]}" data-ate="${esc(o.doc)}"><div class="ag-t"><span>${esc(horaTxt(o.recojo))}</span><span class="pill ag-p ${e[1]}">${esc(e[0])}</span></div>
    <div class="ag-who">${esc(o.h.RECEPTOR||"(sin receptor)")}</div><div class="code">${esc(o.doc)}${o.h.NRO_AREA?" \u00b7 "+esc(o.h.NRO_AREA):""}</div>
    <div class="note">${esc(o.h.AREA)} \u00b7 ${esc(faltanTxt(o))}</div>${o.vencido?`<div class="code neg">deb\u00eda venir el ${fdate(o.recojo.fecha)}</div>`:""}</button>`;}
function renderRec(){ const w=semanaRec(), hoy=today();
  $("#rcTit").textContent=`Semana del ${fdate(w.ini)} al ${fdate(w.fin)}`;
  $("#rcVenc").innerHTML=w.venc.length?`<div class="ag-venc"><div class="ag-h"><span>Vencidos \u00b7 no recogieron</span><span>${w.venc.length}</span></div><div class="ag-venc-list">${w.venc.map(cardRec).join("")}</div></div>`:"";
  const cols=w.dias.map(d=>`<div class="ag-col ${d.f===hoy?"hoy":""} ${d.items.length?"":"vacio"}"><div class="ag-h"><span>${diaTxt(d.f)}${d.f===hoy?" \u00b7 hoy":""}</span><span>${d.items.length||""}</span></div>${d.items.map(cardRec).join("")||'<div class="ag-empty">Sin recojos</div>'}</div>`);
  if(!w.dias.some(d=>d.items.length)) cols.push('<div class="ag-empty" style="grid-column:1/-1">No hay recojos programados esta semana.</div>');
  $("#rcAgenda").style.setProperty("--n",w.dias.length); $("#rcAgenda").innerHTML=cols.join("");}
$("#rcVenc").addEventListener("click",e=>{const a=e.target.closest("[data-ate]"); if(a){$("#pRec").hidden=true; abrirAte(a.dataset.ate);}});
$("#btnRec").onclick=()=>{ S.recWk=lunes(today()); const con=S.sols.filter(o=>o.recojo);
  keepSel($("#rcCon"),opts(uniq(con.map(o=>o.h.RECEPTOR)),"Todos los contratistas")); keepSel($("#rcArea"),opts(uniq(con.map(o=>o.h.AREA)),"Todas las \u00e1reas"));
  renderRec(); $("#pRec").hidden=false; };
$("#rcPrev").onclick=()=>{S.recWk=addDays(S.recWk,-7);renderRec();}; $("#rcSig").onclick=()=>{S.recWk=addDays(S.recWk,7);renderRec();}; $("#rcHoy").onclick=()=>{S.recWk=lunes(today());renderRec();};
["#rcCon","#rcArea"].forEach(x=>$(x).addEventListener("input",renderRec));
$("#rcAgenda").addEventListener("click",e=>{const a=e.target.closest("[data-ate]"); if(a){$("#pRec").hidden=true; abrirAte(a.dataset.ate);}});
var lineaRec=o=>`${horaTxt(o.recojo)} \u00b7 ${o.h.RECEPTOR||"-"} \u00b7 ${o.doc}${o.h.NRO_AREA?" ("+o.h.NRO_AREA+")":""} \u00b7 ${o.h.AREA}`;
function textoSemana(w){ const L=["*Cronograma de recojo de almac\u00e9n*",`Semana del ${fdate(w.ini)} al ${fdate(w.fin)}`];
  if(w.venc.length) L.push("","*VENCIDOS (no recogieron)*",...w.venc.map(o=>fdate(o.recojo.fecha).slice(0,5)+" \u00b7 "+lineaRec(o)));
  w.dias.forEach(d=>{const it=d.items.filter(o=>o.abierta); if(it.length) L.push("",`*${diaTxt(d.f)}*`,...it.map(lineaRec));});
  if(L.length===2) L.push("","No hay recojos programados.");
  return L.join("\n");}
$("#rcWsp").onclick=()=>window.open(wspUrl(textoSemana(semanaRec())),"_blank");
$("#rcPrint").onclick=()=>{ const w=semanaRec(), filas=[], fila=(f,o)=>[f,horaTxt(o.recojo),o.h.RECEPTOR,o.doc+(o.h.NRO_AREA?" ("+o.h.NRO_AREA+")":""),o.h.AREA,faltanTxt(o),recEst(o)[0]];
  w.venc.forEach(o=>filas.push(fila(fdate(o.recojo.fecha),o))); w.dias.forEach(d=>d.items.forEach(o=>filas.push(fila(diaTxt(d.f),o))));
  imprimir({titulo:"Cronograma de recojo",vertical:true,filtro:`Semana del ${fdate(w.ini)} al ${fdate(w.fin)}${w.filtro?" \u00b7 "+w.filtro:""}`,
    cabeza:[["D\u00eda"],["Hora"],["Contratista"],["Solicitud"],["\u00c1rea"],["Por recoger"],["Estado"]],filas,
    nota:"El detalle de materiales est\u00e1 en cada solicitud. Pasado el plazo, almac\u00e9n puede liberar el material separado.",firmas:["Jefe de almac\u00e9n"]}); };
/* imagen de la semana para WhatsApp (se dibuja aqui mismo, sin librerias) */
function rr(x,a,b,w,h,r){x.beginPath();x.moveTo(a+r,b);x.arcTo(a+w,b,a+w,b+h,r);x.arcTo(a+w,b+h,a,b+h,r);x.arcTo(a,b+h,a,b,r);x.arcTo(a,b,a+w,b,r);x.closePath();}
function imagenSemana(w){
  const g=[]; if(w.venc.length) g.push({t:"VENCIDOS \u00b7 no recogieron",c:"#b42318",list:w.venc});
  w.dias.forEach(d=>{ if(d.items.length) g.push({t:diaTxt(d.f).toUpperCase()+(d.f===today()?" \u00b7 HOY":""),c:d.f===today()?"#b54708":"#0f2a43",list:d.items}); });
  const W=1080,P=40,RH=96,HH=58; let H=96+30; g.forEach(x=>H+=HH+x.list.length*(RH+10)+12); if(!g.length) H+=90; H+=56;
  const cv=document.createElement("canvas"); cv.width=W; cv.height=H; const x=cv.getContext("2d"), F="Arial, Helvetica, sans-serif";
  const col={ok:"#067647",warn:"#b54708",bad:"#b42318",info:"#1f5f8b",mute:"#98a2b3"};
  const corta=(t,max)=>{t=String(t||""); if(x.measureText(t).width<=max) return t; while(t.length>1&&x.measureText(t+"\u2026").width>max) t=t.slice(0,-1); return t+"\u2026";};
  x.fillStyle="#eef1f4"; x.fillRect(0,0,W,H); x.fillStyle="#0f2a43"; x.fillRect(0,0,W,96);
  x.fillStyle="#fff"; x.font="bold 34px "+F; x.fillText("Cronograma de recojo",P,48); x.font="22px "+F; x.fillText(`Semana del ${fdate(w.ini)} al ${fdate(w.fin)}${w.filtro?" \u00b7 "+w.filtro:""}`,P,80);
  let y=96+20;
  g.forEach(gr=>{ x.fillStyle=gr.c; x.font="bold 26px "+F; x.fillText(gr.t,P,y+38); y+=HH;
    gr.list.forEach(o=>{ const e=recEst(o), c=col[e[1]], et=e[0].toUpperCase();
      x.fillStyle="#fff"; rr(x,P,y,W-2*P,RH,12); x.fill(); x.fillStyle=c; rr(x,P,y,10,RH,5); x.fill();
      x.font="bold 20px "+F; const tw=x.measureText(et).width+28, px=W-P-tw-18;
      x.fillStyle=c; rr(x,px,y+16,tw,34,17); x.fill(); x.fillStyle="#fff"; x.fillText(et,px+14,y+40);
      x.fillStyle="#111"; x.font="bold 28px "+F; x.fillText(horaTxt(o.recojo),P+28,y+44);
      x.font="bold 28px "+F; x.fillText(corta(o.h.RECEPTOR||"(sin receptor)",px-P-230),P+220,y+44);
      x.fillStyle="#555"; x.font="22px "+F; x.fillText(corta(`${o.doc}${o.h.NRO_AREA?" ("+o.h.NRO_AREA+")":""} \u00b7 ${o.h.AREA} \u00b7 ${faltanTxt(o)}`,W-2*P-240),P+220,y+80);
      y+=RH+10; }); y+=12; });
  if(!g.length){ x.fillStyle="#555"; x.font="24px "+F; x.fillText("No hay recojos programados esta semana.",P,y+44); }
  x.fillStyle="#777"; x.font="18px "+F; x.fillText(`Almac\u00e9n \u00b7 actualizado el ${fdate(today())} a las ${new Date().toTimeString().slice(0,5)}`,P,H-22);
  return cv;}
function verImagen(cv,nombre){ const url=cv.toDataURL("image/png"), v=window.open("","_blank");
  if(!v){toast("Permite las ventanas emergentes para ver la imagen.");return;}
  v.document.write(`<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cronograma de recojo</title>
    <style>body{margin:0;background:#e9edf1;font:15px Arial,sans-serif;color:#222}p{margin:12px 16px;line-height:1.5}img{display:block;max-width:100%;margin:0 auto 16px;box-shadow:0 2px 10px rgba(0,0,0,.2)}a{color:#1f5f8b;font-weight:bold}</style></head>
    <body><p>En la PC: clic derecho sobre la imagen, <b>Copiar imagen</b>, y p\u00e9gala en WhatsApp Web con Ctrl+V. En el celular: mant\u00e9n presionada la imagen para guardarla o compartirla. <a download="${nombre}" href="${url}">Descargar imagen</a></p>
    <img src="${url}" alt="Cronograma de recojo"></body></html>`);
  v.document.close();}
$("#rcImg").onclick=async()=>{ const w=semanaRec(), cv=imagenSemana(w), nombre=`recojos-${w.ini}.png`;
  if(!(navigator.canShare&&navigator.share)) return verImagen(cv,nombre);
  try{ const blob=await new Promise(ok=>cv.toBlob(ok,"image/png")), file=new File([blob],nombre,{type:"image/png"});
    if(navigator.canShare({files:[file]})){ await navigator.share({files:[file],title:"Cronograma de recojo"}); return; } }
  catch(e){ if(e&&e.name==="AbortError") return; }
  verImagen(cv,nombre); };

/* ---------- formato impreso de la solicitud (mismo orden que el E-117) ---------- */
function printSol(doc){const o=S.sols.find(x=>U(x.doc)===U(doc)); if(!o){toast("No se encontr\u00f3 la solicitud "+doc+".");return;} printSolData(o,false);}
function printSolData(o,borrador){
  const h=o.h, ent=o.atendido>0;
  imprimir({titulo:"SOLICITUD DE MATERIALES",docn:(borrador?"BORRADOR":o.doc)+(h.NRO_AREA?"  \u00b7  N\u00b0 \u00e1rea "+h.NRO_AREA:""),vertical:true,qr:borrador?"":qrLink("d",o.doc),
    info:[["N\u00b0 almac\u00e9n",borrador?"(se asigna al registrar)":o.doc],["Tipo",h.PRESTAMO==="SI"?"PR\u00c9STAMO \u00b7 devolver el "+fdate(h.FECHA_DEV):""],["N\u00b0 del \u00e1rea",h.NRO_AREA||"\u2014"],["De",h.AREA],["Para","ALMAC\u00c9N GENERAL"],["Obra / proyecto",h.OBRA],["Motivo",h.MOTIVO],
      ["\u00c1rea intervenida",h.METRADO],["Fecha",fdate(h.FECHA)],["Receptor",h.RECEPTOR],["Contrato",h.CONTRATO],["Responsable",h.RESPONSABLE||h.SOLICITANTE],
      ["Lote",h.LOTES_OBRA],["Mz",h.MZ],["Uso / partida",h.USO],["Estado",borrador?"Borrador (sin registrar)":solTxt[o.estado]],["Vale de salida",o.vales.join(", ")],["Observaci\u00f3n",h.OBS]].filter(x=>x[1]),
    cabeza:[["Item","n"],["REQ"],["ORC"],["C\u00f3digo"],["Descripci\u00f3n"],["Und"],["Cant","n"],...(ent?[["Entregado","n"]]:[])],
    filas:o.items.map((x,i)=>{const k=solKey(x), l=S.lots[k], oe=x.DOC_SAL?orcsEntregadas(x):[], gen=!l&&k.indexOf("MAT|")===0;
      const orc=oe.length?oe.join(", "):l?(l.ORC||"\u2014"):gen?"ALMAC\u00c9N GENERAL":(orcsDe(k).join(", ")||"\u2014");
      return [i+1,l?(l.REQ||"\u2014"):gen?"STOCK":U(x.REQ),orc,x.CODIGO,x.DESCRIPCION,x.UND,fmt(x.CANT),...(ent?[x.ATENDIDO?fmt(x.ATENDIDO):""]:[])];}),
    pie:["","","","","TOTAL","",fmt(o.pedido),...(ent?[fmt(o.atendido)]:[])],
    nota:borrador?"Vista previa: esta solicitud todav\u00eda no est\u00e1 registrada.":lineaTiempo(o).filter(p=>p[1]).map(p=>`${p[0]}: ${p[1]}${p[2]?" ("+p[2]+")":""}`).join(" \u00b7 "),
    firmas:["Solicitante","V\u00b0B\u00b0 Residente","Almac\u00e9n"]});
}
// arma una solicitud "en borrador" para la vista previa
function solBorrador(cab,items){
  const h={NRO_AREA:U(cab.nroArea),AREA:U(cab.area),OBRA:U(cab.obra),MOTIVO:cab.motivo,METRADO:cab.metrado,FECHA:cab.fecha,RECEPTOR:U(cab.receptor),CONTRATO:U(cab.contrato),PRESTAMO:cab.prestamo?"SI":"",FECHA_DEV:cab.fechaDev||"",RESPONSABLE:cab.responsable,
    SOLICITANTE:S.ses.nombre,LOTES_OBRA:cab.lotes,MZ:U(cab.mz),USO:U(cab.uso),OBS:cab.obs};
  const it=items.map(x=>{const m=S.byCod[U(x.codigo)]||{};return {LOTE:"",REQ:U(x.req||"STOCK"),CODIGO:x.codigo,DESCRIPCION:m.desc||x.codigo,UND:m.und||"",CANT:N(x.cant),ATENDIDO:0};});
  return {doc:"",h,items:it,pedido:sum(it,x=>x.CANT),atendido:0,vales:[],estado:"ENVIADA"};
}
/* ---------- leer el formato de solicitud del area (Excel E-117) ---------- */
// Busca las etiquetas por texto (DE:, MOTIVO:, \u2026) y la tabla por sus titulos, no por celda fija:
// si ingenieria inserta una fila o mueve una columna, la lectura sigue funcionando.
var nzx=v=>String(v??"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toUpperCase().replace(/\s+/g," ").trim();
var ETIQ=[["nro",/^(N[\u00ba\u00b0O]?\.?|NRO\.?|NUMERO)$/],["de",/^DE$/],["para",/^PARA$/],["proyecto",/PROYECTO|DIRECCION/],["motivo",/^MOTIVO$/],
  ["metrado",/^AREA( INTERVENIDA)?( \(M2\))?$|^METRADO$/],["fecha",/^FECHA$/],["receptor",/^RECEPTOR$/],["responsable",/^RESPONSABLE$/],["lotes",/^LOTES?$/],["mz",/^MZ\.?$|^MANZANA$/],
  ["contrato",/^((COD(IGO)?\.?|N[\u00ba\u00b0O]?\.?|NRO\.?|NUMERO)( DE)? )?CONTRATO$/]];
var etiq=c=>{const k=nzx(c).replace(/\s*:\s*$/,""); if(!k||k.length>24) return null; const e=ETIQ.find(x=>x[1].test(k)); return e?e[0]:null;};
var fechaIso=v=>{ if(typeof v==="number"&&v>20000&&v<80000) v=new Date(Math.round((v-25569)*864e5)+new Date().getTimezoneOffset()*6e4);
  if(v instanceof Date&&!isNaN(v)) return new Date(v-v.getTimezoneOffset()*6e4).toISOString().slice(0,10);
  const t=String(v||"").trim(), m=/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})$/.exec(t); if(m) return `${m[3].length===2?"20"+m[3]:m[3]}-${m[2].padStart(2,"0")}-${m[1].padStart(2,"0")}`;
  return /^\d{4}-\d\d-\d\d/.test(t)?t.slice(0,10):""; };
var numx=v=>{ if(typeof v==="number") return v; const t=String(v??"").trim().replace(/\s/g,""); if(!/^-?\d+([.,]\d+)?$/.test(t)) return NaN; return Number(t.replace(",",".")); };
function leerSolicitudXlsx(wb){
  const nom=wb.SheetNames.find(n=>/SOLICITUD/i.test(n))||wb.SheetNames[0], ws=wb.Sheets[nom];
  const rows=XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:"",blankrows:true});
  const hr=rows.findIndex(r=>r.some(c=>nzx(c)==="DESCRIPCION")&&r.some(c=>/^CANT/.test(nzx(c))));
  if(hr<0) throw new Error("No encontr\u00e9 la tabla de materiales: debe tener una fila de t\u00edtulos con DESCRIPCION y CANT.");
  const H=rows[hr].map(nzx), col=re=>H.findIndex(h=>re.test(h));
  const c={req:col(/^REQ/),orc:col(/^ORC|^ORDEN/),cod:col(/^COD/),des:col(/^DESCRIPCION$/),und:col(/^UND|^UNIDAD/),cant:col(/^CANT/)};
  const cab={hoja:nom};
  for(let i=0;i<hr;i++){ const r=rows[i];
    r.forEach((v,j)=>{ const k=etiq(v); if(!k||cab[k]!=null) return;
      for(let x=j+1;x<r.length;x++){ const w=r[x]; if(String(w).trim()===""||String(w).trim()===",") continue; if(etiq(w)) break; cab[k]=w; break; } }); }
  cab.fecha=fechaIso(cab.fecha);
  ["nro","de","para","proyecto","motivo","metrado","receptor","responsable","lotes","mz","contrato"].forEach(k=>cab[k]=String(cab[k]??"").replace(/\s+/g," ").trim());
  const items=[]; let i=hr+1;
  for(;i<rows.length;i++){ const r=rows[i], d=String(r[c.des]??"").trim(); if(!d) break;
    items.push({fila:i+1,req:String(c.req>=0?r[c.req]:"").trim(),orc:String(c.orc>=0?r[c.orc]:"").trim(),cod:String(c.cod>=0?r[c.cod]:"").trim(),
      desc:d.replace(/\s+/g," "),und:String(c.und>=0?r[c.und]:"").trim(),cantTxt:String(r[c.cant]??"").trim(),cant:numx(r[c.cant])}); }
  // control: el total que trae el formato al pie (primera cifra en CANT despues de la tabla)
  let total=null; for(let k=i;k<Math.min(rows.length,i+4);k++){ const t=numx(rows[k][c.cant]); if(!isNaN(t)&&String(rows[k][c.des]??"").trim()===""){total=t;break;} }
  return {cab,items,total};
}
/* ---------- importar la solicitud del area desde su Excel ---------- */
var XLSX_URL=["https:","","cdnjs.cloudflare.com","ajax","libs","xlsx","0.18.5","xlsx.full.min.js"].join("/"); // sin barras dobles: el servidor de Google las corta
function cargarXlsx(){return window.XLSX?Promise.resolve():new Promise((ok,ko)=>{const t=document.createElement("script"); t.src=XLSX_URL; t.onload=ok;
  t.onerror=()=>ko(new Error("No se pudo cargar el lector de Excel. Revisa tu conexi\u00f3n a internet e int\u00e9ntalo otra vez.")); document.head.appendChild(t);});}
// unidades escritas distinto pero iguales (GL = GALON, BLS = BOLSA\u2026)
var UNDS={UND:["UND","UNID","UNIDAD","UNIDADES","U","PZA","PIEZA","PZ"],GALON:["GALON","GALONES","GL","GLN","GAL"],BOLSA:["BOLSA","BOLSAS","BLS","BL"],KG:["KG","KGS","KILO","KILOS","KILOGRAMO"],
  M:["M","ML","MT","MTS","METRO","METROS"],CAJA:["CAJA","CAJAS","CJ","CJA"],ROLLO:["ROLLO","ROLLOS","RLL","RL"],PLANCHA:["PLANCHA","PLANCHAS","PL"],VARILLA:["VARILLA","VARILLAS","VAR"],LT:["LT","LTS","LITRO","LITROS","L"]};
var undCan=u=>{u=nzx(u).replace(/\.$/,""); if(!u) return ""; if(S.undMap&&S.undMap[u]) return S.undMap[u]; if(S.undMap&&Object.keys(S.undMap).length) return u; for(const [k,v] of Object.entries(UNDS)) if(v.includes(u)) return k; return u;};
var undIgual=(a,b)=>{a=undCan(a);b=undCan(b);return a===b||(["UND","PZA"].includes(a)&&["UND","PZA"].includes(b));};
var descKey=t=>nzx(t).replace(/["'\u00b4`]/g,"").replace(/\s*([\/xX\u00d7-])\s*/g,"$1").replace(/[^A-Z0-9\u00d1\/\u00b0.,X-]/g," ").replace(/\s+/g," ").trim();
function sugerir(desc){const k=new Set(descKey(desc).split(" ").filter(w=>w.length>1));
  return S.stock.map(m=>{const w=descKey(m.desc).split(" ").filter(x=>x.length>1), c=w.filter(x=>k.has(x)).length;return {m,p:c/Math.max(k.size,w.length,1)};})
    .filter(x=>x.p>=0.34).sort((a,b)=>b.p-a.p).slice(0,3).map(x=>x.m);}
var esStockGeneral=(req,orc)=>!req||/^STOCK$/.test(nzx(req))||/ALMACEN/.test(nzx(orc));
function prepLinea(it){
  const L={...it,incl:true,codigo:"",reqSel:"",nota:""};
  let m=it.cod&&S.byCod[U(it.cod)]; if(!m){const k=descKey(it.desc); m=S.stock.find(x=>descKey(x.desc)===k);}
  if(m){ L.codigo=m.codigo;
    const uA=undCan(it.und), uM=undCan(m.und);
    if(it.und&&!undIgual(uA,uM)){ const e=S.eq.find(q=>q.CODIGO===U(m.codigo)&&undCan(q.UND_COMPRA)===uA);
      if(e&&!isNaN(it.cant)){L.cant=Math.round(it.cant*e.FACTOR*1e6)/1e6; L.nota=`El \u00e1rea pidi\u00f3 ${fmt(it.cant)} ${it.und}: convertido a ${fmt(L.cant)} ${m.und} (1 ${e.UND_COMPRA} = ${fmt(e.FACTOR)} ${m.und}).`;}
      else L.nota=`El \u00e1rea escribi\u00f3 ${it.und} y almac\u00e9n maneja ${m.und}: revisa la cantidad.`; }
    if(!it.req&&!it.orc) L.reqSel="";        // sin REQ en el archivo: se propone al validar
    else if(esStockGeneral(it.req,it.orc)) L.reqSel="STOCK";
    else { const r=reqsPedibles(m.codigo,areaImp()).find(o=>nzx(o.req)===nzx(it.req));
      if(r) L.reqSel=r.req; else if((S.lotsMat[U(m.codigo)]||[]).some(l=>!U(l.AREA)&&nzx(l.REQ)===nzx(it.req))) L.reqSel="STOCK"; else L.reqNo=true; }
  } else L.sug=sugerir(it.desc);
  return L;
}
function areaImp(){return esArea()?S.ses.area:U(($("#iArea")||{}).value);}
function validarImp(){
  const a=areaImp(), usado={}, veces={};
  S.imp.lineas.forEach(x=>{if(x.incl&&x.codigo) veces[U(x.codigo)]=(veces[U(x.codigo)]||0)+1;});
  S.imp.lineas.forEach(x=>{ x.err=[]; x.av=[]; const m=S.byCod[U(x.codigo)];
    // sin REQ en el archivo: se propone el REQ del area con saldo, si no stock general
    if(m&&!x.reqSel){ const o=reqsPedibles(m.codigo,a).find(r=>r.suya&&dispKey(r.k)>0); x.reqSel=o?o.req:"STOCK"; }
    const k=m?reqKey(x.reqSel,m.codigo):"", libre=m?dispKey(k):0;
    x.disp=Math.max(0,libre-(usado[k]||0));
    if(!x.incl) return;
    if(!m) x.err.push("No est\u00e1 en la lista de materiales de almac\u00e9n: elige cu\u00e1l es.");
    if(isNaN(x.cant)||!(x.cant>0)) x.err.push(`Cantidad no v\u00e1lida: "${x.cantTxt||"vac\u00eda"}".`);
    else if(m&&noEntero(x.cant,m.und)) x.err.push(`${m.und} se cuenta en enteros.`);
    if(m&&x.cant>0){ if(x.disp<=0) x.err.push(U(x.reqSel)!=="STOCK"?`El ${x.reqSel} ya no tiene saldo libre de este material.`:"Sin saldo en stock general.");
      else if(x.cant>x.disp) x.err.push(`Solo hay ${fmt(x.disp)} ${m.und} disponibles.`);
      usado[k]=(usado[k]||0)+Math.min(x.cant,x.disp); }
    if(m&&U(x.reqSel)!=="STOCK"){ const r=reqsPedibles(m.codigo,a).find(o=>o.req===U(x.reqSel)); if(!r) x.err.push(`El ${x.reqSel} no es de ${a||"esta \u00e1rea"}.`); }
    if(x.nota) x.av.push(x.nota);
    if(x.reqNo) x.av.push(`No encontr\u00e9 el ${x.req} con este material: elige el REQ correcto o stock general.`);
    if(m&&veces[U(m.codigo)]>1) x.av.push("Este material est\u00e1 en m\u00e1s de una fila.");
  });
}
function prepImport(r,archivo){
  const c=r.cab; S.imp={archivo,total:r.total,cab:c,lineas:r.items.map(prepLinea)};
  fillSolSelects();
  const ars=areas(), am=ars.find(x=>claveNom(x)===claveNom(c.de));
  if(!esArea()) $("#iArea").value=am||"";
  const rec=entAct("CONTRATISTA").find(x=>claveNom(x)===claveNom(c.receptor))||parecidos("CONTRATISTA",c.receptor)[0]||"";
  $("#iRec").value=rec; const ob=entAct("OBRA").find(x=>claveNom(x)===claveNom(c.proyecto))||"";
  $("#iObra").value=ob;
  $("#iNro").value=c.nro; $("#iFecha").value=c.fecha||today(); $("#iResp").value=c.responsable; $("#iMot").value=c.motivo; $("#iMet").value=c.metrado;
  $("#iLotes").value=c.lotes; $("#iMz").value=c.mz; $("#iCont").value=U(c.contrato); $("#iObs").value=c.proyecto&&!ob?"Proyecto: "+c.proyecto:"";
  // lo que no tiene stock arranca sin incluir: se ve, pero no bloquea
  validarImp(); S.imp.lineas.forEach(x=>{ if(x.codigo&&x.disp<=0) x.incl=false; });
  $("#iPaso1").hidden=true; $("#iPaso2").hidden=false; $("#iSaveErr").textContent=""; renderImp(); $("#pImp").scrollTop=0;
}
function avisosCab(){const c=S.imp.cab, w=[];
  if(esArea()&&c.de&&claveNom(c.de)!==claveNom(S.ses.area)) w.push(`El archivo dice DE: ${c.de}, pero tu usuario es de ${S.ses.area}.`);
  if(!esArea()&&c.de&&!$("#iArea").value) w.push(`El \u00e1rea "${c.de}" no est\u00e1 en la lista: el\u00edgela o cr\u00e9ala en Contratistas y proveedores \u2192 \u00c1reas.`);
  if(c.receptor&&!$("#iRec").value) w.push(`El receptor "${c.receptor}" no est\u00e1 en la lista: cr\u00e9alo con + Nuevo o elige el correcto.`);
  else if(c.receptor&&claveNom($("#iRec").value)!==claveNom(c.receptor)) w.push(`Receptor del archivo: "${c.receptor}". Se tom\u00f3 "${$("#iRec").value}": confirma que es el mismo.`);
  const rep=nroRepetido($("#iNro").value,areaImp()); if(rep) w.push(`La solicitud ${U($("#iNro").value)} de ${areaImp()} ya fue registrada como ${rep}.`);
  return w;}
function renderImp(){
  validarImp(); const L=S.imp.lineas, inc=L.filter(x=>x.incl), suma=sum(inc.filter(x=>!isNaN(x.cant)),x=>x.cant), sumaArchivo=sum(L.filter(x=>!isNaN(x.cant)),x=>x.cant);
  const nErr=inc.filter(x=>x.err.length).length, nAv=inc.filter(x=>!x.err.length&&x.av.length).length, nOk=inc.length-nErr-nAv, nFuera=L.length-inc.length;
  const tot=S.imp.total==null?`<span>El archivo no trae total al pie</span>`:Math.abs(S.imp.total-sumaArchivo)<1e-6?`<span class="ok">Total del archivo ${fmt(S.imp.total)} = suma le\u00edda \u2713</span>`:`<span class="bad">Total del archivo ${fmt(S.imp.total)} \u2260 suma le\u00edda ${fmt(sumaArchivo)}: revisa que no falte una fila</span>`;
  $("#iRes").innerHTML=`<span>${esc(S.imp.archivo)} \u00b7 ${L.length} filas le\u00eddas</span>${tot}<span class="ok">${nOk} listas</span>${nAv?`<span class="warn">${nAv} con aviso</span>`:""}${nErr?`<span class="bad">${nErr} con error</span>`:""}${nFuera?`<span>${nFuera} no se incluir\u00e1n</span>`:""}`;
  $("#iWarn").textContent=avisosCab().join(" ");
  $("#iItems").innerHTML=L.map((x,i)=>{const m=S.byCod[U(x.codigo)], rs=m?reqsPedibles(m.codigo,areaImp()).filter(o=>dispKey(o.k)>0||o.req===x.reqSel):[];
    const nivel=!x.incl?"":x.err.length?"st-bad":x.av.length?"st-warn":"";
    const orden=!m?"\u2014":`<select data-ireq="${i}" aria-label="De qu\u00e9 requerimiento">${rs.map(o=>`<option value="${esc(o.req)}" ${o.req===x.reqSel?"selected":""}>${esc(o.req)}${o.area?" \u00b7 "+esc(o.area):""} \u00b7 libre ${fmt(Math.max(0,dispKey(o.k)))}</option>`).join("")}<option value="STOCK" ${U(x.reqSel)==="STOCK"?"selected":""}>Stock general \u00b7 libre ${fmt(Math.max(0,dispKey(reqKey("STOCK",m.codigo))))}</option></select>`;
    const rev=!x.incl?`<span class="note">No se incluir\u00e1${m&&x.disp<=0?" (sin stock)":""}</span>`:x.err.length?`<span class="pill bad">Error</span>${x.err.map(e=>`<div class="neg">${esc(e)}</div>`).join("")}`:x.av.length?`<span class="pill warn">Revisar</span>`:`<span class="pill ok">OK</span>`;
    return `<tr class="${nivel} ${x.incl?"":"excl"}"><td><input type="checkbox" data-iinc="${i}" ${x.incl?"checked":""} aria-label="Incluir fila ${x.fila}"></td><td class="code">${x.fila}</td>
    <td>${esc(x.desc)}<div class="code">${esc([x.req,x.orc].filter(Boolean).join(" \u00b7 "))} \u00b7 ${esc(x.cantTxt)} ${esc(x.und)}</div></td>
    <td><input data-imat="${i}" list="dlMat" value="${esc(m?m.desc:"")}" placeholder="Elige el material" autocomplete="off" style="min-width:210px">${m?`<div class="code">${esc(m.codigo)} \u00b7 ${esc(m.und)}</div>`:(x.sug&&x.sug.length?`<div class="code">\u00bfEs ${x.sug.map(s=>`<a href="#" data-isug="${i}" data-cod="${esc(s.codigo)}">${esc(s.desc)}</a>`).join(" o ")}?</div>`:"")}</td>
    <td>${orden}</td><td class="num">${m?fmt(x.disp):"\u2014"}</td>
    <td class="num"><input class="qty" type="number" min="0" step="any" value="${isNaN(x.cant)?"":x.cant}" data-icant="${i}" aria-label="Cantidad"></td>
    <td class="rev">${rev}${x.incl&&x.av.length?x.av.map(a=>`<div>${esc(a)}</div>`).join(""):""}${x.incl&&m&&x.disp>0&&x.cant>x.disp?`<div><button class="btn sm" data-iaj="${i}">Ajustar a ${fmt(x.disp)}</button></div>`:""}</td></tr>`;}).join("");
}
$("#btnImp").onclick=()=>{ if(!libreModal("pImp")) return; $("#iFile").value=""; $("#iErr").textContent=""; $("#iPaso1").hidden=false; $("#iPaso2").hidden=true; $("#pImp").hidden=false; cargarXlsx().catch(()=>{}); };
$("#iOtro").onclick=$("#btnImp").onclick;
async function leerArchivo(f){
  if(!f) return; const err=$("#iErr"); err.textContent="Leyendo "+f.name+"\u2026";
  try{ await cargarXlsx(); const wb=XLSX.read(await f.arrayBuffer(),{type:"array",cellDates:true}); const r=leerSolicitudXlsx(wb);
    if(!r.items.length) throw new Error("El archivo no tiene materiales debajo de la fila de t\u00edtulos.");
    err.textContent=""; prepImport(r,f.name);
  }catch(x){ err.textContent="No se pudo leer el archivo: "+msg(x); }
}
$("#iFile").addEventListener("change",e=>leerArchivo(e.target.files[0]));
["dragenter","dragover"].forEach(ev=>$("#iDrop").addEventListener(ev,e=>{e.preventDefault();$("#iDrop").classList.add("on");}));
["dragleave","drop"].forEach(ev=>$("#iDrop").addEventListener(ev,e=>{e.preventDefault();$("#iDrop").classList.remove("on");}));
$("#iDrop").addEventListener("drop",e=>leerArchivo(e.dataTransfer.files[0]));
$("#iItems").addEventListener("change",e=>{const d=e.target.dataset, L=S.imp.lineas;
  if(d.iinc!=null) L[d.iinc].incl=e.target.checked;
  if(d.icant!=null){ L[d.icant].cant=e.target.value===""?NaN:Number(e.target.value); L[d.icant].cantTxt=e.target.value; L[d.icant].nota=""; }
  if(d.ireq!=null){ L[d.ireq].reqSel=e.target.value; L[d.ireq].reqNo=false; }
  if(d.imat!=null){ const m=matFind(e.target.value), x=L[d.imat]; x.codigo=m?m.codigo:""; x.reqSel=""; x.reqNo=false; x.nota=""; if(m&&!x.incl) x.incl=true; }
  setTimeout(renderImp);});
$("#iItems").addEventListener("click",e=>{const a=e.target.closest("[data-iaj]"); if(a){const x=S.imp.lineas[a.dataset.iaj]; x.cant=x.disp; x.cantTxt=String(x.disp); renderImp(); return;}
  const s=e.target.closest("[data-isug]"); if(s){e.preventDefault(); const x=S.imp.lineas[s.dataset.isug]; x.codigo=s.dataset.cod; x.reqSel=""; x.incl=true; renderImp();}});
["#iArea","#iRec","#iNro"].forEach(x=>$(x).addEventListener("change",()=>renderImp()));
$("#iRecNew").onclick=()=>{ abrirEnt("CONTRATISTA",null,"iRec"); if(S.imp&&S.imp.cab.receptor){ $("#eNom").value=U(S.imp.cab.receptor); $("#eNom").dispatchEvent(new Event("input")); } };
$("#iRec").addEventListener("change",()=>{ if(S.imp) setTimeout(renderImp); });
function cabImp(){const v=x=>$(x).value.trim();
  return {fecha:v("#iFecha")||today(),nroArea:v("#iNro"),area:areaImp(),receptor:v("#iRec"),responsable:v("#iResp"),obra:v("#iObra"),contrato:v("#iCont"),motivo:v("#iMot"),
    metrado:v("#iMet"),lotes:v("#iLotes"),mz:v("#iMz"),uso:"",obs:v("#iObs"),origen:"IMPORTADA"};}
var itemsImp=()=>S.imp.lineas.filter(x=>x.incl).map(x=>({codigo:x.codigo,cant:x.cant,req:x.reqSel||"STOCK"}));
$("#iPrev").onclick=()=>{ const it=itemsImp().filter(x=>x.codigo); if(!it.length){$("#iSaveErr").textContent="No hay materiales incluidos para mostrar.";return;} printSolData(solBorrador(cabImp(),it),true); };
$("#iSave").onclick=async()=>{
  const err=$("#iSaveErr"); err.textContent=""; renderImp(); const cab=cabImp(), inc=S.imp.lineas.filter(x=>x.incl);
  if(!cab.area){err.textContent="Elige el \u00e1rea que solicita.";return;}
  if(!cab.motivo){err.textContent="Falta el motivo de la solicitud.";return;}
  if(!inc.length){err.textContent="No hay materiales incluidos.";return;}
  const mal=inc.filter(x=>x.err.length); if(mal.length){err.textContent=`Hay ${mal.length} fila${mal.length>1?"s":""} con error (fila ${mal.map(x=>x.fila).slice(0,6).join(", ")}${mal.length>6?"\u2026":""}). Corr\u00edgelas o desm\u00e1rcalas.`;return;}
  const rep=nroRepetido(cab.nroArea,cab.area); if(rep){err.textContent=`Esta solicitud ya fue registrada como ${rep}.`;return;}
  $("#iSave").disabled=true; $("#iSave").textContent="Registrando\u2026";
  try{ const doc=await api("registrarSolicitud",cab,itemsImp()); await cargar(); $("#pImp").hidden=true;
    toast(`Solicitud ${doc}${cab.nroArea?" ("+U(cab.nroArea)+")":""} registrada con ${inc.length} materiales.`); showTab("sol"); if(canWrite()) abrirAte(doc);
  }catch(x){ err.textContent="No se pudo registrar: "+msg(x); }
  $("#iSave").disabled=false; $("#iSave").textContent="Registrar solicitud";
};
function renderMov(){
  const q=U($("#qMov").value), t=esArea()?"INGRESO":$("#qMovT").value, de=$("#qMovDe").value, a=$("#qMovA").value, ar=esArea();
  const paraMi=d=>U(d.h.AREA)===S.ses.area||d.items.some(x=>U(x.AREA)===S.ses.area), mia=ar&&$("#qMovMia").checked;
  const r=S.docs.filter(d=>(!t||d.tipo===t)&&(!mia||paraMi(d))&&(!de||d.fecha>=de)&&(!a||d.fecha<=a)&&
    (!q||U([d.doc,d.h.PROVEEDOR,d.h.CONTRATISTA,d.h.AREA,d.h.OBRA,d.h.ORC,d.h.REQ,d.h.GUIA,d.h.USO,d.h.DOC_REF,d.h.OBS,...d.items.map(x=>x.DESCRIPCION+" "+x.CODIGO+" "+((S.lots[x.LOTE]||{}).ORC||""))].join(" ")).includes(q)));
  $("#tbMov").innerHTML=!r.length?empty(8,S.docs.length?"Ning\u00fan documento coincide con el filtro.":"A\u00fan no hay documentos registrados."):
    r.slice(0,500).map(d=>{const h=d.h,T=TIPO[d.tipo]||{};
      const ref=[h.AREA,h.OBRA,h.ORC&&"ORC "+h.ORC,h.REQ,h.DOC_REF&&"de "+h.DOC_REF,h.USO,d.tipo==="AJUSTE"?h.OBS:""].filter(Boolean).join(" \u00b7 ");
      return `<tr class="${h.ANULADO?"anul":""}"><td><b class="code" style="color:var(--ink)">${esc(d.doc)}</b>${h.ANULADO?'<div><span class="pill bad">Anulado</span></div>':h.CORREGIDO?'<div><span class="pill mute">Corregido</span></div>':""}<div class="code">${esc(h.USUARIO)}</div></td><td>${fdate(d.fecha)}</td><td><span class="pill ${T.pill||"mute"}">${esc(T.nom||d.tipo)}</span></td>
      <td>${esc(who(h))}${h.SOLICITANTE?`<div class="code">Sol.: ${esc(h.SOLICITANTE)}</div>`:""}</td><td class="note">${esc(ref)}${d.tipo==="PRESTAMO"&&h.FECHA_DEV?`<div>Devolver: ${fdate(h.FECHA_DEV)}</div>`:""}</td>
      <td>${resumenItems(d.items)}</td>${ar?(paraMi(d)?`<td><span class="pill ok">Para tu \u00e1rea</span></td>`:"<td></td>"):`<td class="num">${mf.format(d.total)}</td><td class="bar"><button class="btn sm" data-print="${esc(d.doc)}">Imprimir</button>${corregible(d)?`<button class="btn sm" data-corr="${esc(d.doc)}">Corregir</button>`:""}</td>`}</tr>`;}).join("");
}
var misLoans=()=>esArea()?S.loans.filter(l=>l.area===S.ses.area||(S.lots[l.lote]||{}).AREA===S.ses.area):S.loans;
function filtLoans(q,con,e){return misLoans().filter(l=>(e==="todos"?true:e?l.estado===e:l.pend>0)&&(!con||U(l.con)===con)&&(!q||U([l.doc,l.desc,l.codigo,l.obra,l.sol,l.area,(S.lots[l.lote]||{}).ORC].join(" ")).includes(q)));}
function venceTxt(l){if(l.estado==="Devuelto"||l.dias==null)return "";return l.dias<0?`hace ${-l.dias} d\u00eda${l.dias===-1?"":"s"}`:l.dias===0?"hoy":`en ${l.dias} d\u00eda${l.dias===1?"":"s"}`;}
function renderPres(){
  const pend=misLoans().filter(l=>l.pend>0);
  $("#pN").textContent=pend.length; $("#pV").textContent=pend.filter(l=>l.estado==="Vencido").length;
  $("#pC").textContent=uniq(pend.map(l=>l.con)).length; $("#pS").textContent=money(sum(pend,l=>l.pend*l.pu));
  const r=filtLoans(U($("#qPre").value),$("#qPreCon").value,$("#qPreSt").value);
  $("#tbPre").innerHTML=!r.length?empty(10,S.loans.length?"No hay pr\u00e9stamos con este filtro.":"A\u00fan no hay pr\u00e9stamos registrados."):
    r.map(l=>{const c=prCls[l.estado], lo=S.lots[l.lote];return `<tr class="${c==="bad"?"st-bad":c==="warn"?"st-warn":""}"><td><b class="code" style="color:var(--ink)">${esc(l.doc)}</b><div class="code">${fdate(l.fecha)}</div></td>
    <td>${l.aut?`<b>Para ${esc(l.para)}</b><div class="code">recibe ${esc(l.con)} \u00b7 autoriz\u00f3 ${esc(l.aut)}</div>`:`${esc(l.con)}<div class="code">${esc([l.area,l.obra].filter(Boolean).join(" \u00b7 "))}</div>`}</td><td>${esc(l.desc)}<div class="code">${esc(l.codigo)} \u00b7 ${esc(l.und)}</div>${l.estDev&&l.estDev!=="BUENO"?`<span class="pill ${l.estDev==="MALOGRADO"?"bad":"warn"}">Volvi\u00f3 ${l.estDev.toLowerCase()}</span>`:""}</td>
    <td>${lo?`${esc("ORC "+(lo.ORC||"s/n"))}<div class="code">${esc([lo.AREA,lo.OBRA].filter(Boolean).join(" \u00b7 "))}</div>`:'<span class="note">\u2014</span>'}</td>
    <td class="num">${fmt(l.prestado)}</td><td class="num">${fmt(l.devuelto)}</td><td class="num"><span class="big">${fmt(l.pend)}</span></td>
    <td>${fdate(l.fdev)}<div class="code">${venceTxt(l)}</div></td><td><span class="pill ${c}">${l.estado}</span></td>
    <td>${l.pend>0&&canWrite()?`<button class="btn sm primary" data-dev="${esc(l.doc)}">Devolver</button>`:""}</td></tr>`;}).join("");
}
function kardexRows(s,de,a){
  let saldo=0, ini=0; const rows=[];
  S.mov.filter(x=>U(x.CODIGO)===U(s.codigo)).forEach(x=>{const e=ef(x); saldo+=e;
    if(de&&x.FECHA<de){ini=saldo;return;} if(a&&x.FECHA>a) return;
    rows.push({x,ent:e>0?e:0,sal:e<0?-e:0,saldo});});
  return {ini,rows};
}
function kOrden(x){const l=x.TIPO==="INGRESO"?{ORC:x.ORC,AREA:x.AREA}:S.lots[x.LOTE]; let t=l?lotTxt(l):""; if(x.TIPO==="LIBERACION") t+=` \u2192 stock general (${fmt(x.CANT)} ${x.UND})`; if(x.LOTE_ORIGEN) t+=` \u2190 repone desde ${lotTxt(S.lots[x.LOTE_ORIGEN])}`; return t;}
var KDX_ULT=50;
$("#tbKdx").addEventListener("click",e=>{const k=e.target.closest("[data-kmat]"); if(!k) return; e.preventDefault(); const m=S.byCod[U(k.dataset.kmat)]; if(m){$("#qKdx").value=m.desc; renderKdx();}});
function renderKdx(){
  const s=matFind($("#qKdx").value);
  if(!s){ // sin material: ultimos movimientos de todos, el mas reciente primero
    const de=$("#qKdxDe").value, a=$("#qKdxA").value, sal={}, all=[];
    S.mov.forEach(x=>{const k=U(x.CODIGO), e=ef(x); sal[k]=(sal[k]||0)+e; if((de&&x.FECHA<de)||(a&&x.FECHA>a)) return; all.push({x,ent:e>0?e:0,sal:e<0?-e:0,saldo:sal[k]});});
    const rows=all.slice(-KDX_ULT).reverse();
    $("#kdxHead").innerHTML=`<span class="note">\u00daltimos ${rows.length} movimientos de todos los materiales${de||a?" en el periodo":""}. Elige un material para ver su kardex completo.</span>`;
    $("#tbKdx").innerHTML=rows.length?rows.map(r=>{const x=r.x;return `<tr><td>${fdate(x.FECHA)}</td><td class="code">${esc(x.DOC)}</td><td><span class="pill ${TIPO[x.TIPO]?.pill||"mute"}">${esc(TIPO[x.TIPO]?.nom||x.TIPO)}</span></td>
    <td><a href="#" data-kmat="${esc(x.CODIGO)}">${esc(x.DESCRIPCION)}</a><div class="note">${esc(kOrden(x))}</div></td><td>${esc(who(x))}</td><td class="num pos">${r.ent?fmt(r.ent):""}</td><td class="num neg">${r.sal?fmt(r.sal):""}</td><td class="num"><b>${fmt(r.saldo)}</b> <span class="code">${esc(x.UND)}</span></td><td class="num">${mf.format(N(x.PU))}</td></tr>`;}).join(""):empty(9,"No hay movimientos en el periodo.");
    return;}
  const {ini,rows}=kardexRows(s,$("#qKdxDe").value,$("#qKdxA").value);
  $("#kdxHead").innerHTML=`<b>${esc(s.desc)}</b><span class="code">${esc(s.codigo)} \u00b7 ${esc(s.und)}</span><span>Saldo actual: <b>${fmt(s.saldo)}</b></span>${s.pres?`<span>Prestado: <b>${fmt(s.pres)}</b></span>`:""}<span>Costo prom.: <b>${money(s.cp)}</b></span>`;
  $("#tbKdx").innerHTML=($("#qKdxDe").value?`<tr><td>${fdate($("#qKdxDe").value)}</td><td colspan="6" class="note">Saldo inicial</td><td class="num"><b>${fmt(ini)}</b></td><td></td></tr>`:"")+
    (rows.length?rows.map(r=>{const x=r.x;return `<tr><td>${fdate(x.FECHA)}</td><td class="code">${esc(x.DOC)}</td><td><span class="pill ${TIPO[x.TIPO]?.pill||"mute"}">${esc(TIPO[x.TIPO]?.nom||x.TIPO)}</span></td>
    <td class="note">${esc(kOrden(x))}</td><td>${esc(who(x))}</td><td class="num pos">${r.ent?fmt(r.ent):""}</td><td class="num neg">${r.sal?fmt(r.sal):""}</td><td class="num"><b>${fmt(r.saldo)}</b></td><td class="num">${mf.format(N(x.PU))}</td></tr>`;}).join(""):empty(9,"Este material no tiene movimientos en el periodo."));
}
function renderEq(){
  $$("#matSeg button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.mv===S.mv)); $("#matBox").hidden=S.mv!=="mat"; $("#eqBox").hidden=S.mv!=="eq"; $("#undBox").hidden=S.mv!=="und"; renderUnd();
  $("#btnEq").hidden=!isAdmin(); const q=U($("#qEq").value);
  const r=S.eq.map(e=>({...e,m:S.byCod[e.CODIGO]||{desc:"(material no encontrado)",und:""}})).filter(e=>!q||U([e.CODIGO,e.m.desc,e.UND_COMPRA].join(" ")).includes(q))
    .sort((a,b)=>String(a.m.desc).localeCompare(String(b.m.desc),"es")||a.UND_COMPRA.localeCompare(b.UND_COMPRA));
  $("#tbEq").innerHTML=!r.length?empty(7,S.eq.length?"Ninguna equivalencia coincide.":"A\u00fan no hay equivalencias. Se crean solas al registrar un ingreso en otra unidad, o con + Equivalencia."):
    r.map(e=>`<tr><td class="code">${esc(e.CODIGO)}</td><td>${esc(e.m.desc)}</td><td><b>1 ${esc(e.UND_COMPRA)}</b></td><td>${fmt(e.FACTOR)} ${esc(e.m.und)}</td>
    <td><span class="pill ${e.TIPO==="FIJA"?"info":"warn"}">${e.TIPO==="FIJA"?"Fija":"Variable"}</span></td><td class="note">${esc(e.OBS)}</td>
    <td>${isAdmin()?`<button class="btn sm" data-eqe="${esc(e.CODIGO)}|${esc(e.UND_COMPRA)}">Editar</button> <button class="btn sm" data-eqd="${esc(e.CODIGO)}|${esc(e.UND_COMPRA)}">Quitar</button>`:""}</td></tr>`).join("");
}
$("#matSeg").addEventListener("click",e=>{const b=e.target.closest("[data-mv]"); if(b){S.mv=b.dataset.mv; renderEq();}});
$("#qEq").addEventListener("input",renderEq);
function abrirEqv(cod,und){
  const e=cod?eqBusca(cod,und):null, s=cod?S.byCod[U(cod)]:null; S.eqEdit=!!e;
  $("#qTit").textContent=e?"Editar equivalencia":"Nueva equivalencia de compra";
  $("#qvMat").value=s?s.desc:""; $("#qvUnd").value=e?e.UND_COMPRA:""; $("#qvFac").value=e?e.FACTOR:""; $("#qvTipo").value=e?e.TIPO:"FIJA"; $("#qvObs").value=e?e.OBS:"";
  $("#qvMat").readOnly=$("#qvUnd").readOnly=!!e; $("#qvErr").textContent=""; qvInfo(); $("#pEqv").hidden=false; (e?$("#qvFac"):$("#qvMat")).focus({preventScroll:true});
}
function qvInfo(){ const s=matFind($("#qvMat").value), u=U($("#qvUnd").value)||"unidad", f=N($("#qvFac").value);
  $("#qvU").textContent=u; $("#qvB").textContent=s?s.und:"\u2014";
  $("#qvInfo").textContent=s?`Unidad de almac\u00e9n: ${s.und}.`+(f>0&&u!=="unidad"?` Ejemplo: 10 ${u} = ${fmt(10*f)} ${s.und}.`:""):"Elige el material de la lista."; }
["#qvMat","#qvUnd","#qvFac"].forEach(x=>$(x).addEventListener("input",qvInfo));
$("#btnEq").onclick=()=>abrirEqv(null);
$("#tbEq").addEventListener("click",async e=>{
  const ed=e.target.closest("[data-eqe]"); if(ed){const [c,u]=ed.dataset.eqe.split("|"); abrirEqv(c,u); return;}
  const del=e.target.closest("[data-eqd]"); if(!del) return; const [c,u]=del.dataset.eqd.split("|");
  if(!confirm(`\u00bfQuitar la equivalencia 1 ${u} de ${(S.byCod[c]||{}).desc||c}? Los ingresos ya registrados no cambian.`)) return;
  try{ await api("eliminarEquivalencia",c,u); toast("Equivalencia quitada."); await cargar(); }catch(x){ toast("No se pudo quitar: "+msg(x)); } });
$("#fEqv").onsubmit=async e=>{e.preventDefault(); const err=$("#qvErr"); err.textContent="";
  const s=matFind($("#qvMat").value), u=U($("#qvUnd").value), f=N($("#qvFac").value);
  if(!s){err.textContent="Elige el material de la lista.";return;}
  if(!u){err.textContent="Escribe la unidad en que compra log\u00edstica.";return;}
  if(u===s.und){err.textContent=`${u} ya es la unidad de almac\u00e9n de este material.`;return;}
  if(!(f>0)){err.textContent="El factor debe ser mayor que cero.";return;}
  if(!S.eqEdit&&eqBusca(s.codigo,u)){err.textContent=`Ya existe una equivalencia en ${u} para este material. Usa Editar.`;return;}
  $("#qvSave").disabled=true;
  try{ const r=await api("guardarEquivalencia",{codigo:s.codigo,und:u,factor:f,tipo:$("#qvTipo").value,obs:$("#qvObs").value.trim()});
    toast("Guardado: "+r); $("#pEqv").hidden=true; await cargar(); }catch(x){ err.textContent="No se pudo guardar: "+msg(x); }
  $("#qvSave").disabled=false; };
function vidaCelda(cod){ const m=S.mat.find(x=>U(x.CODIGO)===U(cod))||{}, t=U(m.VIDA_TIPO); if(!t) return '<span class="note">No vence</span>';
  return `${t==="PERECIBLE"?"Vence":t==="REVISION"?"Revisar":"Reponer"} a los ${fmt(m.VIDA_DIAS)} d\u00edas<div class="code" title="${esc(m.VIDA_FUENTE)}">${esc(String(m.VIDA_FUENTE||"sin fuente").slice(0,38))}</div>`; }
function filtMat(){ const q=U($("#qMat").value), c=$("#qMatCat").value;
  return S.stock.filter(s=>(!c||s.cat===c)&&(!q||U([s.desc,s.codigo,s.ubi].join(" ")).includes(q))).sort((a,b)=>String(a.codigo).localeCompare(String(b.codigo))); }
function renderMat(){
  renderEq();
  const r=filtMat();
  $("#tbMat").innerHTML=!r.length?empty(9,S.mat.length?"Ning\u00fan material coincide.":"No hay materiales registrados."):
    r.map(s=>`<tr><td class="code">${esc(s.codigo)}</td><td>${esc(s.desc)}</td><td>${esc(s.cat)}</td><td>${esc(s.und)}${eqDe(s.codigo).map(e=>`<div class="code">${esc(eqTxt(e))}</div>`).join("")}</td><td class="num">${fmt(s.saldo)}</td><td class="num">${s.min?fmt(s.min):"\u2013"}</td><td>${vidaCelda(s.codigo)}</td><td>${esc(s.ubi)}</td>
    <td>${canWrite()?`<button class="btn sm" data-edit="${esc(s.codigo)}">Editar</button>`:""}</td></tr>`).join("");
}

/* ---------- lista maestra ---------- */
var claveNom=s=>U(s).normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/&/g,"Y").replace(/\b(S\.?\s?A\.?\s?C\.?|S\.?\s?R\.?\s?L\.?|E\.?\s?I\.?\s?R\.?\s?L\.?|S\.?\s?A\.?\s?A\.?|S\.?\s?A\.?)\s*$/,"").replace(/[^A-Z0-9]/g,"");
function parecidos(tipo,nombre){const k=claveNom(nombre); if(k.length<2) return [];
  return S.ent.filter(e=>e.TIPO===tipo&&U(e.NOMBRE)!==U(nombre)).filter(e=>{const o=claveNom(e.NOMBRE);return o===k||(Math.min(o.length,k.length)>=3&&(o.includes(k)||k.includes(o)));}).map(e=>e.NOMBRE);}
function renderEnt(){
  $$("#entSeg button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.et===S.et));
  const q=U($("#qEnt").value), col=ENTCOL[S.et], cnt={}; (S.movAll||S.mov).forEach(x=>{const n=U(x[col]); if(n) cnt[n]=(cnt[n]||0)+1;});
  const r=S.ent.filter(e=>e.TIPO===S.et&&(!q||U(e.NOMBRE+" "+e.DOCUMENTO).includes(q))).sort((a,b)=>a.NOMBRE.localeCompare(b.NOMBRE,"es"));
  $("#tbEnt").innerHTML=!r.length?empty(6,"No hay nombres registrados en esta lista."):
    r.map(e=>{const p=parecidos(S.et,e.NOMBRE);return `<tr><td><b>${esc(e.NOMBRE)}</b>${p.length?`<div><span class="pill warn">\u00bfRepetido de ${esc(p.join(", "))}?</span></div>`:""}</td><td class="code">${esc(e.DOCUMENTO)}</td><td>${esc(e.CONTACTO)}</td>
    <td class="num">${fmt(cnt[U(e.NOMBRE)]||0)}</td><td><span class="pill ${e.ACTIVO==="NO"?"mute":"ok"}">${e.ACTIVO==="NO"?"Inactivo":"Activo"}</span></td>
    <td class="bar">${canWrite()?`<button class="btn sm" data-eedit="${esc(e.NOMBRE)}">Editar</button>`:""}${isAdmin()?`<button class="btn sm" data-euni="${esc(e.NOMBRE)}">Unificar</button>`:""}${isAdmin()&&!cnt[U(e.NOMBRE)]&&!entEnUso(S.et,U(e.NOMBRE))?`<button class="btn sm danger" data-edel="${esc(e.NOMBRE)}">Eliminar</button>`:""}</td></tr>`;}).join("");
}
$("#entSeg").addEventListener("click",e=>{const b=e.target.closest("[data-et]");if(b){S.et=b.dataset.et;renderEnt();}});
$("#qEnt").addEventListener("input",renderEnt);
function abrirEnt(tipo,nombre,destino){
  const e=nombre?S.ent.find(x=>x.TIPO===tipo&&x.NOMBRE===nombre):null; S.entEdit={tipo,nombre:e?e.NOMBRE:"",destino};
  $("#eTit").textContent=(e?"Editar ":"Nuevo ")+ENTN[tipo]; $("#fEnt").reset(); $("#eErr").textContent=""; $("#eWarn").textContent="";
  $("#eNom").value=e?e.NOMBRE:""; $("#eNom").readOnly=!!e; $("#eDoc").value=e?e.DOCUMENTO:""; $("#eCon").value=e?e.CONTACTO:""; $("#eAct").checked=!e||e.ACTIVO!=="NO"; $("#eActBox").hidden=!e;
  $("#pEnt").hidden=false; (e?$("#eDoc"):$("#eNom")).focus();
}
$("#eNom").addEventListener("input",()=>{const p=parecidos(S.entEdit.tipo,$("#eNom").value); $("#eWarn").textContent=p.length?`Ojo: ya existe ${p.join(", ")}. Si es el mismo, cancela y el\u00edgelo de la lista.`:"";});
$("#btnEnt").onclick=()=>abrirEnt(S.et,null,null);
// un nombre sin movimientos se puede borrar si no esta en solicitudes ni asignado a un usuario
var entEnUso=(t,n)=>S.sol.some(x=>U(t==="CONTRATISTA"?x.RECEPTOR:t==="AREA"?x.AREA:t==="OBRA"?x.OBRA:"")===n)||(t==="AREA"&&S.usuarios.some(u=>U(u.AREA)===n));
$("#tbEnt").addEventListener("click",async e=>{const d=e.target.closest("[data-edel]");
  if(d){ if(!confirm(`\u00bfEliminar ${d.dataset.edel} de la lista? No tiene movimientos.`)) return;
    try{ await api("eliminarEntidad",S.et,d.dataset.edel); toast(`${d.dataset.edel} eliminado.`); await cargar(); }catch(y){ toast("No se pudo eliminar: "+msg(y)); } return; } });
$("#tbEnt").addEventListener("click",e=>{const a=e.target.closest("[data-eedit]"),b=e.target.closest("[data-euni]");
  if(a) abrirEnt(S.et,a.dataset.eedit,null);
  if(b){ S.uni=b.dataset.euni; $("#uDe").textContent=S.uni; $("#uErr").textContent=""; $("#uA").innerHTML=opts(S.ent.filter(x=>x.TIPO===S.et&&x.NOMBRE!==S.uni).map(x=>x.NOMBRE).sort(),"\u2014 Elige el nombre correcto \u2014"); $("#pUni").hidden=false; }});
$("#fEnt").onsubmit=async e=>{e.preventDefault(); const x=S.entEdit, err=$("#eErr"); err.textContent="";
  const nombre=x.nombre||U($("#eNom").value).replace(/\s+/g," "); if(nombre.length<2){err.textContent="Escribe el nombre.";return;}
  $("#eSave").disabled=true;
  try{ const n=await api("guardarEntidad",{tipo:x.tipo,nombre,documento:$("#eDoc").value,contacto:$("#eCon").value,activo:$("#eAct").checked});
    $("#pEnt").hidden=true; toast(`${ENTN[x.tipo][0].toUpperCase()+ENTN[x.tipo].slice(1)} guardado: ${n}`); await cargar();
    if(x.destino){ fillDocSelects(); $("#"+x.destino).value=n; $("#"+x.destino).dispatchEvent(new Event("change")); }
  }catch(y){err.textContent=msg(y);}
  $("#eSave").disabled=false; };
$("#uSave").onclick=async()=>{ const a=$("#uA").value; if(!a){$("#uErr").textContent="Elige el nombre correcto.";return;}
  try{ const n=await api("unificarEntidad",S.et,S.uni,a); $("#pUni").hidden=true; toast(`Unificado: ${n} movimientos pasaron a ${a}.`); await cargar(); }catch(y){$("#uErr").textContent=msg(y);} };

/* ---------- usuarios ---------- */
function renderUsr(){
  if(!isAdmin()){ $("#tbUsr").innerHTML=""; return; }
  $("#tbUsr").innerHTML=S.usuarios.map(u=>`<tr><td class="code" style="color:var(--ink)">${esc(u.USUARIO)}</td><td>${esc(u.NOMBRE)}</td><td>${esc(S.roles[U(u.ROL)]||u.ROL)}</td><td>${esc(u.AREA||"")}</td>
    <td><span class="pill ${U(u.ACTIVO)==="NO"?"mute":"ok"}">${U(u.ACTIVO)==="NO"?"Inactivo":"Activo"}</span></td><td>${u.CREADO?fdate(u.CREADO):'<span class="note">sin fecha</span>'}</td><td><button class="btn sm" data-uedit="${esc(u.USUARIO)}">Editar</button></td></tr>`).join("")||empty(7,"Sin usuarios.");
}
function abrirUsr(id){
  const u=id?S.usuarios.find(x=>x.USUARIO===id):null; S.usrEdit=u?u.USUARIO:null;
  $("#uTit").textContent=u?"Editar usuario":"Usuario nuevo"; $("#fUsr").reset(); $("#usErr").textContent="";
  $("#usRol").innerHTML=Object.entries(S.roles).map(([k,v])=>`<option value="${k}">${esc(v)}</option>`).join("");
  $("#usUsr").value=u?u.USUARIO:""; $("#usUsr").readOnly=!!u; $("#usNom").value=u?u.NOMBRE:""; $("#usRol").value=u?U(u.ROL):"ALMACEN";
  $("#usPwdL").textContent=u?"Nueva contrase\u00f1a (d\u00e9jala vac\u00eda para no cambiarla)":"Contrase\u00f1a (m\u00ednimo 6 caracteres)";
  $("#usArea").innerHTML=opts(entAct("AREA"),"\u2014 Elige el \u00e1rea \u2014"); $("#usArea").value=u?U(u.AREA):""; $("#usAreaBox").hidden=$("#usRol").value!=="AREA";
  $("#usMail").value=u?(u.CORREO||""):""; $("#usAct").checked=!u||U(u.ACTIVO)!=="NO"; $("#usActBox").hidden=!u; $("#usDel").hidden=!u||U(u.USUARIO)===U(S.ses.usuario); $("#pUsr").hidden=false; (u?$("#usNom"):$("#usUsr")).focus();
}
$("#btnUsr").onclick=()=>abrirUsr(null);
function avisoBtn(){ const b=$("#btnAviso"); b.textContent="Aviso semanal por correo: "+(S.aviso?"activado":"desactivado"); b.classList.toggle("primary",false);
  b.title="Cada lunes 7 a. m.: a cada \u00e1rea su material sin retirar (60+ d\u00edas); a almac\u00e9n y administraci\u00f3n, vencimientos y saldos sin movimiento."; }
$("#btnCie").onclick=()=>{ $("#ciFecha").value=today(); $("#ciConf").value=""; $("#ciErr").textContent=""; $("#ciDone").hidden=true; $("#ciSave").disabled=false; resumenCie(); $("#pCie").hidden=false; };
async function resumenCie(){ const r=$("#ciRes"); r.textContent="Calculando\u2026";
  try{ const x=await api("resumenCierre",$("#ciFecha").value);
    r.innerHTML=`Hoy hay <b>${fmt(x.movimientos)}</b> movimientos. Quedar\u00e1n <b>${fmt(x.saldos)}</b> l\u00edneas de saldo inicial (${esc(x.doc)}), <b>${fmt(x.prestamos)}</b> pr\u00e9stamo${x.prestamos===1?"":"s"} pendiente${x.prestamos===1?"":"s"} y <b>${fmt(x.solAbiertas)}</b> solicitud${x.solAbiertas===1?"":"es"} abierta${x.solAbiertas===1?"":"s"}. Las ${fmt(x.solCerradas)} solicitudes cerradas quedan solo en la copia.`+
      (x.ultimo?`<br>\u00daltimo cierre: ${fdate(x.ultimo.fecha)} por ${esc(x.ultimo.por)}.`:""); }
  catch(e){ r.textContent="No se pudo calcular: "+msg(e); } }
$("#ciFecha").addEventListener("change",resumenCie);
$("#ciSave").onclick=async()=>{ const err=$("#ciErr"); err.textContent="";
  if(U($("#ciConf").value)!=="CERRAR"){err.textContent="Escribe CERRAR para confirmar.";return;}
  if(!confirm("Se har\u00e1 la copia de respaldo y este archivo quedar\u00e1 solo con los saldos iniciales y lo pendiente. \u00bfContinuar?")) return;
  $("#ciSave").disabled=true; $("#ciSave").textContent="Haciendo el cierre\u2026";
  try{ const x=await api("cierreAnual",$("#ciFecha").value,$("#ciConf").value);
    $("#ciDone").innerHTML=`<span class="note">Cierre hecho</span><span class="docn">${esc(x.doc)}</span><span>${fmt(x.movimientos)} movimientos pasaron a la copia. Quedan ${fmt(x.saldos)} saldos iniciales, ${fmt(x.prestamos)} pr\u00e9stamos pendientes y ${fmt(x.solAbiertas)} solicitudes abiertas.</span>
      <div class="bar"><a class="btn primary" href="${esc(x.url)}" target="_blank" rel="noopener">Abrir la copia hist\u00f3rica</a><button class="btn" type="button" data-close2="pCie">Cerrar</button></div>`;
    $("#ciDone").hidden=false; await cargar(); toast("Cierre anual hecho. La copia qued\u00f3 en tu Drive."); }
  catch(e){ err.textContent="No se pudo hacer el cierre: "+msg(e); $("#ciSave").disabled=false; }
  $("#ciSave").textContent="Hacer cierre anual"; };
$("#btnPil").onclick=()=>{ $("#plConf").value=""; $("#plErr").textContent=""; $("#plDone").hidden=true; $("#plSave").disabled=false; resumenPil(); $("#pPil").hidden=false; };
async function resumenPil(){ const r=$("#plRes"); r.textContent="Calculando\u2026"; $("#plNuevos").innerHTML="";
  try{ const x=await api("resumenLimpieza"); S.pil=x;
    $("#plIni").hidden=!!x.piloto; $("#plActivo").hidden=!x.piloto;
    if(x.piloto) $("#plActivo").textContent=`Prueba piloto empezada el ${fdate(x.piloto.desde)} por ${x.piloto.por}.`;
    r.innerHTML=`Se borrar\u00e1n <b>${fmt(x.docs)}</b> documento${x.docs===1?"":"s"} (${fmt(x.movimientos)} l\u00edneas), <b>${fmt(x.solicitudes)}</b> solicitud${x.solicitudes===1?"":"es"} y <b>${fmt(x.correcciones)}</b> ${x.correcciones===1?"correcci\u00f3n":"correcciones"}. El stock queda en cero y la numeraci\u00f3n vuelve a 0001.`;
    const nom={MATERIALES:"Materiales",ENTIDADES:"Contratistas, proveedores, \u00e1reas y obras",USUARIOS:"Usuarios",EQUIVALENCIAS:"Equivalencias de compra"};
    const g=Object.keys(x.nuevos||{}).filter(k=>x.nuevos[k].length);
    $("#plNuevos").innerHTML=!x.piloto?'<p class="note">No marcaste el inicio de la prueba, as\u00ed que se quedan todos los materiales, contratistas y usuarios. Si quieres que el sistema sepa qu\u00e9 se cre\u00f3 durante la prueba, usa <b>Empezar prueba piloto</b> antes de probar.</p>'
      :g.length?'<p class="note">Creados durante la prueba. Desmarca lo que quieras conservar:</p>'+g.map(k=>`<div class="pl-g"><b>${nom[k]}</b>${x.nuevos[k].map(o=>`<label class="chk"><input type="checkbox" data-pl="${k}" value="${esc(o.clave)}" ${k==="USUARIOS"&&U(o.clave)===U(S.ses.usuario)?"disabled":"checked"}>${esc(o.texto)}</label>`).join("")}</div>`).join("")
      :'<p class="note">Durante la prueba no se crearon materiales, contratistas ni usuarios nuevos.</p>'; }
  catch(e){ r.textContent="No se pudo calcular: "+msg(e); } }
$("#plIni").onclick=async()=>{ if(!confirm("Se guardar\u00e1 la lista de materiales, contratistas y usuarios que existen hoy. Al terminar la prueba podr\u00e1s borrar lo que se cree desde ahora. \u00bfEmpezar?")) return;
  try{ await api("empezarPiloto"); await cargar(); toast("Prueba piloto empezada."); resumenPil(); }catch(e){ $("#plErr").textContent=msg(e); } };
$("#plSave").onclick=async()=>{ const err=$("#plErr"); err.textContent="";
  if(U($("#plConf").value)!=="BORRAR"){err.textContent="Escribe BORRAR para confirmar.";return;}
  if(!confirm("Se har\u00e1 una copia de respaldo en tu Drive y luego se borrar\u00e1n todos los movimientos y solicitudes. \u00bfContinuar?")) return;
  const b={}; $$("#plNuevos [data-pl]").forEach(c=>{ if(c.checked&&!c.disabled) (b[c.dataset.pl]=b[c.dataset.pl]||[]).push(c.value); });
  $("#plSave").disabled=true; $("#plSave").textContent="Borrando\u2026";
  try{ const x=await api("limpiarDatosPrueba",$("#plConf").value,b);
    $("#plDone").innerHTML=`<span class="note">Listo</span><span>Se borraron ${fmt(x.movimientos)} l\u00edneas de movimientos y ${fmt(x.solicitudes)} solicitudes${x.borrados?`, y ${fmt(x.borrados)} registro${x.borrados===1?"":"s"} creados en la prueba`:""}. El sistema qued\u00f3 listo para empezar con datos reales.</span>
      <div class="bar"><a class="btn" href="${esc(x.url)}" target="_blank" rel="noopener">Abrir la copia de respaldo</a><button class="btn primary" type="button" data-close2="pPil">Cerrar</button></div>`;
    $("#plDone").hidden=false; await cargar(); toast("Datos de prueba borrados."); }
  catch(e){ err.textContent="No se pudo limpiar: "+msg(e); $("#plSave").disabled=false; }
  $("#plSave").textContent="Borrar datos de prueba"; };
$("#plDone").addEventListener("click",e=>{ if(e.target.closest("[data-close2]")) $("#pPil").hidden=true; });
$("#ciDone").addEventListener("click",e=>{ if(e.target.closest("[data-close2]")) $("#pCie").hidden=true; });
$("#btnAviso").onclick=async()=>{ const act=!S.aviso;
  if(!confirm(act?"\u00bfActivar el correo semanal de los lunes (7 a. m.)? Llega a quienes tengan correo en su usuario: a cada \u00e1rea su material sin retirar y a almac\u00e9n/administraci\u00f3n los vencimientos y saldos sin movimiento.":"\u00bfDesactivar el correo semanal?")) return;
  try{ S.aviso=await api("activarAvisoSemanal",act); avisoBtn(); toast(S.aviso?"Aviso semanal activado: llegar\u00e1 cada lunes a las 7 a. m.":"Aviso semanal desactivado."); }catch(x){ toast("No se pudo: "+msg(x)); } };
$("#usDel").onclick=async()=>{ const u=S.usrEdit; if(!u) return;
  if(!confirm(`\u00bfEliminar al usuario ${u}? Ya no podr\u00e1 entrar y, si tiene la app abierta, se le cierra la sesi\u00f3n. Su nombre se queda en los documentos que registr\u00f3.`)) return;
  try{ await api("eliminarUsuario",u); $("#pUsr").hidden=true; toast(`Usuario ${u} eliminado.`); await cargar(); }catch(y){ $("#usErr").textContent=msg(y); } };
$("#usRol").addEventListener("change",()=>$("#usAreaBox").hidden=$("#usRol").value!=="AREA");
$("#tbUsr").addEventListener("click",e=>{const b=e.target.closest("[data-uedit]");if(b)abrirUsr(b.dataset.uedit);});
$("#fUsr").onsubmit=async e=>{e.preventDefault(); const err=$("#usErr"); err.textContent=""; const pwd=$("#usPwd").value;
  if(!S.usrEdit&&pwd.length<6){err.textContent="La contrase\u00f1a debe tener al menos 6 caracteres.";return;}
  if($("#usRol").value==="AREA"&&!$("#usArea").value){err.textContent="Elige el \u00e1rea que podr\u00e1 consultar.";return;}
  if(S.usrEdit&&pwd&&pwd.length<6){err.textContent="La contrase\u00f1a debe tener al menos 6 caracteres.";return;}
  $("#usSave").disabled=true;
  try{ const u=await api("guardarUsuario",{usuario:$("#usUsr").value,nombre:$("#usNom").value,rol:$("#usRol").value,area:$("#usArea").value,correo:$("#usMail").value.trim(),clave:pwd||"",activo:$("#usAct").checked});
    $("#pUsr").hidden=true; toast(`Usuario ${u} guardado.`); await cargar(); }catch(y){err.textContent=msg(y);}
  $("#usSave").disabled=false; };

/* ---------- navegacion ---------- */
function showTab(t){ if(!puedeVer(t)) t=esArea()?"stock":"dash"; S.tab=t;
  menuSide(false); $$("[data-tab]").forEach(b=>b.toggleAttribute("aria-current",b.dataset.tab===t)); $$("[data-tab]").forEach(b=>{if(b.dataset.tab===t)b.setAttribute("aria-current","page");});
  $$(".view").forEach(v=>v.hidden=v.id!=="v-"+t); $("#pgTit").textContent=TIT[t]; try{localStorage.setItem("alm.tab",t)}catch(e){}
  window.scrollTo(0,0); if(t==="dash") renderDash(); }
$$("[data-tab]").forEach(b=>b.onclick=()=>showTab(b.dataset.tab));
/* menu lateral como cajon en el celular */
function menuSide(on){ document.body.classList.toggle("menu-on",!!on); $("#scrim").hidden=!on; }
$("#btnMenu").onclick=()=>menuSide(true); $("#bnMas").onclick=()=>menuSide(true); $("#scrim").onclick=()=>menuSide(false);
document.addEventListener("click",e=>{ const m=$("#actMas"); if(m.open&&!m.contains(e.target)) m.open=false; });
$("#btnBell").onclick=()=>{ showTab("dash"); setTimeout(()=>$("#atCard").scrollIntoView({behavior:"smooth",block:"start"}),60); };
/* buscador de la barra superior: lleva a la pantalla que corresponde */
function buscarGlobal(q){ const u=U(q);
  if(/^SM-\d+$/.test(u)||S.sols.some(o=>U(o.h.NRO_AREA)===u)){ $("#qSolSt").value=""; $("#qSol").value=q; showTab("sol"); renderSol(); }
  else if(S.docMap[u]&&puedeVer("mov")){ if(!esArea()) $("#qMovT").value=""; $("#qMov").value=q; showTab("mov"); renderMov(); }
  else if(S.lotList.some(l=>U(l.ORC)===u||U(l.REQ)===u||U(l.GUIA)===u)){ $("#qOrcSt").value=""; $("#qOrc").value=q; showTab("orc"); renderOrc(); }
  else { $("#qSt").value=""; $("#qStock").value=q; showTab("stock"); renderStock(); } }
$("#qGlobal").addEventListener("keydown",e=>{ if(e.key!=="Enter") return; e.preventDefault(); const q=e.target.value.trim(); if(q&&S.db){ buscarGlobal(q); e.target.blur(); } });
$("#avisos").addEventListener("click",e=>{ const b=e.target.closest("[data-av]"); if(!b) return; const k=b.dataset.av;
  if(k==="sol"||k==="rec"){ $("#qSolSt").value="abiertas"; $("#qSol").value=""; showTab("sol"); renderSol(); if(k==="rec"&&!$("#btnRec").hidden) $("#btnRec").click(); }
  else if(k==="pre"){ $("#qPreSt").value=""; $("#qPre").value=""; showTab("pres"); renderPres(); }
  else { if(!esArea()) $("#qMovT").value="INGRESO"; $("#qMov").value=""; showTab("mov"); renderMov(); } });
$$(".tile[data-go]").forEach(b=>b.onclick=()=>{ if(b.dataset.go==="stock"){$("#qSt").value=b.dataset.st;$("#qStock").value="";} else if(b.dataset.go==="orc"){$("#qOrcSt").value=b.dataset.st;$("#qOrc").value="";} else {$("#qPreSt").value=b.dataset.st;} showTab(b.dataset.go); render(); });
$$("[data-close]").forEach(b=>b.onclick=()=>cerrarModal(b.dataset.close));
/* ---------- minimizar ventanas largas: se esconden sin perder lo llenado y quedan en una barrita abajo ---------- */
var LARGOS=["pDoc","pAte","pSol","pImp","pInv"];
var tieneDatos=id=>id==="pDoc"?!!(S.d&&S.d.cart.length&&$("#dDone").hidden):id==="pSol"?!!(S.s&&S.s.cart.length&&$("#sDone").hidden):
  id==="pImp"?!!(S.imp&&!$("#iPaso2").hidden&&S.imp.lineas.length):id==="pAte"?!!(S.a&&S.a.tocado):id==="pInv"?!!(S.inv&&Object.keys(S.inv).length&&!S.invDoc):false;
function nombreMin(id){ const n=id==="pDoc"?(S.d?S.d.cart.length:0):id==="pSol"?(S.s?S.s.cart.length:0):id==="pImp"?(S.imp?S.imp.lineas.filter(x=>x.incl).length:0):id==="pInv"?Object.keys(S.inv||{}).length:0;
  const t=id==="pDoc"?(TIPO[S.d.tipo]||{doc:"Documento"}).doc:id==="pSol"?"Solicitud nueva":id==="pImp"?"Importaci\u00f3n de Excel":id==="pAte"?"Solicitud "+(S.a?S.a.doc:""):"Inventario f\u00edsico";
  return t+(n?` \u00b7 ${n} ${id==="pInv"?"conteo":"\u00edtem"}${n===1?"":"s"}`:""); }
function renderTray(){ $("#tray").innerHTML=LARGOS.filter(id=>$("#"+id).dataset.min).map(id=>`<button type="button" data-res="${id}" title="Volver a la ventana"><span>${esc(nombreMin(id))}</span><b>\u25b2</b></button>`).join(""); }
function minimizar(id){ const el=$("#"+id); el.dataset.min="1"; el.hidden=true; renderTray(); }
function restaurar(id){ LARGOS.forEach(o=>{ if(o!==id&&!$("#"+o).hidden) minimizar(o); }); const el=$("#"+id); delete el.dataset.min; el.hidden=false; renderTray(); }
function cerrarModal(id){ if(LARGOS.includes(id)&&tieneDatos(id)&&!confirm("\u00bfDescartar lo que llenaste?\nSi solo quieres revisar otra cosa, usa el bot\u00f3n \u2014 (minimizar).")) return;
  const el=$("#"+id); el.hidden=true; if(el.dataset.min){ delete el.dataset.min; renderTray(); } }
// al abrir una ventana que ya esta minimizada con datos: pregunta si se descarta o se vuelve a ella
function libreModal(id){ const el=$("#"+id); if(!el.dataset.min) return true;
  if(!tieneDatos(id)||confirm(`Tienes minimizada: ${nombreMin(id)}.\n\u00bfDescartarla y empezar otra? (Cancelar = volver a la minimizada)`)){ delete el.dataset.min; renderTray(); return true; }
  restaurar(id); return false; }
$$("[data-min]").forEach(b=>b.onclick=()=>minimizar(b.dataset.min));
$("#tray").addEventListener("click",e=>{const b=e.target.closest("[data-res]"); if(b) restaurar(b.dataset.res);});
document.addEventListener("keydown",e=>{if(e.key!=="Escape")return; const top=["pConf","pQr","pResp","pUnd","pUnif","pPil","pCie","pCor","pRec","pInv","pLib","pImp","pAte","pSol","pEqv","pEnt","pMat","pUni","pUsr","pClave"].find(id=>!$("#"+id).hidden); if(top==="pConf"&&S.cfFin) S.cfFin(false); else if(top) cerrarModal(top);});
["#qStock","#qStCat","#qSt"].forEach(s=>$(s).addEventListener("input",renderStock));
["#qOrc","#qOrcArea","#qOrcSt"].forEach(s=>$(s).addEventListener("input",renderOrc));
["#qMov","#qMovT","#qMovMia","#qMovDe","#qMovA"].forEach(s=>$(s).addEventListener("input",renderMov));
["#qPre","#qPreCon","#qPreSt"].forEach(s=>$(s).addEventListener("input",renderPres));
["#qKdx","#qKdxDe","#qKdxA"].forEach(s=>$(s).addEventListener("input",renderKdx));
["#qMat","#qMatCat"].forEach(s=>$(s).addEventListener("input",renderMat));
$("#tbMov").addEventListener("click",e=>{const b=e.target.closest("[data-print]");if(b)printDoc(b.dataset.print); const c=e.target.closest("[data-corr]"); if(c) abrirCorr(c.dataset.corr);});
$("#tbPre").addEventListener("click",e=>{const b=e.target.closest("[data-dev]");if(b)abrirDoc("DEVOLUCION",b.dataset.dev);});
$("#tbAt").addEventListener("click",e=>{const sa=e.target.closest("[data-ate]"); if(sa){abrirAte(sa.dataset.ate);return;} const lb=e.target.closest("[data-lib]"); if(lb){abrirLib(lb.dataset.lib);return;} const b=e.target.closest("[data-dev]");if(b)abrirDoc("DEVOLUCION",b.dataset.dev);const k=e.target.closest("[data-kdx]");if(k){$("#qKdx").value=k.dataset.kdx;showTab("kdx");renderKdx();}});
$$("[data-nuevo]").forEach(b=>b.onclick=()=>{ $("#actMas").open=false; abrirDoc(b.dataset.nuevo); });
$("#btnInv").onclick=()=>{ $("#actMas").open=false; abrirInv(); };
$("#btnRef").onclick=async()=>{await cargar();toast("Datos actualizados.");};

/* ---------- documento: NI / VS / PR / DV / AJ ---------- */
function fillSolSelects(){
  const ars=areas();
  if(!esArea()){ keepSel($("#sArea"),opts(ars)); keepSel($("#iArea"),opts(ars,"\u2014 Elige el \u00e1rea \u2014")); }
  ["#sRec","#iRec"].forEach(x=>keepSel($(x),opts(entAct("CONTRATISTA"),"\u2014 Elige el receptor \u2014")));
  ["#sObra","#iObra"].forEach(x=>keepSel($(x),opts(entAct("OBRA"),"(sin obra)")));
}
function fillDocSelects(){ fillSolSelects();
  keepSel($("#dProv"),opts(entAct("PROVEEDOR"),"\u2014 Elige proveedor \u2014"));
  keepSel($("#dCon"),opts(entAct("CONTRATISTA"),"\u2014 Elige receptor \u2014"));
  keepSel($("#dArea"),opts(entAct("AREA"),"\u2014 Elige \u00e1rea \u2014"));
  keepSel($("#dObra"),opts(entAct("OBRA"),"(sin obra)"));
}
$$("[data-newent]").forEach(b=>b.onclick=()=>abrirEnt(b.dataset.newent,null,b.dataset.for));
function abrirDoc(tipo,ref){ if(!libreModal("pDoc")) return false;
  S.d={tipo,cart:[],ref:""}; fillDocSelects();
  ["#dProv","#dOrc","#dReq","#dGuia","#dCon","#dCont","#dObra","#dArea","#dUso","#dSol","#dObs","#dMat","#dCant","#dPu","#dUndN","#dFac"].forEach(s=>$(s).value="");
  $("#dFecha").value=today(); $("#dFdev").value=addDays(today(),7); $("#dEntre").checked=false; $("#dAut").value=""; $("#dDeuda").hidden=true;
  ["#dErr","#dSaveErr","#dInfo","#dWarn"].forEach(s=>$(s).textContent="");
  $("#dForm").hidden=false; $("#dDone").hidden=true; $("#dSave").disabled=false;
  setTipo(tipo); $("#pDoc").hidden=false; $("#pDoc").scrollTop=0;
  if(ref){$("#dRef").value=ref; elegirRef();}
}
function setTipo(t){
  S.d.tipo=t; S.d.cart=[]; S.d.ref="";
  $$("#dSeg button").forEach(b=>b.setAttribute("aria-pressed",b.dataset.tipo===t));
  $$("#pDoc [data-t]").forEach(el=>el.hidden=!el.dataset.t.split(" ").includes(t));
  $("#dTit").textContent=TIPO[t].doc; $("#dHelp").textContent=TIPO[t].help;
  $("#dConL").textContent={SALIDA:"Entregado a",PRESTAMO:"Prestado a",DEVOLUCION:"Devuelto por",INTERNAMIENTO:"Contratista que devuelve",MERMA:"Responsable (opcional)"}[t]||"";
  $("#dRet").checked=false; $("#dRetUBox").hidden=true; $("#dEst").value="BUENO";
  $("#dAreaL").textContent={INGRESO:"\u00c1rea due\u00f1a de la orden",SALIDA:"\u00c1rea que consume",PRESTAMO:"\u00c1rea que pide prestado",DEVOLUCION:"\u00c1rea que devuelve"}[t]||"\u00c1rea";
  $("#dObsL").textContent=t==="AJUSTE"?"Motivo del ajuste (obligatorio)":t==="MERMA"?"Motivo de la merma (obligatorio)":"Observaci\u00f3n";
  if(t==="DEVOLUCION"){
    const docs={}; S.loans.filter(l=>l.pend>0).forEach(l=>{(docs[l.doc]=docs[l.doc]||[]).push(l);});
    $("#dRef").innerHTML=`<option value="">Sobrante de obra (no es pr\u00e9stamo)</option>`+Object.entries(docs).map(([d,ls])=>`<option value="${esc(d)}">${esc(d)} \u00b7 ${esc(ls[0].con)} \u00b7 ${ls.length} \u00edtem${ls.length>1?"s":""} \u00b7 devolver ${fdate(ls[0].fdev)}${ls[0].estado==="Vencido"?" (VENCIDO)":""}</option>`).join("");
  }
  $("#dPickBox").hidden=false; entreUI(); prepLote(); prepUnd(); renderCart();
}
$("#dSeg").addEventListener("click",e=>{const b=e.target.closest("[data-tipo]");if(b&&b.dataset.tipo!==S.d.tipo)setTipo(b.dataset.tipo);});
function elegirRef(){
  const ref=$("#dRef").value; S.d.ref=ref; S.d.cart=[];
  if(ref){ const ls=S.loans.filter(l=>l.doc===ref&&l.pend>0);
    if(ls[0]){$("#dCon").value=ls[0].con||"";$("#dCont").value=ls[0].cont||"";$("#dObra").value=ls[0].obra||"";$("#dArea").value=ls[0].area||"";}
    S.d.cart=ls.map(l=>({codigo:l.codigo,desc:l.desc,und:l.und,cant:l.pend,pu:0,lote:l.lote,max:l.pend,origen:""})); }
  $("#dPickBox").hidden=!!ref; renderCart();
}
$("#dRef").addEventListener("change",elegirRef);
var usaLote=()=>["SALIDA","PRESTAMO","DEVOLUCION","MERMA"].includes(S.d.tipo);
// cuanto del documento ya sale de esa orden (incluye reposiciones)
function enCartLote(id,skip){return S.d.cart.reduce((a,x,i)=>a+(i!==skip&&(x.origen===id||(TIPO[S.d.tipo].signo<0&&x.lote===id))?N(x.cant):0),0);}
function enCartMat(cod,skip){return S.d.cart.reduce((a,x,i)=>a+(i!==skip&&U(x.codigo)===U(cod)&&!x.origen?N(x.cant):0),0);}
var libreLote=id=>(S.lots[id]?S.lots[id].SALDO:0)-N(S.resL[id]);   // descuenta lo ya solicitado y no entregado
var dispLote=(id,skip)=>(S.lots[id]?S.lots[id].SALDO:0)-enCartLote(id,skip);
var dispMat=(cod,skip)=>(S.byCod[U(cod)]?S.byCod[U(cod)].saldo:0)-enCartMat(cod,skip);
function lotesDe(cod){const a=U($("#dArea").value);
  if(entre()){ const ob=U($("#dObra").value);   // para otra obra: primero stock general (sin deuda), luego las ordenes de otras etapas
    return (S.lotsMat[U(cod)]||[]).filter(l=>esGeneral(l)||U(l.OBRA)!==ob).sort((x,y)=>esGeneral(y)-esGeneral(x)||String(x.FECHA).localeCompare(String(y.FECHA))); }
  return (S.lotsMat[U(cod)]||[]).slice().sort((x,y)=>(U(y.AREA)===a)-(U(x.AREA)===a)||String(x.FECHA).localeCompare(String(y.FECHA)));}
var entre=()=>S.d&&S.d.tipo==="PRESTAMO"&&$("#dEntre").checked;
function entreUI(){ const e=entre(); $("#dAutBox").hidden=!e;
  $("#dObraL").textContent=e?"Obra / etapa que pide":"Obra / etapa"; $("#dConL").textContent=S.d.tipo==="PRESTAMO"?(e?"Recibe":"Prestado a"):$("#dConL").textContent;
  $("#dObsL").textContent=e?"Motivo (obligatorio)":S.d.tipo==="AJUSTE"?"Motivo del ajuste (obligatorio)":S.d.tipo==="MERMA"?"Motivo de la merma (obligatorio)":"Observaci\u00f3n"; }
$("#dEntre").addEventListener("change",()=>{ S.d.cart=[]; entreUI(); prepLote(); renderCart(); });
$("#dObra").addEventListener("change",()=>{ if(entre()){ S.d.cart=S.d.cart.filter(x=>!x.lote||esGeneral(S.lots[x.lote])||U(S.lots[x.lote].OBRA)!==U($("#dObra").value)); prepLote(); renderCart(); } });
function prepLote(){
  const s=matFind($("#dMat").value), t=S.d.tipo, box=$("#dLoteBox"), sel=$("#dLote"); $("#dWarn").textContent="";
  const ls=s?lotesDe(s.codigo):[];
  box.hidden=!usaLote()||!s||!ls.length;
  if(box.hidden){sel.innerHTML="";return;}
  const neg=TIPO[t].signo<0, lista=neg?ls.filter(l=>dispLote(l.ID)>0):ls;
  sel.innerHTML=(neg?"":`<option value="">Sin orden espec\u00edfica</option>`)+(lista.length?lista.map(l=>{const res=N(S.resL[l.ID]);return `<option value="${esc(l.ID)}">${entre()?(esGeneral(l)?"STOCK GENERAL (sin deuda) \u00b7 ":"Pr\u00e9stamo de "+esc(l.OBRA||"orden sin etapa")+" \u00b7 "):""}${esc(l.REQ||"sin REQ")} \u00b7 ${esc(lotTxt(l))}${l.OC&&l.OC.n>1?" \u00b7 llegada "+l.LLEGADA:""} \u00b7 quedan ${fmt(dispLote(l.ID))} ${esc(l.UND)}${res?" ("+fmt(res)+" solicitados)":""}</option>`;}).join(""):`<option value="">Ninguna orden tiene saldo</option>`);
  avisoLote();
}
function avisoLote(){const l=S.lots[$("#dLote").value], a=U($("#dArea").value); $("#dWarn").textContent="";
  if(l&&a&&l.AREA&&U(l.AREA)!==a&&S.d.tipo==="SALIDA") $("#dWarn").textContent=`Esta orden es de ${l.AREA}. Si se la est\u00e1s prestando a ${a}, usa Pr\u00e9stamo para que vuelva a su orden.`;}
$("#dLote").addEventListener("change",avisoLote); $("#dArea").addEventListener("change",()=>{prepLote();});
$("#dMat").addEventListener("input",()=>{const s=matFind($("#dMat").value); $("#dErr").textContent="";
  $("#dInfo").textContent=s?`${s.codigo} \u00b7 ${s.und} \u00b7 stock general ${fmt(s.saldo)}`+(s.cp?` \u00b7 costo prom. ${money(s.cp)} por ${s.und}`:""):"";
  prepLote(); prepUnd();
  if(s&&["SALIDA","PRESTAMO"].includes(S.d.tipo)){const r=retazoAviso(s.codigo); if(r) $("#dWarn").textContent=r;}
  if(s&&kgDe(s.codigo,s.saldo)) $("#dInfo").textContent+=` (${kgDe(s.codigo,s.saldo)})`;});
$("#dRet").addEventListener("change",()=>{$("#dRetUBox").hidden=!$("#dRet").checked; updConv(false);});
$("#dRetU").addEventListener("change",()=>updConv(false));
/* ---------- unidad de compra (solo ingreso): se convierte a la unidad de almacen ---------- */
var undC=()=>$("#dUndC").value==="__otra"?undCan($("#dUndN").value):U($("#dUndC").value);
function prepUnd(){ // llena el selector con la unidad de almac\u00e9n + equivalencias del material
  const s=matFind($("#dMat").value), sel=$("#dUndC");
  sel.innerHTML=s?`<option value="${esc(s.und)}">${esc(s.und)} (unidad de almac\u00e9n)</option>`+eqDe(s.codigo).map(e=>`<option value="${esc(e.UND_COMPRA)}">${esc(e.UND_COMPRA)} \u00b7 ${esc(eqTxt(e))}${e.TIPO==="FIJA"?"":" (variable)"}</option>`).join("")+`<option value="__otra">Otra unidad\u2026</option>`:`<option value="">Elige primero el material</option>`;
  sel.disabled=!s; $("#dUndN").value=""; $("#dFac").value=""; $("#dFija").checked=false; updConv(true); }
function updConv(prefill){
  const s=matFind($("#dMat").value), t=S.d.tipo, u=undC(), conv=t==="INGRESO"&&!!s&&!!u&&!undIgual(u,s.und), e=conv?eqBusca(s.codigo,u):null;
  $("#dUndNBox").hidden=!(t==="INGRESO"&&$("#dUndC").value==="__otra");
  $("#dFacBox").hidden=!conv; $("#dFijaBox").hidden=!conv||!!e;
  $("#dCantL").textContent=t==="AJUSTE"?"Conteo f\u00edsico":t==="INTERNAMIENTO"&&$("#dRet").checked?`Medida del retazo (${$("#dRetU").value})`:`Cantidad${conv?` (${u})`:s?` (${s.und})`:""}`;
  $("#dPuL").textContent=`P.U. sin IGV${conv?" por "+u:s?" por "+s.und:""} (S/)`;
  if(conv){ $("#dFacU").textContent=u; $("#dFacB").textContent=s.und;
    if(prefill){ $("#dFac").value=e?e.FACTOR:""; $("#dPu").value=e&&s.cp?Math.round(s.cp*e.FACTOR*100)/100:""; }
    $("#dFac").readOnly=!!(e&&e.TIPO==="FIJA"); }
  else if(prefill&&t==="INGRESO") $("#dPu").value=s&&s.cp?Math.round(s.cp*100)/100:"";
  convPreview(); }
function convPreview(){
  const s=matFind($("#dMat").value), t=S.d.tipo, q=N($("#dCant").value); let txt="";
  if(s&&t==="INGRESO"&&!$("#dFacBox").hidden){ const u=undC(), e=eqBusca(s.codigo,u), f=N($("#dFac").value), pu=N($("#dPu").value);
    txt=!(f>0)?`Escribe cu\u00e1ntos ${s.und} trae 1 ${u}.`:(e&&e.TIPO==="FIJA"?"Equivalencia fija. ":e?"\u00daltimo factor usado: corr\u00edgelo si la gu\u00eda dice otro peso. ":"")+
      (q>0?`Ingresan ${fmt(q*f)} ${s.und}`+(pu?` a S/ ${new Intl.NumberFormat("es-PE",{maximumFractionDigits:4}).format(pu/f)} por ${s.und}`:""):""); }
  else if(s&&TIPO[t]&&TIPO[t].signo<0) txt=aprox(s.codigo,q);
  $("#dConv").textContent=txt; }
$("#dUndC").addEventListener("change",()=>{updConv(true); if(!$("#dUndNBox").hidden) $("#dUndN").focus();});
$("#dUndN").addEventListener("input",()=>updConv(true));
["#dFac","#dCant","#dPu"].forEach(x=>$(x).addEventListener("input",convPreview));
$("#dAdd").onclick=()=>{
  const s=matFind($("#dMat").value), q=Number($("#dCant").value), t=S.d.tipo, err=$("#dErr"), lote=$("#dLoteBox").hidden?"":$("#dLote").value;
  if(!s){err.textContent=t==="INGRESO"?"Ese material no est\u00e1 registrado. Usa + Material nuevo para crearlo con su c\u00f3digo.":"Elige un material de la lista.";return;}
  if(t==="AJUSTE"?!(q>=0)||$("#dCant").value==="":!(q>0)){err.textContent=t==="AJUSTE"?"Escribe la cantidad contada (puede ser 0).":"La cantidad debe ser mayor que cero.";return;}
  if(t==="AJUSTE"&&S.d.cart.some(x=>U(x.codigo)===U(s.codigo))){err.textContent="Este material ya est\u00e1 en el ajuste.";return;}
  const u=t==="INGRESO"?undC():"";
  if(t==="INGRESO"&&$("#dUndC").value==="__otra"&&!u){err.textContent="Escribe la unidad en que compr\u00f3 log\u00edstica.";return;}
  if(u&&!undIgual(u,s.und)){ const e=eqBusca(s.codigo,u), f=e&&e.TIPO==="FIJA"?e.FACTOR:N($("#dFac").value);
    if(!(f>0)){err.textContent=`Indica cu\u00e1ntos ${s.und} trae 1 ${u}.`;return;}
    const qb=Math.round(q*f*1e6)/1e6;
    if(noEntero(qb,s.und)){err.textContent=`${fmt(q)} ${u} dan ${fmt(qb)} ${s.und}, y ${s.und} solo acepta cantidades enteras. Revisa el factor.`;return;}
    const puC=N($("#dPu").value);
    S.d.cart.push({codigo:s.codigo,desc:s.desc,und:s.und,cant:qb,pu:puC/f,undC:u,cantC:q,puC,fac:f,fija:!e&&$("#dFija").checked,lote:"",origen:""});
    ["#dMat","#dCant","#dPu"].forEach(x=>$(x).value=""); err.textContent=""; $("#dInfo").textContent=""; prepLote(); prepUnd(); renderCart(); $("#dMat").focus(); return; }
  if(t==="INTERNAMIENTO"){ const ret=$("#dRet").checked&&!matDe(s.codigo).RETAZO_DE, ur=$("#dRetU").value, und=ret?ur:s.und;
    if(noEntero(q,und)){err.textContent=`${und} se cuenta en enteros: no se aceptan decimales.`;return;}
    S.d.cart.push({codigo:s.codigo,desc:ret?"RETAZO "+s.desc+(ur==="M"?"":" ("+ur+")"):s.desc,und,cant:q,pu:ret?0:s.cp,lote:"",origen:"",estado:$("#dEst").value,retazo:ret,undRetazo:ret?ur:"",base:s.desc});
    ["#dMat","#dCant"].forEach(x=>$(x).value=""); $("#dRet").checked=false; $("#dRetUBox").hidden=true; $("#dEst").value="BUENO"; err.textContent=""; $("#dInfo").textContent=""; prepLote(); updConv(false); renderCart(); $("#dMat").focus(); return; }
  if(noEntero(q,s.und)){err.textContent=`${s.und} se cuenta en enteros: no se aceptan decimales.`;return;}
  if(TIPO[t].signo<0){
    if(!$("#dLoteBox").hidden&&!lote){err.textContent="Elige de qu\u00e9 orden de compra sale.";return;}
    if(q>dispMat(s.codigo)){err.textContent=`Stock insuficiente. Disponible: ${fmt(dispMat(s.codigo))} ${s.und}.`;return;}
    if(lote&&q>dispLote(lote)){ const pl=planLlegadas(lote,q);
      if(!pl){err.textContent=`Esa orden solo tiene ${fmt(dispLote(lote))} ${s.und}.`+(entre()?" Agrega esa cantidad de aqu\u00ed y el resto de una orden de otra etapa.":"");return;}
      pl.forEach(p=>S.d.cart.push({codigo:s.codigo,desc:s.desc,und:s.und,cant:p.q,pu:p.l.PU,lote:p.l.ID,origen:""}));
      toast(`Sale de ${pl.length} llegadas de la ORC ${S.lots[lote].ORC}, desde la m\u00e1s antigua.`);
      ["#dMat","#dCant","#dPu"].forEach(x=>$(x).value=""); err.textContent=""; $("#dInfo").textContent=""; prepLote(); prepUnd(); renderCart(); $("#dMat").focus(); return; }
  }
  S.d.cart.push({codigo:s.codigo,desc:s.desc,und:s.und,cant:q,pu:t==="INGRESO"?N($("#dPu").value):(S.lots[lote]?S.lots[lote].PU:s.cp),lote,origen:""});
  ["#dMat","#dCant","#dPu"].forEach(x=>$(x).value=""); err.textContent=""; $("#dInfo").textContent=""; prepLote(); prepUnd(); renderCart(); $("#dMat").focus();
};
$("#dCant").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();$("#dAdd").click();}});
function renderCart(){
  const t=S.d.tipo, c=S.d.cart, conPR=t==="DEVOLUCION"&&S.d.ref;
  $("#dColOrc").textContent=conPR?"Vuelve a la orden":"Orden";
  $("#dColOrc").hidden=t==="INGRESO"||t==="AJUSTE"||t==="INTERNAMIENTO";
  $("#dColCtx").textContent=t==="AJUSTE"?"Saldo sistema":conPR?"Pendiente":TIPO[t].signo<0?"Disponible":"Stock actual";
  $("#dColCant").textContent=t==="AJUSTE"?"Conteo":"Cantidad";
  $("#dColTot").textContent=t==="AJUSTE"?"Diferencia":"Total S/";
  $("#dTotL").textContent=t==="AJUSTE"?"\u00cdtems a ajustar":"Total del documento";
  $("#dItems").innerHTML=c.length?c.map((x,i)=>{const s=S.byCod[U(x.codigo)]||{saldo:0,cp:0}, l=S.lots[x.lote];
    const ctx=conPR?x.max:TIPO[t].signo<0?(x.lote?dispLote(x.lote,i):dispMat(x.codigo,i)):x.retazo?sum(retazosDe(x.codigo).filter(r=>r.und===x.und),r=>r.saldo):s.saldo;
    const pu=t==="INGRESO"||t==="INTERNAMIENTO"?x.pu:(l?l.PU:s.cp);
    const last=t==="AJUSTE"?`<b class="${x.cant-s.saldo<0?"neg":"pos"}">${x.cant-s.saldo>0?"+":""}${fmt(x.cant-s.saldo)}</b>`:mf.format(x.cant*pu);
    let orc=l?esc(lotTxt(l)):'<span class="note">\u2014</span>';
    if(conPR){ const otras=(S.lotsMat[U(x.codigo)]||[]).filter(o=>o.ID!==x.lote&&(dispLote(o.ID,i)>0||o.ID===x.origen));
      orc+=`<div style="margin-top:4px"><select data-org="${i}" aria-label="C\u00f3mo se devuelve"><option value="">Regresa el material f\u00edsico</option>${otras.map(o=>`<option value="${esc(o.ID)}" ${o.ID===x.origen?"selected":""}>Reponer desde ${esc(lotTxt(o))} (quedan ${fmt(dispLote(o.ID,i))})</option>`).join("")}</select></div>`; }
    const kgx=x.retazo?(x.undRetazo==="M"&&kgPorMetro(x.base)?`\u2248 ${fmt(x.cant*kgPorMetro(x.base))} kg`:""):kgDe(x.codigo,x.cant);
    const cv=t==="INGRESO"&&x.fac, ax=[TIPO[t].signo<0?aprox(x.codigo,x.cant):"",kgx].filter(Boolean).join(" \u00b7 ");
    const vt=vidaTipo(x.codigo), extra=t==="INTERNAMIENTO"?`<label class="code mini">Estado <select data-est="${i}">${["BUENO","REGULAR","MALOGRADO"].map(e=>`<option ${x.estado===e?"selected":""}>${e}</option>`).join("")}</select></label>${x.retazo?' <span class="pill info">Retazo</span>':""}${x.estado==="MALOGRADO"?' <span class="pill bad">No entra al stock</span>':""}`
      :t==="INGRESO"&&vt==="PERECIBLE"?`<label class="code mini">Vence (fecha del empaque, opcional) <input type="date" value="${esc(x.vence||"")}" data-ven="${i}"></label>`
      :t==="DEVOLUCION"&&vt==="HERRAMIENTA"?`<label class="code mini">Estado al volver <select data-est="${i}">${["BUENO","REGULAR","MALOGRADO"].map(e=>`<option ${x.estado===e?"selected":""}>${e}</option>`).join("")}</select></label>`:"";
    const ocx=t==="INGRESO"?ocCampo(x,i):"";
    return `<tr><td>${i+1}</td><td>${esc(x.desc)}<div class="code">${esc(x.codigo)}</div>${extra}${ocx}</td><td>${cv?`${esc(x.undC)}<div class="code">1 = ${fmt(x.fac)} ${esc(x.und)}</div>`:esc(x.und)}</td><td ${$("#dColOrc").hidden?"hidden":""}>${orc}</td><td class="num">${fmt(ctx)}</td>
    <td class="num">${cv?`<input class="qty" type="number" min="0" step="any" value="${x.cantC}" data-qc="${i}" aria-label="Cantidad en ${esc(x.undC)}"><div class="code">= ${fmt(x.cant)} ${esc(x.und)}</div>`:`<input class="qty" type="number" min="0" step="any" value="${x.cant}" data-q="${i}" aria-label="Cantidad">${ax?`<div class="code">${esc(ax)}</div>`:""}`}</td>
    <td class="num">${cv?`<input class="qty" type="number" min="0" step="any" value="${x.puC}" data-puc="${i}" aria-label="Precio por ${esc(x.undC)}"><div class="code">${mf.format(x.pu)} / ${esc(x.und)}</div>`:t==="INGRESO"?`<input class="qty" type="number" min="0" step="any" value="${x.pu}" data-pu="${i}" aria-label="Precio unitario">`:mf.format(pu)}</td>
    <td class="num">${last}</td><td><button class="btn sm" data-rm="${i}">Quitar</button></td></tr>`;}).join("")
    :`<tr><td colspan="9" class="empty">${conPR?"Este pr\u00e9stamo ya no tiene pendientes.":"Agrega materiales con el buscador de arriba."}</td></tr>`;
  $("#dTot").textContent=t==="AJUSTE"?String(c.length):money(sum(c,x=>x.cant*(t==="INGRESO"||t==="INTERNAMIENTO"?x.pu:((S.lots[x.lote]||{}).PU??(S.byCod[U(x.codigo)]||{}).cp))));
}
$("#dItems").addEventListener("change",e=>{const d=e.target.dataset;
  const v=Number(e.target.value)||0;
  if(d.qc!=null){const x=S.d.cart[d.qc]; x.cantC=v; x.cant=Math.round(v*x.fac*1e6)/1e6;}
  if(d.puc!=null){const x=S.d.cart[d.puc]; x.puC=v; x.pu=v/x.fac;}
  if(d.q!=null) S.d.cart[d.q].cant=Number(e.target.value)||0; if(d.pu!=null) S.d.cart[d.pu].pu=Number(e.target.value)||0; if(d.org!=null) S.d.cart[d.org].origen=e.target.value; if(d.ven!=null) S.d.cart[d.ven].vence=e.target.value; if(d.est!=null) S.d.cart[d.est].estado=e.target.value; if(d.oc!=null) S.d.cart[d.oc].oc=Number(e.target.value)||0; setTimeout(renderCart);});
$("#dOrc").addEventListener("input",()=>{ if(S.d&&S.d.tipo==="INGRESO"&&S.d.cart.length) renderCart(); });
var vidaTipo=cod=>U((S.mat.find(m=>U(m.CODIGO)===U(cod))||{}).VIDA_TIPO);
$("#dItems").addEventListener("click",e=>{const b=e.target.closest("[data-rm]");if(!b)return;S.d.cart.splice(+b.dataset.rm,1);renderCart();});
function validarDoc(){
  const t=S.d.tipo, c=S.d.cart, conPR=t==="DEVOLUCION"&&S.d.ref;
  if(!c.length) return "El documento no tiene \u00edtems.";
  if(t==="INGRESO"&&!$("#dProv").value) return "Elige el proveedor.";
  if(["INGRESO","SALIDA","PRESTAMO"].includes(t)&&!$("#dArea").value) return "Elige el \u00e1rea.";
  if((t==="SALIDA"||t==="PRESTAMO")&&!$("#dCon").value) return "Elige a qui\u00e9n se entrega el material.";
  if(t==="PRESTAMO"&&!$("#dFdev").value) return "Indica la fecha de devoluci\u00f3n.";
  if(t==="PRESTAMO"&&$("#dFdev").value<$("#dFecha").value) return "La fecha de devoluci\u00f3n no puede ser anterior a la del pr\u00e9stamo.";
  if(t==="AJUSTE"&&!$("#dObs").value.trim()) return "Escribe el motivo del ajuste.";
  if(t==="INTERNAMIENTO"&&!$("#dCon").value) return "Elige el contratista que devuelve el material.";
  if(t==="MERMA"&&!$("#dObs").value.trim()) return "Escribe el motivo de la merma.";
  if(entre()&&!$("#dObra").value) return "Elige la obra o etapa que pide el material.";
  if(entre()&&!$("#dAut").value.trim()) return "Escribe qui\u00e9n autoriz\u00f3 el pr\u00e9stamo.";
  if(entre()&&!$("#dObs").value.trim()) return "Escribe el motivo.";
  for(const [i,x] of c.entries()){
    if(t==="AJUSTE"?x.cant<0:!(x.cant>0)&&!conPR) return `Cantidad no v\u00e1lida en ${x.desc}.`;
    if(noEntero(x.cant,x.und)) return x.fac?`${x.desc}: ${fmt(x.cantC)} ${x.undC} dan ${fmt(x.cant)} ${x.und}, y ${x.und} solo acepta enteros.`:`${x.desc}: ${x.und} solo acepta cantidades enteras.`;
    if(TIPO[t].signo<0&&x.lote&&x.cant>dispLote(x.lote,i)) return `La orden de ${x.desc} solo tiene ${fmt(dispLote(x.lote,i))}.`;
    if(TIPO[t].signo<0&&x.cant>dispMat(x.codigo,i)) return `Stock insuficiente de ${x.desc}. Disponible: ${fmt(dispMat(x.codigo,i))}.`;
    if(conPR&&x.cant>x.max) return `Se devuelve m\u00e1s de lo prestado en ${x.desc}. Pendiente: ${fmt(x.max)}.`;
    if(x.origen&&x.cant>dispLote(x.origen,i)) return `La orden con la que repones ${x.desc} solo tiene ${fmt(dispLote(x.origen,i))}.`;
  }
  if(conPR&&!c.some(x=>x.cant>0)) return "Indica cu\u00e1nto se devuelve.";
  if(t==="AJUSTE"&&c.every(x=>x.cant===(S.byCod[U(x.codigo)]||{}).saldo)) return "El conteo coincide con el sistema: no hay nada que ajustar.";
  return "";
}
$("#dSave").onclick=async()=>{
  const err=$("#dSaveErr"); err.textContent=""; const m=validarDoc(); if(m){err.textContent=m;return;}
  const t=S.d.tipo, v=s=>$(s).value.trim();
  const cab={tipo:t,fecha:$("#dFecha").value||today(),proveedor:v("#dProv"),orc:v("#dOrc"),req:v("#dReq"),guia:v("#dGuia"),area:v("#dArea"),contratista:v("#dCon"),contrato:v("#dCont"),obra:v("#dObra"),
    uso:v("#dUso"),solicitante:v("#dSol"),docRef:t==="DEVOLUCION"?S.d.ref:"",fechaDev:t==="PRESTAMO"?$("#dFdev").value:"",obs:v("#dObs")};
  const items=S.d.cart.filter(x=>t!=="DEVOLUCION"||x.cant>0).map(x=>({codigo:x.codigo,cant:x.cant,pu:x.pu,lote:x.lote||"",origen:x.origen||"",
    undCompra:x.fac?x.undC:"",cantCompra:x.fac?x.cantC:"",puCompra:x.fac?x.puC:"",factor:x.fac||"",fija:!!x.fija,
    vence:t==="INGRESO"?(x.vence||""):"",estado:t==="INTERNAMIENTO"?(x.estado||"BUENO"):t==="DEVOLUCION"&&vidaTipo(x.codigo)==="HERRAMIENTA"?(x.estado||"BUENO"):"",
    retazo:t==="INTERNAMIENTO"&&!!x.retazo,undRetazo:x.undRetazo||"",cantOc:t==="INGRESO"?ocTotal(x):""}));
  $("#dSave").disabled=true; $("#dSave").textContent="Registrando\u2026";
  try{ if(entre()){ cab.autoriza=v("#dAut"); const r=await api("registrarPrestamoObras",cab,items); await cargar();
      $("#dForm").hidden=true; $("#dDone").hidden=false; $("#dDoneN").textContent=[r.pr,r.vs].filter(Boolean).join(" + "); S.d.done=r.pr||r.vs;
      $("#dDoneTxt").textContent=(r.pr?`${r.pr}: pr\u00e9stamo a ${cab.obra}, devolver el ${fdate(cab.fechaDev)}. `:"")+(r.vs?`${r.vs}: vale de salida del stock general, sin deuda.`:"");
      $("#dSave").disabled=false; $("#dSave").textContent="Registrar documento"; return; }
    const doc=await api("registrarDocumento",cab,items); await cargar();
    $("#dForm").hidden=true; $("#dDone").hidden=false; $("#dDoneN").textContent=doc; S.d.done=doc;
    $("#dDoneTxt").textContent=`${TIPO[t].doc} con ${items.length} \u00edtem${items.length>1?"s":""}`+(cab.contratista&&t!=="INGRESO"?` \u00b7 ${cab.contratista}`:"")+(t==="PRESTAMO"?` \u00b7 devolver el ${fdate(cab.fechaDev)}`:"")+".";
    if(t==="INGRESO") avisoDeuda(doc,cab.obra,cab.area);
  }catch(e){ err.textContent="No se pudo registrar: "+msg(e); }
  $("#dSave").disabled=false; $("#dSave").textContent="Registrar documento";
};
$("#dPrint").onclick=()=>printDoc(S.d.done);
// al ingresar una orden de una etapa que debe material a otra: ofrece devolverlo con esta orden
function deudasDe(obra,cods,area){ return S.loans.filter(l=>l.aut&&l.pend>0&&(l.obra?obra&&U(l.obra)===U(obra):area&&U(l.area)===U(area))&&(!cods||cods.includes(U(l.codigo)))); }
function avisoDeuda(doc,obra,area){ const box=$("#dDeuda"), nuevos=S.lotList.filter(l=>l.DOC===doc), d=deudasDe(obra,nuevos.map(l=>U(l.CODIGO)),area);
  box.hidden=!d.length; if(!d.length) return; const g={}; d.forEach(l=>(g[l.doc]=g[l.doc]||[]).push(l));
  box.innerHTML=`<b>${esc(U(obra||area))} debe material prestado por otra etapa</b>`+Object.entries(g).map(([pr,ls])=>`<div class="row"><span>${ls.map(l=>`${fmt(l.pend)} ${esc(l.und)} de ${esc(l.desc)} a ${esc(l.de)}`).join("; ")} (${esc(pr)})</span><button class="btn sm primary" data-devobra="${esc(pr)}" data-ni="${esc(doc)}">Devolver ahora</button></div>`).join(""); }
$("#dDeuda").addEventListener("click",e=>{ const b=e.target.closest("[data-devobra]"); if(!b) return; const ni=b.dataset.ni;
  abrirDoc("DEVOLUCION",b.dataset.devobra); let n=0;
  S.d.cart.forEach((x,i)=>{ const l=S.lotList.find(o=>o.DOC===ni&&U(o.CODIGO)===U(x.codigo)&&dispLote(o.ID,i)>0); if(!l) { x.cant=0; return; }
    x.origen=l.ID; x.cant=Math.min(x.cant,dispLote(l.ID,i)); n++; });
  renderCart(); toast(n?`Se repone con la orden nueva ${ni}: el saldo vuelve a la orden de la etapa que prest\u00f3. Revisa y registra.`:"La orden nueva no tiene esos materiales."); });
$("#dOtro").onclick=()=>abrirDoc(S.d.tipo);

/* ---------- materiales ---------- */
function nuevoCodigo(cat){
  cat=U(cat); if(!cat) return "";
  const deCat=S.mat.filter(m=>U(m.CATEGORIA)===cat&&/-\d{4}$/.test(String(m.CODIGO))); let pre;
  if(deCat.length){const c={};deCat.forEach(m=>{const p=String(m.CODIGO).replace(/-\d{4}$/,"");c[p]=(c[p]||0)+1;});pre=Object.keys(c).sort((a,b)=>c[b]-c[a])[0];}
  else pre=cat.normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^A-Z0-9]/g,"").slice(0,4)||"MAT";
  const max=Math.max(0,...S.mat.filter(m=>String(m.CODIGO).startsWith(pre+"-")).map(m=>parseInt(String(m.CODIGO).slice(-4),10)||0));
  return pre+"-"+String(max+1).padStart(4,"0");
}
function abrirMat(cod,desdeDoc){
  const s=cod?S.byCod[U(cod)]:null; S.edit=s?s.codigo:null; S.matDesdeDoc=!!desdeDoc;
  $("#mTit").textContent=s?"Editar material":"Material nuevo";
  $("#mDesc").value=s?s.desc:""; $("#mCat").value=s?s.cat:""; $("#mUnd").value=s?s.und:"UND"; $("#mCod").value=s?s.codigo:"";
  $("#mMin").value=s&&s.min?s.min:""; $("#mUbi").value=s?s.ubi:""; $("#mErr").textContent="";
  const mv=s?S.mat.find(m=>U(m.CODIGO)===U(s.codigo))||{}:{}; $("#mVidaT").value=U(mv.VIDA_TIPO); $("#mVidaD").value=N(mv.VIDA_DIAS)||""; $("#mVidaF").value=str(mv.VIDA_FUENTE); vidaForm();
  const conMov=!!s&&S.mov.some(x=>U(x.CODIGO)===U(s.codigo)); S.editMov=conMov;
  ["#mDesc","#mCat"].forEach(x=>$(x).readOnly=!!s); $("#mUnd").readOnly=conMov;
  $("#mUnd").title=conMov?"Ya tiene movimientos: la unidad no se cambia. Usa una equivalencia de compra.":"";
  $("#pMat").hidden=false; (s?$("#mMin"):$("#mDesc")).focus({preventScroll:true});
}
$("#btnMat").onclick=()=>abrirMat(null);
function vidaForm(){ const t=$("#mVidaT").value; $("#mVidaDBox").hidden=!t; $("#mVidaFBox").hidden=!t;
  $("#mVidaDL").textContent=t==="PERECIBLE"?"Vence a los (d\u00edas del ingreso)":t==="REVISION"?"Revisar cada (d\u00edas)":"Reponer cada (d\u00edas, referencial)"; }
$("#mVidaT").addEventListener("change",vidaForm);
$("#btnVidaSug").onclick=async()=>{ if(!confirm("Se cargar\u00e1 una vida \u00fatil referencial (cemento 90 d\u00edas, yeso 90, pegamentos y siliconas 12 meses, pinturas 24 meses, acero y cables en revisi\u00f3n, herramientas en reposici\u00f3n) solo en los materiales que a\u00fan no tienen una. Despu\u00e9s confirma cada valor con la ficha t\u00e9cnica. \u00bfContinuar?")) return;
  try{ const r=await api("aplicarVidaSugerida"); await cargar(); toast(r.n?`Vida \u00fatil cargada en ${r.n} materiales. Rev\u00edsalos en la columna Vida \u00fatil.`:"No hubo materiales nuevos que coincidan con las reglas."); }catch(x){ toast("No se pudo: "+msg(x)); } };
$("#dNewMat").onclick=()=>{abrirMat(null,true); const t=$("#dMat").value.trim(); if(t&&!matFind(t)) $("#mDesc").value=t.toUpperCase();};
$("#tbMat").addEventListener("click",e=>{const b=e.target.closest("[data-edit]");if(b)abrirMat(b.dataset.edit);});
$("#mCat").addEventListener("input",()=>{if(!S.edit)$("#mCod").value=nuevoCodigo($("#mCat").value);});
$("#fMat").onsubmit=async e=>{e.preventDefault(); const err=$("#mErr"); err.textContent="";
  const d={descripcion:$("#mDesc").value.trim(),categoria:$("#mCat").value.trim(),und:$("#mUnd").value.trim(),stockMin:Number($("#mMin").value)||0,ubicacion:$("#mUbi").value.trim(),
    vidaTipo:$("#mVidaT").value,vidaDias:Number($("#mVidaD").value)||0,vidaFuente:$("#mVidaF").value.trim()};
  if(d.vidaTipo&&!(d.vidaDias>0)){err.textContent="Indica la vida \u00fatil en d\u00edas.";return;}
  if(!S.edit){ if(!d.descripcion||!d.categoria||!d.und){err.textContent="Completa descripci\u00f3n, categor\u00eda y unidad.";return;}
    if(S.mat.some(m=>U(m.DESCRIPCION)===U(d.descripcion))){err.textContent="Este material ya est\u00e1 registrado.";return;} }
  $("#mSave").disabled=true;
  try{ const cod=S.edit?await api("actualizarMaterial",{codigo:S.edit,und:S.editMov?"":d.und,stockMin:d.stockMin,ubicacion:d.ubicacion,vidaTipo:d.vidaTipo,vidaDias:d.vidaDias,vidaFuente:d.vidaFuente}):await api("registrarMaterial",d);
    toast(S.edit?`Material ${cod} actualizado`:`Material registrado con c\u00f3digo ${cod}`); $("#pMat").hidden=true; await cargar();
    if(S.matDesdeDoc&&!S.edit){ $("#dMat").value=U(d.descripcion); $("#dMat").dispatchEvent(new Event("input")); $("#dCant").focus(); }
  }catch(x){err.textContent="No se pudo guardar: "+msg(x);}
  $("#mSave").disabled=false; };

$("#btnCsv").onclick=()=>{
  const rows=[["CODIGO","DESCRIPCION","CATEGORIA","UND","UND SUNAT","ENTRADAS","SALIDAS","PRESTADO","SALDO","STOCK_MIN","ESTADO","COSTO_PROM","VALOR S/"]]
    .concat(filtStock(U($("#qStock").value),$("#qStCat").value,$("#qSt").value).map(s=>[s.codigo,s.desc,s.cat,s.und,undSunat(s.und),s.ent,s.sal,s.pres,s.saldo,s.min,s.estado,s.cp.toFixed(4),s.valor.toFixed(2)]));
  const csv="\ufeff"+rows.map(r=>r.map(v=>`"${String(v).replace(/"/g,'""')}"`).join(";")).join("\r\n");
  const a=document.createElement("a"); a.href=URL.createObjectURL(new Blob([csv],{type:"text/csv"})); a.download=`STOCK-ALMACEN-${today()}.csv`; document.body.appendChild(a); a.click(); a.remove(); };

/* ---------- panel ---------- */
var CH={};
var css=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
var MES=["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Set","Oct","Nov","Dic"];
var short=(t,n=28)=>{t=String(t);return t.length>n?t.slice(0,n-1)+"\u2026":t;};
function chart(id,cfg){ if(!window.Chart) return; if(CH[id]){CH[id].data=cfg.data;CH[id].options=cfg.options;CH[id].update();return;} CH[id]=new Chart(document.getElementById(id),cfg); }
function baseOpts(horiz,isMoney){
  const ink=css("--muted"), grid=css("--line");
  const fmtV=v=>isMoney?"S/ "+nf.format(v):nf.format(v);
  const kfmt=v=>(isMoney?"S/ ":"")+(Math.abs(v)>=1000?nf.format(v/1000)+"k":nf.format(v));
  const valAxis={grid:{color:grid},border:{display:false},beginAtZero:true,ticks:{color:ink,maxRotation:0,maxTicksLimit:6,callback:kfmt}};
  const catAxis={grid:{display:false},border:{display:false},ticks:{color:ink,maxRotation:0,autoSkip:false,callback:function(v){return short(this.getLabelForValue(v),horiz?30:12);}}};
  return {responsive:true,maintainAspectRatio:false,indexAxis:horiz?"y":"x",animation:false,
    plugins:{legend:{display:false},tooltip:{callbacks:{label:c=>" "+fmtV(c.parsed[horiz?"x":"y"])}}},
    scales:horiz?{x:valAxis,y:catAxis}:{x:catAxis,y:valAxis}};
}
var soles0=v=>"S/ "+new Intl.NumberFormat("es-PE",{maximumFractionDigits:0}).format(v);
// resalta: la ultima barra (el mes actual) va en color fuerte y las demas en suave, como en el diseno
function barras(id,pares,horiz,resalta){const acc=css("--accent"), bg=resalta&&/^#[0-9a-f]{6}$/i.test(acc)?pares.map((p,i)=>i===pares.length-1?acc:acc+"59"):acc;
  chart(id,{type:"bar",data:{labels:pares.map(p=>p[0]),datasets:[{data:pares.map(p=>Math.round(p[1]*100)/100),backgroundColor:bg,borderRadius:4,maxBarThickness:horiz?22:36}]},options:baseOpts(horiz,true)});}
function agrupar(arr,kf,vf){const m={};arr.forEach(x=>{const k=kf(x);m[k]=(m[k]||0)+N(vf(x));});return Object.entries(m).sort((a,b)=>b[1]-a[1]);}
function filasAtencion(){
  const pend=S.loans.filter(l=>l.pend>0);
  const at=pend.filter(l=>l.estado==="Vencido").map(l=>`<tr class="st-bad"><td>Pr\u00e9stamo ${esc(l.doc)}<div class="code">${esc(l.con)}</div></td><td>${esc(l.desc)}<div class="code">deb\u00eda volver el ${fdate(l.fdev)}, ${venceTxt(l)}</div></td><td class="num"><b>${fmt(l.pend)}</b> ${esc(l.und)}</td><td><span class="pill bad">Vencido</span></td><td>${canWrite()?`<button class="btn sm primary" data-dev="${esc(l.doc)}">Devolver</button>`:""}</td></tr>`)
    .concat(S.stock.filter(s=>s.estado==="Sin stock"||s.estado==="Bajo m\u00ednimo").sort((a,b)=>a.saldo-b.saldo).map(s=>{const k=stCls[s.estado];return `<tr class="st-${k}"><td>${esc(s.desc)}<div class="code">${esc(s.codigo)}</div></td><td class="note">${s.min?`M\u00ednimo ${fmt(s.min)} ${esc(s.und)}`:"Se agot\u00f3"}${s.pres?` \u00b7 ${fmt(s.pres)} prestado`:""}</td><td class="num"><b>${fmt(s.saldo)}</b> ${esc(s.und)}</td><td><span class="pill ${k}">${s.estado}</span></td><td><button class="btn sm" data-kdx="${esc(s.desc)}">Kardex</button></td></tr>`;}));
  if(canWrite()) S.sols.filter(o=>o.abierta).forEach(o=>{ const t=`Solicitud ${esc(o.doc)}${o.h.NRO_AREA?" ("+esc(o.h.NRO_AREA)+")":""}<div class="code">${esc(o.h.AREA)}${o.h.RECEPTOR?" \u00b7 "+esc(o.h.RECEPTOR):""}</div>`, p=pendientesSol(o);
    if(o.vencido) at.unshift(`<tr class="st-bad"><td>${t}</td><td class="note">No recogi\u00f3: deb\u00eda pasar el ${esc(recTxt(o.recojo))}</td><td class="num"><b>${p.length}</b> \u00edtem${p.length>1?"s":""}</td><td><span class="pill bad">Recojo vencido</span></td><td><button class="btn sm primary" data-ate="${esc(o.doc)}">Revisar</button></td></tr>`);
    else if(o.atendido>0){ const hay=p.filter(i=>sum(poolSol(solKey(i)),l=>Math.max(0,l.SALDO))>0);
      if(hay.length) at.unshift(`<tr class="st-warn"><td>${t}</td><td class="note">Ya hay material para completarla: ${hay.map(i=>esc(i.DESCRIPCION)+" (faltan "+fmt(i.CANT-i.ATENDIDO)+" "+esc(i.UND)+")").join(", ")}</td><td class="num"><b>${hay.length}</b> \u00edtem${hay.length>1?"s":""}</td><td><span class="pill info">Completar entrega</span></td><td><button class="btn sm primary" data-ate="${esc(o.doc)}">Atender</button></td></tr>`); } });
  at.push(...S.lotList.filter(l=>l.vida).sort((a,b)=>a.vida.dias-b.vida.dias).map(l=>`<tr class="st-${vidaCls[l.vida.estado]}"><td>${esc(l.DESCRIPCION)}<div class="code">ORC ${esc(l.ORC||"s/n")}${l.AREA?" \u00b7 "+esc(l.AREA):" \u00b7 stock general"}</div></td><td class="note">${esc(vidaTxt(l.vida))}</td><td class="num"><b>${fmt(l.SALDO)}</b> ${esc(l.UND)}</td><td><span class="pill ${vidaCls[l.vida.estado]}">${esc(l.vida.estado)}</span></td><td></td></tr>`),
    ...S.lotList.filter(l=>l.dorm).sort((a,b)=>b.dorm-a.dorm).map(l=>`<tr class="st-warn"><td>${esc(l.DESCRIPCION)}<div class="code">ORC ${esc(l.ORC||"s/n")}${l.REQ?" \u00b7 "+esc(l.REQ):""} \u00b7 ${esc(l.AREA)}</div></td><td class="note">${l.dorm} d\u00edas sin salidas</td><td class="num"><b>${fmt(l.libre)}</b> ${esc(l.UND)}</td><td><span class="pill warn">Sin movimiento</span></td><td>${puedeLiberar(l)?`<button class="btn sm" data-lib="${esc(l.ID)}">A stock general</button>`:""}</td></tr>`));
  return at; }
function renderAvisos(pend){
  const hoy=today(), pl=(n,s,p)=>n+" "+(n===1?s:p), lista=(a,f)=>a.slice(0,2).map(f).join("; ")+(a.length>2?" y "+(a.length-2)+" m\u00e1s":"");
  const sp=S.sols.filter(o=>o.estado==="ENVIADA"||o.estado==="VISTA"), rh=S.sols.filter(o=>o.abierta&&o.recojo&&o.recojo.fecha===hoy),
    pv=pend.filter(l=>l.fdev&&l.fdev>=hoy&&dias(hoy,l.fdev)<=7).sort((a,b)=>String(a.fdev).localeCompare(String(b.fdev))),
    ni=S.docs.filter(d=>d.tipo==="INGRESO"&&!d.h.ANULADO&&String(d.fecha).slice(0,10)>=addDays(hoy,-7));
  const C=[
    {k:"sol",pill:"warn",tag:"Pendiente",ic:"ic-sol",t:"Solicitudes por aprobar",n:sp.length,go:"Revisar",
     d:sp.length?`<b>${pl(sp.length,"solicitud","solicitudes")}</b> esperando revisi\u00f3n: ${lista(sp,o=>esc(o.doc)+" ("+esc(o.h.AREA)+")")}.`:"No hay solicitudes nuevas por revisar."},
    {k:"rec",pill:"info",tag:"Programaci\u00f3n",ic:"ic-cal",t:"Recojos programados hoy",n:rh.length,go:"Ver cronograma",
     d:rh.length?`<b>${pl(rh.length,"recojo","recojos")}</b>: ${lista(rh,o=>esc(o.h.RECEPTOR||o.h.AREA)+" ("+esc(recTxt(o.recojo))+")")}.`:"Nadie tiene recojo programado para hoy."},
    {k:"pre",pill:"bad",tag:"Vencimiento",ic:"ic-pres",t:"Pr\u00e9stamos que vencen en 7 d\u00edas",n:pv.length,go:"Ver pr\u00e9stamos",
     d:pv.length?`<b>${pl(pv.length,"pr\u00e9stamo","pr\u00e9stamos")}</b>: ${lista(pv,l=>esc(l.con)+" devuelve "+esc(short(l.desc,30))+" el "+fdate(l.fdev))}.`:"Ning\u00fan pr\u00e9stamo vence esta semana."},
    {k:"ing",pill:"ok",tag:"Recepci\u00f3n",ic:"ic-orc",t:"Ingresos de los \u00faltimos 7 d\u00edas",n:ni.length,go:"Ver ingresos",
     d:ni.length?`<b>${pl(ni.length,"nota de ingreso","notas de ingreso")}</b> con ${pl(sum(ni,d=>d.items.length),"\u00edtem","\u00edtems")}: ${lista(ni,d=>esc(d.doc))}.`:"No lleg\u00f3 material en los \u00faltimos 7 d\u00edas."}];
  $("#avisos").innerHTML=C.map(c=>`<div class="av-c${c.n?"":" cero"}"><div class="av-h"><span class="pill ${c.pill}">${c.tag}</span><svg class="i"><use href="#${c.ic}"/></svg></div><span class="t">${c.t}</span><p>${c.d}</p><button type="button" class="go" data-av="${c.k}">${c.go} \u203a</button></div>`).join("");
  const n=sp.length+rh.length+pv.length; $("#avN").textContent=n?pl(n,"aviso para hoy","avisos para hoy"):"Sin avisos para hoy";
}
function renderDash(){
  if(!S.db||$("#v-dash").hidden) return;
  const pend=S.loans.filter(l=>l.pend>0), at=filasAtencion();
  $("#tbAt").innerHTML=at.length?at.join(""):empty(5,"Nada pendiente: no hay pr\u00e9stamos vencidos ni materiales bajo el m\u00ednimo.");
  $("#atN").textContent=at.length?at.length+(at.length===1?" pendiente":" pendientes"):"";
  renderAvisos(pend);
  if(!window.Chart) return;
  Chart.defaults.font.family=css("--f-body"); Chart.defaults.color=css("--muted");
  const vs=S.mov.filter(x=>x.TIPO==="SALIDA");
  const m={}; vs.forEach(x=>{const k=(x.FECHA||"").slice(0,7); if(k) m[k]=(m[k]||0)+N(x.TOTAL);});
  const mk=Object.keys(m).sort().slice(-12);
  barras("chMes",mk.map(k=>[MES[+k.slice(5,7)-1]+" "+k.slice(2,4),m[k]]),false,true);
  $("#bMes").textContent=mk.length?soles0(sum(mk,k=>m[k]))+" en "+mk.length+(mk.length===1?" mes":" meses"):"";
  barras("chArea",agrupar(vs,x=>U(x.AREA)||"SIN \u00c1REA",x=>x.TOTAL).slice(0,10),true);
  $("#bArea").textContent=vs.length?soles0(sum(vs,x=>x.TOTAL))+" total":"";
  const est=["Normal","Bajo m\u00ednimo","Sin stock"], col=[css("--ok"),css("--warn"),css("--bad")];
  const cnt=est.map(e=>S.stock.filter(r=>r.estado===e).length);
  chart("chEst",{type:"doughnut",data:{labels:est,datasets:[{data:cnt,backgroundColor:col,borderColor:css("--surface"),borderWidth:2}]},
    options:{responsive:true,maintainAspectRatio:false,animation:false,cutout:"62%",plugins:{legend:{display:false}}}});
  $("#dcN").textContent=sum(cnt,x=>x);
  $("#lgEst").innerHTML=est.map((e,i)=>`<span><em><i style="background:${col[i]}"></i>${e}</em><b>${cnt[i]}</b></span>`).join("")+`<span class="mu"><em>Sin movimiento</em><b>${S.stock.filter(r=>r.estado==="Sin movimiento").length}</b></span>`;
  barras("chPre",agrupar(pend,l=>U(l.con)||"SIN NOMBRE",l=>l.pend*l.pu).slice(0,10),true);
  $("#bPre").textContent=pend.length?soles0(sum(pend,l=>l.pend*l.pu)):"";
}

/* ---------- impresion ---------- */
function imprimir(o){
  const w=window.open("","_blank"); if(!w){toast("Permite las ventanas emergentes para ver el reporte.");return;}
  const ahora=new Date().toLocaleString("es-PE",{dateStyle:"long",timeStyle:"short"}), cab=o.cabeza;
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${esc(o.titulo)}</title><style>
  @page{size:A4 ${o.vertical?"portrait":"landscape"};margin:12mm}body{font:11px/1.35 Arial,Helvetica,sans-serif;color:#111;margin:0}
  .top{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:3px solid #0f2a43;padding-bottom:6px;margin-bottom:8px}
  h1{font-size:17px;margin:0;letter-spacing:.03em}.meta{color:#555;font-size:10px;text-align:right}.f{color:#444;margin:4px 0 8px}
  .docn{font-size:20px;font-weight:bold;color:#1f5f8b}
  .info{display:grid;grid-template-columns:1fr 1fr;gap:3px 24px;margin:8px 0 12px;font-size:11.5px}.info b{display:inline-block;min-width:130px;color:#444;font-size:10px;text-transform:uppercase}
  table{border-collapse:collapse;width:100%}th{background:#0f2a43;color:#fff;font-size:9.5px;text-transform:uppercase;letter-spacing:.04em;padding:5px;text-align:left}
  td{border-bottom:1px solid #ccc;padding:4px 5px;vertical-align:top}tr:nth-child(even) td{background:#f4f6f8}.n{text-align:right;white-space:nowrap}.blank{border-bottom:1px solid #999;min-width:70px}
  tfoot td{font-weight:bold;border-top:2px solid #0f2a43;background:#fff!important}.nota{margin-top:10px;padding:6px 8px;border:1px solid #c9a227;background:#fff8e1}
  .firmas{display:flex;justify-content:space-around;gap:20px;margin-top:64px}.firmas div{border-top:1px solid #000;flex:0 1 200px;text-align:center;padding-top:4px;font-size:10px}
  .no-print{margin:10px 0}@media print{.no-print{display:none}}button{font:600 13px Arial;padding:8px 14px;background:#1f5f8b;color:#fff;border:0;border-radius:4px;cursor:pointer}
  .top .qr{flex:none;width:22mm;margin-left:10px;text-align:center;font-size:7px;color:#555}.top .qr svg{width:22mm;height:22mm;display:block}.top .meta{margin-left:auto}
  tr.sub td{font-weight:bold;background:#e8eef4!important;border-bottom:1px solid #0f2a43}
  </style></head><body><div class="no-print"><button onclick="print()">Imprimir / guardar PDF</button></div>
  <div class="top"><div><div style="font-size:10px;color:#555">CONTROL ALMAC\u00c9N</div><h1>${esc(o.titulo)}</h1></div><div class="meta">${o.docn?`<div class="docn">${esc(o.docn)}</div>`:""}Emitido: ${esc(ahora)} \u00b7 ${esc(S.ses.nombre)}${o.docn?"":`<br>${o.filas.filter(r=>!r.sub).length} registros`}</div>${o.qr&&qrSvg(o.qr)?`<div class="qr">${qrSvg(o.qr)}Escanea para ver el estado</div>`:""}</div>
  ${o.filtro?`<div class="f">${esc(o.filtro)}</div>`:""}
  ${o.info?`<div class="info">${o.info.filter(r=>r[1]).map(r=>`<div><b>${esc(r[0])}</b> ${esc(r[1])}</div>`).join("")}</div>`:""}
  <table><thead><tr>${cab.map(h=>`<th class="${h[1]||""}">${esc(h[0])}</th>`).join("")}</tr></thead>
  <tbody>${o.filas.map(r=>`<tr${r.sub?' class="sub"':""}>${r.map((v,i)=>`<td class="${cab[i][1]||""}">${esc(v)}</td>`).join("")}</tr>`).join("")||`<tr><td colspan="${cab.length}">Sin registros para este filtro.</td></tr>`}</tbody>
  ${o.pie?`<tfoot><tr>${o.pie.map((v,i)=>`<td class="${cab[i][1]||""}">${esc(v)}</td>`).join("")}</tr></tfoot>`:""}</table>
  ${o.nota?`<div class="nota">${esc(o.nota)}</div>`:""}
  ${o.firmas?`<div class="firmas">${o.firmas.map(f=>`<div>${esc(f)}</div>`).join("")}</div>`:""}
  <script>setTimeout(()=>print(),500)<\/script></body></html>`);
  w.document.close();
}
function printDoc(doc){
  const d=S.docs.find(x=>U(x.doc)===U(doc)); if(!d){toast("No se encontr\u00f3 el documento "+doc+".");return;}
  const h=d.h, t=d.tipo, T=TIPO[t]||{doc:t};
  const info={
    INGRESO:[["Fecha",fdate(h.FECHA)],["Proveedor",h.PROVEEDOR],["Orden de compra",h.ORC],["\u00c1rea",h.AREA],["Requerimiento",h.REQ],["Gu\u00eda de remisi\u00f3n",h.GUIA],["Observaci\u00f3n",h.OBS]],
    SALIDA:[["Fecha",fdate(h.FECHA)],["Entregado a",h.CONTRATISTA],["Contrato",h.CONTRATO],["\u00c1rea que consume",h.AREA],["Obra / frente",h.OBRA],["Uso / partida",h.USO],["Solicitado por",h.SOLICITANTE],["Requerimiento",uniq(d.items.map(x=>x.REQ)).join(", ")],["Observaci\u00f3n",h.OBS]],
    PRESTAMO:[["Fecha",fdate(h.FECHA)],["Prestado a",h.AUTORIZA?(h.OBRA||h.AREA)+" (recibe "+h.CONTRATISTA+")":h.CONTRATISTA],["Contrato",h.CONTRATO],["Sale de",h.AUTORIZA?uniq(d.items.map(x=>(S.lots[x.LOTE]||{}).OBRA||(S.lots[x.LOTE]||{}).AREA||"orden sin etapa")).join(", "):""],["Autorizado por",h.AUTORIZA],["\u00c1rea que pide",h.AREA],["Obra / frente",h.OBRA],["Solicitado por",h.SOLICITANTE],["Devolver a m\u00e1s tardar",fdate(h.FECHA_DEV)],["Observaci\u00f3n",h.OBS]],
    DEVOLUCION:[["Fecha",fdate(h.FECHA)],["Devuelto por",h.CONTRATISTA],["Contrato",h.CONTRATO],["\u00c1rea",h.AREA],["Obra / frente",h.OBRA],["Pr\u00e9stamo",h.DOC_REF||"Sobrante de obra"],["Observaci\u00f3n",h.OBS]],
    AJUSTE:[["Fecha",fdate(h.FECHA)],["Motivo",h.OBS]],
    INTERNAMIENTO:[["Fecha",fdate(h.FECHA)],["Devuelto por",h.CONTRATISTA],["Contrato",h.CONTRATO],["Obra / frente",h.OBRA],["Entra a","STOCK GENERAL (a costo promedio)"],["Observaci\u00f3n",h.OBS]],
    MERMA:[["Fecha",fdate(h.FECHA)],["Responsable",h.CONTRATISTA],["Contrato",h.CONTRATO],["Obra / frente",h.OBRA],["Motivo",h.OBS]],
    LIBERACION:[["Fecha",fdate(h.FECHA)],["\u00c1rea de origen",h.AREA||"\u2014"],["Requerimiento de origen",uniq(d.items.map(x=>x.REQ)).join(", ")],["Pasa a","STOCK GENERAL (lo puede usar cualquier \u00e1rea)"],["Motivo",h.OBS]]
  }[t]||[];
  const sa=t==="SALIDA"&&S.sols.find(o=>o.vales.includes(d.doc));
  if(sa) info.push(["Atiende solicitud",sa.doc+(sa.h.NRO_AREA?" (N\u00b0 \u00e1rea "+sa.h.NRO_AREA+")":"")]);
  info.push(["Registrado por",h.USUARIO]); if(h.CORREGIDO) info.push(["Corregido",h.CORREGIDO]); if(h.ANULADO) info.push(["ANULADO",h.ANULADO]);
  const firmas={INGRESO:["Recibido por (Almac\u00e9n)","Entregado por (Proveedor)"],SALIDA:["Despachado por (Almac\u00e9n)","Recibido por","V\u00b0B\u00b0 Residente"],
    PRESTAMO:["Entregado por (Almac\u00e9n)","Recibido por (se compromete a devolver)","V\u00b0B\u00b0 \u00c1rea propietaria"],DEVOLUCION:["Recibido por (Almac\u00e9n)","Devuelto por"],AJUSTE:["Almacenero","V\u00b0B\u00b0 Residente"],INTERNAMIENTO:["Recibido por (Almac\u00e9n)","Devuelto por (Contratista)","V\u00b0B\u00b0 Residente"],MERMA:["Almacenero","V\u00b0B\u00b0 Residente"],LIBERACION:["Jefe de almac\u00e9n","V\u00b0B\u00b0 \u00c1rea de origen"]}[t];
  const aj=t==="AJUSTE";
  const conReq=l=>l?(l.REQ?l.REQ+" \u00b7 ":"")+lotTxt(l):"";
  const ordenTxt=x=>t==="INTERNAMIENTO"?"Estado "+(x.ESTADO_DEV||"BUENO")+(x.ESTADO_DEV==="MALOGRADO"?" (no entra al stock)":"")+(kgDe(x.CODIGO,x.CANT)?" \u00b7 "+kgDe(x.CODIGO,x.CANT):""):t==="INGRESO"?x.ORC+(ocTxt(S.oc[ocKey(x.ORC,x.CODIGO)],x)?" \u00b7 "+ocTxt(S.oc[ocKey(x.ORC,x.CODIGO)],x):""):x.LOTE_ORIGEN?`${conReq(S.lots[x.LOTE])} (repuesto desde ${conReq(S.lots[x.LOTE_ORIGEN])})`:conReq(S.lots[x.LOTE]);
  const cc=t==="INGRESO"&&d.items.some(x=>x.UND_COMPRA), pu4=new Intl.NumberFormat("es-PE",{minimumFractionDigits:2,maximumFractionDigits:4});
  imprimir({titulo:(h.ANULADO?"ANULADO \u00b7 ":"")+T.doc.toUpperCase(),docn:d.doc,qr:qrLink("d",d.doc),info,vertical:true,firmas,
    cabeza:[["#","n"],["C\u00f3digo"],["Descripci\u00f3n"],...(cc?[["Seg\u00fan orden de compra"]]:[]),["Und"],["Orden"],[aj?"Diferencia":"Cantidad","n"],["P.U.","n"],["Total S/","n"]],
    filas:d.items.map((x,i)=>[i+1,x.CODIGO,x.DESCRIPCION,...(cc?[compraTxt(x)]:[]),x.UND,ordenTxt(x),(aj&&N(x.CANT)>0?"+":"")+fmt(x.CANT),pu4.format(N(x.PU)),mf.format(N(x.TOTAL))]),
    pie:["","","TOTAL",...(cc?[""]:[]),"","","","",mf.format(d.total)],
    nota:h.ANULADO?`Documento ANULADO: no cuenta en el stock. ${h.ANULADO}`:t==="PRESTAMO"?`El receptor se compromete a devolver los materiales en buen estado a m\u00e1s tardar el ${fdate(h.FECHA_DEV)}. Lo no devuelto podr\u00e1 ser descontado de su valorizaci\u00f3n.`:""});
}
var REP={
  stock(){ const c=$("#rStCat").value, e=$("#rStEst").value, r=filtStock("",c,e);
    imprimir({titulo:"Reporte de stock valorizado",filtro:`Categor\u00eda: ${c||"Todas"} \u00b7 Estado: ${e==="con"?"Con movimiento":e||"Todos"} \u00b7 Al ${fdate(today())}`,
      cabeza:[["C\u00f3digo"],["Descripci\u00f3n"],["Categor\u00eda"],["Und"],["Entradas","n"],["Salidas","n"],["Prestado","n"],["Saldo","n"],["M\u00ednimo","n"],["Estado"],["C. prom.","n"],["Valor S/","n"]],
      filas:r.map(s=>[s.codigo,s.desc,s.cat,s.und,fmt(s.ent),fmt(s.sal),fmt(s.pres),fmt(s.saldo),s.min?fmt(s.min):"",s.estado,mf.format(s.cp),mf.format(s.valor)]),
      pie:["","TOTAL","","","","","","","","","",mf.format(sum(r,s=>s.valor))],firmas:["Jefe de almac\u00e9n","V\u00b0B\u00b0 Residente"]}); },
  orc(){ REP._orc(filtOrc(U($("#qOrc").value),$("#qOrcArea").value,$("#qOrcSt").value),$("#qOrcArea").value); },
  orcRep(){ REP._orc(filtOrc("",$("#rOrcArea").value,$("#rOrcSt").value),$("#rOrcArea").value); },
  _orc(r,a){ r=[...r].sort((x,y)=>String(x.AREA).localeCompare(String(y.AREA))||String(x.ORC).localeCompare(String(y.ORC))||String(x.FECHA).localeCompare(String(y.FECHA)));
    imprimir({titulo:"Saldo por orden de compra",filtro:`\u00c1rea: ${a||"Todas"} \u00b7 Al ${fdate(today())}`,
      cabeza:[["\u00c1rea"],["Orden de compra"],["REQ"],["Ingreso"],["Fecha"],["Proveedor"],["C\u00f3digo"],["Material"],["Und"],["P.U.","n"],["Ingresado","n"],["Usado","n"],["Saldo","n"],["Valor saldo S/","n"]],
      filas:r.map(o=>[o.AREA,o.ORC,o.REQ,o.DOC,fdate(o.FECHA),o.PROVEEDOR,o.CODIGO,o.DESCRIPCION,o.UND,mf.format(o.PU),fmt(o.ING),fmt(o.USADO),fmt(o.SALDO),mf.format(Math.max(0,o.SALDO)*o.PU)]),
      pie:["","","","","","","","TOTAL","","","","","",mf.format(sum(r,o=>Math.max(0,o.SALDO)*o.PU))],firmas:["Jefe de almac\u00e9n","V\u00b0B\u00b0 Residente"]}); },
  req(){ const a=$("#rReqArea").value, e=$("#rReqSt").value;
    const g={}; S.lotList.forEach(l=>{const k=U(l.AREA)+"|"+U(l.REQ||"(sin REQ)")+"|"+U(l.CODIGO);
      const o=g[k]||(g[k]={AREA:l.AREA,REQ:l.REQ||"(sin REQ)",CODIGO:l.CODIGO,DESCRIPCION:l.DESCRIPCION,UND:l.UND,ING:0,USADO:0,SALDO:0,ORC:[]});
      o.ING+=l.ING; o.USADO+=l.USADO; o.SALDO+=l.SALDO; if(l.ORC&&!o.ORC.includes(l.ORC))o.ORC.push(l.ORC);});
    let r=Object.values(g).filter(o=>(!a||U(o.AREA)===a)&&(e==="abiertas"?o.SALDO>0:true))
      .sort((x,y)=>String(x.AREA).localeCompare(String(y.AREA))||String(x.REQ).localeCompare(String(y.REQ))||String(x.DESCRIPCION).localeCompare(String(y.DESCRIPCION)));
    const pedido={}; S.sol.forEach(x=>{if(["RECHAZADA","ANULADA"].includes(x.ESTADO))return;const sk=solKey(x);if(sk.indexOf("MAT|")===0)return;const l=S.lots[sk]||poolSol(sk)[0];if(!l)return;
      const k=U(l.AREA)+"|"+U(l.REQ||"(sin REQ)")+"|"+U(x.CODIGO); pedido[k]=(pedido[k]||0)+(x.CANT-x.ATENDIDO);});
    imprimir({titulo:"Saldo por requerimiento",filtro:`\u00c1rea: ${a||"Todas"} \u00b7 ${e==="abiertas"?"Solo con saldo":"Todos"} \u00b7 Al ${fdate(today())}`,
      cabeza:[["\u00c1rea"],["Requerimiento"],["\u00d3rdenes"],["C\u00f3digo"],["Material"],["Und"],["Ingresado","n"],["Entregado","n"],["Saldo","n"],["Solicitado pendiente","n"]],
      filas:r.map(o=>[o.AREA,o.REQ,o.ORC.join(", "),o.CODIGO,o.DESCRIPCION,o.UND,fmt(o.ING),fmt(o.USADO),fmt(o.SALDO),fmt(pedido[U(o.AREA)+"|"+U(o.REQ)+"|"+U(o.CODIGO)]||0)]),
      pie:["","","","","TOTAL","",fmt(sum(r,o=>o.ING)),fmt(sum(r,o=>o.USADO)),fmt(sum(r,o=>o.SALDO)),""],firmas:["Jefe de almac\u00e9n","V\u00b0B\u00b0 Residente"]}); },
  vida(){ const a=$("#rVidArea").value, r=S.lotList.filter(l=>l.vida&&(!a||U(l.AREA)===a)).sort((x,y)=>x.vida.dias-y.vida.dias);
    const mm={}; S.mat.forEach(m=>mm[U(m.CODIGO)]=m);
    imprimir({titulo:"Vencimientos y revisiones",filtro:`\u00c1rea: ${a||"Todas"} \u00b7 Aviso con ${DIAS_VENCER} d\u00edas de anticipaci\u00f3n \u00b7 Al ${fdate(today())}`,
      cabeza:[["Estado"],["Fecha"],["C\u00f3digo"],["Material"],["Und"],["Saldo","n"],["Orden"],["\u00c1rea"],["Ingres\u00f3"],["Vida \u00fatil"],["Fuente"]],
      filas:r.map(l=>{const m=mm[U(l.CODIGO)]||{};return [l.vida.estado,fdate(l.vida.fecha),l.CODIGO,l.DESCRIPCION,l.UND,fmt(l.SALDO),"ORC "+(l.ORC||"s/n")+(l.REQ?" \u00b7 "+l.REQ:""),l.AREA||"STOCK GENERAL",fdate(l.FECHA),(VIDA_NOM[U(m.VIDA_TIPO)]||"")+" \u00b7 "+fmt(m.VIDA_DIAS)+" d",m.VIDA_FUENTE||""];}),
      firmas:["Jefe de almac\u00e9n","V\u00b0B\u00b0 Residente"]}); },
  dorm(){ const a=$("#rDorArea").value, r=S.lotList.filter(l=>l.dorm&&(!a||U(l.AREA)===a)).sort((x,y)=>String(x.AREA).localeCompare(String(y.AREA))||y.dorm-x.dorm);
    imprimir({titulo:"Material sin movimiento",filtro:`\u00c1rea: ${a||"Todas"} \u00b7 ${DIAS_DORM} d\u00edas o m\u00e1s sin salidas \u00b7 Al ${fdate(today())}`,
      cabeza:[["\u00c1rea"],["Requerimiento"],["Orden"],["C\u00f3digo"],["Material"],["Und"],["Ingres\u00f3"],["\u00daltimo movimiento"],["D\u00edas","n"],["Saldo libre","n"],["Valor S/","n"]],
      filas:r.map(l=>[l.AREA,l.REQ,l.ORC,l.CODIGO,l.DESCRIPCION,l.UND,fdate(l.FECHA),fdate(l.ULT),String(l.dorm),fmt(l.libre),mf.format(l.libre*l.PU)]),
      pie:["","","","","TOTAL","","","","","",mf.format(sum(r,l=>l.libre*l.PU))],firmas:["Jefe de almac\u00e9n","V\u00b0B\u00b0 \u00c1rea"]}); },
  sol(){ const a=$("#rSolArea").value, e=$("#rSolSt").value, r=filtSol("",a,e);
    imprimir({titulo:"Solicitudes de material",filtro:`\u00c1rea: ${a||"Todas"} \u00b7 ${e==="abiertas"?"Pendientes y parciales":e||"Todas"} \u00b7 Al ${fdate(today())}`,
      cabeza:[["Solicitud"],["Fecha"],["\u00c1rea"],["Solicitante"],["Motivo"],["Lote / Mz"],["\u00cdtems","n"],["Pedido","n"],["Entregado","n"],["Estado"],["Vale"]],
      filas:r.map(o=>[o.doc,fdate(o.h.FECHA),o.h.AREA,o.h.SOLICITANTE,o.h.MOTIVO,[o.h.LOTES_OBRA,o.h.MZ].filter(Boolean).join(" \u00b7 "),String(o.items.length),fmt(o.pedido),fmt(o.atendido),solTxt[o.estado],o.vales.join(", ")]),
      firmas:["Jefe de almac\u00e9n","V\u00b0B\u00b0 Residente"]}); },
  mov(){ const de=$("#rMovDe").value, a=$("#rMovA").value, t=$("#rMovT").value, ar=$("#rMovArea").value;
    const r=S.mov.filter(x=>(!t||x.TIPO===t)&&(!ar||U(x.AREA)===ar)&&(!de||x.FECHA>=de)&&(!a||x.FECHA<=a));
    imprimir({titulo:"Reporte de movimientos",filtro:`Desde: ${de?fdate(de):"inicio"} \u00b7 Hasta: ${a?fdate(a):"hoy"} \u00b7 Tipo: ${t?TIPO[t].nom:"Todos"} \u00b7 \u00c1rea: ${ar||"Todas"}`,
      cabeza:[["Fecha"],["Documento"],["Tipo"],["C\u00f3digo"],["Descripci\u00f3n"],["Und"],["Cant","n"],["Total S/","n"],["Orden"],["\u00c1rea"],["Proveedor / receptor"]],
      filas:r.map(x=>[fdate(x.FECHA),x.DOC,TIPO[x.TIPO]?.nom||x.TIPO,x.CODIGO,x.DESCRIPCION,x.UND,fmt(x.CANT),mf.format(N(x.TOTAL)),x.TIPO==="INGRESO"?x.ORC:(S.lots[x.LOTE]||{}).ORC||"",x.AREA,who(x)]),
      pie:["","","","","TOTAL","","",mf.format(sum(r,x=>x.TOTAL)),"","",""]}); },
  pres(){ const c=$("#rPreCon").value, v=$("#rPreVen").checked;
    const r=S.loans.filter(l=>l.pend>0&&(!c||U(l.con)===c)&&(!v||l.estado==="Vencido")).sort((a,b)=>String(a.con).localeCompare(String(b.con))||String(a.fdev).localeCompare(String(b.fdev)));
    imprimir({titulo:"Pr\u00e9stamos pendientes de devoluci\u00f3n",filtro:`Receptor: ${c||"Todos"}${v?" \u00b7 Solo vencidos":""} \u00b7 Al ${fdate(today())}`,
      cabeza:[["Pr\u00e9stamo"],["Fecha"],["Prestado a"],["\u00c1rea"],["De la orden"],["Material"],["Und"],["Prestado","n"],["Devuelto","n"],["Pendiente","n"],["Devolver el"],["Estado"],["Valor S/","n"]],
      filas:r.map(l=>[l.doc,fdate(l.fecha),l.con,l.area,lotTxt(S.lots[l.lote]),l.desc,l.und,fmt(l.prestado),fmt(l.devuelto),fmt(l.pend),fdate(l.fdev),l.estado+(l.estado==="Vencido"?" ("+venceTxt(l)+")":""),mf.format(l.pend*l.pu)]),
      pie:["","","","","","TOTAL","","","","","","",mf.format(sum(r,l=>l.pend*l.pu))],firmas:["Jefe de almac\u00e9n",c?"Conforme: "+c:"Receptor","V\u00b0B\u00b0 Residente"]}); },
  consumo(){ const de=$("#rConDe").value, a=$("#rConA").value, g=$("#rConG").value, nom={AREA:"\u00c1rea",OBRA:"Obra",CONTRATISTA:"Receptor",USO:"Uso / partida"}[g];
    const m={}; S.mov.filter(x=>x.TIPO==="SALIDA"&&(!de||x.FECHA>=de)&&(!a||x.FECHA<=a)).forEach(x=>{const gv=U(x[g])||"SIN "+nom.toUpperCase(), k=gv+"|"+U(x.CODIGO);
      const o=m[k]||(m[k]={g:gv,c:x.CODIGO,d:x.DESCRIPCION,u:x.UND,q:0,v:0}); o.q+=N(x.CANT); o.v+=N(x.TOTAL);});
    const r=Object.values(m).sort((x,y)=>x.g.localeCompare(y.g,"es")||y.v-x.v);
    imprimir({titulo:"Reporte de consumo por "+nom.toLowerCase(),filtro:`Desde: ${de?fdate(de):"inicio"} \u00b7 Hasta: ${a?fdate(a):"hoy"} \u00b7 Solo vales de salida`,
      cabeza:[[nom],["C\u00f3digo"],["Material"],["Und"],["Cantidad","n"],["Valor S/","n"]],filas:r.map(o=>[o.g,o.c,o.d,o.u,fmt(o.q),mf.format(o.v)]),
      pie:["TOTAL","","","","",mf.format(sum(r,o=>o.v))]}); },
  kardex(){ const s=matFind($("#rKdx").value); if(!s){toast("Elige un material para el kardex.");return;}
    const de=$("#rKdxDe").value, a=$("#rKdxA").value, {ini,rows}=kardexRows(s,de,a);
    const filas=(de?[[fdate(de),"","Saldo inicial","","","","",fmt(ini),""]]:[]).concat(rows.map(r=>[fdate(r.x.FECHA),r.x.DOC,TIPO[r.x.TIPO]?.nom||r.x.TIPO,kOrden(r.x),who(r.x),r.ent?fmt(r.ent):"",r.sal?fmt(r.sal):"",fmt(r.saldo),mf.format(N(r.x.PU))]));
    imprimir({titulo:"Kardex de material",filtro:`Desde: ${de?fdate(de):"inicio"} \u00b7 Hasta: ${a?fdate(a):"hoy"}`,
      info:[["Material",s.desc],["C\u00f3digo",s.codigo],["Unidad",s.und],["Saldo actual",fmt(s.saldo)],["Costo promedio",money(s.cp)],["Ubicaci\u00f3n",s.ubi]],
      cabeza:[["Fecha"],["Documento"],["Tipo"],["Orden \u00b7 \u00e1rea"],["Proveedor / receptor"],["Entrada","n"],["Salida","n"],["Saldo","n"],["P.U.","n"]],filas,
      pie:["","","","","TOTAL",fmt(sum(rows,r=>r.ent)),fmt(sum(rows,r=>r.sal)),rows.length?fmt(rows[rows.length-1].saldo):fmt(ini),""]}); },
  contratista(){ const c=$("#rCtrCon").value, ct=$("#rCtrCont").value, de=$("#rCtrDe").value, a=$("#rCtrA").value, g={}, base=cod=>U(matDe(cod).RETAZO_DE)||U(cod);
    S.mov.filter(x=>["SALIDA","PRESTAMO","DEVOLUCION","INTERNAMIENTO","MERMA"].includes(x.TIPO)&&U(x.CONTRATISTA)&&(!c||U(x.CONTRATISTA)===c)&&(!ct||(ct===SIN_CONT?!x.CONTRATO:x.CONTRATO===ct))&&(!de||x.FECHA>=de)&&(!a||x.FECHA<=a)).forEach(x=>{
      const b=base(x.CODIGO), k=U(x.CONTRATISTA)+"|"+x.CONTRATO+"|"+b, m=S.byCod[b]||{desc:x.DESCRIPCION,und:x.UND,cp:0}, q=N(x.CANT), esRet=U(x.CODIGO)!==b;
      const o=g[k]||(g[k]={con:U(x.CONTRATISTA),cont:x.CONTRATO||"",cod:b,desc:m.desc,und:m.und,cp:m.cp||N(x.PU),ent:0,dev:0,mal:0,ret:{},kg:0,mer:{}});
      if(x.TIPO==="SALIDA"||x.TIPO==="PRESTAMO") o.ent+=q;
      else if(x.TIPO==="MERMA"||(esRet&&x.ESTADO_DEV==="MALOGRADO")) o.mer[x.UND]=(o.mer[x.UND]||0)+q;
      else if(esRet){ o.ret[x.UND]=(o.ret[x.UND]||0)+q; o.kg+=q*kgM(x.CODIGO); }
      else if(x.ESTADO_DEV==="MALOGRADO") o.mal+=q; else o.dev+=q; });
    const ut=m=>Object.entries(m).map(([u,q])=>fmt(q)+" "+u).join(" + ");
    const r=Object.values(g).map(o=>Object.assign(o,{neto:o.ent-o.dev-o.mal})).sort((x,y)=>x.con.localeCompare(y.con,"es")||(!x.cont)-(!y.cont)||x.cont.localeCompare(y.cont,"es")||y.neto*y.cp-x.neto*x.cp);
    // con contratos: un subtotal por cada contrato del contratista (lo que no tiene contrato va como "sin contrato")
    const conCt=r.some(o=>o.cont), filas=[], cn=o=>o.cont||"sin contrato";
    r.forEach((o,i)=>{ filas.push([o.con,...(conCt?[cn(o)]:[]),o.cod,o.desc,o.und,fmt(o.ent),fmt(o.dev),fmt(o.mal),ut(o.ret)+(o.kg?" \u2248 "+fmt(o.kg)+" kg":""),ut(o.mer),fmt(o.neto),mf.format(o.neto*o.cp)]);
      const n=r[i+1]; if(conCt&&(!n||n.con!==o.con||n.cont!==o.cont)){ const gr=r.filter(z=>z.con===o.con&&z.cont===o.cont), f=["","","",`Subtotal ${o.con} \u00b7 ${cn(o)}`,"","","","","","","",mf.format(sum(gr,z=>z.neto*z.cp))]; f.sub=true; filas.push(f); } });
    imprimir({titulo:"Material por contratista",filtro:`Contratista: ${c||"Todos"}${ct?" \u00b7 Contrato: "+(ct===SIN_CONT?"sin contrato":ct):""} \u00b7 Desde: ${de?fdate(de):"inicio"} \u00b7 Hasta: ${a?fdate(a):"hoy"}`,
      cabeza:[["Contratista"],...(conCt?[["Contrato"]]:[]),["C\u00f3digo"],["Material"],["Und"],["Entregado","n"],["Devuelto","n"],["Malogrado","n"],["Retazos devueltos"],["Merma"],["Consumo neto","n"],["Valor S/","n"]],
      filas,
      pie:["","",...(conCt?[""]:[]),"TOTAL","","","","","","","",mf.format(sum(r,o=>o.neto*o.cp))],
      nota:"Entregado = vales de salida y pr\u00e9stamos. Devuelto = devoluciones e internamientos en estado bueno o regular. Consumo neto = entregado \u2212 devuelto \u2212 malogrado. Los retazos se muestran aparte en metros o piezas, y el fierro tambi\u00e9n en kg.",
      firmas:["Jefe de almac\u00e9n",c?"Conforme: "+c:"Contratista","V\u00b0B\u00b0 Residente"]}); },
  inventario(){ const c=$("#rInvCat").value, todo=$("#rInvTodo").checked;
    const r=S.stock.filter(s=>(!c||s.cat===c)&&(todo||s.estado!=="Sin movimiento")).sort((a,b)=>(a.ubi||"~").localeCompare(b.ubi||"~")||a.desc.localeCompare(b.desc,"es"));
    imprimir({titulo:"Hoja de toma de inventario",filtro:`Categor\u00eda: ${c||"Todas"} \u00b7 Fecha del conteo: ____ / ____ / ________`,
      cabeza:[["C\u00f3digo"],["Descripci\u00f3n"],["Und"],["Ubicaci\u00f3n"],["Saldo sistema","n"],["Conteo f\u00edsico","blank"],["Diferencia","blank"],["Observaci\u00f3n","blank"]],
      filas:r.map(s=>[s.codigo,s.desc,s.und,s.ubi,fmt(s.saldo),"","",""]),
      nota:"Las diferencias se registran en la aplicaci\u00f3n con un documento de Ajuste (AJ), indicando el motivo.",firmas:["Contado por","Almacenero","V\u00b0B\u00b0 Residente"]}); },
  obras(){ const ob=$("#rObr").value, sp=$("#rObrPend").checked;
    const r=S.loans.filter(l=>l.aut&&(!ob||l.para===ob||l.de===ob)&&(!sp||l.pend>0)).sort((a,b)=>String(a.de).localeCompare(String(b.de))||String(a.para).localeCompare(String(b.para))||String(a.fecha).localeCompare(String(b.fecha)));
    imprimir({titulo:"Pr\u00e9stamos entre obras / etapas",filtro:`Obra / etapa: ${ob||"Todas"}${sp?" \u00b7 Solo lo que falta devolver":""} \u00b7 Al ${fdate(today())}`,
      cabeza:[["Fecha"],["Pr\u00e9stamo"],["Presta"],["Recibe"],["Autoriz\u00f3"],["Orden"],["Material"],["Und"],["Prestado","n"],["Devuelto","n"],["Falta","n"],["Devolver el"],["Valor que falta S/","n"]],
      filas:r.map(l=>{const lo=S.lots[l.lote]||{};return [fdate(l.fecha),l.doc,l.de,l.para,l.aut,lo.ORC||"",l.desc,l.und,fmt(l.prestado),fmt(l.devuelto),fmt(l.pend),l.pend>0?fdate(l.fdev)+(l.estado==="Vencido"?" (VENCIDO)":""):"Devuelto",mf.format(l.pend*l.pu)];}),
      pie:["","","","","","","TOTAL","","","","","",mf.format(sum(r,l=>l.pend*l.pu))],
      nota:"Lo que falta es material de la etapa que presta usado por la etapa que recibe, a precio de su orden de compra. Se devuelve con una devoluci\u00f3n que repone desde una orden de la etapa que recibe; si no se devuelve, este reporte muestra el monto que pas\u00f3 de una etapa a otra.",
      firmas:["Jefe de almac\u00e9n","Etapa que presta","Etapa que recibe"]}); },
  doc(){ const v=$("#rDoc").value.trim(); if(!v){toast("Escribe el n\u00famero del documento.");return;} printDoc(v); }
};
$$("[data-rep]").forEach(b=>b.onclick=()=>REP[b.dataset.rep]());
/* ---------- contrato del contratista (opcional) ---------- */
var SIN_CONT="(SIN CONTRATO)";
// contratos ya usados (vales y solicitudes); con contratista, solo los suyos
var contratosDe=con=>uniq(S.mov.filter(x=>x.CONTRATO&&(!con||x.CONTRATISTA===U(con))).map(x=>x.CONTRATO)
  .concat(S.sol.filter(x=>x.CONTRATO&&(!con||x.RECEPTOR===U(con))).map(x=>x.CONTRATO))).sort();
function optsCont(){ const c=$("#rCtrCon").value, l=contratosDe(c), sin=S.mov.some(x=>["SALIDA","PRESTAMO","DEVOLUCION","INTERNAMIENTO","MERMA"].includes(x.TIPO)&&x.CONTRATISTA&&(!c||x.CONTRATISTA===c)&&!x.CONTRATO);
  keepSel($("#rCtrCont"),`<option value="">Todos los contratos</option>`+l.map(v=>`<option>${esc(v)}</option>`).join("")+(sin&&l.length?`<option value="${SIN_CONT}">Sin contrato</option>`:"")); }
$("#rCtrCon").addEventListener("change",optsCont);
var conDeCampo=el=>el.id==="dCont"?$("#dCon").value:el.id==="sCont"?$("#sRec").value:el.id==="iCont"?$("#iRec").value:(($("#coCab [data-cf=\"CONTRATISTA\"]")||{}).value||"");
document.addEventListener("focusin",e=>{ const el=e.target; if(!el||el.getAttribute("list")!=="dlCont") return;
  const l=contratosDe(conDeCampo(el)); $("#dlCont").innerHTML=l.map(v=>`<option value="${esc(v)}"></option>`).join(""); });
$("#btnKdx").onclick=()=>{$("#rKdx").value=$("#qKdx").value;$("#rKdxDe").value=$("#qKdxDe").value;$("#rKdxA").value=$("#qKdxA").value;REP.kardex();};

/* ---------- corregir / anular documento ---------- */
var CORR_CAMPOS={INGRESO:["FECHA","PROVEEDOR","AREA","OBRA","ORC","REQ","GUIA","OBS"],SALIDA:["FECHA","CONTRATISTA","CONTRATO","AREA","OBRA","USO","SOLICITANTE","OBS"],
  PRESTAMO:["FECHA","CONTRATISTA","CONTRATO","AREA","OBRA","AUTORIZA","SOLICITANTE","FECHA_DEV","OBS"],DEVOLUCION:["FECHA","CONTRATISTA","CONTRATO","AREA","OBRA","OBS"],AJUSTE:["FECHA","OBS"],
  INTERNAMIENTO:["FECHA","CONTRATISTA","CONTRATO","OBRA","OBS"],MERMA:["FECHA","CONTRATISTA","CONTRATO","OBRA","OBS"],LIBERACION:[]};
var CORR_OBLIG={INGRESO:["PROVEEDOR","AREA"],SALIDA:["CONTRATISTA","AREA"],PRESTAMO:["CONTRATISTA","AREA"],INTERNAMIENTO:["CONTRATISTA"]};
var CORR_ETQ={FECHA:"Fecha",PROVEEDOR:"Proveedor",AREA:"\u00c1rea",ORC:"Orden de compra (ORC)",REQ:"Requerimiento (REQ)",GUIA:"Gu\u00eda de remisi\u00f3n",OBS:"Observaci\u00f3n",
  CONTRATISTA:"Contratista / receptor",CONTRATO:"Contrato (opcional)",AUTORIZA:"Autorizado por (pr\u00e9stamo entre obras)",OBRA:"Obra / etapa",USO:"Uso / partida",SOLICITANTE:"Solicitado por",FECHA_DEV:"Devolver a m\u00e1s tardar"};
// el administrador corrige todo; el almacenero solo lo registrado hoy y no anula
var corregible=d=>canWrite()&&!d.h.ANULADO&&(isAdmin()||(d.tipo!=="LIBERACION"&&String(d.h.REGISTRADO).slice(0,10)===today()));
function abrirCorr(doc){
  const d=S.docs.find(x=>x.doc===doc); if(!d) return; const h=d.h, t=d.tipo, campos=CORR_CAMPOS[t]||[];
  S.co={d};
  $("#coTit").textContent=`Corregir ${d.doc} \u00b7 ${(TIPO[t]||{}).doc||t}`;
  $("#coHelp").textContent=t==="LIBERACION"?"Un pase a stock general no se corrige: si fue un error, an\u00falalo y reg\u00edstralo de nuevo.":
    "Cambia solo lo que est\u00e1 mal. Si corriges el REQ o la orden de un ingreso, el cambio pasa tambi\u00e9n a sus salidas. Una cantidad solo se corrige si ning\u00fan saldo queda negativo."+(t==="INGRESO"?" El material de una l\u00ednea solo se cambia si esa orden todav\u00eda no tuvo salidas.":"")+(t==="SALIDA"?" Si el vale atendi\u00f3 una solicitud, la solicitud se actualiza sola.":"");
  $("#coCab").innerHTML=campos.map(c=>{const v=h[c]??"", ent=["PROVEEDOR","CONTRATISTA","AREA","OBRA"].includes(c);
    const inp=ent?`<select data-cf="${c}">${opts(uniq(entAct(c).concat(v?[v]:[])),(CORR_OBLIG[t]||[]).includes(c)?null:"(ninguno)")}</select>`
      :c==="FECHA"||c==="FECHA_DEV"?`<input type="date" data-cf="${c}" value="${esc(String(v).slice(0,10))}">`:`<input data-cf="${c}" maxlength="${c==="OBS"?250:c==="CONTRATO"?40:60}"${c==="CONTRATO"?' list="dlCont" autocomplete="off"':""} value="${esc(v)}">`;
    return `<label class="${c==="OBS"?"full":""}">${esc(CORR_ETQ[c]||c)}${inp}</label>`;}).join("")||'<p class="note full">Este documento no tiene datos que corregir.</p>';
  campos.forEach(c=>{const el=$(`#coCab [data-cf="${c}"]`); if(el&&el.tagName==="SELECT") el.value=U(h[c]);});
  const editCant=!["AJUSTE","LIBERACION"].includes(t), editMat=t==="INGRESO";
  $("#coItems").innerHTML=d.items.map((x,i)=>`<tr><td>${i+1}</td><td>${editMat?`<input list="dlMat" autocomplete="off" data-cm="${x.ID}" value="${esc(x.DESCRIPCION)}" style="width:100%" aria-label="Material">`:esc(x.DESCRIPCION)}<div class="code">${esc(x.CODIGO)}${x.ESTADO_DEV?" \u00b7 "+esc(x.ESTADO_DEV):""}</div></td><td>${esc(x.UND)}</td>
    <td class="num">${editCant?`<input class="qty" type="number" min="0" step="any" data-cq="${x.ID}" value="${N(x.CANT)}" aria-label="Cantidad">`:fmt(x.CANT)}</td></tr>`).join("");
  $("#coMot").value=""; $("#coErr").textContent="";
  $("#coSave").hidden=!campos.length; $("#coAnu").hidden=!isAdmin();
  $("#coNota").textContent=isAdmin()?"Anular deja el documento a la vista como ANULADO y deja de contar en el stock. Cada correcci\u00f3n queda en la hoja CORRECCIONES con qui\u00e9n, cu\u00e1ndo, qu\u00e9 cambi\u00f3 y el motivo.":
    "Como almacenero corriges los documentos registrados hoy. Para anular un documento o corregir uno de otro d\u00eda, p\u00eddeselo al administrador.";
  $("#pCor").hidden=false; $("#pCor").scrollTop=0;
}
$("#coSave").onclick=async()=>{ const d=S.co.d, h=d.h, err=$("#coErr"); err.textContent="";
  const mot=$("#coMot").value.trim(); if(!mot){err.textContent="Escribe el motivo de la correcci\u00f3n.";return;}
  const cab={}; $$("#coCab [data-cf]").forEach(el=>{const c=el.dataset.cf, v=el.value.trim(), o=c==="FECHA"||c==="FECHA_DEV"?String(h[c]||"").slice(0,10):str(h[c]);
    if(["PROVEEDOR","CONTRATISTA","CONTRATO","AUTORIZA","AREA","OBRA","REQ","GUIA","USO","SOLICITANTE"].includes(c)?U(v)!==U(o):v!==o) cab[c]=v;});
  const lineas=[];
  for(const x of d.items){ const q=$(`#coItems [data-cq="${x.ID}"]`), m=$(`#coItems [data-cm="${x.ID}"]`), l={id:x.ID};
    if(q&&Number(q.value)!==N(x.CANT)){ if(!(Number(q.value)>0)){err.textContent=`Cantidad no v\u00e1lida en ${x.DESCRIPCION}. Si no sali\u00f3 nada, anula el documento.`;return;} l.cant=Number(q.value); }
    if(m&&U(m.value)!==U(x.DESCRIPCION)){ const s=matFind(m.value); if(!s){err.textContent=`Elige de la lista el material correcto para ${x.DESCRIPCION}.`;return;} if(U(s.codigo)!==U(x.CODIGO)) l.codigo=s.codigo; }
    if(l.cant!=null||l.codigo) lineas.push(l); }
  if(!Object.keys(cab).length&&!lineas.length){err.textContent="No cambiaste nada.";return;}
  $("#coSave").disabled=true;
  try{ const n=await api("corregirDocumento",d.doc,{cab,lineas},mot); $("#pCor").hidden=true; toast(`${d.doc} corregido (${n} cambio${n>1?"s":""}).`); await cargar(); }
  catch(x){ err.textContent="No se pudo corregir: "+msg(x); }
  $("#coSave").disabled=false; };
$("#coAnu").onclick=async()=>{ const d=S.co.d, err=$("#coErr"); err.textContent="";
  const mot=$("#coMot").value.trim(); if(!mot){err.textContent="Escribe en Motivo por qu\u00e9 se anula.";return;}
  if(!confirm(`\u00bfAnular ${d.doc}? Deja de contar en el stock y queda a la vista como ANULADO.`)) return;
  $("#coAnu").disabled=true;
  try{ await api("anularDocumento",d.doc,mot); $("#pCor").hidden=true; toast(`${d.doc} anulado.`); await cargar(); }
  catch(x){ err.textContent="No se pudo anular: "+msg(x); }
  $("#coAnu").disabled=false; };

/* ---------- inventario fisico: conteo contra el sistema y ajuste ---------- */
function abrirInv(){ if(!libreModal("pInv")) return; S.inv={}; S.invDoc=""; S.invAntes=null;
  keepSel($("#ivCat"),opts(uniq(S.mat.map(m=>m.CATEGORIA)),"Todas las categor\u00edas")); $("#ivQ").value=""; $("#ivSolo").checked=false;
  $("#ivFecha").value=today(); $("#ivMot").value="Inventario f\u00edsico "+fdate(today()); $("#ivErr").textContent=""; renderInv(); $("#pInv").hidden=false; $("#pInv").scrollTop=0; }
function invFilas(){const q=U($("#ivQ").value), c=$("#ivCat").value, solo=$("#ivSolo").checked;
  return S.stock.filter(s=>(!c||s.cat===c)&&(!q||U(s.desc+" "+s.codigo).includes(q))&&(solo?S.inv[s.codigo]!=null:s.estado!=="Sin movimiento"||S.inv[s.codigo]!=null))
    .sort((a,b)=>(a.ubi||"~").localeCompare(b.ubi||"~")||a.desc.localeCompare(b.desc,"es"));}
var difTxt=d=>d==null?"":`<b class="${d<0?"neg":d>0?"pos":""}">${d>0?"+":""}${fmt(d)}</b>`;
function renderInv(){const r=invFilas().slice(0,400);
  $("#ivItems").innerHTML=r.length?r.map(s=>{const v=S.inv[s.codigo];return `<tr><td>${esc(s.desc)}<div class="code">${esc(s.codigo)}</div></td><td>${esc(s.und)}</td><td class="note">${esc(s.ubi||"")}</td><td class="num">${fmt(s.saldo)}</td>
    <td class="num"><input class="qty" type="number" min="0" step="any" data-iv="${esc(s.codigo)}" value="${v==null?"":v}" aria-label="Contado"></td><td class="num" data-ivd="${esc(s.codigo)}">${difTxt(v==null?null:v-s.saldo)}</td></tr>`;}).join(""):empty(6,"Ning\u00fan material coincide.");
  resInv();}
var conDif=()=>Object.keys(S.inv).filter(k=>Math.abs(S.inv[k]-(S.byCod[U(k)]||{saldo:0}).saldo)>1e-9);
function resInv(){const n=Object.keys(S.inv).length, d=conDif().length;
  const rs=conDif().map(k=>{const s=S.byCod[U(k)], dd=S.inv[k]-s.saldo, t=repartoTxt(k,dd), area=dd<0&&/ORC /.test(t);
    return `<li class="${area?"neg":""}"><b>${esc(s.desc)}</b> (${dd>0?"+":""}${fmt(dd)} ${esc(s.und)}): ${esc(t)}</li>`;});
  $("#ivRep").innerHTML=rs.length?`<b>As\u00ed se reparte la diferencia</b>${conDif().some(k=>S.inv[k]<S.byCod[U(k)].saldo&&/ORC /.test(repartoTxt(k,S.inv[k]-S.byCod[U(k)].saldo)))?" \u00b7 <span class=\"neg\">en rojo, lo que toca \u00f3rdenes de un \u00e1rea (se le avisa por correo)</span>":""}<ul>${rs.join("")}</ul>`:"";
  $("#ivRep").hidden=!rs.length;
  $("#ivRes").textContent=`${n} material${n===1?"":"es"} contado${n===1?"":"s"} \u00b7 ${d} con diferencia`+(S.invDoc?` \u00b7 registrado en ${S.invDoc}`:"");}
$("#ivItems").addEventListener("input",e=>{const k=e.target.dataset.iv; if(k==null) return; const v=e.target.value;
  if(v==="") delete S.inv[k]; else S.inv[k]=Number(v);
  const s=S.byCod[U(k)], td=[...$$("#ivItems [data-ivd]")].find(x=>x.dataset.ivd===k); if(td) td.innerHTML=difTxt(v===""?null:Number(v)-s.saldo); resInv();});
["#ivQ","#ivCat","#ivSolo"].forEach(x=>$(x).addEventListener("input",renderInv));
$("#ivSave").onclick=async()=>{const err=$("#ivErr"); err.textContent="";
  const it=conDif().map(k=>({codigo:k,cant:S.inv[k]}));
  if(!it.length){err.textContent=Object.keys(S.inv).length?"Todo lo contado coincide con el sistema: no hay nada que ajustar.":"Escribe al menos un conteo.";return;}
  for(const x of it){const s=S.byCod[U(x.codigo)]; if(x.cant<0||noEntero(x.cant,s.und)){err.textContent=`Conteo no v\u00e1lido en ${s.desc}.`;return;}}
  const mot=$("#ivMot").value.trim(); if(!mot){err.textContent="Escribe el motivo.";return;}
  if(!confirm(`Se registrar\u00e1 un ajuste con ${it.length} material${it.length>1?"es":""} con diferencia. \u00bfContinuar?`)) return;
  S.invAntes=Object.fromEntries(Object.keys(S.inv).map(k=>[k,(S.byCod[U(k)]||{saldo:0}).saldo]));
  $("#ivSave").disabled=true;
  try{ const doc=await api("registrarDocumento",{tipo:"AJUSTE",fecha:$("#ivFecha").value||today(),obs:mot},it); S.invDoc=doc; await cargar(); toast(`Ajuste ${doc} registrado.`); renderInv(); printInv(); }
  catch(x){ err.textContent="No se pudo registrar: "+msg(x); }
  $("#ivSave").disabled=false; };
function printInv(){const ks=Object.keys(S.inv); if(!ks.length){toast("A\u00fan no hay conteos para la constancia.");return;}
  const ant=S.invDoc&&S.invAntes, filas=ks.map(k=>{const s=S.byCod[U(k)], sis=ant?S.invAntes[k]:s.saldo, d=S.inv[k]-sis;
    return [s.codigo,s.desc,s.und,s.ubi||"",fmt(sis),fmt(S.inv[k]),(d>0?"+":"")+fmt(d),mf.format(d*s.cp)];});
  imprimir({titulo:"Constancia de inventario f\u00edsico",docn:S.invDoc||"",vertical:true,filtro:`Fecha del conteo: ${fdate($("#ivFecha").value)} \u00b7 ${$("#ivMot").value}`,
    cabeza:[["C\u00f3digo"],["Material"],["Und"],["Ubicaci\u00f3n"],["Sistema","n"],["Contado","n"],["Diferencia","n"],["Valor dif. S/","n"]],filas,
    nota:S.invDoc?`Las diferencias se registraron en el ajuste ${S.invDoc}.`:"Borrador: las diferencias todav\u00eda no se registran en el sistema.",firmas:["Contado por","Almacenero","V\u00b0B\u00b0 Residente"]});}
$("#ivPrint").onclick=printInv;

/* conteo fisico: el faltante sale primero del stock general y luego de las ordenes de area mas antiguas (igual que el servidor) */
function repartoAj(ls,r){ const gen=l=>U(l.REQ)==="STOCK"||!l.AREA, out=[];
  ls.filter(gen).concat(ls.filter(l=>!gen(l))).forEach(l=>{const u=Math.min(Math.max(l.SALDO,0),r); if(u>1e-9){out.push({l,q:u}); r-=u;}});
  if(r>1e-9&&ls.length) out.push({l:ls[ls.length-1],q:r}); return out; }
function repartoTxt(k,d){ if(d>0) return "+"+fmt(d)+" entra a stock general";
  const p=repartoAj((S.lotsMat[U(k)]||[]).map(l=>({...l})),-d);
  const g={}; p.forEach(x=>{const n=U(x.l.REQ)==="STOCK"||!x.l.AREA?"stock general":"ORC "+(x.l.ORC||"s/n")+" de "+x.l.AREA; g[n]=(g[n]||0)+x.q;});
  return Object.keys(g).map(n=>n+": "+fmt(g[n])).join(" \u00b7 ")||"sin \u00f3rdenes"; }

/* ---------- total comprado por orden de compra (llegadas) ---------- */
var ocKey=(orc,cod)=>U(orc)+"|"+U(cod);
var ocFalta=o=>o&&o.total?o.total-o.llego:0;
function ocTxt(oc,x){ if(!oc||(!oc.total&&oc.n<2)) return ""; const van=x&&x._van?x._van:oc.llego, n=x&&x._n?x._n:0;
  return (n?"llegada "+n+": ":"")+(oc.total?`van ${fmt(van)} de ${fmt(oc.total)}`+(oc.total-van>1e-9?`, faltan ${fmt(oc.total-van)}`:van-oc.total>1e-9?`, ${fmt(van-oc.total)} de m\u00e1s`:", completa"):`van ${fmt(van)}`); }
function ocLote(l){ const o=l.OC; if(!o||(!o.total&&o.n<2)) return "";
  return `Llegada ${l.LLEGADA} \u00b7 ORC: lleg\u00f3 ${fmt(o.llego)}`+(o.total?` de ${fmt(o.total)}`+(ocFalta(o)>1e-9?`, faltan ${fmt(ocFalta(o))}`:", completa"):""); }
// total de la orden para una linea del ingreso: lo escrito, o lo que ya se sabia de llegadas anteriores
function ocTotal(x){ const o=S.oc[ocKey($("#dOrc").value.trim(),x.codigo)]; return x.oc!=null?N(x.oc):(o?o.total:0); }
function ocCampo(x,i){ const orc=$("#dOrc").value.trim();
  if(!orc) return `<div class="code note">Escribe la ORC arriba para llevar la cuenta de lo que falta llegar.</div>`;
  const o=S.oc[ocKey(orc,x.codigo)], tot=ocTotal(x), antes=o?o.llego:0, van=antes+N(x.cant), n=(o?o.n:0)+1;
  const m=tot?(van-tot>1e-9?`<span class="neg">Llegada ${n}: llega ${fmt(van-tot)} ${esc(x.und)} m\u00e1s de lo comprado</span>`:`Llegada ${n}: van ${fmt(van)} de ${fmt(tot)}`+(tot-van>1e-9?`, faltan ${fmt(tot-van)}`:", orden completa"))
    :antes?`Llegada ${n}: antes llegaron ${fmt(antes)}`:"";
  return `<label class="code mini">Total comprado en la ORC (${esc(x.und)}) <input type="number" min="0" step="any" value="${tot||""}" data-oc="${i}" placeholder="opcional" style="width:90px"></label>${m?`<div class="code">${m}</div>`:""}`; }
// la orden elegida no alcanza: completa con las otras llegadas de la misma ORC, area y REQ (la mas antigua primero)
function planLlegadas(id,q){ const l=S.lots[id]; if(!l||!str(l.ORC)) return null;
  const g=(S.lotsMat[U(l.CODIGO)]||[]).filter(o=>U(o.ORC)===U(l.ORC)&&U(o.AREA)===U(l.AREA)&&U(o.REQ)===U(l.REQ)&&!o.IM&&!o.AJ&&dispLote(o.ID)>0).sort(porFecha);
  if(g.length<2||sum(g,o=>dispLote(o.ID))<q-1e-9) return null;
  let r=q; const out=[]; g.forEach(o=>{ if(r<=1e-9) return; const u=Math.min(dispLote(o.ID),r); out.push({l:o,q:Math.round(u*1e6)/1e6}); r-=u; }); return out; }

/* ---------- codigos QR: documentos, estantes y ordenes ---------- */
// el QR guarda el enlace de la app + ?d=documento, ?m=material o ?l=orden (lote); al abrirlo, la app muestra eso
var QR_URLS=[["https:","","cdn.jsdelivr.net","npm","qrcode-generator@1.4.4","qrcode.js"].join("/"),["https:","","cdnjs.cloudflare.com","ajax","libs","qrcode-generator","1.4.4","qrcode.min.js"].join("/")];
function cargarQr(){ if(window.qrcode) return Promise.resolve(true); if(cargarQr.p) return cargarQr.p;
  return cargarQr.p=QR_URLS.reduce((p,u)=>p.then(ok=>ok||new Promise(res=>{const t=document.createElement("script"); t.src=u; t.onload=()=>res(!!window.qrcode); t.onerror=()=>{t.remove();res(false);}; document.head.appendChild(t);})),Promise.resolve(false))
    .then(ok=>{ if(!ok) cargarQr.p=null; return ok; }); }
var qrLink=(k,v)=>S.url&&v?S.url+"?"+k+"="+encodeURIComponent(v):"";
function qrSvg(txt){ if(!txt||!window.qrcode) return ""; try{ const q=qrcode(0,"M"); q.addData(txt); q.make(); return q.createSvgTag({cellSize:4,margin:0,scalable:true}); }catch(e){ return ""; } }
var QRP=null;
function leerQr(){ try{ google.script.url.getLocation(loc=>{ const p=(loc&&loc.parameter)||{}, k=["d","m","l"].find(x=>p[x]); if(!k) return;
  QRP={k,v:String(p[k])}; if(S.db){ irQr(); return; }
  const t=$("#lQr"); t.hidden=false; t.textContent=`Ingresa para ver ${k==="d"?"el documento "+QRP.v:k==="m"?"el material "+QRP.v:"la orden escaneada"}.`; }); }catch(e){} }
function irQr(){ if(!QRP) return; const p=QRP; QRP=null; $("#lQr").hidden=true; abrirQr(p.k,p.v); }
var estadoQr=m=>m?`<div class="qr-msg ${m[0]}">${esc(m[1])}</div>`:"";
var filasQr=rows=>`<div class="qr-info">${rows.filter(r=>r[1]!==""&&r[1]!=null).map(r=>`<div><span>${esc(r[0])}</span><b>${esc(r[1])}</b></div>`).join("")}</div>`;
var noQr=t=>({tit:"C\u00f3digo escaneado",html:estadoQr(["bad",t]),btns:[]});
function abrirQr(k,v){ v=str(v); const r=k==="d"?(/^SM-/i.test(v)?qrSol(v):qrDoc(v)):k==="m"?qrMat(v):qrLote(v);
  $("#qrTit").textContent=r.tit; $("#qrBody").innerHTML=r.html; S.qrBtns=r.btns;
  $("#qrAct").innerHTML=r.btns.map((b,i)=>`<button class="btn ${b.p?"primary":""}" type="button" data-qa="${i}">${esc(b.t)}</button>`).join("")+`<button class="btn" type="button" data-qx="1">Cerrar</button>`;
  $("#pQr").hidden=false; $("#pQr").scrollTop=0; }
$("#qrAct").addEventListener("click",e=>{ const b=e.target.closest("[data-qa]"); if(b){ $("#pQr").hidden=true; S.qrBtns[+b.dataset.qa].f(); return; } if(e.target.closest("[data-qx]")) $("#pQr").hidden=true; });
$("#qrBody").addEventListener("click",e=>{ const a=e.target.closest("[data-qrl]"); if(a){ e.preventDefault(); abrirQr("l",a.dataset.qrl); } });
function qrSol(doc){ const o=S.sols.find(x=>U(x.doc)===U(doc));
  if(!o) return noQr(`No se encontr\u00f3 la solicitud ${doc}`+(esArea()?" entre las de tu \u00e1rea.":"."));
  const h=o.h, e=o.estado, pend=pendientesSol(o).length, b=[]; let m;
  if(["ENVIADA","VISTA"].includes(e)){ m=["warn","Todav\u00eda no est\u00e1 aprobada: no se entrega material hasta que almac\u00e9n la revise y la apruebe."]; if(canWrite()) b.push({t:"Revisar y aprobar",p:1,f:()=>abrirAte(o.doc)}); }
  else if(["APROBADA","PARCIAL"].includes(e)){ m=["ok",(e==="PARCIAL"?"Ya se entreg\u00f3 una parte. ":"")+`Lista para entregar: ${pend} \u00edtem${pend===1?"":"s"} por recoger.`+(o.recojo?` Recojo: ${recTxt(o.recojo)}${o.vencido?" (vencido)":""}.`:"")];
    if(canWrite()) b.push({t:"Entregar ahora",p:1,f:()=>abrirAte(o.doc)}); }
  else if(e==="ENTREGADA") m=["mute",`Ya se entreg\u00f3 completa${o.vales.length?" con "+o.vales.join(", "):""}. Esta hoja ya no sirve para recoger otra vez.`];
  else m=["bad",`${solTxt[e]||e}: con esta solicitud no se entrega material.`];
  if(!b.length) b.push({t:"Ver detalle",f:()=>abrirAte(o.doc)});
  b.push({t:"Imprimir",f:()=>printSol(o.doc)});
  if(!esArea()) o.vales.forEach(v=>b.push({t:"Vale "+v,f:()=>printDoc(v)}));
  return {tit:`Solicitud ${o.doc}`+(h.NRO_AREA?" \u00b7 "+h.NRO_AREA:""),btns:b,html:estadoQr(m)+filasQr([["Estado",solTxt[e]||e],["\u00c1rea",h.AREA],["Recoge",h.RECEPTOR],["Fecha",fdate(h.FECHA)],
    ["\u00cdtems",`${o.items.length} \u00b7 entregado ${fmt(o.atendido)} de ${fmt(o.pedido)}`],["Vales de salida",o.vales.join(", ")]])}; }
function qrDoc(doc){ const d=S.docs.find(x=>U(x.doc)===U(doc));
  if(!d) return noQr(`No se encontr\u00f3 el documento ${doc}. Puede ser de un a\u00f1o ya cerrado.`);
  if(esArea()&&d.tipo!=="INGRESO") return noQr("Este documento lo ve solo almac\u00e9n.");
  const h=d.h, t=d.tipo, T=TIPO[t]||{doc:t}, b=[]; let m=h.ANULADO?["bad","Documento ANULADO: no cuenta en el stock. "+h.ANULADO]:null;
  if(t==="PRESTAMO"&&!h.ANULADO){ const ls=S.loans.filter(l=>l.doc===d.doc), p=ls.filter(l=>l.pend>0);
    m=p.length?[ls.some(l=>l.estado==="Vencido")?"bad":"warn",`Falta devolver: ${p.map(l=>fmt(l.pend)+" "+l.und+" de "+l.desc).join(", ")}. Fecha l\u00edmite ${fdate(h.FECHA_DEV)}.`]:["ok","Pr\u00e9stamo devuelto completo."];
    if(p.length&&canWrite()) b.push({t:"Registrar devoluci\u00f3n",p:1,f:()=>abrirDoc("DEVOLUCION",d.doc)}); }
  if(t==="INGRESO"&&h.ORC) b.push({t:"Ver la orden de compra",f:()=>{ $("#qOrc").value=h.ORC; $("#qOrcSt").value=""; showTab("orc"); renderOrc(); }});
  if(!esArea()) b.push({t:"Imprimir",f:()=>printDoc(d.doc)});
  const fil=d.items.map(x=>{ const oc=t==="INGRESO"?ocTxt(S.oc[ocKey(x.ORC,x.CODIGO)],x):"";
    return `<div><div>${esc(x.DESCRIPCION)}<div class="code">${esc(x.CODIGO)}${oc?" \u00b7 "+esc(oc):""}</div></div><span class="q">${fmt(Math.abs(x.CANT))} ${esc(x.UND)}</span></div>`; }).join("");
  return {tit:`${T.doc} ${d.doc}`,btns:b,html:estadoQr(m)+filasQr([["Fecha",fdate(h.FECHA)],[t==="INGRESO"?"Proveedor":"Contratista",who(h)],["\u00c1rea",h.AREA],["Orden de compra",t==="INGRESO"?h.ORC:""],["Registrado por",h.USUARIO]])
    +`<div class="qr-list">${fil}</div>`}; }
function qrMat(cod){ const s=S.byCod[U(cod)]; if(!s) return noQr(`No se encontr\u00f3 el material ${cod}.`);
  const ls=(S.lotsMat[U(cod)]||[]).filter(l=>l.SALDO>1e-9).sort(porFecha), vis=esArea()?ls.filter(l=>U(l.AREA)===S.ses.area||esGeneral(l)):ls;
  const gen=sum(ls.filter(esGeneral),l=>l.SALDO)+Math.max(0,s.saldo-sum(ls,l=>l.SALDO)), b=[];
  if(canWrite()&&s.saldo>0) b.push({t:"Registrar salida",p:1,f:()=>salidaDe(s.codigo,"")});
  b.push({t:"Ver kardex",f:()=>{ $("#qKdx").value=s.desc; showTab("kdx"); renderKdx(); }});
  if(!esArea()) b.push({t:"Imprimir etiqueta",f:()=>etqMat([s])});
  const fil=vis.map(l=>`<div><div><a href="#" data-qrl="${esc(l.ID)}">${l.IM?"Internamiento "+esc(l.DOC):"ORC "+esc(l.ORC||"s/n")}</a> \u00b7 ${esGeneral(l)?"Stock general":esc(l.AREA)}${l.vida?` <span class="pill ${vidaCls[l.vida.estado]}">${esc(l.vida.estado)}</span>`:""}
    <div class="code">${esc([l.REQ,fdate(String(l.FECHA).slice(0,10)),l.DOC].filter(Boolean).join(" \u00b7 "))}${l.OC&&l.OC.n>1?" \u00b7 llegada "+l.LLEGADA:""}</div></div><span class="q">${fmt(l.SALDO)}</span></div>`).join("");
  return {tit:s.desc,btns:b,html:`<div class="qr-big">${fmt(s.saldo)} <small>${esc(s.und)} en almac\u00e9n</small></div>`+filasQr([["C\u00f3digo",s.codigo],["Ubicaci\u00f3n",s.ubi||"\u2014"],["Stock general (cualquier \u00e1rea)",fmt(gen)+" "+s.und],["Prestado",s.pres?fmt(s.pres)+" "+s.und:""]])
    +(vis.length?`<h3>Saldo por orden (toca una para verla)</h3><div class="qr-list">${fil}</div>`:'<p class="note">Ninguna orden tiene saldo de este material.</p>')}; }
function qrLote(id){ const l=S.lots[id];
  if(!l) return noQr("No se encontr\u00f3 esta orden. Puede que su ingreso se haya anulado o que sea de un a\u00f1o ya cerrado.");
  if(esArea()&&U(l.AREA)!==S.ses.area&&!esGeneral(l)) return noQr("Esta orden es de otra \u00e1rea.");
  const m=l.SALDO<=1e-9?["mute","Esta orden ya no tiene saldo."]:l.vida?[l.vida.estado==="Vencido"?"bad":"warn",l.vida.estado+": "+vidaTxt(l.vida)]:null, b=[];
  if(canWrite()&&l.SALDO>1e-9) b.push({t:"Sacar de esta orden",p:1,f:()=>salidaDe(l.CODIGO,l.ID)});
  b.push({t:"Ver todo el material",f:()=>abrirQr("m",l.CODIGO)});
  if(!esArea()) b.push({t:"Imprimir etiqueta",f:()=>imprimirEtiquetas("Etiqueta de orden",[etqLote(l)])});
  return {tit:l.DESCRIPCION,btns:b,html:estadoQr(m)+`<div class="qr-big">${fmt(l.SALDO)} <small>${esc(l.UND)} quedan de esta orden</small></div>`
    +filasQr([["Orden de compra",l.ORC||"s/n"],["Requerimiento",l.REQ],["\u00c1rea",esGeneral(l)?"Stock general":l.AREA],["Ingreso",`${l.DOC} \u00b7 ${fdate(String(l.FECHA).slice(0,10))}`],["Proveedor",l.PROVEEDOR],
      ["Lleg\u00f3 / usado",`${fmt(l.ING)} / ${fmt(l.USADO)} ${l.UND}`],["Toda la ORC",ocLote(l)],["Vence",venceLote(l)?fdate(venceLote(l)):""]])}; }
function salidaDe(cod,lote){ const s=S.byCod[U(cod)], l=S.lots[lote]; if(abrirDoc("SALIDA")===false) return;
  if(l&&l.AREA&&[...$("#dArea").options].some(o=>o.value===l.AREA)) $("#dArea").value=l.AREA;
  $("#dMat").value=s?s.desc:cod; $("#dMat").dispatchEvent(new Event("input"));
  if(lote&&[...$("#dLote").options].some(o=>o.value===lote)){ $("#dLote").value=lote; avisoLote(); }
  $("#dCant").focus(); }

/* ---------- etiquetas con QR: estante (por material) y por orden (perecibles y herramientas) ---------- */
function venceLote(l){ const m=matDe(l.CODIGO); if(U(m.VIDA_TIPO)!=="PERECIBLE") return "";
  if(/^\d{4}-\d\d-\d\d/.test(l.VENCE||"")) return l.VENCE.slice(0,10); return N(m.VIDA_DIAS)?addDays(String(l.FECHA).slice(0,10),N(m.VIDA_DIAS)):""; }
var conEtiqueta=l=>!!l&&["PERECIBLE","HERRAMIENTA"].includes(vidaTipo(l.CODIGO));
var etqLote=l=>({qr:qrLink("l",l.ID),t:l.DESCRIPCION,c:l.IM?"Internamiento "+l.DOC:"ORC "+(l.ORC||"s/n"),
  l:[[l.REQ,esGeneral(l)?"STOCK GENERAL":l.AREA].filter(Boolean).join(" \u00b7 "),`Ingres\u00f3 ${fdate(String(l.FECHA).slice(0,10))} \u00b7 ${l.DOC}`+(l.OC&&l.OC.n>1?` \u00b7 llegada ${l.LLEGADA}`:""),venceLote(l)?"VENCE: "+fdate(venceLote(l)):""],k:"Escanea: saldo de esta orden"});
function etqMat(list){ imprimirEtiquetas("Etiquetas de estante",list.map(s=>({qr:qrLink("m",s.codigo),t:s.desc,c:s.codigo,l:[s.ubi?"Ubicaci\u00f3n: "+s.ubi:"","Unidad: "+s.und],k:"Escanea: stock y \u00f3rdenes"}))); }
function imprimirEtiquetas(titulo,et){
  if(!et.length){ toast("No hay etiquetas para imprimir con este filtro."); return; }
  if(!S.url){ toast("Falta el enlace de la app: \u00e1brela desde el enlace publicado (Implementar) para que el QR sepa a d\u00f3nde llevar."); return; }
  if(!window.qrcode){ toast("Cargando el generador de QR; vuelve a pulsar en unos segundos."); cargarQr(); return; }
  const w=window.open("","_blank"); if(!w){ toast("Permite las ventanas emergentes para imprimir."); return; }
  w.document.write(`<!doctype html><html><head><meta charset="utf-8"><title>${esc(titulo)}</title><style>
  @page{size:A4 portrait;margin:8mm}body{font:10px/1.25 Arial,Helvetica,sans-serif;margin:0;color:#111}
  .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:3mm}
  .et{border:1px dashed #999;border-radius:2mm;padding:2.5mm;display:flex;gap:2.5mm;height:37mm;box-sizing:border-box;break-inside:avoid;overflow:hidden}
  .et svg{width:27mm;height:27mm;flex:none}.tx{min-width:0;display:flex;flex-direction:column;gap:.8mm}
  .t{font-weight:bold;font-size:10.5px;line-height:1.15;max-height:3.5em;overflow:hidden}.c{font:bold 11px monospace}.l{color:#333;font-size:9px}.k{font-size:7.5px;color:#666;margin-top:auto}
  .no-print{margin:10px 0}@media print{.no-print{display:none}}button{font:600 13px Arial;padding:8px 14px;background:#1f5f8b;color:#fff;border:0;border-radius:4px;cursor:pointer}
  </style></head><body><div class="no-print"><button onclick="print()">Imprimir</button> ${et.length} etiqueta${et.length===1?"":"s"} \u00b7 3 por fila, 21 por hoja A4 (sirve papel adhesivo)</div>
  <div class="grid">${et.map(e=>`<div class="et">${qrSvg(e.qr)}<div class="tx"><div class="t">${esc(e.t)}</div>${e.c?`<div class="c">${esc(e.c)}</div>`:""}${e.l.filter(Boolean).map(x=>`<div class="l">${esc(x)}</div>`).join("")}<div class="k">${esc(e.k||"")}</div></div></div>`).join("")}</div>
  </body></html>`);
  w.document.close(); }
$("#btnEtq").onclick=()=>{ const r=filtMat(); if(r.length>63&&!confirm(`Son ${r.length} etiquetas (${Math.ceil(r.length/21)} hojas). Usa el buscador para imprimir solo un estante o una categor\u00eda. \u00bfImprimir todas?`)) return; etqMat(r); };
$("#btnEtqL").onclick=()=>{ const r=filtOrc(U($("#qOrc").value),$("#qOrcArea").value,$("#qOrcSt").value).filter(l=>l.SALDO>0&&conEtiqueta(l));
  if(!r.length){ toast("Las etiquetas por orden son para perecibles y herramientas con saldo. Ninguna orden del filtro es de ese tipo."); return; }
  imprimirEtiquetas("Etiquetas por orden",r.map(etqLote)); };

/* ---------- unidades de medida: lista oficial con codigo SUNAT y sinonimos ---------- */
function prepUnidades(l){ S.und=(l||[]).map(u=>({NOMBRE:U(u.NOMBRE),CODIGO_SUNAT:U(u.CODIGO_SUNAT),SINONIMOS:str(u.SINONIMOS),ACTIVO:U(u.ACTIVO)||"SI"})).filter(u=>u.NOMBRE);
  S.undMap={}; S.und.forEach(u=>{ S.undMap[nzx(u.NOMBRE)]=u.NOMBRE; });
  S.und.forEach(u=>u.SINONIMOS.split(/[,;]/).map(x=>nzx(x).replace(/\.$/,"")).filter(Boolean).forEach(x=>{ if(!S.undMap[x]) S.undMap[x]=u.NOMBRE; })); }
var undSunat=n=>(S.und.find(u=>u.NOMBRE===undCan(n))||{}).CODIGO_SUNAT||"";
var undOficial=n=>S.und.some(u=>u.NOMBRE===U(n));
function dlUnidades(){ const l=S.und.filter(u=>u.ACTIVO!=="NO");
  $("#dlUnd").innerHTML=l.length?l.map(u=>`<option value="${esc(u.NOMBRE)}" label="${esc(u.NOMBRE+" ("+u.CODIGO_SUNAT+")")}">`).join(""):uniq(S.mat.map(m=>m.UND)).map(v=>`<option value="${esc(v)}">`).join(""); }
// al escribir una unidad: GL pasa a GALON; si no esta en la lista, avisa
function fijarUnd(el){ const v=U(el.value); if(!v||!S.und.length) return; const c=undCan(v);
  if(c!==v){ el.value=c; toast(`${v} = ${c}: se usa el nombre oficial.`); el.dispatchEvent(new Event("input")); }
  else if(!undOficial(c)) toast(`${c} no est\u00e1 en la lista de unidades. Si es una unidad nueva, el administrador la agrega en Materiales \u2192 Unidades.`); }
["#mUnd","#dUndN","#qvUnd"].forEach(x=>$(x).addEventListener("change",e=>fijarUnd(e.target)));
function renderUnd(){ if($("#undBox").hidden) return; $("#btnUnd").hidden=$("#btnUnif").hidden=!isAdmin();
  const q=nzx($("#qUnd").value), uso={}; S.mat.forEach(m=>{const k=undCan(m.UND); uso[k]=(uso[k]||0)+1;});
  const fuera=uniq(S.mat.map(m=>m.UND).filter(u=>u&&!undOficial(u)));
  const r=S.und.filter(u=>!q||nzx([u.NOMBRE,u.CODIGO_SUNAT,u.SINONIMOS].join(" ")).includes(q));
  $("#tbUnd").innerHTML=(r.map(u=>`<tr><td><b>${esc(u.NOMBRE)}</b></td><td class="code">${esc(u.CODIGO_SUNAT)}</td><td class="note">${esc(u.SINONIMOS)||"\u2014"}</td><td class="num">${uso[u.NOMBRE]||""}</td>
    <td><span class="pill ${u.ACTIVO==="NO"?"mute":"ok"}">${u.ACTIVO==="NO"?"Inactiva":"Activa"}</span></td><td>${isAdmin()?`<button class="btn sm" data-und="${esc(u.NOMBRE)}">Editar</button>`:""}</td></tr>`).join("")||empty(6,S.und.length?"Ninguna unidad coincide.":"La lista de unidades se crea al actualizar el Code.gs."))
    +(fuera.length?`<tr class="st-warn"><td colspan="6">Unidades usadas en materiales que no est\u00e1n en la lista: <b>${esc(fuera.join(", "))}</b>. ${isAdmin()?"Usa Unificar unidades o agr\u00e9galas con + Unidad.":""}</td></tr>`:""); }
$("#qUnd").addEventListener("input",renderUnd);
function abrirUnd(n){ const u=S.und.find(x=>x.NOMBRE===n); S.undEd=u?u.NOMBRE:"";
  $("#unTit").textContent=u?"Unidad "+u.NOMBRE:"Unidad nueva"; $("#unNom").value=u?u.NOMBRE:""; $("#unCod").value=u?u.CODIGO_SUNAT:""; $("#unSin").value=u?u.SINONIMOS:"";
  $("#unAct").checked=!u||u.ACTIVO!=="NO"; $("#unActBox").hidden=!u; $("#unErr").textContent=""; $("#pUnd").hidden=false; (u?$("#unSin"):$("#unNom")).focus({preventScroll:true}); }
$("#btnUnd").onclick=()=>abrirUnd("");
$("#tbUnd").addEventListener("click",e=>{const b=e.target.closest("[data-und]"); if(b) abrirUnd(b.dataset.und);});
$("#fUnd").onsubmit=async e=>{ e.preventDefault(); const err=$("#unErr"); err.textContent="";
  const d={antes:S.undEd,nombre:$("#unNom").value.trim(),codigo:$("#unCod").value.trim(),sinonimos:$("#unSin").value,activo:$("#unAct").checked};
  if(!d.nombre){err.textContent="Escribe el nombre.";return;} if(!d.codigo){err.textContent="Escribe el c\u00f3digo SUNAT (o NIU si no tiene uno propio).";return;}
  $("#unSave").disabled=true; try{ const n=await api("guardarUnidad",d); await cargar(); $("#pUnd").hidden=true; toast(`Unidad ${n} guardada.`); }catch(x){ err.textContent=msg(x); } $("#unSave").disabled=false; };
async function resumenUnif(){ const r=$("#ufRes"); r.textContent="Calculando\u2026"; $("#ufSave").disabled=true; $("#ufErr").textContent="";
  try{ const p=await api("resumenUnificar"); S.unif=p; const f=p.filas, total=f.materiales+f.movimientos+f.solicitudes+f.equivalencias;
    r.innerHTML=(p.cambios.length?`<p><b>Se cambia:</b></p><ul>${p.cambios.map(c=>`<li>${esc(c.de)}</li>`).join("")}</ul>`:"<p><b>No hay unidades escritas distinto.</b></p>")
      +(total?`<p>Filas que cambian: ${f.materiales} materiales, ${f.movimientos} en movimientos, ${f.solicitudes} en solicitudes, ${f.equivalencias} equivalencias.</p>`:"")
      +(p.quitadas.length?`<p><b>Equivalencias que se quitan:</b></p><ul>${p.quitadas.map(q=>`<li>${esc(q)}</li>`).join("")}</ul>`:"")
      +(p.fuera.length?`<p class="warnmsg">Unidades que no est\u00e1n en la lista y no se cambian: <b>${esc(p.fuera.map(x=>x.und).join(", "))}</b>. Si son sin\u00f3nimos, agr\u00e9galos a su unidad y vuelve a abrir esta ventana; si son nuevas, cr\u00e9alas con + Unidad.</p>`:"");
    $("#ufSave").disabled=!total; }
  catch(x){ r.textContent=""; $("#ufErr").textContent=msg(x); } }
$("#btnUnif").onclick=()=>{ $("#pUnif").hidden=false; resumenUnif(); };
$("#ufSave").onclick=async()=>{ if(!confirm("\u00bfUnificar las unidades? Solo cambia el nombre de la unidad; las cantidades no cambian.")) return;
  $("#ufSave").disabled=true; try{ const p=await api("unificarUnidades"); await cargar(); toast("Unidades unificadas."); resumenUnif(); }catch(x){ $("#ufErr").textContent=msg(x); $("#ufSave").disabled=false; } };

/* ---------- copia de seguridad semanal (administrador) ---------- */
function respBtn(){ const r=S.resp||{}; $("#btnResp").hidden=!isAdmin(); $("#btnResp").textContent="Copia semanal: "+(r.activo?"activada":"desactivada"); }
function renderResp(){ const r=S.resp||{}, u=r.ultimo;
  $("#rsEst").innerHTML=`Estado: <b>${r.activo?"activada (domingos a las 10 p. m.)":"desactivada"}</b>`;
  $("#rsUlt").innerHTML=u?`\u00daltima copia: <b>${esc(hora(u.en))}</b> \u00b7 <a href="${esc(u.url)}" target="_blank" rel="noopener">${esc(u.nombre)}</a><br><a href="${esc(u.carpeta)}" target="_blank" rel="noopener">Abrir la carpeta de respaldos</a>`:"A\u00fan no se ha hecho ninguna copia.";
  $("#rsTog").textContent=r.activo?"Desactivar copia semanal":"Activar copia semanal"; }
$("#btnResp").onclick=()=>{ $("#rsErr").textContent=""; renderResp(); $("#pResp").hidden=false; };
async function accionResp(btn,fn,args,espera,ok){ const t=btn.textContent; $$("#pResp .bar .btn").forEach(b=>b.disabled=true); btn.textContent=espera; $("#rsErr").textContent="";
  try{ S.resp=await api(fn,...args); toast(ok()); }catch(x){ $("#rsErr").textContent=msg(x); }
  $$("#pResp .bar .btn").forEach(b=>b.disabled=false); btn.textContent=t; renderResp(); respBtn(); }
$("#rsTog").onclick=()=>{ const act=!(S.resp||{}).activo; accionResp($("#rsTog"),"activarRespaldo",[act],act?"Activando y haciendo la primera copia\u2026":"Desactivando\u2026",()=>act?"Copia semanal activada. Ya se hizo la primera copia.":"Copia semanal desactivada."); };
$("#rsAhora").onclick=()=>accionResp($("#rsAhora"),"respaldarAhora",[],"Copiando\u2026",()=>"Copia hecha.");

/* ---------- carga de datos ---------- */
async function cargar(){
  const d=await api("getData");
  S.ses=d.sesion; S.roles=d.roles||{}; S.usuarios=d.usuarios||[]; S.aviso=!!d.avisoSemanal; S.cierre=d.cierre||null; S.piloto=d.piloto||null; S.url=d.url||""; S.resp=d.respaldo||null; prepUnidades(d.und);
  $("#pilBan").hidden=!S.piloto; if(S.piloto) $("#pilBan").textContent=`Prueba piloto desde el ${fdate(S.piloto.desde)}: los datos que registres ahora se borrar\u00e1n al terminar la prueba.`;
  S.mat=d.mat.map(m=>({...m,CODIGO:str(m.CODIGO),DESCRIPCION:str(m.DESCRIPCION),CATEGORIA:str(m.CATEGORIA),UND:str(m.UND),UBICACION:str(m.UBICACION),RETAZO_DE:str(m.RETAZO_DE),KG_M:N(m.KG_M)}));
  S.sol=(d.sol||[]).map(x=>({...x,ID:N(x.ID),DOC:str(x.DOC),FECHA:str(x.FECHA),AREA:U(x.AREA),SOLICITANTE:str(x.SOLICITANTE),RECEPTOR:U(x.RECEPTOR),
    RESPONSABLE:str(x.RESPONSABLE),OBRA:U(x.OBRA),MOTIVO:str(x.MOTIVO),METRADO:str(x.METRADO),LOTES_OBRA:str(x.LOTES_OBRA),MZ:str(x.MZ),USO:str(x.USO),
    CODIGO:str(x.CODIGO),DESCRIPCION:str(x.DESCRIPCION),UND:str(x.UND),CANT:N(x.CANT),LOTE:str(x.LOTE),ATENDIDO:N(x.ATENDIDO),ESTADO:U(x.ESTADO)||"ENVIADA",
    DOC_SAL:str(x.DOC_SAL),OBS:str(x.OBS),USUARIO:str(x.USUARIO),NRO_AREA:U(x.NRO_AREA),ORIGEN:U(x.ORIGEN),REGISTRADO:str(x.REGISTRADO),
    VISTA_POR:str(x.VISTA_POR),VISTA_EN:str(x.VISTA_EN),APROBADA_POR:str(x.APROBADA_POR),APROBADA_EN:str(x.APROBADA_EN),CERRADA_POR:str(x.CERRADA_POR),CERRADA_EN:str(x.CERRADA_EN),
    REQ:str(x.REQ),RECOJO_FECHA:str(x.RECOJO_FECHA).slice(0,10),RECOJO_TURNO:U(x.RECOJO_TURNO),RECOJO_LIMITE:str(x.RECOJO_LIMITE).slice(0,10),RECOJO_HORA:/^\d{1,2}:\d{2}$/.test(str(x.RECOJO_HORA))?str(x.RECOJO_HORA):"",CONTRATO:U(x.CONTRATO),PRESTAMO:U(x.PRESTAMO),FECHA_DEV:str(x.FECHA_DEV).slice(0,10)}));
  S.eq=(d.eq||[]).map(e=>({CODIGO:U(e.CODIGO),UND_COMPRA:U(e.UND_COMPRA),FACTOR:N(e.FACTOR),TIPO:U(e.TIPO)==="FIJA"?"FIJA":"VARIABLE",OBS:str(e.OBS)})).filter(e=>e.CODIGO&&e.UND_COMPRA&&e.FACTOR>0);
  S.ent=(d.ent||[]).map(e=>({TIPO:U(e.TIPO),NOMBRE:U(e.NOMBRE),DOCUMENTO:str(e.DOCUMENTO),CONTACTO:str(e.CONTACTO),ACTIVO:U(e.ACTIVO)||"SI"}));
  S.mov=d.mov.map(x=>({...x,ID:N(x.ID),DOC:str(x.DOC),TIPO:U(x.TIPO),FECHA:str(x.FECHA),FECHA_DEV:str(x.FECHA_DEV),CODIGO:str(x.CODIGO),DESCRIPCION:str(x.DESCRIPCION),UND:str(x.UND),
    CANT:N(x.CANT),PU:N(x.PU),TOTAL:N(x.TOTAL),PROVEEDOR:U(x.PROVEEDOR),ORC:str(x.ORC),REQ:str(x.REQ),GUIA:str(x.GUIA),CONTRATISTA:U(x.CONTRATISTA),OBRA:U(x.OBRA),AREA:U(x.AREA),
    USO:str(x.USO),SOLICITANTE:str(x.SOLICITANTE),DOC_REF:str(x.DOC_REF),OBS:str(x.OBS),USUARIO:str(x.USUARIO),LOTE:str(x.LOTE),LOTE_ORIGEN:str(x.LOTE_ORIGEN),
    UND_COMPRA:U(x.UND_COMPRA),CANT_COMPRA:N(x.CANT_COMPRA),PU_COMPRA:N(x.PU_COMPRA),FACTOR:N(x.FACTOR),VENCE:str(x.VENCE).slice(0,10),ESTADO_DEV:U(x.ESTADO_DEV),
    ANULADO:str(x.ANULADO),CORREGIDO:str(x.CORREGIDO),REGISTRADO:str(x.REGISTRADO),CANT_OC:N(x.CANT_OC),CONTRATO:U(x.CONTRATO),AUTORIZA:U(x.AUTORIZA)}))
    .sort((a,b)=>a.FECHA.localeCompare(b.FECHA)||a.ID-b.ID);
  // lo anulado se ve en Movimientos pero no cuenta en ningun saldo
  S.movAll=S.mov; S.mov=S.movAll.filter(x=>!x.ANULADO);
  S.db=true; $("#login").hidden=true; $("#app").hidden=false;
  let t="dash"; try{t=localStorage.getItem("alm.tab")||"dash";}catch(e){}
  if(!$("#v-"+t)) t="dash";
  render(); showTab(S.tab&&S.tab!=="dash"?S.tab:t);
  cargarQr(); if(QRP) irQr();
}
leerQr();
S.token=tkGuardado();
if(S.token) cargar().catch(e=>salir(msg(e)));
setInterval(()=>{ if(S.db&&document.visibilityState==="visible"&&$$(".modal").every(m=>m.hidden)) cargar().catch(()=>{}); },90000);
window.APP_OK=1;
</script>

</body></html>
